---
import { Image } from 'astro:assets';
import ArrowRightBold from 'phosphor-astro/ArrowRightBold.astro';
import CheckCircleFill from 'phosphor-astro/CheckCircleFill.astro';
import HeartBold from 'phosphor-astro/HeartBold.astro';
import Button from '@components/ui/Button.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import maxiPhoto from '../../assets/home/maxi-1.webp';
import promiseBackground from '../../assets/home/join-the-pack-background.webp';
import { isStoreLive } from '../../config/storefront';
import { localizeHref, localizedLinkLabel } from '../../i18n/routes';

const paragraphs = [
    'Maxi forma parte de nuestras vidas desde cachorro. Desde el principio buscamos juguetes que despertaran su interés, accesorios cómodos y productos útiles que facilitaran los paseos, los viajes, la alimentación, la hidratación y el cuidado diario.',
    'Vivir con Maxi nos enseñó que no todos los productos para mascotas ofrecen la misma experiencia. Algunos juguetes se convierten enseguida en favoritos. Algunos accesorios se ven bien, pero resultan poco prácticos. Y ciertos productos cotidianos terminan siendo imprescindibles sin que apenas nos demos cuenta.',
    'De esas experiencias nació la idea de Maxi Pawz: una tienda inspirada en la vida real con un perro de verdad. Queríamos reunir juguetes, accesorios prácticos, esenciales para viajes e hidratación, productos para el descanso y artículos de uso diario bajo una marca cercana.',
    'No desarrollamos la idea solos. Nuestros amigos creyeron en Maxi Pawz, nos animaron, compartieron ideas y nos ayudaron a seguir adelante cuando el negocio apenas comenzaba. Su apoyo convirtió una idea personal inspirada en Maxi en un proyecto que sigue creciendo.',
];

const milestones = [
    { number: '01', title: 'La vida con Maxi', description: 'Cuidar de Maxi desde cachorro nos dio experiencia directa con juguetes, accesorios, rutinas y necesidades cotidianas de las mascotas.' },
    { number: '02', title: 'Aprender qué funciona', description: 'Con el tiempo aprendimos a distinguir entre los productos que solo resultan atractivos y los que son realmente útiles.' },
    { number: '03', title: 'Crecer desde cero, juntos', description: 'Nuestros amigos apoyaron la idea con ánimo, opiniones, creatividad y la confianza de que Maxi Pawz podía convertirse en algo especial.' },
    { number: '04', title: 'Una visión que crece', description: 'La idea que inspiró Maxi se ha convertido en una marca que continúa evolucionando con el apoyo de nuestra comunidad.' },
];

const lessons = [
    { title: 'El juego debe tener un propósito', description: 'Un buen juguete despierta interés, actividad, curiosidad, interacción o, simplemente, un momento de felicidad.' },
    { title: 'Los detalles prácticos importan', description: 'La comodidad, la durabilidad, la facilidad de transporte, el tamaño y la facilidad de uso pueden aportar mucho valor a un producto cotidiano.' },
    { title: 'Cada perro es diferente', description: 'Los perros tienen sus propias preferencias, personalidades, rutinas y formas de jugar, igual que las personas que los quieren.' },
    { title: 'Las buenas ideas crecen en compañía', description: 'Maxi inspiró la tienda, pero el ánimo y el apoyo de nuestros amigos nos ayudaron a hacer realidad el proyecto.' },
];

const promises = [
    'Productos considerados para el uso cotidiano real',
    'Información clara sobre su propósito, tamaños y cuidados',
    'Opciones para jugar, pasear, viajar, hidratarse, descansar y acompañar las rutinas diarias',
    'Orientación honesta, sin promesas exageradas',
    'Una experiencia de compra cercana, basada en la experiencia de cuidar de una mascota',
];

const actionHref = isStoreLive ? '/shop' : '/#join-the-pack';
const actionLabel = isStoreLive ? 'Explorar la tienda' : 'Unirme a la comunidad';
---

<BaseLayout
    title="Conoce a Maxi"
    description="Conoce a Maxi, el perro que inspiró Maxi Pawz, y descubre cómo nuestra experiencia diaria y el apoyo de nuestros amigos dieron forma a la marca."
>
    <section class="relative overflow-hidden" aria-labelledby="about-page-title">
        <div class="site-container-wide grid items-center gap-10 py-12 sm:py-16 lg:grid-cols-2 lg:gap-16">
        <div>
            <p class="text-sm font-extrabold tracking-wide text-brand-700">Nuestra historia</p>
            <h1 id="about-page-title" class="mt-4 text-5xl text-ink-900 sm:text-6xl lg:text-7xl">
            Conoce a Maxi, el corazón de <span class="text-brand-gradient">Maxi Pawz.</span>
            </h1>
            <p class="mt-6 max-w-2xl text-lg leading-8 text-ink-600">
            Maxi es nuestro perro, la inspiración de nuestra mascota de marca y la razón por la que
            existe esta tienda. Nuestra experiencia al elegir productos comenzó en casa, cuidándolo
            desde cachorro y descubriendo qué marca la diferencia en la vida diaria de un perro.
            </p>
            <div class="mt-8 flex flex-wrap gap-3">
            <Button href="#maxis-story" variant="primary" size="lg" iconPosition="right">
                <ArrowRightBold slot="icon" aria-hidden="true" />
                Descubrir su historia
            </Button>
            <Button href={localizeHref(actionHref, 'es')} variant="secondary" size="lg">
                {localizedLinkLabel(actionLabel, actionHref, 'es')}
            </Button>
            </div>
            <ul class="mt-8 space-y-2 text-sm font-bold text-ink-600">
            <li>Inspirados por nuestro propio perro</li>
            <li>Guiados por la experiencia directa</li>
            <li>Acompañados por el apoyo de nuestros amigos</li>
            </ul>
        </div>
        <figure class="overflow-hidden rounded-[2.5rem] border border-sand bg-white-warm shadow-card">
            <Image
            src={maxiPhoto}
            alt="Maxi, el perro que inspiró el nombre y la mascota de Maxi Pawz"
            class="aspect-4/5 w-full object-cover"
            widths={[480, 640, 768, 960]}
            sizes="(min-width: 1024px) 45vw, 100vw"
            loading="eager"
            fetchpriority="high"
            quality={85}
            />
            <figcaption class="p-5 text-sm leading-6 text-ink-600">
            <strong class="block text-lg text-ink-900">El Maxi Paw original.</strong>
            El perro de verdad que inspiró nuestro nombre, nuestra mascota de marca y nuestra misión.
            </figcaption>
        </figure>
        </div>
    </section>

    <section id="maxis-story" class="section-spacing scroll-mt-28 border-y border-sand bg-white-warm/70" aria-labelledby="maxi-story-title">
        <div class="site-container-wide grid gap-12 lg:grid-cols-[1.1fr_0.9fr]">
        <div>
            <p class="text-sm font-extrabold text-brand-700">Dónde comenzó todo</p>
            <h2 id="maxi-story-title" class="mt-4 text-4xl text-ink-900 sm:text-5xl">
            Antes de la tienda, llegó Maxi.
            </h2>
            <div class="mt-6 space-y-5 text-base leading-8 text-ink-600 sm:text-lg">
            {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            </div>
            <p class="mt-8 font-bold leading-7 text-brand-800">
            Inspirados por Maxi. Apoyados por amigos. Pensados para las mascotas y sus familias.
            </p>
        </div>
        <ol class="space-y-5">
            {milestones.map((milestone) => (
            <li class="rounded-3xl border border-sand bg-cream-soft p-6">
                <span class="text-sm font-black text-brand-700" aria-hidden="true">{milestone.number}</span>
                <h3 class="mt-2 text-2xl text-ink-900">{milestone.title}</h3>
                <p class="mt-3 text-sm leading-7 text-ink-600">{milestone.description}</p>
            </li>
            ))}
        </ol>
        </div>
    </section>

    <section class="section-spacing" aria-labelledby="maxi-lessons-title">
        <div class="site-container-wide">
        <div class="max-w-3xl">
            <p class="text-sm font-extrabold text-brand-700">Lo que Maxi nos enseñó</p>
            <h2 id="maxi-lessons-title" class="mt-4 text-4xl text-ink-900 sm:text-5xl">
            La experiencia real guía nuestra visión.
            </h2>
            <p class="mt-5 text-lg leading-8 text-ink-600">
            Vivir con Maxi nos ayudó a entender que los mejores productos combinan felicidad,
            utilidad, comodidad y un propósito claro.
            </p>
        </div>
        <div class="mt-9 grid gap-5 sm:grid-cols-2 xl:grid-cols-4">
            {lessons.map((lesson) => (
            <article class="rounded-3xl border border-sand bg-white-warm p-6">
                <h3 class="text-2xl text-ink-900">{lesson.title}</h3>
                <p class="mt-4 text-sm leading-7 text-ink-600">{lesson.description}</p>
            </article>
            ))}
        </div>
        </div>
    </section>

    <section class="section-spacing pt-0" aria-labelledby="customer-promise-title">
        <div class="site-container-wide">
        <div class="grid overflow-hidden rounded-[2.5rem] border border-brand-200 bg-brand-50 shadow-card lg:grid-cols-2">
            <div class="relative flex min-h-96 flex-col justify-end overflow-hidden p-7 sm:p-10">
            <Image src={promiseBackground} alt="" class="absolute inset-0 size-full object-cover" widths={[480, 640, 768, 960]} sizes="(min-width: 1024px) 45vw, 100vw" loading="lazy" quality={85} />
            <div class="absolute inset-0 bg-linear-to-t from-ink-950/95 via-ink-950/50 to-transparent" aria-hidden="true"></div>
            <div class="relative">
                <HeartBold class="size-9 text-accent-300" aria-hidden="true" />
                <h2 id="customer-promise-title" class="mt-5 text-4xl text-white">
                Una tienda inspirada en la vida real con un perro de verdad.
                </h2>
                <p class="mt-4 text-base leading-7 text-white/90">
                Queremos que Maxi Pawz sea una marca honesta, útil y cercana, basada en las
                experiencias cotidianas que comparten quienes cuidan de una mascota.
                </p>
            </div>
            </div>
            <ul class="grid content-center gap-5 p-7 sm:p-10">
            {promises.map((promise) => (
                <li class="flex items-start gap-3 text-base font-bold leading-7 text-ink-700">
                <CheckCircleFill class="mt-1 size-5 shrink-0 text-brand-600" aria-hidden="true" />
                <span>{promise}</span>
                </li>
            ))}
            </ul>
        </div>
        </div>
    </section>

    <section class="section-spacing pt-0" aria-labelledby="about-next-title">
        <div class="site-container">
        <div class="rounded-[2.5rem] border border-accent-200 bg-accent-50 px-6 py-10 sm:p-10">
            <h2 id="about-next-title" class="max-w-3xl text-4xl text-ink-900 sm:text-5xl">
            Maxi inspiró el comienzo. Tú puedes ser parte de lo que viene.
            </h2>
            <p class="mt-5 max-w-3xl text-lg leading-8 text-ink-600">
            {isStoreLive
                ? 'Descubre nuestra colección de productos divertidos, prácticos y elegidos con cuidado para los perros y las personas que los quieren.'
                : 'Únete a la comunidad de Maxi Pawz para recibir novedades del lanzamiento, nuevos productos, guías útiles y más historias de Maxi.'}
            </p>
            <div class="mt-7 flex flex-wrap gap-3">
            <Button href={localizeHref(actionHref, 'es')} variant="primary" size="lg">
                {localizedLinkLabel(actionLabel, actionHref, 'es')}
            </Button>
            <Button href="/es/faq" variant="ghost" size="lg">Preguntas frecuentes</Button>
            </div>
        </div>
        </div>
    </section>
</BaseLayout>