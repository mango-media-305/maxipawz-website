---
import ProductRoutePage from '@components/products/ProductRoutePage.astro';

import type { Product } from '../../../types/product';

import { getActiveProducts } from '../../../utils/products';

interface Props {
  product: Product;
}

export function getStaticPaths() {
  return getActiveProducts('es').map((product) => ({
    params: {
      slug: product.slug,
    },

    props: {
      product,
    },
  }));
}

const { product } = Astro.props as Props;
---

<ProductRoutePage product={product} />
