---
import ArrowRightBold from 'phosphor-astro/ArrowRightBold.astro';
import CheckCircleFill from 'phosphor-astro/CheckCircleFill.astro';
import HeartBold from 'phosphor-astro/HeartBold.astro';
import PawPrintBold from 'phosphor-astro/PawPrintBold.astro';
import ShieldCheckBold from 'phosphor-astro/ShieldCheckBold.astro';
import ShoppingBagOpenBold from 'phosphor-astro/ShoppingBagOpenBold.astro';
import SparkleBold from 'phosphor-astro/SparkleBold.astro';

import FaqGroup from '@components/faq/FaqGroup.astro';
import Badge from '@components/ui/Badge.astro';
import Button from '@components/ui/Button.astro';
import BaseLayout from '@layouts/BaseLayout.astro';

import { isStoreLive } from '../../config/storefront';

import { getFaqGroups, type FaqGroupIcon } from '../../data/faq';

const faqGroups = getFaqGroups(isStoreLive);

const iconByGroup: Record<FaqGroupIcon, typeof PawPrintBold> = {
    storefront: ShoppingBagOpenBold,
    products: PawPrintBold,
    orders: CheckCircleFill,
    help: HeartBold,
};

const heroHighlights = isStoreLive
    ? ['Store and product information', 'Order and return guidance', 'Friendly contact support']
    : ['Upcoming store information', 'Products and Pet Guides', 'Launch updates and support'];
---

<BaseLayout
    title="Frequently Asked Questions"
    description="Find answers about Maxi Pawz, the upcoming store, products, Pet Guides, orders, launch updates, and contacting our team."
>
    <!-- Rounded hero -->
    <section class="py-8 sm:py-10 lg:py-12" aria-labelledby="faq-hero-title">
        <div class="site-container">
        <div
            class:list={[
            'relative overflow-hidden rounded-[2.75rem] border border-brand-200',
            'bg-linear-to-br from-brand-50 via-white-warm to-accent-50',
            'p-6 shadow-card sm:p-8 lg:p-10',
            ]}
        >
            <div
            class="pointer-events-none absolute -top-32 -left-28 size-80 rounded-full bg-brand-300/25 blur-3xl"
            aria-hidden="true"
            >
            </div>

            <div
            class="pointer-events-none absolute -right-28 -bottom-36 size-96 rounded-full bg-accent-300/25 blur-3xl"
            aria-hidden="true"
            >
            </div>

            <div class="relative grid items-center gap-9 lg:grid-cols-[1.08fr_0.92fr] lg:gap-12">
            <div class="max-w-2xl">
                <Badge variant="accent" size="md">
                <SparkleBold slot="icon" aria-hidden="true" />

                Maxi Pawz FAQ
                </Badge>

                <h1 id="faq-hero-title" class="mt-6 text-5xl text-ink-900 sm:text-6xl lg:text-7xl">
                Helpful answers,

                <span class="text-brand-gradient">
                    {' '}all in one place.
                </span>
                </h1>

                <p class="mt-6 max-w-xl text-lg leading-8 text-ink-600">
                {
                    isStoreLive
                    ? 'Find clear information about Maxi Pawz, our products, Pet Guides, orders, returns, and customer support.'
                    : 'Learn about Maxi Pawz, the store we are building, future products, Pet Guides, launch updates, and ways to contact us.'
                }
                </p>

                <div class="mt-8 flex flex-col gap-3 sm:flex-row">
                <Button
                    href="#faq-content"
                    variant="primary"
                    size="lg"
                    iconPosition="right"
                    class="w-full sm:w-auto"
                >
                    <ArrowRightBold slot="icon" aria-hidden="true" />

                    Browse Questions
                </Button>

                <Button
                    href="/contact"
                    variant="secondary"
                    size="lg"
                    iconPosition="right"
                    class="w-full sm:w-auto"
                >
                    <HeartBold slot="icon" aria-hidden="true" />

                    Contact Maxi Pawz
                </Button>
                </div>

                <div class="mt-8 grid gap-3 sm:grid-cols-3">
                {
                    heroHighlights.map((highlight) => (
                    <div class="flex items-start gap-2 rounded-2xl border border-sand/80 bg-white-warm/75 p-3">
                        <CheckCircleFill
                        class="mt-0.5 size-5 shrink-0 text-brand-500"
                        aria-hidden="true"
                        />

                        <span class="text-sm font-bold leading-5 text-ink-700">{highlight}</span>
                    </div>
                    ))
                }
                </div>
            </div>

            <aside
                class="rounded-4xl border border-sand bg-white-warm/85 p-5 shadow-sm sm:p-6"
                aria-labelledby="popular-faq-topics"
            >
                <div class="flex items-start gap-4">
                <span
                    class="grid size-12 shrink-0 place-items-center rounded-2xl bg-brand-500 text-white shadow-blue"
                    aria-hidden="true"
                >
                    <PawPrintBold class="size-6" />
                </span>

                <div>
                    <p class="text-xs font-extrabold tracking-[0.09em] text-brand-700 uppercase">
                    Quick Navigation
                    </p>

                    <h2 id="popular-faq-topics" class="mt-2 text-2xl text-ink-900">Choose a topic</h2>
                </div>
                </div>

                <nav class="mt-6 grid gap-3" aria-label="FAQ topics">
                {
                    faqGroups.map((group) => {
                    const Icon = iconByGroup[group.icon];

                    return (
                        <a
                        href={`#${group.id}`}
                        class:list={[
                            'group flex items-center justify-between gap-4',
                            'rounded-2xl border border-sand/80',
                            'bg-cream-soft/80 p-3.5',
                            'transition duration-200',
                            'hover:-translate-y-0.5',
                            'hover:border-brand-300',
                            'hover:bg-white-warm',
                            'hover:shadow-sm',
                            'focus-visible:outline-none',
                            'focus-visible:ring-4',
                            'focus-visible:ring-brand-200',
                        ]}
                        >
                        <span class="flex min-w-0 items-center gap-3">
                            <span
                            class:list={[
                                'grid size-10 shrink-0 place-items-center',
                                'rounded-xl bg-brand-100 text-brand-700',
                                'transition duration-200',
                                'group-hover:scale-105',
                                'group-hover:bg-brand-200',
                            ]}
                            aria-hidden="true"
                            >
                            <Icon class="size-5" />
                            </span>

                            <span class="text-sm font-extrabold leading-5 text-ink-700">
                            {group.title}
                            </span>
                        </span>

                        <ArrowRightBold
                            class="size-4 shrink-0 text-brand-700 transition group-hover:translate-x-1"
                            aria-hidden="true"
                        />
                        </a>
                    );
                    })
                }
                </nav>
            </aside>
            </div>
        </div>
        </div>
    </section>

    <!-- One rounded FAQ workspace -->
    <section
        id="faq-content"
        class="mt-5 scroll-mt-24 pb-12 sm:pb-16 lg:pb-20"
        aria-labelledby="faq-content-title"
    >
        <div class="site-container">
        <div
            class:list={[
            'rounded-[2.75rem] border border-sand',
            'bg-white-warm/75 p-4 shadow-card',
            'sm:p-6 lg:p-8',
            ]}
        >
            <div
            class="rounded-4xl border border-sand/80 bg-cream-soft/80 px-5 py-6 text-center sm:px-8 sm:py-8"
            >
            <Badge variant="brand" size="md" class="mx-auto">
                <PawPrintBold slot="icon" aria-hidden="true" />

                Frequently Asked Questions
            </Badge>

            <h2
                id="faq-content-title"
                class="mx-auto mt-5 max-w-3xl text-3xl text-ink-900 sm:text-4xl"
            >
                Open a question to see the answer.
            </h2>

            <p class="mx-auto mt-3 max-w-2xl text-base leading-7 text-ink-600">
                Information will continue to be updated as the Maxi Pawz store, collection, and customer
                experience grow.
            </p>
            </div>

            <div class="mt-6 grid items-start gap-6 lg:grid-cols-[16rem_minmax(0,1fr)] lg:gap-8">
            <aside class="lg:sticky lg:top-28">
                <div class="rounded-4xl border border-brand-200 bg-brand-50/80 p-4">
                <p class="px-2 text-xs font-extrabold tracking-[0.09em] text-brand-700 uppercase">
                    FAQ Topics
                </p>

                <nav class="mt-3 mb-5 grid gap-4" aria-label="FAQ section navigation">
                    {
                    faqGroups.map((group) => {
                        const Icon = iconByGroup[group.icon];

                        return (
                        <a
                            href={`#${group.id}`}
                            class:list={[
                            'group flex items-center gap-3',
                            'rounded-2xl px-3 py-3',
                            'text-sm font-extrabold leading-5 text-ink-700',
                            'transition duration-200',
                            'hover:bg-white-warm',
                            'hover:text-brand-800',
                            'focus-visible:outline-none',
                            'focus-visible:ring-4',
                            'focus-visible:ring-brand-200',
                            ]}
                        >
                            <span
                            class="grid size-9 shrink-0 place-items-center rounded-xl bg-white-warm text-brand-700 shadow-sm"
                            aria-hidden="true"
                            >
                            <Icon class="size-4.5" />
                            </span>

                            <span>{group.title}</span>
                        </a>
                        );
                    })
                    }
                </nav>
                </div>

                <div class="mt-4 mb-4 rounded-4xl border border-accent-200 bg-accent-50 p-4">
                <ShieldCheckBold class="size-6 text-accent-600" aria-hidden="true" />

                <h3 class="mt-3 text-base text-ink-900">Pet health or safety concern?</h3>

                <p class="mt-2 text-sm leading-6 text-ink-600">
                    Our guides and FAQ provide general information. Contact a qualified professional for
                    advice specific to your pet.
                </p>
                </div>
            </aside>

            <div class="flex min-w-0 flex-col gap-6">
                {
                faqGroups.map((group, index) => {
                    const Icon = iconByGroup[group.icon];

                    return (
                    <div class="mt-5 flex w-full flex-col">
                        <FaqGroup group={group} openFirst={index === 0}>
                        <Icon slot="icon" aria-hidden="true" />
                        </FaqGroup>
                    </div>
                    );
                })
                }
            </div>
            </div>
        </div>
        </div>
    </section>

    <!-- Rounded final CTA -->
    <section class="pt-16 pb-16 sm:pt-20 sm:pb-20 lg:pt-24 lg:pb-24">
        <div class="site-container">
        <div
            class:list={[
            'relative mt-5 overflow-hidden rounded-[2.5rem]',
            'bg-ink-950 p-6 text-white shadow-card',
            'sm:p-8 lg:p-10',
            ]}
        >
            <div class="relative grid items-center gap-8 lg:grid-cols-[1fr_auto]">
            <div>
                <Badge variant="accent" size="md">
                <HeartBold slot="icon" aria-hidden="true" />

                Still Have a Question?
                </Badge>

                <h2 class="mt-5 text-3xl text-white sm:text-4xl">
                Send us a message and tell us what you need.
                </h2>

                <p class="mt-4 text-base leading-7 text-white/70">
                Contact Maxi Pawz about products, partnerships, website feedback, or store support.
                </p>
            </div>

            <div class="flex flex-col gap-3 sm:flex-row lg:flex-col">
                <Button
                href="/contact#contact-form"
                variant="primary"
                size="lg"
                iconPosition="right"
                class="w-full sm:w-auto"
                >
                <HeartBold slot="icon" aria-hidden="true" />

                Contact Maxi Pawz
                </Button>

                {
                isStoreLive ? (
                    <Button
                    href="/shop"
                    variant="secondary"
                    size="lg"
                    iconPosition="right"
                    class="w-full sm:w-auto"
                    >
                    <ShoppingBagOpenBold slot="icon" aria-hidden="true" />
                    Explore the Shop
                    </Button>
                ) : (
                    <Button
                    href="/#join-the-pack"
                    variant="secondary"
                    size="lg"
                    iconPosition="right"
                    class="w-full sm:w-auto"
                    >
                    <ArrowRightBold slot="icon" aria-hidden="true" />
                    Join the Pack
                    </Button>
                )
                }
            </div>
            </div>
        </div>
        </div>
    </section>
</BaseLayout>