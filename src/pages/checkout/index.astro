---
import EmbeddedCheckout from '@components/checkout/EmbeddedCheckout';
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout
    title="Secure Checkout"
    description="Complete your MaxiPawz order using secure Stripe Checkout."
    noIndex={true}
>
    <section class="section-spacing">
        <div class="site-container">
        <div class="mx-auto max-w-4xl">
            <div class="mb-8 text-center">
            <p class="text-sm font-extrabold tracking-[0.09em] text-brand-700 uppercase">
                Secure Checkout
            </p>

            <h1 class="mt-3 text-4xl text-ink-900 sm:text-5xl">Almost there.</h1>

            <p class="mx-auto mt-4 max-w-2xl text-base leading-7 text-ink-600">
                Enter your U.S. shipping address to see available carrier rates. Stripe securely handles
                payment and sales-tax calculation.
            </p>
            </div>

            <div class="rounded-[2.75rem] border border-brand-200 bg-white-warm p-4 shadow-card sm:p-6">
            <EmbeddedCheckout client:load />
            </div>
        </div>
        </div>
    </section>
</BaseLayout>
