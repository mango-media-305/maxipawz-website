---
import maxipawzLogo from '../assets/brand/maxipawz-horizontal-logo.webp';

import FoundingPackAnalytics from '@components/analytics/FoundingPackAnalytics.astro';
import FoundingPackPersonalizationAnalytics from '@components/analytics/FoundingPackPersonalizationAnalytics.astro';
import BrandStorySection from '@components/home/BrandStorySection.astro';
import FoundingPackPersonalizationPersistence from '@components/home/FoundingPackPersonalizationPersistence.astro';
import FoundingPackWelcomeBack from '@components/home/FoundingPackWelcomeBack.astro';
import HeroSection from '@components/home/HeroSection.astro';
import HomeMotion from '@components/home/HomeMotion.astro';
import HomeProductCollection from '@components/home/HomeProductCollection.astro';
import LaunchSignup from '@components/home/LaunchSignup.astro';
import PetGuidesPreview from '@components/home/PetGuidesPreview.astro';
import ShopByLifestyle from '@components/home/ShopByLifestyle.astro';
import WelcomeDiscountPopup from '@components/home/WelcomeDiscountPopup.astro';
import HomeBenefits from '@components/home/HomeBenefits.astro';
import HomeExploreSection from '@components/home/HomeExploreSection.astro';

import BaseLayout from '@layouts/BaseLayout.astro';

import { isStoreLive } from '../config/storefront';
import { siteConfig } from '../config/site';
import { lifestyleCategories } from '../data/homepage';

const homeURL = new URL('/', Astro.site ?? new URL(siteConfig.url)).toString();

const logoURL = new URL(maxipawzLogo.src, homeURL).toString();

const socialProfiles = Object.values(siteConfig.social).filter(
  (profile) => Boolean(profile),
);

const onlineStoreData = {
  '@type': 'Organization',
  '@id': `${homeURL}#organization`,

  additionalType: 'https://schema.org/OnlineStore',

  name: siteConfig.name,
  alternateName: siteConfig.shortName,

  url: homeURL,
  logo: logoURL,

  description: siteConfig.description,

  slogan: siteConfig.slogan,

  location: {
    '@type': 'VirtualLocation',

    url: homeURL,
  },

  knowsAbout: [
    'Pet toys',
    'Pet enrichment',
    'Dog accessories',
    'Pet travel',
    'Pet hydration',
    'Pet comfort',
    'Everyday pet care',
  ],

  ...(socialProfiles.length > 0
    ? {
        sameAs: socialProfiles,
      }
    : {}),

  ...(isStoreLive
    ? {
        hasOfferCatalog: {
          '@type': 'OfferCatalog',

          name: 'Maxi Pawz pet products',

          itemListElement: lifestyleCategories.map((category) => ({
            '@type': 'OfferCatalog',

            name: category.title,
          })),
        },
      }
    : {}),
};

const structuredData = {
  '@context': 'https://schema.org',

  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${homeURL}#website`,

      url: homeURL,
      name: siteConfig.name,

      alternateName: siteConfig.shortName,

      description: siteConfig.description,

      inLanguage: 'en-US',

      publisher: {
        '@id': `${homeURL}#organization`,
      },
    },

    onlineStoreData,
  ],
};
---

<BaseLayout
  title="Online Pet Toys & Everyday Essentials"
  description="Discover thoughtful pet toys, accessories, travel gear, hydration essentials, and practical pet guides from Maxi Pawz Store."
  image={maxipawzLogo.src}
  imageAlt="Maxi Pawz Store logo"
  structuredData={structuredData}
>
  <div class="home-motion-scope" data-home-motion>
    <HeroSection />

    <HomeBenefits />

    {isStoreLive && <HomeProductCollection />}

    {!isStoreLive && <HomeExploreSection />}

    <div data-reveal>
      <ShopByLifestyle />
    </div>

    <div data-reveal>
      <BrandStorySection />
    </div>

    <FoundingPackWelcomeBack />

    <div data-reveal>
      <PetGuidesPreview />
    </div>

    <!-- Preserve the original signup URL alongside #maxi-pawz-updates. -->
    <div id="join-the-pack" class="scroll-mt-28" data-reveal>
      <LaunchSignup />
    </div>

    <HomeMotion />

    <FoundingPackAnalytics />

    <FoundingPackPersonalizationAnalytics />

    <FoundingPackPersonalizationPersistence />
  </div>

  {isStoreLive && <WelcomeDiscountPopup />}
</BaseLayout>