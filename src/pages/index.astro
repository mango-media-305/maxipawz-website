---
import ArrowRightBold from 'phosphor-astro/ArrowRightBold.astro';
import CheckCircleFill from 'phosphor-astro/CheckCircleFill.astro';
import ConfettiBold from 'phosphor-astro/ConfettiBold.astro';
import HeartBold from 'phosphor-astro/HeartBold.astro';
import PawPrintBold from 'phosphor-astro/PawPrintBold.astro';
import ShieldCheckBold from 'phosphor-astro/ShieldCheckBold.astro';
import ShoppingBagOpenBold from 'phosphor-astro/ShoppingBagOpenBold.astro';

import BrandStorySection from '@components/home/BrandStorySection.astro';
import HeroSlider from '@components/home/HeroSlider.astro';
import LaunchSignup from '@components/home/LaunchSignup.astro';
import ShopByLifestyle from '@components/home/ShopByLifestyle.astro';
import Badge from '@components/ui/Badge.astro';
import Button from '@components/ui/Button.astro';
import BaseLayout from '@layouts/BaseLayout.astro';

import {
  createProductHeroSlides,
  prelaunchHeroSlides,
  type HeroProductPreview,
} from '../data/hero-slides';

import { isStoreLive } from '../config/storefront';

/*
 * This remains empty until the product content collection is created.
 *
 * Later, published and featured products will be mapped into this array.
 * It can contain any MaxiPawz product category—not only toys.
 */
const liveProductPreviews: HeroProductPreview[] = [];

const productHeroSlides = createProductHeroSlides(liveProductPreviews);

const showLiveProductHero = isStoreLive && productHeroSlides.length > 0;

const heroSlides = showLiveProductHero ? productHeroSlides : prelaunchHeroSlides;

const heroHighlights = showLiveProductHero
  ? ['Toys, supplies, and accessories', 'Helpful product guidance', 'Secure checkout']
  : ['Playful and practical finds', 'Thoughtfully selected', 'Made for everyday pet life'];

const benefits = [
  {
    icon: ShieldCheckBold,

    title: 'Thoughtfully selected',

    description:
      'Products considered for their usefulness, purpose, quality, and place in everyday pet life.',
  },

  {
    icon: PawPrintBold,

    title: 'For play and daily routines',

    description:
      'Future options for enrichment, walking, travel, hydration, feeding, comfort, grooming, and care.',
  },

  {
    icon: HeartBold,

    title: 'Inspired by real pet life',

    description:
      'A warm shopping experience shaped by the lessons we have learned while caring for Maxi.',
  },
];
---

<BaseLayout
  title="MaxiPawz Store"
  description="Discover pet toys, accessories, travel gear, hydration products, and everyday supplies selected for happier moments with your pet."
  noIndex={true}
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute -top-40 -left-40 size-128 rounded-full bg-brand-300/25 blur-3xl"
      aria-hidden="true"
    >
    </div>

    <div
      class="pointer-events-none absolute top-16 -right-48 size-136 rounded-full bg-accent-300/25 blur-3xl"
      aria-hidden="true"
    >
    </div>

    <div
      class="site-container-wide grid items-center gap-10 py-12 sm:py-14 lg:grid-cols-[1.02fr_0.98fr] lg:gap-14 lg:py-16"
    >
      <!-- Hero content -->
      <div class="relative z-10 max-w-2xl">
        <Badge variant={showLiveProductHero ? 'brand' : 'accent'} size="md">
          <ConfettiBold slot="icon" aria-hidden="true" />

          {
            showLiveProductHero
              ? 'Find their next MaxiPawz favorite'
              : 'A joyful pet store is coming'
          }
        </Badge>

        <h1 class="mt-6 max-w-2xl text-5xl text-ink-900 sm:text-6xl lg:text-7xl">
          {
            showLiveProductHero ? (
              <>
                Find something special for{' '}
                <span class="text-brand-gradient">every pet moment.</span>
              </>
            ) : (
              <>
                More joy for <span class="text-brand-gradient">every pet moment.</span>
              </>
            )
          }
        </h1>

        <p class="mt-6 max-w-xl text-lg leading-8 text-ink-600 sm:text-xl">
          {
            showLiveProductHero
              ? 'Discover thoughtfully selected products for play, walks, travel, feeding, hydration, comfort, care, and everyday life together.'
              : 'MaxiPawz is creating a friendly destination for pet toys, accessories, travel gear, hydration essentials, and useful everyday supplies.'
          }
        </p>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          {
            showLiveProductHero ? (
              <>
                <Button
                  href="/shop"
                  variant="primary"
                  size="lg"
                  iconPosition="left"
                  class="w-full sm:w-auto"
                >
                  <ShoppingBagOpenBold slot="icon" aria-hidden="true" />
                  Shop the Collection
                </Button>

                <Button
                  href="/pet-guides"
                  variant="secondary"
                  size="lg"
                  iconPosition="right"
                  class="w-full sm:w-auto"
                >
                  <ArrowRightBold slot="icon" aria-hidden="true" />
                  Explore Pet Guides
                </Button>
              </>
            ) : (
              <>
                <Button
                  href="/#join-the-pack"
                  variant="primary"
                  size="lg"
                  iconPosition="left"
                  class="w-full sm:w-auto"
                >
                  <HeartBold slot="icon" aria-hidden="true" />
                  Join the Pack
                </Button>

                <Button
                  href="/about"
                  variant="secondary"
                  size="lg"
                  iconPosition="right"
                  class="w-full sm:w-auto"
                >
                  <ArrowRightBold slot="icon" aria-hidden="true" />
                  Meet Maxi
                </Button>
              </>
            )
          }
        </div>

        <div class="mt-8 flex flex-wrap gap-x-6 gap-y-3 text-sm font-bold text-ink-600">
          {
            heroHighlights.map((highlight) => (
              <span class="inline-flex items-center gap-2">
                <CheckCircleFill class="size-5 shrink-0 text-brand-500" aria-hidden="true" />

                {highlight}
              </span>
            ))
          }
        </div>
      </div>

      <HeroSlider
        slides={heroSlides}
        id="maxipawz-homepage-hero"
        label={showLiveProductHero ? 'Featured MaxiPawz products' : 'Discover the MaxiPawz brand'}
        autoplay={true}
        interval={6500}
      />
    </div>
  </section>

  <!-- Brand promises -->
  <section class="border-y border-sand bg-white-warm/65" aria-label="Why MaxiPawz">
    <div class="site-container grid gap-2 py-6 md:grid-cols-3 md:gap-4 sm:py-8">
      {
        benefits.map(({ icon: Icon, title, description }) => (
          <article class="flex gap-4 rounded-3xl p-4 transition hover:bg-cream sm:p-5">
            <span
              class="grid size-11 shrink-0 place-items-center rounded-2xl bg-brand-100 text-brand-700 sm:size-12"
              aria-hidden="true"
            >
              <Icon class="size-5 sm:size-6" />
            </span>

            <div class="min-w-0">
              <h2 class="interface-heading text-lg">{title}</h2>

              <p class="mt-2 text-sm leading-6 text-ink-600">{description}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <ShopByLifestyle />

  <BrandStorySection />

  <LaunchSignup />
</BaseLayout>
