---
import ArrowRightBold from 'phosphor-astro/ArrowRightBold.astro';
import HeartBold from 'phosphor-astro/HeartBold.astro';
import PawPrintBold from 'phosphor-astro/PawPrintBold.astro';

import Badge from '@components/ui/Badge.astro';
import Button from '@components/ui/Button.astro';
import BaseLayout from '@layouts/BaseLayout.astro';

import {
  getLocaleFromPathname,
} from '../i18n/languages';

import {
  localizeHref,
  localizedLinkLabel,
} from '../i18n/routes';

const locale =
  getLocaleFromPathname(
    Astro.url.pathname,
  );

const spanish =
  locale === 'es';

const copy = spanish
  ? {
      title:
        'Página no encontrada',

      description:
        'No pudimos encontrar la página que solicitaste. Regresa a Maxi Pawz Store o explora nuestras guías prácticas para mascotas.',

      badge:
        '404 — Camino equivocado',

      heading:
        'Esta página se fue de paseo.',

      message:
        'Es posible que la página se haya movido, que el enlace esté desactualizado o que la dirección se haya escrito incorrectamente. Podemos ayudarte a encontrar el camino de regreso.',

      homeButton:
        'Volver al inicio',

      petGuidesButton:
        'Explorar guías para mascotas',

      helpfulLinksLabel:
        'Enlaces útiles de Maxi Pawz',

      visitPage:
        'Visitar esta página',
    }
  : {
      title:
        'Page Not Found',

      description:
        'The page you requested could not be found. Return to Maxi Pawz Store or explore our practical pet guides.',

      badge:
        '404 — Wrong Turn',

      heading:
        'This page wandered off.',

      message:
        'The page may have moved, the link may be outdated, or the address may have been entered incorrectly. No worries—we can help you find your way back.',

      homeButton:
        'Return Home',

      petGuidesButton:
        'Explore Pet Guides',

      helpfulLinksLabel:
        'Helpful Maxi Pawz links',

      visitPage:
        'Visit this page',
    };

const helpfulLinks = spanish
  ? [
      {
        title:
          'Explorar guías para mascotas',

        description:
          'Lee consejos prácticos sobre juego, viajes, hidratación, comodidad, aseo y el cuidado diario de tu mascota.',

        href:
          '/pet-guides',
      },

      {
        title:
          'Descubre Maxi Pawz',

        description:
          'Conoce la historia, los valores y el perro feliz que inspiró el nombre Maxi Pawz.',

        href:
          '/about',
      },

      {
        title:
          'Contacta con el Pack',

        description:
          'Envíanos un mensaje si buscabas algo específico o encontraste un enlace que no funciona.',

        href:
          '/contact',
      },
    ]
  : [
      {
        title:
          'Explore pet guides',

        description:
          'Read practical guidance about play, travel, hydration, comfort, grooming, and everyday pet care.',

        href:
          '/pet-guides',
      },

      {
        title:
          'Discover Maxi Pawz',

        description:
          'Learn about the story, values, and happy dog behind the Maxi Pawz name.',

        href:
          '/about',
      },

      {
        title:
          'Contact the pack',

        description:
          'Send us a message if you were looking for something specific or found a broken link.',

        href:
          '/contact',
      },
    ];

const homeHref =
  localizeHref(
    '/',
    locale,
  );

const petGuidesHref =
  localizeHref(
    '/pet-guides',
    locale,
  );

const petGuidesLabel =
  localizedLinkLabel(
    copy.petGuidesButton,
    '/pet-guides',
    locale,
  );
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  noIndex={true}
>
  <section
    class="relative flex min-h-[75vh] items-center overflow-hidden py-16 sm:py-20"
    aria-labelledby="not-found-title"
  >
    <div
      class="pointer-events-none absolute -top-40 -left-40 size-128 rounded-full bg-brand-300/25 blur-3xl"
      aria-hidden="true"
    >
    </div>

    <div
      class="pointer-events-none absolute -right-40 -bottom-40 size-136 rounded-full bg-accent-300/25 blur-3xl"
      aria-hidden="true"
    >
    </div>

    <div class="site-container relative">
      <div
        class="mx-auto max-w-5xl overflow-hidden rounded-[2.5rem] border border-brand-200 bg-linear-to-br from-brand-50 via-white-warm to-accent-50 p-6 shadow-card sm:p-8 lg:p-12"
      >
        <div class="mx-auto max-w-3xl text-center">
          <span
            class="mx-auto grid size-20 place-items-center rounded-full bg-brand-100 text-brand-700 shadow-soft"
            aria-hidden="true"
          >
            <PawPrintBold class="size-10" />
          </span>

          <Badge
            variant="accent"
            size="md"
            class="mx-auto mt-7"
          >
            <HeartBold
              slot="icon"
              aria-hidden="true"
            />

            {copy.badge}
          </Badge>

          <h1
            id="not-found-title"
            class="mx-auto mt-6 max-w-3xl text-5xl text-ink-900 sm:text-6xl lg:text-7xl"
          >
            {copy.heading}
          </h1>

          <p
            class="mx-auto mt-5 max-w-2xl text-base leading-7 text-ink-600 sm:text-lg sm:leading-8"
          >
            {copy.message}
          </p>

          <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
            <Button
              href={homeHref}
              variant="primary"
              size="lg"
              iconPosition="right"
              class="w-full sm:w-auto"
            >
              <ArrowRightBold
                slot="icon"
                aria-hidden="true"
              />

              {copy.homeButton}
            </Button>

            <Button
              href={petGuidesHref}
              variant="secondary"
              size="lg"
              iconPosition="right"
              class="w-full sm:w-auto"
            >
              <PawPrintBold
                slot="icon"
                aria-hidden="true"
              />

              {petGuidesLabel}
            </Button>
          </div>
        </div>

        <div
          class="mt-10 grid gap-4 border-t border-brand-200 pt-8 md:grid-cols-3"
          aria-label={copy.helpfulLinksLabel}
        >
          {
            helpfulLinks.map(
              ({
                title,
                description,
                href,
              }) => {
                const localizedHref =
                  localizeHref(
                    href,
                    locale,
                  );

                const localizedTitle =
                  localizedLinkLabel(
                    title,
                    href,
                    locale,
                  );

                return (
                  <a
                    href={localizedHref}
                    class="group flex h-full flex-col rounded-3xl border border-sand bg-white-warm p-5 shadow-soft transition hover:-translate-y-1 hover:border-brand-300 hover:shadow-card"
                  >
                    <h2 class="text-xl text-ink-900">
                      {localizedTitle}
                    </h2>

                    <p class="mt-3 flex-1 text-sm leading-6 text-ink-600">
                      {description}
                    </p>

                    <span class="mt-5 inline-flex items-center gap-2 text-sm font-extrabold text-brand-700">
                      {copy.visitPage}

                      <ArrowRightBold
                        class="size-4 transition group-hover:translate-x-1"
                        aria-hidden="true"
                      />
                    </span>
                  </a>
                );
              },
            )
          }
        </div>
      </div>
    </div>
  </section>
</BaseLayout>