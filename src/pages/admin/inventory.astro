---
import AdminInventory from '@components/admin/AdminInventory';
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout
    title="Inventory Management"
    description="Private Maxi Pawz inventory management dashboard."
    noIndex={true}
>
    <section class="section-spacing">
        <div class="site-container">
            <nav
                class="mb-6 flex flex-wrap gap-2"
                aria-label="Admin navigation"
            >
                <a
                    href="/admin/inventory"
                    aria-current="page"
                    class="rounded-full bg-brand-500 px-4 py-2 text-sm font-extrabold text-white"
                >
                    Inventory
                </a>

                <a
                    href="/admin/reservations"
                    class="rounded-full border border-brand-200 bg-brand-50 px-4 py-2 text-sm font-extrabold text-brand-800 transition hover:bg-brand-100"
                >
                    Reservations
                </a>

                <a
                    href="/admin/orders"
                    class="rounded-full border border-brand-200 bg-brand-50 px-4 py-2 text-sm font-extrabold text-brand-800 transition hover:bg-brand-100"
                >
                    Orders
                </a>
            </nav>

            <AdminInventory client:load />
        </div>
    </section>
</BaseLayout>