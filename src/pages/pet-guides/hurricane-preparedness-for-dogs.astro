---
import ArrowRightBold from 'phosphor-astro/ArrowRightBold.astro';
import CheckCircleFill from 'phosphor-astro/CheckCircleFill.astro';
import HeartBold from 'phosphor-astro/HeartBold.astro';
import PawPrintBold from 'phosphor-astro/PawPrintBold.astro';
import ShieldCheckBold from 'phosphor-astro/ShieldCheckBold.astro';

import maxipawzLogo from '../../assets/brand/maxipawz-horizontal-logo.webp';
import GuideShareBar from '@components/guides/GuideShareBar.astro';
import GuideArticleLayout from '@layouts/GuideArticleLayout.astro';

const guide = {
  slug: 'hurricane-preparedness-for-dogs',
  href: '/pet-guides/hurricane-preparedness-for-dogs',
  title: 'Hurricane Preparedness for Dogs: Emergency Kit & Evacuation Checklist',
  seoTitle: 'Hurricane Preparedness for Dogs: Emergency Checklist',
  seoDescription:
    'Prepare your dog for hurricane season with a practical emergency kit, evacuation plan, identification checklist, shelter-in-place setup, and post-storm safety steps.',
  description:
    'Build a practical hurricane plan for your dog with an emergency kit, current identification, evacuation options, a safe indoor setup, and post-storm precautions.',
  introduction:
    'Hurricane preparation is easier when your dog is included before a storm is approaching. A ready-to-go kit, current identification, known evacuation options, and a practiced routine can remove last-minute decisions when conditions change quickly.',
  eyebrow: 'Storm & Emergency Safety',
  readingTime: '9 min read',
  publishedAt: '2026-08-18',
  updatedAt: '2026-08-18',
  learningPoints: [
    'Build a dog-specific emergency kit before severe weather threatens your area.',
    'Keep identification, veterinary records, medications, and contact information current.',
    'Plan pet-friendly evacuation destinations and transportation before you need them.',
    'Know how to shelter indoors and what hazards to watch for after flooding or storm damage.',
  ],
  sections: [
    {
      id: 'make-the-plan-early',
      title: 'Make the plan before the forecast becomes urgent.',
      paragraphs: [
        'Start by identifying the severe-weather risks that apply to your area and deciding what you would do if officials recommend evacuation or sheltering in place. Your dog should be part of the same household plan rather than an afterthought.',
        'The CDC recommends planning where you and your pets can stay, identifying veterinary or boarding resources near a possible evacuation destination, and creating a buddy system in case you are away from home when an emergency develops.',
      ],
      points: [
        'Choose more than one possible pet-friendly evacuation destination.',
        'Keep a carrier, leash, or appropriate restraint easy to access.',
        'Identify a trusted person who could help your dog if you cannot get home.',
        'Save your veterinarian and an emergency veterinary contact in your phone and written records.',
        'Review the plan at the beginning of hurricane season and whenever your household changes.',
      ],
    },
    {
      id: 'build-a-go-kit',
      title: 'Build a dog emergency kit that can leave with you.',
      paragraphs: [
        'A pet emergency kit should be packed before it is needed and stored where it can be grabbed quickly. Keep supplies protected from water and organize medications and documents so they are easy to find.',
        'CDC disaster-kit guidance recommends preparing substantial reserves of food, water, medications, veterinary documents, identification information, cleaning supplies, and transport equipment. Rotate dated items so the kit stays usable instead of becoming something you pack once and forget.',
      ],
      points: [
        'Food and water stored in appropriate containers, plus bowls and a manual can opener when needed.',
        'Prescription medications, medication instructions, and preventive-care supplies appropriate for your dog.',
        'Copies of vaccination records, medical history, prescriptions, proof of ownership, and microchip information in a waterproof container.',
        'A collar with current ID, leash, harness, and an appropriately sized carrier when applicable.',
        'Waste bags, paper towels, cleaning supplies, a first-aid kit, and familiar comfort items.',
        'Recent photos of your dog and written household contact information.',
      ],
      tip: {
        title: 'Make the kit easy to maintain',
        description:
          'Add a calendar reminder to inspect food, water, medications, batteries, documents, and contact details periodically. Preparedness works best when the kit is ready before a storm enters the forecast.',
      },
    },
    {
      id: 'update-identification',
      title: 'Check identification before every hurricane season.',
      paragraphs: [
        'Storms can change familiar scents, landmarks, fences, doors, and routines. The CDC notes that pets may become confused and lost after an emergency, making current identification especially important.',
        'Make sure tags are readable and contact details are correct. If your dog is microchipped, confirm that the chip is registered and that the associated phone numbers and addresses are current.',
      ],
      points: [
        'Confirm the phone number on the ID tag.',
        'Check that the collar and tag attachment are in good condition.',
        'Verify microchip registration and contact information.',
        'Keep the microchip number and company information with your emergency documents.',
        'Store recent photos that clearly show your dog.',
      ],
    },
    {
      id: 'plan-evacuation',
      title: 'Know where your dog can go if you evacuate.',
      paragraphs: [
        'Do not assume every emergency shelter accepts pets. Policies vary by location and situation, and CDC guidance recommends confirming pet accommodations in advance and identifying alternatives such as pet-friendly lodging, friends or relatives, boarding facilities, veterinary hospitals, or local animal-welfare resources.',
        'If authorities direct your area to evacuate, follow official instructions and take your pets with you. Keep the emergency kit, restraint equipment, and records together so you are not searching for essential items while preparing to leave.',
      ],
      points: [
        'Check current local emergency-management information before each storm.',
        'Confirm pet policies directly with your planned destination.',
        'Know at least one backup destination outside your immediate area.',
        'Practice getting your dog into the vehicle or carrier calmly.',
        'Leave enough time to follow official evacuation guidance safely.',
      ],
    },
    {
      id: 'shelter-in-place',
      title: 'Prepare a safe indoor space if you shelter at home.',
      paragraphs: [
        'When sheltering in place, CDC hurricane guidance recommends staying indoors and away from windows while following official updates. For pets, choose a secure indoor area where doors, windows, chemicals, plants, and tight hiding spaces can be managed.',
        'Bring your dog’s leash, carrier, water, medications, bedding, and essential supplies into the safe area before conditions deteriorate. Keeping familiar items nearby can make the setup more practical during a prolonged period indoors.',
      ],
      points: [
        'Use an interior area with few or no windows when appropriate for the emergency.',
        'Keep your dog indoors and secured.',
        'Move the emergency kit and essential medications into the safe area.',
        'Keep a leash or carrier within reach in case conditions require you to leave.',
        'Continue monitoring official local weather and emergency instructions.',
      ],
    },
    {
      id: 'practice-before-storm',
      title: 'Practice the parts of the plan that can be practiced.',
      paragraphs: [
        'An emergency should not be your dog’s first experience with a carrier, travel restraint, unfamiliar vehicle setup, or household evacuation routine. Short, calm practice sessions can reveal practical problems while you still have time to solve them.',
        'The CDC recommends practicing evacuation with pets and helping them become comfortable with carriers and transportation. The goal is not to simulate a frightening storm; it is to make the equipment and routine familiar.',
      ],
      points: [
        'Practice entering and resting in the carrier when one is used.',
        'Take short practice drives using the same transportation setup planned for evacuation.',
        'Make sure everyone in the household knows where pet supplies are stored.',
        'Practice gathering your dog, emergency kit, documents, and restraint equipment.',
        'Adjust the plan if mobility, age, health, or household needs change.',
      ],
    },
    {
      id: 'after-the-storm',
      title: 'Treat the area as unfamiliar after the storm.',
      paragraphs: [
        'Do not assume familiar outdoor areas are immediately safe after severe weather. Floodwater, debris, damaged fencing, wildlife, exposed wiring, spilled chemicals, and changed landmarks can create new risks.',
        'CDC guidance recommends keeping pets leashed or in carriers when going outside after an emergency and avoiding stagnant or contaminated water. Inspect your property before returning to a normal routine and contact a veterinarian if your dog shows signs of illness or injury.',
      ],
      points: [
        'Keep your dog leashed or otherwise securely controlled outdoors.',
        'Avoid floodwater and stagnant water.',
        'Check for damaged fencing, sharp debris, exposed wires, chemicals, and displaced wildlife.',
        'Use safe drinking water and clean food and water containers.',
        'Watch for changes in behavior, comfort, appetite, mobility, or health after the event.',
      ],
    },
    {
      id: 'final-hurricane-checklist',
      title: 'Use a final hurricane-readiness checklist.',
      paragraphs: [
        'A simple review before hurricane season—and again when a storm may affect your area—can help catch expired supplies, outdated contact information, or a destination that is no longer available.',
      ],
      points: [
        'Emergency kit packed and recently checked.',
        'Food, water, medications, and documents ready.',
        'ID tag and microchip information current.',
        'Leash, harness, carrier, or transport restraint accessible.',
        'Primary and backup pet-friendly evacuation destinations identified.',
        'Veterinary and emergency contacts saved.',
        'Household members know the pet evacuation plan.',
        'Official local emergency information bookmarked or otherwise accessible.',
      ],
    },
  ],
  relatedLinks: [
    {
      title: 'Dog Walking and Travel Essentials: A Practical Checklist',
      description:
        'Prepare transportation, hydration, identification, comfort items, and practical supplies for outings and travel.',
      href: '/pet-guides/walk-and-travel',
    },
    {
      title: 'Dog Feeding and Hydration Essentials for Everyday Routines',
      description:
        'Review practical hydration products, cleaning routines, and portable water considerations.',
      href: '/pet-guides/feeding-and-hydration',
    },
    {
      title: 'Pet Product Safety',
      description:
        'Review general guidance for inspecting, maintaining, supervising, and replacing everyday pet products.',
      href: '/product-safety',
    },
  ],
  closingTitle: 'Preparation is most useful when it happens early.',
  closingDescription:
    'A hurricane plan for your dog does not need to be complicated. Keep identification current, maintain a practical emergency kit, know where you can go, practice the routine, and follow official local instructions when severe weather threatens.',
};

const tableOfContents = guide.sections.map((section) => ({ id: section.id, label: section.title }));
const siteURL = Astro.site ?? new URL('https://maxipawz.com');
const homeURL = new URL('/', siteURL).toString();
const petGuidesURL = new URL('/pet-guides', siteURL).toString();
const guideURL = new URL(guide.href, siteURL).toString();
const logoURL = new URL(maxipawzLogo.src, siteURL).toString();
const guideSocialImage = '/images/og/guides/hurricane-preparedness-for-dogs.svg';
const guideSocialImageURL = new URL(guideSocialImage, siteURL).toString();
const guideSocialImageAlt = 'Hurricane Preparedness for Dogs — Maxi Pawz Pet Guide.';
const organizationID = `${homeURL}#organization`;
const guideText = [guide.title, guide.description, guide.introduction, ...guide.learningPoints, ...guide.sections.flatMap((section) => [section.title, ...section.paragraphs, ...(section.points ?? []), ...(section.tip ? [section.tip.title, section.tip.description] : [])]), guide.closingTitle, guide.closingDescription].join(' ');
const wordCount = guideText.trim().split(/\s+/).filter(Boolean).length;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Organization', '@id': organizationID, name: 'Maxi Pawz Store', url: homeURL, logo: { '@type': 'ImageObject', url: logoURL } },
    { '@type': 'Article', '@id': `${guideURL}#article`, url: guideURL, headline: guide.title, description: guide.seoDescription, image: { '@type': 'ImageObject', url: guideSocialImageURL, width: 1200, height: 630, caption: guideSocialImageAlt }, articleSection: guide.eyebrow, wordCount, inLanguage: 'en-US', datePublished: guide.publishedAt, dateModified: guide.updatedAt, mainEntityOfPage: { '@type': 'WebPage', '@id': guideURL }, isPartOf: { '@type': 'CollectionPage', '@id': petGuidesURL, name: 'Maxi Pawz Pet Guides', url: petGuidesURL }, author: { '@id': organizationID }, publisher: { '@id': organizationID } },
    { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: homeURL }, { '@type': 'ListItem', position: 2, name: 'Pet Guides', item: petGuidesURL }, { '@type': 'ListItem', position: 3, name: guide.title, item: guideURL }] },
  ],
};
const formattedUpdatedAt = new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${guide.updatedAt}T12:00:00Z`));
---

<GuideArticleLayout title={guide.title} description={guide.description} seoTitle={guide.seoTitle} seoDescription={guide.seoDescription} image={guideSocialImage} imageAlt={guideSocialImageAlt} publishedAt={guide.publishedAt} modifiedAt={guide.updatedAt} articleSection={guide.eyebrow} eyebrow={guide.eyebrow} readingTime={guide.readingTime} updatedAt={formattedUpdatedAt} updatedAtISO={guide.updatedAt} sections={tableOfContents} structuredData={structuredData}>
  <div class="rounded-4xl border border-brand-200 bg-linear-to-br from-brand-50 via-white-warm to-accent-50 p-5 shadow-sm sm:p-6">
    <span class="grid size-12 place-items-center rounded-2xl bg-brand-500 text-white shadow-blue" aria-hidden="true"><ShieldCheckBold class="size-6" /></span>
    <p class="mt-5 text-lg leading-8 text-ink-700">{guide.introduction}</p>
    <div class="mt-6 grid gap-3">{guide.learningPoints.map((point) => <div class="flex items-start gap-3 rounded-2xl border border-sand/80 bg-white-warm/80 p-4"><CheckCircleFill class="mt-0.5 size-5 shrink-0 text-brand-500" aria-hidden="true" /><p class="text-sm font-bold leading-6 text-ink-700">{point}</p></div>)}</div>
  </div>

  <GuideShareBar guideTitle={guide.title} guideSlug={guide.slug} guideURL={guideURL} />

  {guide.sections.map((section, index) => (
    <section id={section.id} class="mt-12 scroll-mt-32" aria-labelledby={`${section.id}-title`}>
      <div class="flex items-start gap-4">
        <span class:list={['grid size-12 shrink-0 place-items-center rounded-2xl', index % 2 === 0 ? 'bg-brand-500 text-white shadow-blue' : 'bg-accent-500 text-ink-950 shadow-orange']} aria-hidden="true"><span class="text-sm font-black">{String(index + 1).padStart(2, '0')}</span></span>
        <div class="min-w-0"><p class:list={['text-xs font-extrabold tracking-[0.09em] uppercase', index % 2 === 0 ? 'text-brand-700' : 'text-accent-700']}>Guide Section</p><h2 id={`${section.id}-title`} class="mt-2 text-3xl text-ink-900 sm:text-4xl">{section.title}</h2></div>
      </div>
      <div class="mt-6 max-w-3xl space-y-4 text-base leading-8 text-ink-600 sm:text-lg">{section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}</div>
      {section.points && <ul class="mt-7 grid gap-3">{section.points.map((point) => <li class="flex items-start gap-3 rounded-2xl border border-sand bg-cream-soft p-4 text-sm font-bold leading-6 text-ink-700"><CheckCircleFill class="mt-0.5 size-5 shrink-0 text-brand-500" aria-hidden="true" /><span>{point}</span></li>)}</ul>}
      {section.tip && <aside class="mt-7 rounded-4xl border border-accent-200 bg-linear-to-br from-accent-50 via-white-warm to-brand-50 p-5 sm:p-6"><HeartBold class="size-8 text-accent-500" aria-hidden="true" /><h3 class="mt-4 text-2xl text-ink-900">{section.tip.title}</h3><p class="mt-3 text-base leading-7 text-ink-600">{section.tip.description}</p></aside>}
    </section>
  ))}

  <section class="mt-12 rounded-4xl border border-brand-200 bg-brand-50 p-5 sm:p-6" aria-labelledby="guide-conclusion-title">
    <ShieldCheckBold class="size-8 text-brand-500" aria-hidden="true" /><h2 id="guide-conclusion-title" class="mt-5 text-3xl text-ink-900">{guide.closingTitle}</h2><p class="mt-4 text-base leading-7 text-ink-600 sm:text-lg">{guide.closingDescription}</p>
  </section>

  <section class="mt-12" aria-labelledby="guide-sources-title">
    <div class="flex items-center gap-4"><span class="grid size-12 shrink-0 place-items-center rounded-2xl bg-accent-500 text-ink-950 shadow-orange" aria-hidden="true"><PawPrintBold class="size-6" /></span><div><p class="text-xs font-extrabold uppercase tracking-[0.09em] text-accent-700">Research & Sources</p><h2 id="guide-sources-title" class="mt-2 text-3xl text-ink-900 sm:text-4xl">Prepared with current emergency guidance</h2></div></div>
    <div class="mt-7 grid gap-4">
      <a href="https://www.cdc.gov/healthy-pets/emergency-preparedness/index.html" rel="noopener noreferrer" class="group rounded-3xl border border-sand bg-white-warm p-5 shadow-soft transition hover:-translate-y-1 hover:border-brand-300 hover:shadow-card sm:p-6"><h3 class="text-xl text-ink-900">CDC — Be Prepared: Pet Safety in Emergencies</h3><p class="mt-2 text-sm leading-6 text-ink-600">Planning, identification, evacuation, sheltering, and post-disaster pet safety guidance.</p></a>
      <a href="https://www.cdc.gov/healthy-pets/emergency-preparedness/preparedness-kit.html" rel="noopener noreferrer" class="group rounded-3xl border border-sand bg-white-warm p-5 shadow-soft transition hover:-translate-y-1 hover:border-brand-300 hover:shadow-card sm:p-6"><h3 class="text-xl text-ink-900">CDC — Build a Pet Disaster Preparedness Kit</h3><p class="mt-2 text-sm leading-6 text-ink-600">Current checklist for documents, food, water, medications, transport equipment, and other supplies.</p></a>
      <a href="https://www.cdc.gov/hurricanes/safety/" rel="noopener noreferrer" class="group rounded-3xl border border-sand bg-white-warm p-5 shadow-soft transition hover:-translate-y-1 hover:border-brand-300 hover:shadow-card sm:p-6"><h3 class="text-xl text-ink-900">CDC — Preparing for Hurricanes or Other Tropical Storms</h3><p class="mt-2 text-sm leading-6 text-ink-600">General hurricane preparation, evacuation, shelter-in-place, and official-update guidance.</p></a>
    </div>
  </section>

  <section class="mt-12" aria-labelledby="related-guides-title">
    <div class="flex items-center gap-4"><span class="grid size-12 shrink-0 place-items-center rounded-2xl bg-accent-500 text-ink-950 shadow-orange" aria-hidden="true"><PawPrintBold class="size-6" /></span><div><p class="text-xs font-extrabold uppercase tracking-[0.09em] text-accent-700">Continue Learning</p><h2 id="related-guides-title" class="mt-2 text-3xl text-ink-900 sm:text-4xl">Related Maxi Pawz resources</h2></div></div>
    <div class="mt-7 grid gap-4">{guide.relatedLinks.map((relatedLink) => <a href={relatedLink.href} class="group rounded-3xl border border-sand bg-white-warm p-5 shadow-soft transition hover:-translate-y-1 hover:border-brand-300 hover:shadow-card sm:p-6"><div class="flex items-start justify-between gap-5"><div class="min-w-0"><h3 class="text-xl text-ink-900 sm:text-2xl">{relatedLink.title}</h3><p class="mt-3 max-w-2xl text-sm leading-6 text-ink-600 sm:text-base sm:leading-7">{relatedLink.description}</p></div><span class="grid size-10 shrink-0 place-items-center rounded-full bg-brand-100 text-brand-700 transition group-hover:translate-x-1 group-hover:bg-brand-500 group-hover:text-white" aria-hidden="true"><ArrowRightBold class="size-5" /></span></div></a>)}</div>
  </section>
</GuideArticleLayout>
