---
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

import BlogPostLayout from '@layouts/BlogPostLayout.astro';

import { buildBlogStructuredData, getBlogPostPath } from '../../utils/blog';

type BlogPost = CollectionEntry<'blog'>;

interface Props {
  post: BlogPost;
}

export const getStaticPaths = (async () => {
  const blogPosts = await getCollection('blog');

  return blogPosts.map((post) => ({
    params: {
      slug: post.id,
    },
    props: {
      post,
    },
  }));
}) satisfies GetStaticPaths;

const { post } = Astro.props as Props;
const rendered = await render(post);
const { Content, headings } = rendered;
const structuredData = buildBlogStructuredData({ post });

const allPosts = await getCollection('blog');
const postById = new Map(allPosts.map((candidate) => [candidate.id, candidate]));
const relatedPosts = post.data.relatedPosts
  .map((id) => postById.get(id))
  .filter((candidate): candidate is BlogPost => Boolean(candidate) && candidate.data.indexable)
  .map((candidate) => ({
    href: getBlogPostPath(candidate),
    title: candidate.data.title,
    description: candidate.data.description,
    category: candidate.data.category,
    image: {
      src: candidate.data.heroImage.src,
      alt: candidate.data.heroImage.alt,
    },
  }));
---

<BlogPostLayout
  title={post.data.title}
  description={post.data.description}
  seoTitle={post.data.seoTitle}
  seoDescription={post.data.seoDescription}
  category={post.data.category}
  publishedAt={post.data.publishedAt}
  updatedAt={post.data.updatedAt}
  author={post.data.author}
  heroImage={post.data.heroImage}
  ogImage={post.data.ogImage}
  ogImageAlt={post.data.ogImageAlt}
  headings={headings}
  sources={post.data.sources}
  relatedPosts={relatedPosts}
  noIndex={!post.data.indexable}
  structuredData={structuredData}
>
  <Content />
</BlogPostLayout>