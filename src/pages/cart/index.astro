---
import ShoppingCartBold from 'phosphor-astro/ShoppingCartBold.astro';
import SparkleBold from 'phosphor-astro/SparkleBold.astro';

import CartPage from '@components/cart/CartPage';
import Badge from '@components/ui/Badge.astro';
import BaseLayout from '@layouts/BaseLayout.astro';

import { isStorePrelaunch } from '../../config/storefront';

import { getActiveProducts } from '../../utils/products';

const activeProducts = getActiveProducts();

const hasDemoProducts = activeProducts.some((product) => product.isDemo);
---

<BaseLayout
  title="Shopping Cart"
  description="Review products, variants, quantities, and demo totals in your Maxi Pawz shopping cart."
  noIndex={isStorePrelaunch || hasDemoProducts}
>
  <section class="py-8 sm:py-10 lg:py-12">
    <div class="site-container">
      <div
        class="relative overflow-hidden rounded-[2.75rem] border border-brand-200 bg-linear-to-br from-brand-50 via-white-warm to-accent-50 p-6 shadow-card sm:p-8 lg:p-10"
      >
        <div
          class="pointer-events-none absolute -top-32 -left-28 size-80 rounded-full bg-brand-300/25 blur-3xl"
          aria-hidden="true"
        >
        </div>

        <div class="relative max-w-3xl">
          <Badge variant="accent" size="md">
            <ShoppingCartBold slot="icon" aria-hidden="true" />

            Maxi Pawz Cart
          </Badge>

          <h1 class="mt-6 text-5xl text-ink-900 sm:text-6xl lg:text-7xl">
            Review your
            <span class="text-brand-gradient">
              {' '}
              selected products.
            </span>
          </h1>

          <p class="mt-6 max-w-2xl text-lg leading-8 text-ink-600">
            Change quantities, remove products, and test how the future Maxi Pawz cart will work
            before Stripe checkout is connected.
          </p>

          {
            hasDemoProducts && (
              <p class="mt-6 inline-flex items-start gap-2 rounded-2xl border border-accent-200 bg-accent-50 p-4 text-sm font-bold leading-6 text-ink-700">
                <SparkleBold class="mt-0.5 size-5 shrink-0 text-accent-600" aria-hidden="true" />
                The current catalog contains fictional products and demo prices. No real order can
                be submitted.
              </p>
            )
          }
        </div>
      </div>
    </div>
  </section>

  <section class="pb-16 sm:pb-20 lg:pb-24">
    <div class="site-container">
      <CartPage client:load />
    </div>
  </section>
</BaseLayout>
