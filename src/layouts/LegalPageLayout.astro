---
import ArrowRightBold from 'phosphor-astro/ArrowRightBold.astro';
import HeartBold from 'phosphor-astro/HeartBold.astro';
import PawPrintBold from 'phosphor-astro/PawPrintBold.astro';
import ShieldCheckBold from 'phosphor-astro/ShieldCheckBold.astro';
import ShoppingBagOpenBold from 'phosphor-astro/ShoppingBagOpenBold.astro';
import SparkleBold from 'phosphor-astro/SparkleBold.astro';

import Badge from '@components/ui/Badge.astro';
import Button from '@components/ui/Button.astro';
import BaseLayout from '@layouts/BaseLayout.astro';

import { businessConfig, businessDisplayName } from '../config/business';

import type { LegalDocument, LegalDocumentIcon, LegalDocumentTone } from '../data/legal';

interface Props {
  document: LegalDocument;
  noIndex?: boolean;
}

const { document, noIndex = true } = Astro.props;

const iconByDocument: Record<LegalDocumentIcon, typeof PawPrintBold> = {
  privacy: ShieldCheckBold,
  terms: SparkleBold,
  shipping: ShoppingBagOpenBold,
  returns: ArrowRightBold,
  accessibility: HeartBold,
};

const badgeVariantByTone: Record<LegalDocumentTone, 'brand' | 'accent' | 'neutral'> = {
  brand: 'brand',
  accent: 'accent',
  sand: 'neutral',
};

const heroClasses: Record<LegalDocumentTone, string> = {
  brand: 'border-brand-200 bg-linear-to-br from-brand-50 via-white-warm to-accent-50',

  accent: 'border-accent-200 bg-linear-to-br from-accent-50 via-white-warm to-brand-50',

  sand: 'border-sand-dark/70 bg-linear-to-br from-cream-soft via-white-warm to-sand/60',
};

const iconClasses: Record<LegalDocumentTone, string> = {
  brand: 'bg-brand-500 text-white shadow-blue',

  accent: 'bg-accent-500 text-ink-950 shadow-orange',

  sand: 'bg-ink-800 text-white shadow-soft',
};

const DocumentIcon = iconByDocument[document.icon];

const badgeVariant = badgeVariantByTone[document.tone];
---

<BaseLayout title={document.title} description={document.description} noIndex={noIndex}>
  <!-- Rounded document hero -->
  <section class="py-8 sm:py-10 lg:py-12" aria-labelledby="legal-page-title">
    <div class="site-container">
      <div
        class:list={[
          'relative overflow-hidden rounded-[2.75rem] border p-6 shadow-card',
          'sm:p-8 lg:p-10',
          heroClasses[document.tone],
        ]}
      >
        <div
          class="pointer-events-none absolute -top-32 -left-28 size-80 rounded-full bg-brand-300/25 blur-3xl"
          aria-hidden="true"
        >
        </div>

        <div
          class="pointer-events-none absolute -right-28 -bottom-36 size-96 rounded-full bg-accent-300/25 blur-3xl"
          aria-hidden="true"
        >
        </div>

        <div class="relative grid items-center gap-9 lg:grid-cols-[1.08fr_0.92fr] lg:gap-12">
          <div class="max-w-2xl">
            <Badge variant={badgeVariant} size="md">
              <DocumentIcon slot="icon" aria-hidden="true" />

              {document.eyebrow}
            </Badge>

            <h1 id="legal-page-title" class="mt-6 text-5xl text-ink-900 sm:text-6xl lg:text-7xl">
              {document.title}
            </h1>

            <p class="mt-6 max-w-2xl text-lg leading-8 text-ink-600">
              {document.introduction}
            </p>

            <div class="mt-8 flex flex-col gap-3 sm:flex-row">
              <Button
                href="#policy-content"
                variant="primary"
                size="lg"
                iconPosition="right"
                class="w-full sm:w-auto"
              >
                <ArrowRightBold slot="icon" aria-hidden="true" />

                Read the Policy
              </Button>

              <Button
                href={businessConfig.contactHref}
                variant="secondary"
                size="lg"
                iconPosition="right"
                class="w-full sm:w-auto"
              >
                <HeartBold slot="icon" aria-hidden="true" />

                Contact Maxi Pawz
              </Button>
            </div>
          </div>

          <!-- Policy summary -->
          <aside
            class="rounded-card-lg border border-sand bg-white-warm/85 p-5 shadow-sm sm:p-6"
            aria-label="Policy summary"
          >
            <div class="flex items-start gap-4">
              <span
                class:list={[
                  'grid size-12 shrink-0 place-items-center rounded-2xl',
                  '[&>svg]:size-6',
                  iconClasses[document.tone],
                ]}
                aria-hidden="true"
              >
                <DocumentIcon />
              </span>

              <div>
                <p class="text-xs font-extrabold tracking-[0.09em] text-brand-700 uppercase">
                  Document Summary
                </p>

                <h2 class="mt-2 text-2xl text-ink-900">Important details</h2>
              </div>
            </div>

            <dl class="mt-6 grid gap-3">
              <div class="rounded-2xl border border-sand/80 bg-cream-soft/80 p-4">
                <dt class="text-xs font-extrabold tracking-[0.08em] text-ink-500 uppercase">
                  Website operator
                </dt>

                <dd class="mt-2 text-sm font-extrabold text-ink-800">
                  {businessDisplayName}
                </dd>
              </div>

              <div class="rounded-2xl border border-sand/80 bg-cream-soft/80 p-4">
                <dt class="text-xs font-extrabold tracking-[0.08em] text-ink-500 uppercase">
                  Current status
                </dt>

                <dd class="mt-2 text-sm font-extrabold text-ink-800">
                  {document.statusLabel}
                </dd>
              </div>

              <div class="rounded-2xl border border-sand/80 bg-cream-soft/80 p-4">
                <dt class="text-xs font-extrabold tracking-[0.08em] text-ink-500 uppercase">
                  Effective date
                </dt>

                <dd class="mt-2 text-sm font-extrabold text-ink-800">
                  {document.effectiveDate}
                </dd>
              </div>

              <div class="rounded-2xl border border-sand/80 bg-cream-soft/80 p-4">
                <dt class="text-xs font-extrabold tracking-[0.08em] text-ink-500 uppercase">
                  Last updated
                </dt>

                <dd class="mt-2 text-sm font-extrabold text-ink-800">
                  {document.lastUpdated}
                </dd>
              </div>
            </dl>
          </aside>
        </div>
      </div>
    </div>
  </section>

  <!-- Rounded policy workspace -->
  <section
    id="policy-content"
    class="scroll-mt-24 pb-12 sm:pb-16 lg:pb-20"
    aria-labelledby="policy-content-title"
  >
    <div class="site-container">
      <div
        class="rounded-[2.75rem] border border-sand bg-white-warm/75 p-4 shadow-card sm:p-6 lg:p-8"
      >
        <div
          class="rounded-card-lg border border-sand/80 bg-cream-soft/80 px-5 py-6 text-center sm:px-8 sm:py-8"
        >
          <Badge variant={badgeVariant} size="md" class="mx-auto">
            <DocumentIcon slot="icon" aria-hidden="true" />

            {document.shortTitle}
          </Badge>

          <h2
            id="policy-content-title"
            class="mx-auto mt-5 max-w-3xl text-3xl text-ink-900 sm:text-4xl"
          >
            Read each section carefully.
          </h2>

          <p class="mx-auto mt-3 max-w-2xl text-base leading-7 text-ink-600">
            This document reflects the current prelaunch website and will be reviewed as Maxi Pawz
            adds new services and store functionality.
          </p>
        </div>

        <div class="mt-6 grid items-start gap-6 lg:grid-cols-[16rem_minmax(0,1fr)] lg:gap-8">
          <!-- Rounded contents navigation -->
          <aside class="lg:sticky lg:top-28">
            <div class="rounded-card-lg border border-brand-200 bg-brand-50/80 p-4">
              <p class="px-2 text-xs font-extrabold tracking-[0.09em] text-brand-700 uppercase">
                On This Page
              </p>

              <nav class="mt-3 grid gap-1.5" aria-label={`${document.title} sections`}>
                {
                  document.sections.map((section) => (
                    <a
                      href={`#${section.id}`}
                      class:list={[
                        'rounded-2xl px-3 py-2.5',
                        'text-sm font-extrabold leading-5 text-ink-700',
                        'transition duration-200',
                        'hover:bg-white-warm hover:text-brand-800',
                        'focus-visible:outline-none focus-visible:ring-4',
                        'focus-visible:ring-brand-200',
                      ]}
                    >
                      {section.title}
                    </a>
                  ))
                }
              </nav>
            </div>

            <div class="mt-4 rounded-card-lg border border-accent-200 bg-accent-50 p-4">
              <ShieldCheckBold class="size-6 text-accent-600" aria-hidden="true" />

              <h3 class="mt-3 text-base text-ink-900">Prelaunch document</h3>

              <p class="mt-2 text-sm leading-6 text-ink-600">
                Operational details must be reviewed and finalized before the store begins accepting
                orders.
              </p>
            </div>
          </aside>

          <!-- Rounded policy sections -->
          <div class="grid min-w-0 gap-5">
            {
              document.sections.map((section) => (
                <article
                  id={section.id}
                  class="scroll-mt-28 rounded-card-lg border border-sand bg-white-warm p-5 shadow-sm sm:p-6 lg:p-7"
                  aria-labelledby={`${section.id}-title`}
                >
                  <h2 id={`${section.id}-title`} class="text-2xl text-ink-900 sm:text-3xl">
                    {section.title}
                  </h2>

                  <div class="mt-4 max-w-4xl space-y-4 text-sm leading-7 text-ink-600 sm:text-base">
                    {section.paragraphs.map((paragraph) => (
                      <p>{paragraph}</p>
                    ))}
                  </div>

                  {section.bullets && (
                    <ul class="mt-5 grid gap-3">
                      {section.bullets.map((point) => (
                        <li class="flex items-start gap-3 rounded-2xl border border-sand/80 bg-cream-soft/75 p-3.5">
                          <PawPrintBold
                            class="mt-0.5 size-5 shrink-0 text-brand-500"
                            aria-hidden="true"
                          />

                          <span class="text-sm font-bold leading-6 text-ink-700">{point}</span>
                        </li>
                      ))}
                    </ul>
                  )}

                  {section.notice && (
                    <p class="mt-5 rounded-2xl border border-accent-200 bg-accent-50 p-4 text-sm font-bold leading-6 text-ink-700">
                      {section.notice}
                    </p>
                  )}
                </article>
              ))
            }
          </div>
        </div>

        <!-- Related policies -->
        <section
          class="mt-8 rounded-card-lg border border-brand-200 bg-linear-to-br from-brand-50 via-white-warm to-accent-50 p-5 sm:p-6 lg:p-8"
          aria-labelledby="related-policies-title"
        >
          <div class="max-w-3xl">
            <Badge variant="brand" size="md">
              <PawPrintBold slot="icon" aria-hidden="true" />

              Related Information
            </Badge>

            <h2 id="related-policies-title" class="mt-5 text-3xl text-ink-900 sm:text-4xl">
              Continue with another Maxi Pawz resource.
            </h2>
          </div>

          <div class="mt-7 grid gap-4 md:grid-cols-3">
            {
              document.relatedLinks.map((link) => (
                <a
                  href={link.href}
                  class={[
                    'group flex h-full flex-col rounded-card border',
                    'border-sand bg-white-warm p-5 shadow-sm',
                    'transition duration-200',
                    'hover:-translate-y-1 hover:border-brand-300',
                    'hover:shadow-card',
                    'focus-visible:outline-none',
                    'focus-visible:ring-4',
                    'focus-visible:ring-brand-200',
                  ]}
                >
                  <h3 class="text-xl text-ink-900">{link.label}</h3>

                  <p class="mt-3 flex-1 text-sm leading-6 text-ink-600">{link.description}</p>

                  <span class="mt-5 inline-flex items-center gap-2 font-extrabold text-brand-700 transition group-hover:gap-3">
                    Open resource
                    <ArrowRightBold class="size-4" aria-hidden="true" />
                  </span>
                </a>
              ))
            }
          </div>
        </section>
      </div>
    </div>
  </section>

  <!-- Rounded final contact panel -->
  <section class="pb-16 sm:pb-20 lg:pb-24">
    <div class="site-container">
      <div
        class="relative overflow-hidden rounded-[2.5rem] bg-ink-950 p-6 text-white shadow-card sm:p-8 lg:p-10"
      >
        <div
          class="pointer-events-none absolute -top-28 -left-24 size-80 rounded-full bg-brand-500/25 blur-3xl"
          aria-hidden="true"
        >
        </div>

        <div
          class="pointer-events-none absolute -right-28 -bottom-32 size-96 rounded-full bg-accent-500/20 blur-3xl"
          aria-hidden="true"
        >
        </div>

        <div class="relative grid items-center gap-8 lg:grid-cols-[1fr_auto]">
          <div class="max-w-2xl">
            <Badge variant="accent" size="md">
              <HeartBold slot="icon" aria-hidden="true" />

              Policy Questions
            </Badge>

            <h2 class="mt-5 text-3xl text-white sm:text-4xl">
              Need clarification about this document?
            </h2>

            <p class="mt-4 text-base leading-7 text-white/70">
              Send Maxi Pawz a message and identify the policy section connected to your question.
            </p>
          </div>

          <Button
            href={businessConfig.contactHref}
            variant="primary"
            size="lg"
            iconPosition="right"
            class="w-full lg:w-auto"
          >
            <ArrowRightBold slot="icon" aria-hidden="true" />

            Contact Maxi Pawz
          </Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
