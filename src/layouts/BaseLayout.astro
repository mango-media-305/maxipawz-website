---
import Analytics from '@components/analytics/Analytics.astro';

import '@fontsource-variable/nunito-sans/wght.css';

import '@styles/global.css';
import '@styles/typography.css';

import AnnouncementBar from '@components/layout/AnnouncementBar.astro';
import SiteFooter from '@components/layout/SiteFooter.astro';
import SiteHeader from '@components/layout/SiteHeader.astro';

import { siteConfig } from '../config/site';

type StructuredData = Record<string, unknown> | Array<Record<string, unknown>>;

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  noIndex?: boolean;
  hideSiteChrome?: boolean;
  structuredData?: StructuredData;
}

const {
  title,
  description,
  image,
  imageAlt = 'MaxiPawz Store',
  noIndex = false,
  hideSiteChrome = false,
  structuredData,
} = Astro.props;

const environmentNoIndex = import.meta.env.PUBLIC_ROBOTS_NOINDEX === 'true';

const shouldNoIndex = noIndex || environmentNoIndex;

const fullTitle = title === siteConfig.name ? title : `${title} | ${siteConfig.name}`;

const canonicalURL = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : new URL(Astro.url.pathname, Astro.url);

const socialImageURL = image ? new URL(image, canonicalURL).toString() : undefined;

const robotsContent = shouldNoIndex
  ? 'noindex, nofollow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
---

<!doctype html>
<html lang={siteConfig.language}>
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>

    <meta name="description" content={description} />

    <meta name="robots" content={robotsContent} />

    <meta name="theme-color" content="#008aff" />

    <link rel="canonical" href={canonicalURL} />

    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link
      rel="preload"
      href="/fonts/skia/Skia.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    <meta property="og:type" content="website" />

    <meta property="og:site_name" content={siteConfig.name} />

    <meta property="og:locale" content={siteConfig.locale} />

    <meta property="og:title" content={fullTitle} />

    <meta property="og:description" content={description} />

    <meta property="og:url" content={canonicalURL} />

    {socialImageURL && <meta property="og:image" content={socialImageURL} />}

    {socialImageURL && <meta property="og:image:alt" content={imageAlt} />}

    <meta name="twitter:card" content={socialImageURL ? 'summary_large_image' : 'summary'} />

    <meta name="twitter:title" content={fullTitle} />

    <meta name="twitter:description" content={description} />

    {socialImageURL && <meta name="twitter:image" content={socialImageURL} />}

    {socialImageURL && <meta name="twitter:image:alt" content={imageAlt} />}

    {
      structuredData && (
        <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
      )
    }

    <Analytics />
  </head>

  <body>
    <a
      href="#main-content"
      class="fixed top-3 left-3 z-100 -translate-y-24 rounded-full bg-brand-700 px-5 py-3 font-bold text-white shadow-blue transition focus:translate-y-0"
    >
      Skip to main content
    </a>

    {
      !hideSiteChrome && (
        <>
          <AnnouncementBar />
          <SiteHeader />
        </>
      )
    }

    <main id="main-content">
      <slot />
    </main>

    {!hideSiteChrome && <SiteFooter />}
  </body>
</html>
