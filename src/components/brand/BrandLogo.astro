---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

import logoImage from '../../assets/brand/maxipawz-horizontal-logo.webp';
import markImage from '../../assets/brand/maxipawz-mark.webp';
import mascotImage from '../../assets/brand/maxipawz-mascot.webp';
import maxiImage from '../../assets/home/maxi-1.webp';

import { businessConfig } from '../../config/business';

type BrandLogoVariant = 'logo' | 'mark' | 'mascot' | 'maxi';

interface BrandImage {
  src: ImageMetadata;
  alt: string;
}

interface Props {
  variant?: BrandLogoVariant;
  class?: string;
  eager?: boolean;
  decorative?: boolean;
  alt?: string;
  quality?: number;
}

const {
  variant = 'logo',
  class: className = '',
  eager = false,
  decorative = false,
  alt,
  quality = 90,
} = Astro.props;

const imageByVariant: Record<BrandLogoVariant, BrandImage> = {
  logo: {
    src: logoImage,
    alt: businessConfig.publicName,
  },

  mark: {
    src: markImage,
    alt: businessConfig.shortName,
  },

  mascot: {
    src: mascotImage,
    alt: `${businessConfig.shortName} dog mascot`,
  },

  maxi: {
    src: maxiImage,
    alt: `Maxi, the dog who inspired ${businessConfig.publicName}`,
  },
};

const selectedImage = imageByVariant[variant];

const finalAlt = decorative ? '' : (alt ?? selectedImage.alt);
---

<Image
  src={selectedImage.src}
  alt={finalAlt}
  class={className}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : 'auto'}
  quality={quality}
  aria-hidden={decorative ? 'true' : undefined}
  role={decorative ? 'presentation' : undefined}
/>