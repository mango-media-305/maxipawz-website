---
import ConfettiBold from 'phosphor-astro/ConfettiBold.astro';
import HeartBold from 'phosphor-astro/HeartBold.astro';
import PawPrintBold from 'phosphor-astro/PawPrintBold.astro';
import ShieldCheckBold from 'phosphor-astro/ShieldCheckBold.astro';
import ShoppingBagOpenBold from 'phosphor-astro/ShoppingBagOpenBold.astro';
import SuitcaseRollingBold from 'phosphor-astro/SuitcaseRollingBold.astro';

import CategoryCard from '../home/CategoryCard.astro';
import Badge from '../ui/Badge.astro';

import { isStoreLive } from '../../config/storefront';

import { lifestyleCategories, type LifestyleCategoryIcon } from '../../data/shop';

const iconByCategory: Record<LifestyleCategoryIcon, typeof PawPrintBold> = {
    play: ConfettiBold,
    travel: SuitcaseRollingBold,
    hydration: HeartBold,
    comfort: PawPrintBold,
    care: ShieldCheckBold,
    accessories: ShoppingBagOpenBold,
};

function getCategoryHref(slug: string): string {
    if (!isStoreLive) {
        return '#join-the-shop-updates';
    }

    return `/shop?category=${encodeURIComponent(slug)}#products`;
}

const categoryLinkLabel = isStoreLive ? 'Explore category' : 'Get launch updates';
---

<section
    id="shop-categories"
    class="section-spacing scroll-mt-28 relative overflow-hidden border-y border-sand bg-white-warm/70"
    aria-labelledby="shop-categories-title"
>
    <div
        class="pointer-events-none absolute top-8 left-1/2 size-96 -translate-x-1/2 rounded-full bg-brand-200/20 blur-3xl"
        aria-hidden="true"
    >
    </div>

    <div class="site-container relative">
        <div class="mx-auto max-w-4xl text-center">
        <Badge variant="brand" size="md" class="mx-auto">
            <PawPrintBold slot="icon" aria-hidden="true" />

            {isStoreLive ? 'Shop by Lifestyle' : 'What You Will Find'}
        </Badge>

        <h2 id="shop-categories-title" class="section-title mx-auto mt-5 text-4xl sm:text-5xl">
            Products organized around real pet moments.
        </h2>

        <p class="section-description mx-auto mt-4">
            {
            isStoreLive
                ? 'Explore the collection based on the activities, routines, and experiences you share with your pet.'
                : 'Discover the types of products MaxiPawz is preparing for playtime, walks, travel, feeding, comfort, care, and personal style.'
            }
        </p>
        </div>

        <div class="mt-10 grid gap-4 sm:grid-cols-2 sm:gap-5 lg:mt-12 lg:grid-cols-3 lg:gap-6">
        {
            lifestyleCategories.map((category) => {
            const Icon = iconByCategory[category.icon];

            return (
                <CategoryCard
                title={category.title}
                description={category.description}
                href={getCategoryHref(category.slug)}
                linkLabel={categoryLinkLabel}
                tone={category.tone}
                backgroundImage={category.backgroundImage}
                backgroundPosition={category.backgroundPosition}
                backgroundOverlay={category.backgroundOverlay}
                >
                <Icon slot="icon" aria-hidden="true" />
                </CategoryCard>
            );
            })
        }
        </div>

        {
        !isStoreLive && (
            <p class="mx-auto mt-8 max-w-2xl text-center text-sm leading-6 text-ink-500">
            Product availability, pricing, and launch timing will be shared only after the collection
            and shopping experience are ready.
            </p>
        )
        }
    </div>
</section>