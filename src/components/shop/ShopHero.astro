---
import ArrowRightBold from 'phosphor-astro/ArrowRightBold.astro';
import ConfettiBold from 'phosphor-astro/ConfettiBold.astro';
import ShoppingBagOpenBold from 'phosphor-astro/ShoppingBagOpenBold.astro';

import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';

import { isStoreLive } from '../../config/storefront';

import {
  getLocaleFromPathname,
} from '../../i18n/languages';

import {
  localizeHref,
  localizedLinkLabel,
} from '../../i18n/routes';

interface Props {
  hasProducts:
    boolean;

  hasDemoProducts?:
    boolean;
}

const {
  hasProducts,
  hasDemoProducts = false,
} =
  Astro.props;

const locale =
  getLocaleFromPathname(
    Astro.url.pathname,
  );

const spanish =
  locale === 'es';

const isEmptyLiveStore =
  isStoreLive &&
  !hasProducts;

const isCatalogPreview =
  hasProducts &&
  (
    !isStoreLive ||
    hasDemoProducts
  );

const badgeLabel =
  !isStoreLive
    ? spanish
      ? 'Nuestra colección está tomando forma'
      : 'Our collection is taking shape'
    : isEmptyLiveStore
      ? 'Maxi Pawz'
      : isCatalogPreview
        ? spanish
          ? 'Vista previa de productos'
          : 'Product preview'
        : spanish
          ? 'Compra en Maxi Pawz'
          : 'Shop Maxi Pawz';

const headingStart =
  isEmptyLiveStore
    ? spanish
      ? 'No hay productos disponibles'
      : 'No products to show'
    : isStoreLive
      ? spanish
        ? 'Encuentra algo especial para'
        : 'Find something special for'
      : spanish
        ? 'Una tienda alegre para'
        : 'A joyful shop for';

const headingEnd =
  isEmptyLiveStore
    ? spanish
      ? 'en este momento.'
      : 'right now.'
    : isStoreLive
      ? spanish
        ? 'cada momento con tu mascota.'
        : 'every pet moment.'
      : spanish
        ? 'la vida cotidiana con mascotas.'
        : 'everyday pet life.';

const description =
  isEmptyLiveStore
    ? spanish
      ? 'Recibe novedades de productos o explora nuestras guías para encontrar nuevas ideas para disfrutar con tu mascota.'
      : 'Get product updates, or explore our pet guides for ideas to try with your pet.'
    : isStoreLive
      ? spanish
        ? 'Explora la colección, descubre los detalles y encuentra lo que mejor se adapta a la rutina cotidiana de tu mascota.'
        : 'Explore the collection, discover the details, and find what fits your pet’s everyday routine.'
      : hasProducts
        ? spanish
          ? 'Explora una vista previa de la colección que estamos preparando y regístrate para saber cuándo abre la tienda.'
          : 'Preview the collection we are preparing, and sign up to hear when the store opens.'
        : spanish
          ? 'Estamos preparando nuestra primera colección. Descubre lo que viene y regístrate para recibir novedades del lanzamiento.'
          : 'We are preparing our first collection. Explore what is coming and sign up for launch updates.';

const primarySourceHref =
  hasProducts
    ? '#products'
    : '/#maxi-pawz-updates';

const primaryLabel =
  hasProducts
    ? isCatalogPreview
      ? spanish
        ? 'Ver productos'
        : 'Preview Products'
      : spanish
        ? 'Explorar productos'
        : 'Browse Products'
    : isStoreLive
      ? spanish
        ? 'Recibir novedades de productos'
        : 'Get Product Updates'
      : spanish
        ? 'Recibir novedades del lanzamiento'
        : 'Get Launch Updates';

const secondarySourceHref =
  isStoreLive
    ? '/pet-guides'
    : hasProducts
      ? '/#maxi-pawz-updates'
      : '#shop-categories';

const secondaryBaseLabel =
  isStoreLive
    ? spanish
      ? 'Leer guías para mascotas'
      : 'Read Pet Guides'
    : hasProducts
      ? spanish
        ? 'Recibir novedades del lanzamiento'
        : 'Get Launch Updates'
      : spanish
        ? 'Explorar lo que viene'
        : 'Explore What’s Coming';

const primaryHref =
  localizeHref(
    primarySourceHref,
    locale,
  );

const secondaryHref =
  localizeHref(
    secondarySourceHref,
    locale,
  );

const secondaryLabel =
  localizedLinkLabel(
    secondaryBaseLabel,
    secondarySourceHref,
    locale,
  );
---

<section
  class="relative overflow-hidden"
  aria-labelledby="shop-hero-title"
>
  <div
    class="pointer-events-none absolute -top-40 -left-40 size-128 rounded-full bg-brand-300/25 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div
    class="pointer-events-none absolute top-8 -right-48 size-136 rounded-full bg-accent-300/25 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div class="site-container-wide py-8 sm:py-10 lg:py-12">
    <div class="relative z-10 max-w-4xl">
      <Badge
        variant={
          isStoreLive
            ? 'brand'
            : 'accent'
        }
        size="md"
      >
        {
          isStoreLive
            ? (
                <ShoppingBagOpenBold
                  slot="icon"
                  aria-hidden="true"
                />
              )
            : (
                <ConfettiBold
                  slot="icon"
                  aria-hidden="true"
                />
              )
        }

        {badgeLabel}
      </Badge>

      <h1
        id="shop-hero-title"
        class="mt-5 text-4xl leading-[1.1] text-ink-900 sm:text-5xl lg:text-6xl"
      >
        {headingStart}

        <span class="mt-1 block text-brand-gradient">
          {headingEnd}
        </span>
      </h1>

      <p class="mt-5 max-w-2xl text-base leading-7 text-ink-600 sm:text-lg sm:leading-8">
        {description}
      </p>

      <div class="mt-6 flex flex-col gap-3 sm:flex-row">
        <Button
          href={primaryHref}
          variant="primary"
          size="lg"
          iconPosition="right"
          class="w-full sm:w-auto"
        >
          <ArrowRightBold
            slot="icon"
            aria-hidden="true"
          />

          {primaryLabel}
        </Button>

        <Button
          href={secondaryHref}
          variant="secondary"
          size="lg"
          class="w-full sm:w-auto"
        >
          {secondaryLabel}
        </Button>
      </div>
    </div>
  </div>
</section>