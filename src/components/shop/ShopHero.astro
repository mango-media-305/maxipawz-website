---
import ArrowRightBold from 'phosphor-astro/ArrowRightBold.astro';
import ConfettiBold from 'phosphor-astro/ConfettiBold.astro';
import ShoppingBagOpenBold from 'phosphor-astro/ShoppingBagOpenBold.astro';

import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';

import { isStoreLive } from '../../config/storefront';

interface Props {
  hasProducts: boolean;
  hasDemoProducts?: boolean;
}

const { hasProducts, hasDemoProducts = false } = Astro.props;

const isEmptyLiveStore = isStoreLive && !hasProducts;
const isCatalogPreview = hasProducts && (!isStoreLive || hasDemoProducts);

const badgeLabel = !isStoreLive
  ? 'Our collection is taking shape'
  : isEmptyLiveStore
    ? 'Maxi Pawz'
    : isCatalogPreview
      ? 'Product preview'
      : 'Shop Maxi Pawz';

const headingStart = isEmptyLiveStore
  ? 'No products to show'
  : isStoreLive
    ? 'Find something special for'
    : 'A joyful shop for';

const headingEnd = isEmptyLiveStore
  ? 'right now.'
  : isStoreLive
    ? 'every pet moment.'
    : 'everyday pet life.';

const description = isEmptyLiveStore
  ? 'Get product updates, or explore our pet guides for ideas to try with your pet.'
  : isStoreLive
    ? 'Explore the collection, discover the details, and find what fits your pet’s everyday routine.'
    : hasProducts
      ? 'Preview the collection we are preparing, and sign up to hear when the store opens.'
      : 'We are preparing our first collection. Explore what is coming and sign up for launch updates.';

const primaryAction = hasProducts
  ? {
      href: '#products',
      label: isCatalogPreview ? 'Preview Products' : 'Browse Products',
    }
  : {
      href: '/#maxi-pawz-updates',
      label: isStoreLive ? 'Get Product Updates' : 'Get Launch Updates',
    };

const secondaryAction = isStoreLive
  ? {
      href: '/pet-guides',
      label: 'Read Pet Guides',
    }
  : hasProducts
    ? {
        href: '/#maxi-pawz-updates',
        label: 'Get Launch Updates',
      }
    : {
        href: '#shop-categories',
        label: 'Explore What’s Coming',
      };
---

<section class="relative overflow-hidden" aria-labelledby="shop-hero-title">
  <div
    class="pointer-events-none absolute -top-40 -left-40 size-128 rounded-full bg-brand-300/25 blur-3xl"
    aria-hidden="true"
  ></div>

  <div
    class="pointer-events-none absolute top-8 -right-48 size-136 rounded-full bg-accent-300/25 blur-3xl"
    aria-hidden="true"
  ></div>

  <div class="site-container-wide py-8 sm:py-10 lg:py-12">
    <div class="relative z-10 max-w-4xl">
      <Badge variant={isStoreLive ? 'brand' : 'accent'} size="md">
        {
          isStoreLive ? (
            <ShoppingBagOpenBold slot="icon" aria-hidden="true" />
          ) : (
            <ConfettiBold slot="icon" aria-hidden="true" />
          )
        }

        {badgeLabel}
      </Badge>

      <h1
        id="shop-hero-title"
        class="mt-5 text-4xl leading-[1.1] text-ink-900 sm:text-5xl lg:text-6xl"
      >
        {headingStart}
        <span class="mt-1 block text-brand-gradient">{headingEnd}</span>
      </h1>

      <p class="mt-5 max-w-2xl text-base leading-7 text-ink-600 sm:text-lg sm:leading-8">
        {description}
      </p>

      <div class="mt-6 flex flex-col gap-3 sm:flex-row">
        <Button
          href={primaryAction.href}
          variant="primary"
          size="lg"
          iconPosition="right"
          class="w-full sm:w-auto"
        >
          <ArrowRightBold slot="icon" aria-hidden="true" />
          {primaryAction.label}
        </Button>

        <Button
          href={secondaryAction.href}
          variant="secondary"
          size="lg"
          class="w-full sm:w-auto"
        >
          {secondaryAction.label}
        </Button>
      </div>
    </div>
  </div>
</section>