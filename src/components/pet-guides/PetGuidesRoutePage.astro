---
import { getCollection } from 'astro:content';

import ArrowRightBold from 'phosphor-astro/ArrowRightBold.astro';
import CheckCircleBold from 'phosphor-astro/CheckCircleBold.astro';
import CheckCircleFill from 'phosphor-astro/CheckCircleFill.astro';
import HeartBold from 'phosphor-astro/HeartBold.astro';
import PawPrintBold from 'phosphor-astro/PawPrintBold.astro';
import ShoppingBagOpenBold from 'phosphor-astro/ShoppingBagOpenBold.astro';
import SparkleBold from 'phosphor-astro/SparkleBold.astro';

import Badge from '@components/ui/Badge.astro';
import Button from '@components/ui/Button.astro';

import BaseLayout from '@layouts/BaseLayout.astro';

import PetGuidesPagination from './PetGuidesPagination.astro';

import { isStoreLive } from '../../config/storefront';

import { getLocaleFromPathname } from '../../i18n/languages';

import { localizeHref } from '../../i18n/routes';

import {
  getBlogPostPath,
  getIndexableBlogPostsForLocale,
  sortBlogPostsNewestFirst,
} from '../../utils/blog';

const locale = getLocaleFromPathname(Astro.url.pathname);

const spanish = locale === 'es';

const allPosts = await getCollection('blog');

const posts = sortBlogPostsNewestFirst(getIndexableBlogPostsForLocale(allPosts, locale));

const featuredPosts = posts.filter((post) => post.data.featured);

const featuredPost = featuredPosts[0] ?? posts[0];

const topicPosts = posts.filter((post) => post !== featuredPost);

const FeaturedGuideIcon = CheckCircleBold;

const copy = spanish
  ? {
      title: 'Guías para mascotas',

      description:
        'Explora guías prácticas de Maxi Pawz sobre juguetes, enriquecimiento, paseos, viajes, alimentación, hidratación, comodidad, aseo, collares, preparación para huracanes y cuidado cotidiano.',

      badge: 'Guías para mascotas de Maxi Pawz',

      headingStart: 'Consejos prácticos para',

      headingAccent: 'días más felices con tu perro.',

      intro:
        'Explora artículos prácticos sobre juguetes, paseos, viajes, hidratación, comodidad, aseo, preparación para emergencias y productos cotidianos, con orientación específica para Miami y el sur de Florida cuando la ubicación realmente cambia la respuesta.',

      browse: 'Explorar las guías',

      shop: 'Explorar la tienda',

      join: 'Únete a la comunidad',

      guideTopics: 'Biblioteca de guías para mascotas',

      readGuide: 'Leer guía',

      readGuideAria: 'Leer guía',

      photoBy: 'Foto de',

      featured: 'Guía destacada',

      readFull: 'Leer la guía completa',

      lessons: 'Lecciones de Maxi',

      lessonsHeading: 'Cuatro principios sencillos a los que volvemos una y otra vez.',

      disclaimer:
        'Estas guías ofrecen información educativa general. Consulta a un veterinario calificado u otro profesional apropiado para inquietudes médicas, nutricionales, conductuales o de seguridad específicas de tu perro.',

      keepLearning: 'Sigue aprendiendo con Maxi Pawz',

      ctaHeading: 'La orientación útil forma parte de la experiencia de Maxi Pawz.',

      liveCtaDescription:
        'Utiliza nuestras guías junto con la colección de Maxi Pawz para descubrir productos que se adapten a las rutinas y personalidad de tu perro.',

      prelaunchCtaDescription:
        'Únete a la comunidad para recibir nuevas guías, recursos para mascotas en Miami, novedades del lanzamiento, noticias de productos y más lecciones inspiradas en la vida con Maxi.',

      emptyTitle: 'Estamos preparando la biblioteca en español.',

      emptyDescription:
        'Las versiones completas en español de nuestras guías se irán publicando aquí. No mostraremos artículos en inglés dentro de esta biblioteca únicamente para llenar espacio.',

      emptyCta: 'Explorar la tienda',

      tips: [
        {
          title: 'Empieza por tu perro',

          description:
            'La personalidad, el tamaño, la edad, los hábitos y las rutinas importan más que elegir un producto únicamente porque se ve atractivo.',
        },

        {
          title: 'Introduce los productos gradualmente',

          description:
            'Dale tiempo a tu perro para investigar juguetes, accesorios, tazones, transportadoras o herramientas de aseo que no conoce.',
        },

        {
          title: 'Observa el uso real',

          description:
            'Observa cómo interactúa tu perro con un producto y haz ajustes cuando genere incomodidad o un uso inseguro.',
        },

        {
          title: 'Revisa los productos regularmente',

          description:
            'Reemplaza los artículos que estén dañados, sueltos, afilados, muy desgastados o que ya no sean apropiados para continuar utilizándolos.',
        },
      ],
    }
  : {
      title: 'Pet Guides',

      description:
        'Explore practical Maxi Pawz guides for dog toys, enrichment, walking, travel, feeding, hydration, comfort, grooming, collars, hurricane preparedness, and everyday care.',

      badge: 'Maxi Pawz Pet Guides',

      headingStart: 'Practical guidance for',

      headingAccent: 'happier dog days.',

      intro:
        'Explore practical articles about toys, walking, travel, hydration, comfort, grooming, emergency planning, and everyday products — with Miami and South Florida guidance when location genuinely changes the answer.',

      browse: 'Browse the Guides',

      shop: 'Explore the Shop',

      join: 'Join the Pack',

      guideTopics: 'Pet guide library',

      readGuide: 'Read guide',

      readGuideAria: 'Read guide',

      photoBy: 'Photo by',

      featured: 'Featured Guide',

      readFull: 'Read the Full Guide',

      lessons: 'Lessons from Maxi',

      lessonsHeading: 'Four simple principles we return to again and again.',

      disclaimer:
        'These guides provide general educational information. Contact a qualified veterinarian or another appropriate professional for medical, nutritional, behavioral, or safety concerns specific to your dog.',

      keepLearning: 'Keep Learning with Maxi Pawz',

      ctaHeading: 'Helpful guidance is part of the Maxi Pawz experience.',

      liveCtaDescription:
        'Use our guides alongside the Maxi Pawz collection to discover products that fit your dog’s routines and personality.',

      prelaunchCtaDescription:
        'Join the pack for new guides, Miami pet resources, launch updates, product news, and more lessons inspired by life with Maxi.',

      emptyTitle: 'Pet guides are on the way.',

      emptyDescription: 'New practical Maxi Pawz guides will appear here as they are published.',

      emptyCta: 'Explore the Shop',

      tips: [
        {
          title: 'Start with your dog',

          description:
            'Personality, size, age, habits, and routines matter more than choosing a product only because it looks appealing.',
        },

        {
          title: 'Introduce products gradually',

          description:
            'Give your dog time to investigate unfamiliar toys, accessories, bowls, carriers, or grooming tools.',
        },

        {
          title: 'Observe real use',

          description:
            'Watch how your dog interacts with a product and adjust when the product creates discomfort or unsafe use.',
        },

        {
          title: 'Inspect products regularly',

          description:
            'Replace items that become damaged, loose, sharp, heavily worn, or no longer appropriate for continued use.',
        },
      ],
    };

const shopHref = localizeHref('/shop', locale);

const joinHref = localizeHref('/#join-the-pack', locale);

const shouldNoIndex = spanish && posts.length === 0;
---

<BaseLayout title={copy.title} description={copy.description} noIndex={shouldNoIndex}>
  <section class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute -top-40 -left-40 size-128 rounded-full bg-brand-300/25 blur-3xl"
      aria-hidden="true"
    >
    </div>

    <div
      class="pointer-events-none absolute top-8 -right-48 size-136 rounded-full bg-accent-300/25 blur-3xl"
      aria-hidden="true"
    >
    </div>

    <div class="site-container grid items-center gap-10 py-12 sm:py-14 lg:gap-14 lg:py-16">
      <div class="relative z-10">
        <Badge variant="accent" size="md">
          <SparkleBold slot="icon" aria-hidden="true" />

          {copy.badge}
        </Badge>

        <h1 class="mt-6 text-5xl text-ink-900 sm:text-6xl lg:text-7xl">
          {copy.headingStart}{' '}

          <span class="text-brand-gradient">
            {copy.headingAccent}
          </span>
        </h1>

        <p class="mt-6 text-lg leading-8 text-ink-600 sm:text-xl">
          {copy.intro}
        </p>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <Button
            href="#guide-topics"
            variant="primary"
            size="lg"
            iconPosition="right"
            class="w-full sm:w-auto"
          >
            <ArrowRightBold slot="icon" aria-hidden="true" />

            {copy.browse}
          </Button>

          {
            isStoreLive ? (
              <Button
                href={shopHref}
                variant="secondary"
                size="lg"
                iconPosition="right"
                class="w-full sm:w-auto"
              >
                <ShoppingBagOpenBold slot="icon" aria-hidden="true" />

                {copy.shop}
              </Button>
            ) : (
              <Button
                href={joinHref}
                variant="secondary"
                size="lg"
                iconPosition="right"
                class="w-full sm:w-auto"
              >
                <HeartBold slot="icon" aria-hidden="true" />

                {copy.join}
              </Button>
            )
          }
        </div>
      </div>
    </div>
  </section>

  <section
    id="guide-topics"
    class="section-spacing scroll-mt-28 border-y border-sand bg-white-warm/70"
    aria-labelledby="guide-topics-title"
  >
    <div class="site-container">
      <h2 id="guide-topics-title" class="sr-only">
        {copy.guideTopics}
      </h2>

      {
        topicPosts.length > 0 ? (
          <>
            <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:mt-12 lg:grid-cols-3 lg:gap-6">
              {topicPosts.map((post, index) => {
                const positionInPattern = index % 7;

                const isWide = positionInPattern === 0 || positionInPattern === 6;

                const image = post.data.heroImage;

                return (
                  <article
                    class:list={[
                      'group relative overflow-hidden rounded-4xl border border-white/80 bg-ink-950 shadow-card transition duration-300 hover:-translate-y-1.5 hover:shadow-xl',

                      isWide && 'sm:col-span-2',
                    ]}
                  >
                    <a
                      href={getBlogPostPath(post)}
                      class="absolute inset-0 z-20 rounded-4xl focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-brand-300 focus-visible:ring-offset-2 focus-visible:ring-offset-white-warm"
                      aria-label={`${copy.readGuideAria}: ${post.data.title}`}
                    >
                      <span class="sr-only">
                        {copy.readGuide} {post.data.title}
                      </span>
                    </a>

                    <div
                      class:list={[
                        'relative overflow-hidden',

                        isWide ? 'min-h-104 sm:min-h-112' : 'min-h-96',
                      ]}
                    >
                      <img
                        src={image.src}
                        alt={image.alt}
                        width={image.width}
                        height={image.height}
                        loading="lazy"
                        decoding="async"
                        class="absolute inset-0 size-full object-cover transition duration-700 ease-out group-hover:scale-[1.045]"
                      />

                      <div
                        class="pointer-events-none absolute inset-0 bg-linear-to-t from-ink-950 via-ink-950/48 to-transparent"
                        aria-hidden="true"
                      ></div>

                      <div
                        class="pointer-events-none absolute inset-x-0 top-0 h-40 bg-linear-to-b from-ink-950/30 to-transparent"
                        aria-hidden="true"
                      ></div>

                      <div class="relative z-10 flex min-h-inherit h-full flex-col justify-between p-5 sm:p-6 lg:p-7">
                        <div class="flex items-start justify-between gap-4">
                          <span class="rounded-full border border-white/25 bg-ink-950/45 px-3 py-1.5 text-[0.68rem] font-black tracking-[0.14em] text-white uppercase backdrop-blur-md">
                            {post.data.category}
                          </span>
                        </div>

                        <div class:list={['mt-24', isWide ? 'max-w-3xl' : 'max-w-xl']}>
                          <h3
                            class:list={[
                              'text-white drop-shadow-sm',

                              isWide ? 'text-3xl sm:text-4xl lg:text-5xl' : 'text-2xl sm:text-3xl',
                            ]}
                          >
                            {post.data.title}
                          </h3>

                          <p
                            class:list={[
                              'mt-3 text-sm leading-6 text-white/78 sm:text-base sm:leading-7',

                              isWide ? 'max-w-2xl' : 'max-w-lg',
                            ]}
                          >
                            {post.data.description}
                          </p>

                          <div class="mt-5 flex items-center gap-2 font-extrabold text-white">
                            <span>{copy.readGuide}</span>

                            <ArrowRightBold
                              class="size-5 transition-transform duration-300 group-hover:translate-x-1.5"
                              aria-hidden="true"
                            />
                          </div>
                        </div>
                      </div>
                    </div>

                    {(image.credit || image.source) && (
                      <div class="relative z-30 border-t border-white/10 bg-ink-950 px-5 py-3 text-[0.68rem] leading-5 text-white/55 sm:px-6">
                        {image.credit && (
                          <>
                            {copy.photoBy}{' '}
                            <a
                              href={image.credit.url}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="font-bold text-white/75 underline decoration-white/30 underline-offset-2 transition hover:text-white"
                            >
                              {image.credit.name}
                            </a>
                          </>
                        )}

                        {image.credit && image.source && ' · '}

                        {image.source && (
                          <a
                            href={image.source.url}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="font-bold text-white/75 underline decoration-white/30 underline-offset-2 transition hover:text-white"
                          >
                            {image.source.name}
                          </a>
                        )}
                      </div>
                    )}
                  </article>
                );
              })}
            </div>

            <PetGuidesPagination />
          </>
        ) : (
          <div class="mx-auto mt-10 max-w-3xl rounded-[2.5rem] border border-brand-200 bg-linear-to-br from-brand-50 via-white-warm to-accent-50 p-6 text-center shadow-card sm:p-8 lg:mt-12 lg:p-10">
            <span
              class="mx-auto grid size-16 place-items-center rounded-full border border-brand-200 bg-white-warm text-brand-600 shadow-soft"
              aria-hidden="true"
            >
              <PawPrintBold class="size-8" />
            </span>

            <h3 class="mt-6 text-3xl text-ink-900 sm:text-4xl">{copy.emptyTitle}</h3>

            <p class="mx-auto mt-4 max-w-2xl text-base leading-7 text-ink-600">
              {copy.emptyDescription}
            </p>

            <div class="mt-7">
              <Button href={shopHref} variant="secondary" size="lg">
                {copy.emptyCta}
              </Button>
            </div>
          </div>
        )
      }
    </div>
  </section>

  {
    featuredPost && (
      <section
        class="section-spacing relative overflow-hidden bg-ink-950 text-white"
        aria-labelledby="featured-guide-title"
      >
        <div
          class="pointer-events-none absolute -top-32 -left-24 size-80 rounded-full bg-brand-500/20 blur-3xl"
          aria-hidden="true"
        ></div>

        <div
          class="pointer-events-none absolute -right-24 -bottom-32 size-96 rounded-full bg-accent-500/20 blur-3xl"
          aria-hidden="true"
        ></div>

        <div class="site-container relative grid items-center gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-14">
          <div class="max-w-xl">
            <Badge variant="accent" size="md">
              <FeaturedGuideIcon slot="icon" aria-hidden="true" />

              {copy.featured}
            </Badge>

            <h2
              id="featured-guide-title"
              class="section-title mt-5 text-4xl text-white sm:text-5xl"
            >
              {featuredPost.data.title}
            </h2>

            <p class="mt-5 text-base leading-7 text-white/75 sm:text-lg sm:leading-8">
              {featuredPost.data.description}
            </p>

            <p class="mt-4 text-sm font-bold text-accent-300 uppercase">
              {featuredPost.data.category}
            </p>

            <div class="mt-7">
              <Button
                href={getBlogPostPath(featuredPost)}
                variant="primary"
                size="lg"
                iconPosition="right"
              >
                <ArrowRightBold slot="icon" aria-hidden="true" />

                {copy.readFull}
              </Button>
            </div>
          </div>

          <div class="overflow-hidden rounded-4xl border border-white/10 bg-white/5 shadow-card">
            <img
              src={featuredPost.data.heroImage.src}
              alt={featuredPost.data.heroImage.alt}
              width={featuredPost.data.heroImage.width}
              height={featuredPost.data.heroImage.height}
              loading="lazy"
              decoding="async"
              class="aspect-4/3 w-full object-cover"
            />

            <div class="p-5 sm:p-6">
              <p class="text-sm leading-6 text-white/70">
                {featuredPost.data.heroImage.caption ?? featuredPost.data.description}
              </p>

              {(featuredPost.data.heroImage.credit || featuredPost.data.heroImage.source) && (
                <p class="mt-3 text-xs leading-5 text-white/50">
                  {featuredPost.data.heroImage.credit && (
                    <>
                      {copy.photoBy}{' '}
                      <a
                        href={featuredPost.data.heroImage.credit.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="font-bold text-white/70 underline underline-offset-2"
                      >
                        {featuredPost.data.heroImage.credit.name}
                      </a>
                    </>
                  )}

                  {featuredPost.data.heroImage.credit &&
                    featuredPost.data.heroImage.source &&
                    ' · '}

                  {featuredPost.data.heroImage.source && (
                    <a
                      href={featuredPost.data.heroImage.source.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="font-bold text-white/70 underline underline-offset-2"
                    >
                      {featuredPost.data.heroImage.source.name}
                    </a>
                  )}
                </p>
              )}
            </div>
          </div>
        </div>
      </section>
    )
  }

  <section
    class="section-spacing border-y border-sand bg-white-warm/70"
    aria-labelledby="maxi-tips-title"
  >
    <div class="site-container">
      <div class="mx-auto max-w-4xl text-center">
        <Badge variant="accent" size="md" class="mx-auto">
          <PawPrintBold slot="icon" aria-hidden="true" />

          {copy.lessons}
        </Badge>

        <h2 id="maxi-tips-title" class="section-title mx-auto mt-5 text-4xl sm:text-5xl">
          {copy.lessonsHeading}
        </h2>
      </div>

      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:mt-12 lg:grid-cols-4 lg:gap-5">
        {
          copy.tips.map((tip) => (
            <article class="rounded-card border border-sand bg-cream-soft p-5 shadow-sm">
              <CheckCircleFill class="size-7 text-brand-500" aria-hidden="true" />

              <h3 class="mt-5 text-xl text-ink-900">{tip.title}</h3>

              <p class="mt-3 text-sm leading-6 text-ink-600">{tip.description}</p>
            </article>
          ))
        }
      </div>

      <p class="mx-auto mt-8 max-w-3xl text-center text-sm leading-6 text-ink-500">
        {copy.disclaimer}
      </p>
    </div>
  </section>

  <section class="section-spacing">
    <div class="site-container">
      <div
        class="relative overflow-hidden rounded-card-lg border border-brand-200 bg-linear-to-br from-brand-50 via-white-warm to-accent-50 p-6 text-center shadow-card sm:p-8 lg:p-10"
      >
        <div
          class="pointer-events-none absolute -top-24 -right-20 size-64 rounded-full bg-brand-300/25 blur-3xl"
          aria-hidden="true"
        >
        </div>

        <div class="relative mx-auto max-w-3xl">
          <Badge variant="brand" size="md" class="mx-auto">
            <HeartBold slot="icon" aria-hidden="true" />

            {copy.keepLearning}
          </Badge>

          <h2 class="section-title mx-auto mt-5 text-4xl sm:text-5xl">
            {copy.ctaHeading}
          </h2>

          <p class="section-description mx-auto mt-4">
            {isStoreLive ? copy.liveCtaDescription : copy.prelaunchCtaDescription}
          </p>

          <div class="mt-8 flex justify-center">
            {
              isStoreLive ? (
                <Button href={shopHref} variant="primary" size="lg" iconPosition="right">
                  <ShoppingBagOpenBold slot="icon" aria-hidden="true" />

                  {copy.shop}
                </Button>
              ) : (
                <Button href={joinHref} variant="primary" size="lg" iconPosition="right">
                  <ArrowRightBold slot="icon" aria-hidden="true" />

                  {copy.join}
                </Button>
              )
            }
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
