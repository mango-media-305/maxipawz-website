---
import ArrowRightBold from 'phosphor-astro/ArrowRightBold.astro';
import CheckCircleFill from 'phosphor-astro/CheckCircleFill.astro';
import PawPrintBold from 'phosphor-astro/PawPrintBold.astro';

import LandingHeroCarousel from './LandingHeroCarousel';

import type {
    LandingHeroImage,
} from './LandingHeroCarousel';

import AddToCartButton from '../cart/AddToCartButton';

import ProductImage from '../products/ProductImage.astro';

import Button from '../ui/Button.astro';

import type {
    Product,
    ProductImage as ProductImageData,
    ProductPrice,
} from '../../types/product';

import type {
    ResolvedProductLandingPage,
} from '../../utils/product-landing-pages';

import {
    formatPetType,
    formatProductDimensions,
    formatProductPrice,
    getCategoryLabel,
} from '../../utils/products';

interface Props {
    landingPage:
        ResolvedProductLandingPage;
}

const {
    landingPage,
} = Astro.props as Props;

const product =
    landingPage.product;

const productPageHref =
    `/shop/${product.slug}`;

function getImage(
    index = 0,
):
    | ProductImageData
    | undefined {
    return (
        product.images[index] ??
        product.images[0]
    );
}

function getGalleryImages():
    ProductImageData[] {
    const indexes =
        landingPage.gallery
        ?.imageIndexes ??
        product.images.map(
        (_, index) =>
            index,
        );

    return indexes
        .map(
        (index) =>
            product.images[
            index
            ],
        )
        .filter(
        (
            image,
        ): image is ProductImageData =>
            Boolean(
                image,
            ),
        );
}

function getStartingPrice(
    productValue: Product,
):
    | ProductPrice
    | undefined {
    const prices = [
        productValue.price,

        ...(productValue.variants ??
        []).map(
        (variant) =>
            variant.price,
        ),
    ].filter(
        (
        price,
        ): price is ProductPrice =>
        Boolean(
            price,
        ),
    );

    if (
        prices.length === 0
    ) {
        return undefined;
    }

    return prices.reduce(
        (
        lowest,
        current,
        ) =>
        current.amount <
        lowest.amount
            ? current
            : lowest,
    );
}

function toHeroImage(
    image:
        ProductImageData,
): LandingHeroImage {
    if (
        typeof image.src ===
        'string'
    ) {
        return {
        src:
            image.src,

        alt:
            image.alt,

        width:
            image.width,

        height:
            image.height,

        position:
            image.position,
        };
    }

    return {
        src:
        image.src.src,

        alt:
        image.alt,

        width:
        image.src.width,

        height:
        image.src.height,

        position:
        image.position,
    };
}

const heroImages =
    product.images.map(
        toHeroImage,
    );

const purchaseImage =
    getImage(
        landingPage.purchase
        .imageIndex ??
        0,
    );

const galleryImages =
    getGalleryImages();

const startingPrice =
    getStartingPrice(
        product,
    );

const dimensions =
    formatProductDimensions(
        product.dimensions,
    );

const categoryLabel =
    getCategoryLabel(
        product.category,
    );

const specificationRows = [
    {
        label:
        'Category',

        value:
        categoryLabel,
    },

    {
        label:
        'For',

        value:
        product.petTypes
            .map(
            formatPetType,
            )
            .join(
            ', ',
            ),
    },

    product.materials &&
    product.materials.length >
        0
        ? {
            label:
            'Materials',

            value:
            product.materials.join(
                ', ',
            ),
        }
        : undefined,

    dimensions
        ? {
            label:
            'Dimensions',

            value:
            dimensions,
        }
        : undefined,

    product.variants &&
    product.variants.length >
        0
        ? {
            label:
            'Options',

            value:
            product.variants
                .map(
                (variant) =>
                    variant.label,
                )
                .join(
                ', ',
                ),
        }
        : undefined,
].filter(
    (
        row,
    ): row is {
        label: string;
        value: string;
    } =>
        Boolean(
        row,
        ),
);
---

<article>
    {
        landingPage.hero.style ===
        'cinematic' ? (
        <section
            class="bg-cream-soft py-5 sm:py-7 lg:py-9"
        >
            <div
            class="site-container-wide"
            >
            <div
                class="relative isolate min-h-168 overflow-hidden rounded-4xl bg-ink-950 shadow-card sm:min-h-184 lg:min-h-192"
            >
                <LandingHeroCarousel
                images={heroImages}
                productName={product.name}
                client:load
                />

                <div
                class="pointer-events-none absolute inset-0 z-10 bg-linear-to-r from-ink-950/90 via-ink-950/55 to-transparent"
                aria-hidden="true"
                >
                </div>

                <div
                class="pointer-events-none absolute inset-0 z-10 bg-linear-to-t from-ink-950/90 via-ink-950/20 to-ink-950/15"
                aria-hidden="true"
                >
                </div>

                <div
                class="relative z-20 flex min-h-168 items-end px-5 pt-24 pb-12 sm:min-h-184 sm:px-8 sm:pb-14 lg:min-h-192 lg:px-12 lg:pb-16"
                >
                <div
                    class="max-w-3xl"
                >
                    {
                    landingPage.hero
                        .eyebrow && (
                        <p
                        class="text-xs font-extrabold tracking-[0.14em] text-accent-300 uppercase"
                        >
                        {
                            landingPage
                            .hero
                            .eyebrow
                        }
                        </p>
                    )
                    }

                    <h1
                    class="mt-4 max-w-3xl text-5xl leading-[0.96] text-white sm:text-6xl lg:text-7xl xl:text-[5.5rem]"
                    >
                    {
                        landingPage.hero
                        .headline
                    }
                    </h1>

                    <p
                    class="mt-6 max-w-2xl text-base leading-7 text-white/85 sm:text-lg sm:leading-8"
                    >
                    {
                        landingPage.hero
                        .description
                    }
                    </p>

                    {
                    startingPrice && (
                        <p
                        class="mt-5 text-lg font-extrabold text-white"
                        >
                        From{' '}

                        <span
                            class="text-2xl text-accent-300"
                        >
                            {
                            formatProductPrice(
                                startingPrice,
                            )
                            }
                        </span>
                        </p>
                    )
                    }

                    <div
                    class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap"
                    >
                    <Button
                        href={productPageHref}
                        variant="primary"
                        size="lg"
                        iconPosition="right"
                    >
                        <ArrowRightBold
                        slot="icon"
                        aria-hidden="true"
                        />

                        {
                        landingPage.hero
                            .primaryCtaLabel
                        }
                    </Button>

                    {
                        landingPage.hero
                        .secondaryCtaLabel && (
                        <a
                            href="#story"
                            class="inline-flex min-h-12 items-center justify-center rounded-full border border-white/35 bg-white/10 px-6 text-base font-extrabold text-white backdrop-blur-sm transition hover:-translate-y-0.5 hover:bg-white/18"
                        >
                            {
                            landingPage
                                .hero
                                .secondaryCtaLabel
                            }
                        </a>
                        )
                    }

                    <a
                        href={productPageHref}
                        class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full px-4 text-sm font-extrabold text-white transition hover:gap-3 hover:text-accent-200"
                    >
                        View complete product page

                        <ArrowRightBold
                        class="size-4"
                        aria-hidden="true"
                        />
                    </a>
                    </div>
                </div>
                </div>
            </div>
            </div>
        </section>
        ) : (
        <section
            class="bg-cream-soft py-8 sm:py-10 lg:py-12"
        >
            <div
            class="site-container-wide grid min-h-[70svh] items-center gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16"
            >
            <div>
                {
                landingPage.hero
                    .eyebrow && (
                    <p
                    class="text-xs font-extrabold tracking-[0.14em] text-brand-700 uppercase"
                    >
                    {
                        landingPage.hero
                        .eyebrow
                    }
                    </p>
                )
                }

                <h1
                class="mt-4 text-5xl leading-[0.96] text-ink-950 sm:text-6xl lg:text-7xl"
                >
                {
                    landingPage.hero
                    .headline
                }
                </h1>

                <p
                class="mt-6 max-w-xl text-base leading-7 text-ink-600 sm:text-lg sm:leading-8"
                >
                {
                    landingPage.hero
                    .description
                }
                </p>

                {
                startingPrice && (
                    <p
                    class="mt-5 text-xl font-black text-ink-950"
                    >
                    From{' '}

                    {
                        formatProductPrice(
                        startingPrice,
                        )
                    }
                    </p>
                )
                }

                <div
                class="mt-8 flex flex-col gap-3 sm:flex-row"
                >
                <Button
                    href={productPageHref}
                    variant="primary"
                    size="lg"
                    iconPosition="right"
                >
                    <ArrowRightBold
                    slot="icon"
                    aria-hidden="true"
                    />

                    {
                    landingPage.hero
                        .primaryCtaLabel
                    }
                </Button>

                {
                    landingPage.hero
                    .secondaryCtaLabel && (
                    <Button
                        href="#story"
                        variant="ghost"
                        size="lg"
                    >
                        {
                        landingPage
                            .hero
                            .secondaryCtaLabel
                        }
                    </Button>
                    )
                }
                </div>
            </div>

            <div
                class="relative min-h-120 overflow-hidden rounded-4xl bg-ink-950 shadow-card sm:min-h-152 lg:min-h-176"
            >
                <LandingHeroCarousel
                images={heroImages}
                productName={product.name}
                client:load
                />
            </div>
            </div>
        </section>
        )
    }

    {
        landingPage.highlights &&
        landingPage.highlights
            .length > 0 && (
            <section
            class="border-y border-sand bg-white-warm"
            aria-label="Product highlights"
            >
            <div
                class="site-container-wide grid md:grid-cols-3"
            >
                {
                landingPage
                    .highlights
                    .map(
                    (
                        highlight,
                        index,
                    ) => (
                        <div
                        class:list={[
                            'py-8 md:px-8 md:py-10',

                            index > 0
                            ? 'border-t border-sand md:border-t-0 md:border-l'
                            : '',
                        ]}
                        >
                        {
                            highlight.eyebrow && (
                            <p
                                class="text-xs font-extrabold tracking-[0.14em] text-accent-600 uppercase"
                            >
                                {
                                highlight.eyebrow
                                }
                            </p>
                            )
                        }

                        <h2
                            class="mt-2 text-2xl text-ink-950 sm:text-3xl"
                        >
                            {
                            highlight.title
                            }
                        </h2>

                        {
                            highlight.description && (
                            <p
                                class="mt-3 text-sm leading-6 text-ink-600"
                            >
                                {
                                highlight.description
                                }
                            </p>
                            )
                        }
                        </div>
                    ),
                    )
                }
            </div>

            <div
                class="border-t border-sand"
            >
                <div
                class="site-container-wide flex flex-col items-start justify-between gap-5 py-6 sm:flex-row sm:items-center"
                >
                <div>
                    <p
                    class="font-extrabold text-ink-900"
                    >
                    Want sizing, variants, pricing, and complete product information?
                    </p>

                    <p
                    class="mt-1 text-sm text-ink-600"
                    >
                    Everything is available on the full product page.
                    </p>
                </div>

                <Button
                    href={productPageHref}
                    variant="secondary"
                    size="md"
                    iconPosition="right"
                >
                    <ArrowRightBold
                    slot="icon"
                    aria-hidden="true"
                    />

                    View Product
                </Button>
                </div>
            </div>
            </section>
        )
    }

    {
        landingPage.story &&
        landingPage.story
            .length > 0 && (
            <section
            id="story"
            class="bg-paper"
            >
            {
                landingPage.story.map(
                (
                    storyBlock,
                    index,
                ) => {
                    const storyImage =
                    getImage(
                        storyBlock.imageIndex ??
                        0,
                    );

                    const imageOnRight =
                    storyBlock.imageSide ===
                    'right';

                    return (
                    <div
                        class:list={[
                        'site-container-wide py-8 sm:py-10 lg:grid lg:grid-cols-2 lg:items-center lg:gap-16 lg:py-24',

                        index > 0
                            ? 'border-t border-sand/70'
                            : '',
                        ]}
                    >
                        <!--
                        MOBILE:
                        Full image fills the entire card.
                        Text sits over the photo with a gradient.
                        -->
                        <article
                        class="relative min-h-152 overflow-hidden rounded-4xl bg-ink-950 shadow-card lg:hidden"
                        >
                        <ProductImage
                            image={storyImage}
                            fit="cover"
                            class="absolute inset-0 h-full w-full rounded-4xl"
                            imageClass="h-full w-full object-cover"
                            sizes="100vw"
                            widths={[
                            480,
                            640,
                            800,
                            960,
                            ]}
                        />

                        <div
                            class="pointer-events-none absolute inset-0 bg-linear-to-t from-ink-950/95 via-ink-950/50 to-ink-950/5"
                            aria-hidden="true"
                        >
                        </div>

                        <div
                            class="relative z-10 flex min-h-152 items-end p-6 sm:p-8"
                        >
                            <div>
                            {
                                storyBlock.eyebrow && (
                                <p
                                    class="text-xs font-extrabold tracking-[0.14em] text-brand-200 uppercase"
                                >
                                    {
                                    storyBlock
                                        .eyebrow
                                    }
                                </p>
                                )
                            }

                            <h2
                                class="mt-4 text-4xl leading-none text-white sm:text-5xl"
                            >
                                {
                                storyBlock.title
                                }
                            </h2>

                            <div
                                class="mt-5 space-y-3 text-sm leading-6 text-white/85 sm:text-base sm:leading-7"
                            >
                                {
                                storyBlock.body.map(
                                    (
                                    paragraph,
                                    ) => (
                                    <p>
                                        {
                                        paragraph
                                        }
                                    </p>
                                    ),
                                )
                                }
                            </div>

                            {
                                storyBlock.bullets &&
                                storyBlock.bullets
                                    .length > 0 && (
                                    <ul
                                    class="mt-5 space-y-2.5"
                                    >
                                    {
                                        storyBlock
                                        .bullets
                                        .map(
                                            (
                                            bullet,
                                            ) => (
                                            <li
                                                class="flex items-start gap-3 font-extrabold text-white"
                                            >
                                                <CheckCircleFill
                                                class="mt-0.5 size-5 shrink-0 text-brand-300"
                                                aria-hidden="true"
                                                />

                                                <span>
                                                {
                                                    bullet
                                                }
                                                </span>
                                            </li>
                                            ),
                                        )
                                    }
                                    </ul>
                                )
                            }

                            <a
                                href={productPageHref}
                                class="mt-7 inline-flex min-h-11 items-center gap-2 rounded-full border border-white/30 bg-white/15 px-5 text-sm font-extrabold text-white backdrop-blur-sm transition hover:gap-3 hover:bg-white/25"
                            >
                                View {product.name}

                                <ArrowRightBold
                                class="size-4"
                                aria-hidden="true"
                                />
                            </a>
                            </div>
                        </div>
                        </article>

                        <!--
                        DESKTOP:
                        Preserve the editorial image + text layout
                        from the current design.
                        -->
                        <figure
                        class:list={[
                            'hidden overflow-hidden rounded-4xl bg-cream-soft shadow-card lg:block',

                            imageOnRight
                            ? 'lg:order-2'
                            : '',
                        ]}
                        >
                        <ProductImage
                            image={storyImage}
                            fit="cover"
                            class="aspect-4/5 h-full w-full rounded-4xl"
                            imageClass="h-full w-full object-cover"
                            sizes="48vw"
                            widths={[
                            640,
                            800,
                            960,
                            1200,
                            ]}
                        />
                        </figure>

                        <div
                        class:list={[
                            'hidden max-w-xl lg:block',

                            imageOnRight
                            ? 'lg:order-1'
                            : '',
                        ]}
                        >
                        {
                            storyBlock.eyebrow && (
                            <p
                                class="text-xs font-extrabold tracking-[0.14em] text-brand-700 uppercase"
                            >
                                {
                                storyBlock
                                    .eyebrow
                                }
                            </p>
                            )
                        }

                        <h2
                            class="mt-4 text-4xl leading-none text-ink-950 sm:text-5xl"
                        >
                            {
                            storyBlock.title
                            }
                        </h2>

                        <div
                            class="mt-6 space-y-4 text-base leading-7 text-ink-600 sm:text-lg sm:leading-8"
                        >
                            {
                            storyBlock.body.map(
                                (
                                paragraph,
                                ) => (
                                <p>
                                    {
                                    paragraph
                                    }
                                </p>
                                ),
                            )
                            }
                        </div>

                        {
                            storyBlock.bullets &&
                            storyBlock.bullets
                                .length > 0 && (
                                <ul
                                class="mt-7 space-y-3"
                                >
                                {
                                    storyBlock
                                    .bullets
                                    .map(
                                        (
                                        bullet,
                                        ) => (
                                        <li
                                            class="flex items-start gap-3 font-extrabold text-ink-800"
                                        >
                                            <CheckCircleFill
                                            class="mt-0.5 size-5 shrink-0 text-brand-500"
                                            aria-hidden="true"
                                            />

                                            <span>
                                            {
                                                bullet
                                            }
                                            </span>
                                        </li>
                                        ),
                                    )
                                }
                                </ul>
                            )
                        }

                        <Button
                            href={productPageHref}
                            variant="secondary"
                            size="md"
                            iconPosition="right"
                            class="mt-8"
                        >
                            <ArrowRightBold
                            slot="icon"
                            aria-hidden="true"
                            />

                            View {product.name}
                        </Button>
                        </div>
                    </div>
                    );
                },
                )
            }
            </section>
        )
    }

    {
        landingPage.gallery &&
        galleryImages.length >
            0 && (
            <section
            id="gallery"
            class="bg-cream-soft py-16 sm:py-20 lg:py-24"
            >
            <div
                class="site-container-wide"
            >
                <div
                class="flex flex-col items-start justify-between gap-6 lg:flex-row lg:items-end"
                >
                <div
                    class="max-w-3xl"
                >
                    {
                    landingPage.gallery
                        .eyebrow && (
                        <p
                        class="text-xs font-extrabold tracking-[0.14em] text-accent-600 uppercase"
                        >
                        {
                            landingPage
                            .gallery
                            .eyebrow
                        }
                        </p>
                    )
                    }

                    <h2
                    class="mt-4 text-4xl text-ink-950 sm:text-5xl lg:text-6xl"
                    >
                    {
                        landingPage.gallery
                        .title
                    }
                    </h2>

                    {
                    landingPage.gallery
                        .description && (
                        <p
                        class="mt-5 max-w-2xl text-base leading-7 text-ink-600 sm:text-lg"
                        >
                        {
                            landingPage
                            .gallery
                            .description
                        }
                        </p>
                    )
                    }
                </div>

                <Button
                    href={productPageHref}
                    variant="primary"
                    size="md"
                    iconPosition="right"
                >
                    <ArrowRightBold
                    slot="icon"
                    aria-hidden="true"
                    />

                    Shop {product.name}
                </Button>
                </div>

                <div
                class="mt-10 grid gap-4 md:grid-cols-12 md:auto-rows-64 lg:auto-rows-80"
                >
                {
                    galleryImages.map(
                    (
                        image,
                        index,
                    ) => {
                        const isOnlyImage =
                        galleryImages.length ===
                        1;

                        let gridClasses =
                        'md:col-span-6';

                        if (
                        isOnlyImage
                        ) {
                        gridClasses =
                            'md:col-span-12 md:row-span-2';
                        } else if (
                        index === 0
                        ) {
                        gridClasses =
                            'md:col-span-7 md:row-span-2';
                        } else if (
                        index === 1 ||
                        index === 2
                        ) {
                        gridClasses =
                            'md:col-span-5';
                        }

                        return (
                        <figure
                            class={`relative min-h-72 overflow-hidden rounded-4xl bg-white-warm shadow-card ${gridClasses}`}
                        >
                            <ProductImage
                            image={image}
                            fit="cover"
                            class="absolute inset-0 h-full w-full rounded-4xl"
                            imageClass="h-full w-full object-cover"
                            sizes="(min-width: 768px) 60vw, 100vw"
                            widths={[
                                480,
                                720,
                                960,
                                1200,
                            ]}
                            />
                        </figure>
                        );
                    },
                    )
                }
                </div>
            </div>
            </section>
        )
    }

    <section
        class="bg-ink-950 py-16 text-white sm:py-20 lg:py-24"
        aria-labelledby="landing-specifications-title"
    >
        <div
        class="site-container-wide grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20"
        >
        <div>
            <p
            class="text-xs font-extrabold tracking-[0.14em] text-accent-300 uppercase"
            >
            Product details
            </p>

            <h2
            id="landing-specifications-title"
            class="mt-4 text-4xl text-white sm:text-5xl"
            >
            The details that matter.
            </h2>

            <p
            class="mt-5 max-w-md text-base leading-7 text-white/65"
            >
            Practical specifications stay easy to scan without competing with the product story above.
            </p>

            <a
            href={productPageHref}
            class="mt-7 inline-flex min-h-11 items-center gap-2 rounded-full border border-white/25 bg-white/10 px-5 text-sm font-extrabold text-white transition hover:gap-3 hover:bg-white/18"
            >
            See full product details

            <ArrowRightBold
                class="size-4"
                aria-hidden="true"
            />
            </a>
        </div>

        <dl>
            {
            specificationRows.map(
                (
                row,
                ) => (
                <div
                    class="grid gap-2 border-t border-white/15 py-5 sm:grid-cols-[11rem_1fr] sm:gap-8"
                >
                    <dt
                    class="text-xs font-extrabold tracking-[0.12em] text-white/50 uppercase"
                    >
                    {
                        row.label
                    }
                    </dt>

                    <dd
                    class="text-base font-bold leading-7 text-white/90"
                    >
                    {
                        row.value
                    }
                    </dd>
                </div>
                ),
            )
            }
        </dl>
        </div>
    </section>

    <section
        id="buy"
        class="bg-accent-50 py-16 sm:py-20 lg:py-24"
    >
        <div
