---
import type { ImageMetadata } from 'astro';

import { Image } from 'astro:assets';

import PawPrintBold from 'phosphor-astro/PawPrintBold.astro';

import type { ProductImage, ProductImagePosition } from '../../types/product';

interface Props {
    image?: ProductImage;

    eager?: boolean;

    sizes?: string;

    widths?: number[];

    quality?: number;

    class?: string;
}

const {
    image,

    eager = false,

    sizes = '(min-width: 1024px) 50vw, 100vw',

    widths = [480, 640, 800, 960, 1200],

    quality = 82,

    class: className = '',
} = Astro.props as Props;

function getObjectPosition(position: ProductImagePosition = 'center'): string {
    switch (position) {
        case 'top':
        return 'center top';

        case 'bottom':
        return 'center bottom';

        case 'left':
        return 'left center';

        case 'right':
        return 'right center';

        case 'center':
        default:
        return 'center center';
    }
}

const objectPosition = getObjectPosition(image?.position ?? 'center');

const imageStyle = [
    'position: absolute',
    'inset: 0',
    'display: block',
    'width: 100%',
    'height: 100%',
    'max-width: none',
    'object-fit: cover',
    `object-position: ${objectPosition}`,
].join('; ');

function getResponsiveWidths(sourceWidth: number): number[] {
    const validWidths = widths
        .filter((width) => Number.isFinite(width) && width > 0 && width <= sourceWidth)
        .map((width) => Math.round(width));

    if (validWidths.length === 0) {
        return [sourceWidth];
    }

    return Array.from(new Set(validWidths)).sort(
        (firstWidth, secondWidth) => firstWidth - secondWidth,
    );
}

const responsiveWidths = image
    ? getResponsiveWidths(typeof image.src === 'string' ? image.width : image.src.width)
    : [];
---

{
    image ? (
        typeof image.src === 'string' ? (
        <img
            src={image.src}
            alt={image.alt}
            width={image.width}
            height={image.height}
            loading={eager ? 'eager' : 'lazy'}
            decoding="async"
            fetchpriority={eager ? 'high' : 'auto'}
            class:list={['landing-cover-image', className]}
            style={imageStyle}
        />
        ) : (
        <Image
            src={image.src as ImageMetadata}
            alt={image.alt}
            loading={eager ? 'eager' : 'lazy'}
            decoding="async"
            fetchpriority={eager ? 'high' : 'auto'}
            widths={responsiveWidths}
            sizes={sizes}
            quality={quality}
            class:list={['landing-cover-image', className]}
            style={imageStyle}
        />
        )
    ) : (
        <div
        class="absolute inset-0 grid place-items-center bg-linear-to-br from-brand-50 via-cream-soft to-accent-50 p-8 text-center"
        aria-label="Product image coming soon"
        >
        <div>
            <span
            class="mx-auto grid size-16 place-items-center rounded-full border border-brand-200 bg-white-warm text-brand-600 shadow-soft"
            aria-hidden="true"
            >
            <PawPrintBold class="size-8" />
            </span>

            <p class="mt-4 text-sm font-extrabold text-ink-600">Product image coming soon</p>
        </div>
        </div>
    )
}