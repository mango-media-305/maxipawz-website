---
import FaqItem from './FaqItem.astro';

import type { FaqGroup as FaqGroupData, FaqGroupTone } from '../../data/faq';

interface Props {
  group: FaqGroupData;
  openFirst?: boolean;
}

const { group, openFirst = false } = Astro.props;

const surfaceClasses: Record<FaqGroupTone, string> = {
  brand: [
    'border-brand-200',
    'bg-linear-to-br',
    'from-brand-50',
    'via-white-warm',
    'to-brand-100/55',
  ].join(' '),

  accent: [
    'border-accent-200',
    'bg-linear-to-br',
    'from-accent-50',
    'via-white-warm',
    'to-accent-100/55',
  ].join(' '),

  sand: [
    'border-sand-dark/70',
    'bg-linear-to-br',
    'from-cream-soft',
    'via-white-warm',
    'to-sand/55',
  ].join(' '),
};

const iconClasses: Record<FaqGroupTone, string> = {
  brand: 'bg-brand-500 text-white shadow-blue',

  accent: 'bg-accent-500 text-ink-950 shadow-orange',

  sand: 'bg-ink-800 text-white shadow-soft',
};
---

<section id={group.id} class="scroll-mt-28" aria-labelledby={`${group.id}-title`}>
  <div
    class:list={[
      'relative overflow-hidden rounded-card-lg border p-5 shadow-sm',
      'sm:p-6 lg:p-7',
      surfaceClasses[group.tone],
    ]}
  >
    <div
      class="pointer-events-none absolute -top-20 -right-20 size-52 rounded-full bg-white/65 blur-3xl"
      aria-hidden="true"
    >
    </div>

    <div class="relative">
      <header class="flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between">
        <div class="flex items-start gap-4">
          <span
            class:list={[
              'grid size-12 shrink-0 place-items-center rounded-2xl',
              '[&>svg]:size-6',
              iconClasses[group.tone],
            ]}
            aria-hidden="true"
          >
            <slot name="icon" />
          </span>

          <div class="max-w-2xl">
            <p class="text-xs font-extrabold tracking-[0.09em] text-ink-500 uppercase">
              {group.eyebrow}
            </p>

            <h2 id={`${group.id}-title`} class="mt-2 text-2xl text-ink-900 sm:text-3xl">
              {group.title}
            </h2>

            <p class="mt-3 text-sm leading-6 text-ink-600 sm:text-base">
              {group.description}
            </p>
          </div>
        </div>
      </header>

      <div class="mt-6 grid gap-3">
        {group.items.map((item, index) => <FaqItem item={item} open={openFirst && index === 0} />)}
      </div>
    </div>
  </div>
</section>
