---
const apiKey = import.meta.env.PUBLIC_POSTHOG_KEY?.trim() ?? '';
const apiHost = import.meta.env.PUBLIC_POSTHOG_HOST?.trim() ?? '';

const analyticsEnabled =
  import.meta.env.PUBLIC_ANALYTICS_ENABLED?.trim().toLowerCase() === 'true';

const robotsNoIndex =
  import.meta.env.PUBLIC_ROBOTS_NOINDEX?.trim().toLowerCase() === 'true';

const deploymentContext = process.env.CONTEXT?.trim().toLowerCase() ?? '';

const shouldLoadPostHog =
  import.meta.env.PROD &&
  analyticsEnabled &&
  !robotsNoIndex &&
  (deploymentContext === '' || deploymentContext === 'production') &&
  Boolean(apiKey && apiHost);
---

{
  shouldLoadPostHog && (
    <script
      id="maxipawz-posthog-bootstrap"
      is:inline
      define:vars={{ apiKey, apiHost }}
    >
      (() => {
        // A production build can also be served locally or on a preview URL.
        // Only the canonical public origin may initialize this project.
        if (window.location.origin !== 'https://maxipawz.com') {
          return;
        }

        if (window.__maxipawzPostHogInitialized) {
          return;
        }

        window.__maxipawzPostHogInitialized = true;

        (function (t, e) {
          let o, n, p, r;
          if (e.__SV) return;
          window.posthog = e;
          e._i = [];
          e.init = function (i, s, a) {
            function g(t, e) {
              const o = e.split('.');
              if (o.length === 2) {
                t = t[o[0]];
                e = o[1];
              }
              t[e] = function (...args) {
                t.push([e].concat(args));
              };
            }

            p = t.createElement('script');
            p.type = 'text/javascript';
            p.crossOrigin = 'anonymous';
            p.async = true;
            p.src = s.api_host + '/static/array.js';

            r = t.getElementsByTagName('script')[0];
            r.parentNode.insertBefore(p, r);

            let u = e;
            if (a !== undefined) {
              u = e[a] = [];
            } else {
              a = 'posthog';
            }

            u.people = u.people || [];

            u.toString = function (t) {
              let e = 'posthog';
              if (a !== 'posthog') e += '.' + a;
              if (!t) e += ' (stub)';
              return e;
            };

            u.people.toString = function () {
              return u.toString(1) + '.people (stub)';
            };

            o = 'capture identify alias people.set people.set_once set_config register register_once unregister opt_out_capturing has_opted_out_capturing opt_in_capturing reset isFeatureEnabled onFeatureFlags getFeatureFlag getFeatureFlagPayload reloadFeatureFlags group updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures getActiveMatchingSurveys getSurveys getNextSurveyStep onSessionId'.split(
              ' ',
            );

            for (n = 0; n < o.length; n += 1) g(u, o[n]);

            e._i.push([i, s, a]);
          };

          e.__SV = 1;
        })(document, window.posthog || []);

        window.posthog.init(apiKey, {
          api_host: apiHost,
          defaults: '2026-05-30',
          capture_exceptions: {
            capture_unhandled_errors: true,
            capture_unhandled_rejections: true,
            capture_console_errors: false,
          },
          tracing_headers: [window.location.hostname],
        });
      })();
    </script>
  )
}