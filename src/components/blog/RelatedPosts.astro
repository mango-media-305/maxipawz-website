---
import ArrowRightBold from 'phosphor-astro/ArrowRightBold.astro';
import PawPrintBold from 'phosphor-astro/PawPrintBold.astro';

import {
  getLocaleFromPathname,
} from '../../i18n/languages';

interface RelatedPost {
  href:
    string;

  title:
    string;

  description:
    string;

  category:
    string;

  image: {
    src:
      string;

    alt:
      string;
  };
}

interface Props {
  posts?:
    RelatedPost[];
}

const {
  posts = [],
} =
  Astro.props;

const locale =
  getLocaleFromPathname(
    Astro.url.pathname,
  );

const spanish =
  locale === 'es';

const eyebrow =
  spanish
    ? 'Continúa aprendiendo'
    : 'Continue Learning';

const heading =
  spanish
    ? 'Guías relacionadas de Maxi Pawz'
    : 'Related Maxi Pawz guides';

const readLabel =
  spanish
    ? 'Leer guía'
    : 'Read guide';
---

{
  posts.length >
    0 && (
    <section
      class="mt-12"
      aria-labelledby="related-posts-title"
    >
      <div class="flex items-center gap-4">
        <span
          class="grid size-12 shrink-0 place-items-center rounded-2xl bg-accent-500 text-ink-950 shadow-orange"
          aria-hidden="true"
        >
          <PawPrintBold class="size-6" />
        </span>

        <div>
          <p class="text-xs font-extrabold tracking-[0.09em] text-accent-700 uppercase">
            {eyebrow}
          </p>

          <h2
            id="related-posts-title"
            class="mt-2 text-3xl text-ink-900 sm:text-4xl"
          >
            {heading}
          </h2>
        </div>
      </div>

      <div class="mt-7 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
        {
          posts.map(
            (
              post,
            ) => (
              <a
                href={post.href}
                class="group overflow-hidden rounded-3xl border border-sand bg-white-warm shadow-soft transition hover:-translate-y-1 hover:border-brand-300 hover:shadow-card"
              >
                <div class="aspect-[16/10] overflow-hidden bg-cream-soft">
                  <img
                    src={post.image.src}
                    alt={post.image.alt}
                    loading="lazy"
                    decoding="async"
                    class="size-full object-cover transition duration-300 group-hover:scale-[1.025]"
                  />
                </div>

                <div class="p-5">
                  <p class="text-xs font-extrabold tracking-[0.09em] text-brand-700 uppercase">
                    {post.category}
                  </p>

                  <h3 class="mt-2 text-xl text-ink-900">
                    {post.title}
                  </h3>

                  <p class="mt-3 text-sm leading-6 text-ink-600">
                    {post.description}
                  </p>

                  <span class="mt-5 inline-flex items-center gap-2 text-sm font-extrabold text-brand-700 transition group-hover:gap-3 group-hover:text-brand-800">
                    {readLabel}

                    <ArrowRightBold
                      class="size-4"
                      aria-hidden="true"
                    />
                  </span>
                </div>
              </a>
            ),
          )
        }
      </div>
    </section>
  )
}