---
import ArrowRightBold from 'phosphor-astro/ArrowRightBold.astro';

import type { LifestyleCategoryTone } from '../../data/homepage';

interface Props {
    title: string;
    description: string;
    href: string;
    linkLabel: string;
    tone?: LifestyleCategoryTone;
    class?: string;
}

const { title, description, href, linkLabel, tone = 'brand', class: className = '' } = Astro.props;

const toneClasses: Record<LifestyleCategoryTone, string> = {
    brand: [
        'border-brand-200',
        'bg-linear-to-br from-brand-50 via-white-warm to-brand-100/70',
        'hover:border-brand-300',
    ].join(' '),

    accent: [
        'border-accent-200',
        'bg-linear-to-br from-accent-50 via-white-warm to-accent-100/70',
        'hover:border-accent-300',
    ].join(' '),

    sand: [
        'border-sand-dark/70',
        'bg-linear-to-br from-cream-soft via-white-warm to-sand/65',
        'hover:border-sand-dark',
    ].join(' '),
};

const iconClasses: Record<LifestyleCategoryTone, string> = {
    brand: 'bg-brand-500 text-white shadow-blue',
    accent: 'bg-accent-500 text-ink-950 shadow-orange',
    sand: 'bg-ink-800 text-white shadow-soft',
};
---

<article
    class:list={[
        'group relative flex h-full flex-col overflow-hidden rounded-card border p-5 shadow-sm',
        'transition duration-300 hover:-translate-y-1 hover:shadow-card',
        toneClasses[tone],
        className,
    ]}
>
    <div
        class="pointer-events-none absolute -top-14 -right-14 size-36 rounded-full bg-white/65 blur-2xl transition duration-300 group-hover:scale-125"
        aria-hidden="true"
    >
    </div>

    <div class="relative flex h-full flex-col">
        <span
        class:list={[
            'grid size-12 shrink-0 place-items-center rounded-2xl transition duration-300',
            'group-hover:rotate-3 group-hover:scale-105 sm:size-14',
            '[&>svg]:size-6 sm:[&>svg]:size-7',
            iconClasses[tone],
        ]}
        aria-hidden="true"
        >
        <slot name="icon" />
        </span>

        <h3 class="mt-5 text-xl text-ink-900 sm:text-2xl">
        {title}
        </h3>

        <p class="mt-3 flex-1 text-sm leading-6 text-ink-600">
        {description}
        </p>

        <a
        href={href}
        class="mt-5 inline-flex w-fit items-center gap-2 rounded-full font-extrabold text-brand-700 transition duration-200 hover:gap-3 hover:text-brand-800"
        aria-label={`${linkLabel}: ${title}`}
        >
        <span>{linkLabel}</span>

        <ArrowRightBold class="size-4" aria-hidden="true" />
        </a>
    </div>
</article>
