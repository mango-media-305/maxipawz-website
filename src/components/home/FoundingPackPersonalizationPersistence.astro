<script>
    import {
        createFoundingPackPersonalizationProfile,
        serializeFoundingPackPersonalizationProfile,
    } from '../../lib/founding-pack-personalization';

    import {
        FOUNDING_PACK_PERSONALIZATION_STORAGE_KEY,
        type FoundingPackPersonalizationProfile,
    } from '../../types/founding-pack-personalization';

    import type {
        FoundingPackLaunchInterest,
        FoundingPackPetPersonality,
        FoundingPackPetType,
    } from '../../types/founding-pack';

    interface PendingPetProfile {
        petName: string;
        petType: FoundingPackPetType;
        petPersonality?: FoundingPackPetPersonality;
        launchInterest?: FoundingPackLaunchInterest;
    }

    const PERSONALIZATION_SAVED_EVENT = 'maxipawz:founding-pet-personalization-saved';
    const initializedSections = new WeakSet<HTMLElement>();

    const capturePendingProfile = (form: HTMLFormElement): PendingPetProfile | null => {
        const petName = form.querySelector<HTMLInputElement>('[name="pet-name"]')?.value.trim();
        const petType = form.querySelector<HTMLSelectElement>('[name="pet-type"]')?.value.trim();
        const petPersonality = form
        .querySelector<HTMLSelectElement>('[name="pet-personality"]')
        ?.value.trim();
        const launchInterest = form
        .querySelector<HTMLInputElement>('[name="launch-interest"]:checked')
        ?.value.trim();

        if (!petName || !petType) return null;

        return {
        petName,
        petType: petType as FoundingPackPetType,
        ...(petPersonality ? { petPersonality: petPersonality as FoundingPackPetPersonality } : {}),
        ...(launchInterest ? { launchInterest: launchInterest as FoundingPackLaunchInterest } : {}),
        };
    };

    const persistProfile = (
        pendingProfile: PendingPetProfile,
    ): FoundingPackPersonalizationProfile | null => {
        try {
        const profile = createFoundingPackPersonalizationProfile(pendingProfile);

        window.localStorage.setItem(
            FOUNDING_PACK_PERSONALIZATION_STORAGE_KEY,
            serializeFoundingPackPersonalizationProfile(profile),
        );

        return profile;
        } catch {
        // Browser personalization must not interfere with a successful server save.
        return null;
        }
    };

    const initializePersonalizationPersistence = (): void => {
        const sections = document.querySelectorAll<HTMLElement>('[data-launch-signup]');

        for (const section of sections) {
        if (initializedSections.has(section)) continue;

        const profileForm = section.querySelector<HTMLFormElement>('[data-pet-profile-form]');
        const completeStep = section.querySelector<HTMLElement>(
            '[data-founding-pack-step="complete"]',
        );
        const profileStep = section.querySelector<HTMLElement>('[data-founding-pack-step="profile"]');
        const submitButton = profileForm?.querySelector<HTMLButtonElement>('button[type="submit"]');
        const skipButton = profileForm?.querySelector<HTMLButtonElement>('[data-profile-skip]');

        if (!profileForm || !completeStep || !profileStep || !skipButton || !submitButton) continue;

        initializedSections.add(section);
        let pendingProfile: PendingPetProfile | null = null;

        const handleProfileSubmit = (): void => {
            // Capture runs before LaunchSignup disables the button. A duplicate
            // submission during the request must not overwrite its original snapshot.
            if (submitButton.disabled || profileStep.hidden) return;

            pendingProfile = profileForm.checkValidity() ? capturePendingProfile(profileForm) : null;
        };

        const handleSkip = (): void => {
            if (skipButton.disabled) return;

            // A failed save can leave a pending snapshot. Skip must discard it
            // before LaunchSignup reveals the shared completion screen.
            pendingProfile = null;
        };

        const clearPendingProfile = (): void => {
            pendingProfile = null;
        };

        const persistWhenComplete = (): void => {
            if (completeStep.hidden || !pendingProfile) return;

            const profile = persistProfile(pendingProfile);
            pendingProfile = null;

            if (profile) {
            window.dispatchEvent(new CustomEvent(PERSONALIZATION_SAVED_EVENT, { detail: profile }));
            }
        };

        const observer = new MutationObserver(persistWhenComplete);
        observer.observe(completeStep, { attributes: true, attributeFilter: ['hidden'] });

        profileForm.addEventListener('submit', handleProfileSubmit, { capture: true });
        skipButton.addEventListener('click', handleSkip, { capture: true });
        profileForm.addEventListener('reset', clearPendingProfile);
        window.addEventListener('pageshow', clearPendingProfile);

        const cleanup = (): void => {
            observer.disconnect();
            profileForm.removeEventListener('submit', handleProfileSubmit, { capture: true });
            skipButton.removeEventListener('click', handleSkip, { capture: true });
            profileForm.removeEventListener('reset', clearPendingProfile);
            window.removeEventListener('pageshow', clearPendingProfile);
            pendingProfile = null;
            initializedSections.delete(section);
        };

        document.addEventListener('astro:before-swap', cleanup, { once: true });
        }
    };

    initializePersonalizationPersistence();
    document.addEventListener('astro:page-load', initializePersonalizationPersistence);
</script>
