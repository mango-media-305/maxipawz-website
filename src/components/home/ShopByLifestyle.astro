---
import ConfettiBold from 'phosphor-astro/ConfettiBold.astro';
import HeartBold from 'phosphor-astro/HeartBold.astro';
import PawPrintBold from 'phosphor-astro/PawPrintBold.astro';
import ShieldCheckBold from 'phosphor-astro/ShieldCheckBold.astro';
import ShoppingBagOpenBold from 'phosphor-astro/ShoppingBagOpenBold.astro';
import SuitcaseRollingBold from 'phosphor-astro/SuitcaseRollingBold.astro';

import CategoryCard from './CategoryCard.astro';

import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';

import { isStoreLive } from '../../config/storefront';

import { lifestyleCategories, type LifestyleCategoryIcon } from '../../data/homepage';
import { getLifestyleCategoryItems } from '../../utils/storefront-categories';

import { getLocaleFromPathname } from '../../i18n/languages';
import { localizeHref, localizedLinkLabel } from '../../i18n/routes';

const locale = getLocaleFromPathname(Astro.url.pathname);
const t = (english: string, spanish: string): string =>
  locale === 'es' ? spanish : english;

const spanishCategories: Record<string, { title: string; description: string }> = {
  'play-and-enrichment': {
    title: 'Juego y enriquecimiento',
    description: 'Juguetes, rompecabezas, productos interactivos y actividades que ayudan a mantener a las mascotas activas, curiosas y entretenidas.',
  },
  'walk-and-travel': {
    title: 'Paseos y viajes',
    description: 'Esenciales portátiles, accesorios de paseo, artículos de viaje y productos prácticos para disfrutar de aventuras cómodas juntos.',
  },
  'feeding-and-hydration': {
    title: 'Alimentación e hidratación',
    description: 'Botellas de agua, tazones, accesorios de alimentación y productos útiles para las comidas, los premios y la hidratación dentro y fuera de casa.',
  },
  'comfort-and-home': {
    title: 'Descanso y hogar',
    description: 'Productos acogedores, relajantes y prácticos para hacer más cómodos el descanso y la vida diaria en casa.',
  },
  'grooming-and-care': {
    title: 'Higiene y cuidado',
    description: 'Productos útiles y esenciales de higiene que ayudan a simplificar las rutinas de cuidado de tu mascota y hacerlas más agradables.',
  },
  'collars-and-accessories': {
    title: 'Collares y accesorios',
    description: 'Collares, accesorios para llevar puestos, productos de identificación y detalles que dan un toque personal al estilo diario de tu mascota.',
  },
};

const categoryItems = getLifestyleCategoryItems(lifestyleCategories).map((category) => {
  if (locale !== 'es') return category;

  const translated = spanishCategories[category.slug];

  if (!translated) {
    throw new Error(`Missing Spanish homepage category: ${category.slug}`);
  }

  return { ...category, ...translated };
});

const iconByCategory: Record<LifestyleCategoryIcon, typeof PawPrintBold> = {
  play: ConfettiBold,
  travel: SuitcaseRollingBold,
  hydration: HeartBold,
  comfort: PawPrintBold,
  care: ShieldCheckBold,
  accessories: ShoppingBagOpenBold,
};

function getCategoryHref(slug: string): string {
  if (!isStoreLive) {
    return '/#maxi-pawz-updates';
  }

  return `/shop?category=${encodeURIComponent(slug)}#products`;
}

const categoryLinkLabel = isStoreLive ? t('Explore category', 'Explorar categoría') : t('Get launch updates', 'Recibir novedades del lanzamiento');
---

{
  categoryItems.length > 0 && (
    <section
      id="shop-by-lifestyle"
      class="category-showcase section-spacing relative isolate overflow-hidden"
      aria-labelledby="shop-by-lifestyle-title"
      data-category-showcase
    >
      <div
        class="category-showcase__pattern pointer-events-none absolute inset-0"
        aria-hidden="true"
      />

      <div
        class="category-showcase__orb category-showcase__orb--blue pointer-events-none absolute -top-24 -left-24 size-80 rounded-full bg-brand-300/25 blur-3xl"
        aria-hidden="true"
      />

      <div
        class="category-showcase__orb category-showcase__orb--orange pointer-events-none absolute -right-28 bottom-12 size-96 rounded-full bg-accent-300/20 blur-3xl"
        aria-hidden="true"
      />

      <div
        class="category-showcase__paw category-showcase__paw--one pointer-events-none absolute top-20 right-[8%] hidden text-brand-300/35 lg:block"
        aria-hidden="true"
      >
        <PawPrintBold class="size-16 rotate-12" />
      </div>

      <div
        class="category-showcase__paw category-showcase__paw--two pointer-events-none absolute bottom-32 left-[4%] hidden text-accent-300/30 lg:block"
        aria-hidden="true"
      >
        <PawPrintBold class="size-12 -rotate-12" />
      </div>

      <div class="site-container relative z-10">
        <div class="grid items-end gap-7 lg:grid-cols-1 lg:gap-14">
          <div data-category-reveal>
            <Badge variant="brand" size="md">
              <PawPrintBold slot="icon" aria-hidden="true" />

              {isStoreLive ? t('Shop by lifestyle', 'Compra según su estilo de vida') : t('What you will find', 'Lo que encontrarás')}
            </Badge>

            <h2
              id="shop-by-lifestyle-title"
              class="mt-5 text-4xl sm:text-5xl lg:text-6xl"
            >
              {isStoreLive
                ? t('Find a category for your pet’s routine.', 'Encuentra una categoría para la rutina de tu mascota.')
                : t('Products for play, care, comfort, and everyday adventures.', 'Productos para jugar, cuidarse, descansar y vivir aventuras cada día.')}
            </h2>
          </div>

          <div
            class="lg:pb-1"
            data-category-reveal
            style="--category-reveal-delay: 90ms;"
          >
            <p>
              {isStoreLive
                ? t('Explore Maxi Pawz products based on the moments, routines, and experiences you share with your pet.', 'Explora los productos de Maxi Pawz según los momentos, rutinas y experiencias que compartes con tu mascota.')
                : t('Maxi Pawz is preparing a varied collection that supports playtime, walks, travel, feeding, hydration, comfort, care, and personal style.', 'Maxi Pawz está preparando una colección variada para acompañar el juego, los paseos, los viajes, la alimentación, la hidratación, el descanso, el cuidado y el estilo de tu mascota.')}
            </p>
          </div>
        </div>

        <div
          class:list={[
            'mt-8 grid gap-5 lg:mt-10 lg:gap-6',
            categoryItems.length === 1 && 'mx-auto max-w-xl',
            categoryItems.length === 2 && 'mx-auto max-w-4xl sm:grid-cols-2',
            categoryItems.length >= 3 && 'sm:grid-cols-2 lg:grid-cols-3',
          ]}
        >
          {categoryItems.map((category, index) => {
            const Icon = iconByCategory[category.icon];

            return (
              <CategoryCard
                title={category.title}
                description={category.description}
                href={localizeHref(getCategoryHref(category.slug), locale)}
                linkLabel={localizedLinkLabel(categoryLinkLabel, getCategoryHref(category.slug), locale)}
                eyebrow={t('Pet lifestyle', 'Vida con mascotas')}
                tone={category.tone}
                backgroundImage={category.backgroundImage}
                backgroundPosition={category.backgroundPosition}
                backgroundOverlay={category.backgroundOverlay}
                index={index}
              >
                <Icon slot="icon" aria-hidden="true" />
              </CategoryCard>
            );
          })}
        </div>

        <div
          class="category-showcase__cta mt-10 flex flex-col gap-6 overflow-hidden rounded-card-lg border border-brand-200/70 bg-white-warm/90 p-6 shadow-card backdrop-blur-md sm:p-8 lg:mt-12 lg:flex-row lg:items-center lg:justify-between"
          data-category-reveal
          style={`--category-reveal-delay: ${categoryItems.length * 85 + 80}ms;`}
        >
          <div class="relative z-10 flex max-w-2xl items-start gap-4">
            <span
              class="grid size-12 shrink-0 place-items-center rounded-2xl bg-accent-100 text-accent-700 shadow-orange"
              aria-hidden="true"
            >
              <HeartBold class="size-6" />
            </span>

            <div>
              <h3 class="text-2xl sm:text-3xl">
                {isStoreLive
                  ? t('Find something made for your routine.', 'Encuentra algo pensado para su rutina.')
                  : t('Be first to meet the collection.', 'Sé de los primeros en conocer la colección.')}
              </h3>

              <p class="mt-2 leading-7 text-ink-600">
                {isStoreLive
                  ? t('Browse the full Maxi Pawz collection and discover useful products for more of the moments you share together.', 'Explora toda la colección de Maxi Pawz y descubre productos útiles para los momentos que comparten juntos.')
                  : t('Join the Maxi Pawz pack for launch news, collection updates, useful guidance, and occasional subscriber offers.', 'Únete a la comunidad de Maxi Pawz para recibir noticias del lanzamiento, novedades de la colección, consejos útiles y ofertas ocasionales para suscriptores.')}
              </p>
            </div>
          </div>

          <div class="relative z-10 shrink-0">
            {isStoreLive ? (
              <Button
                href={localizeHref('/shop#products', locale)}
                variant="primary"
                size="lg"
                iconPosition="right"
                class="w-full sm:w-auto"
              >
                <ShoppingBagOpenBold slot="icon" aria-hidden="true" />
                {localizedLinkLabel(t('Shop All Products', 'Ver todos los productos'), '/shop#products', locale)}
              </Button>
            ) : (
              <Button
                href={localizeHref('/#maxi-pawz-updates', locale)}
                variant="primary"
                size="lg"
                iconPosition="right"
                class="w-full sm:w-auto"
              >
                <HeartBold slot="icon" aria-hidden="true" />
                {localizedLinkLabel(t('Join the Pack', 'Unirme a la comunidad'), '/#maxi-pawz-updates', locale)}
              </Button>
            )}
          </div>
        </div>
      </div>
    </section>
  )
}

<style is:global>
  .category-showcase {
    background: linear-gradient(
      180deg,
      rgb(255 253 244 / 20%) 0%,
      rgb(255 248 220 / 78%) 48%,
      rgb(255 253 244 / 18%) 100%
    );
  }

  .category-showcase__pattern {
    background-image: radial-gradient(
      circle,
      rgb(0 138 255 / 10%) 1.25px,
      transparent 1.25px
    );
    background-size: 2rem 2rem;
    mask-image: linear-gradient(
      to bottom,
      transparent,
      black 16%,
      black 78%,
      transparent
    );
    opacity: 0.65;
  }

  .category-showcase__orb {
    animation: category-orb-drift 10s ease-in-out infinite;
    will-change: transform;
  }

  .category-showcase__orb--orange {
    animation-delay: -4s;
    animation-direction: reverse;
  }

  .category-showcase__paw {
    animation: category-paw-float 7s ease-in-out infinite;
    will-change: transform;
  }

  .category-showcase__paw--two {
    animation-delay: -3.5s;
    animation-direction: reverse;
  }

  .category-showcase__cta {
    position: relative;
  }

  .category-showcase__cta::before {
    position: absolute;
    top: -7rem;
    right: -5rem;
    width: 19rem;
    height: 19rem;
    border-radius: 9999px;
    background: rgb(82 184 255 / 20%);
    content: '';
    filter: blur(2.5rem);
    pointer-events: none;
  }

  .category-showcase__cta::after {
    position: absolute;
    bottom: -8rem;
    left: 22%;
    width: 17rem;
    height: 17rem;
    border-radius: 9999px;
    background: rgb(255 174 102 / 18%);
    content: '';
    filter: blur(2.5rem);
    pointer-events: none;
  }

  .category-motion-ready [data-category-reveal] {
    opacity: 0;
    transform: translate3d(0, 1.5rem, 0) scale(0.985);
    transition:
      opacity 650ms var(--ease-friendly) var(--category-reveal-delay, 0ms),
      transform 650ms var(--ease-friendly) var(--category-reveal-delay, 0ms);
    will-change: opacity, transform;
  }

  .category-motion-ready [data-category-reveal].is-category-visible {
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1);
  }

  @keyframes category-orb-drift {
    0%,
    100% {
      transform: translate3d(0, 0, 0) scale(1);
    }

    50% {
      transform: translate3d(1rem, -1.25rem, 0) scale(1.06);
    }
  }

  @keyframes category-paw-float {
    0%,
    100% {
      transform: translate3d(0, 0, 0) rotate(-4deg);
    }

    50% {
      transform: translate3d(0.45rem, -0.8rem, 0) rotate(5deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .category-showcase__orb,
    .category-showcase__paw {
      animation: none !important;
    }

    .category-motion-ready [data-category-reveal] {
      transform: none !important;
      transition: none !important;
    }

    .category-motion-ready [data-category-reveal] {
      opacity: 1 !important;
    }
  }
</style>

<script>
  const initializeCategoryShowcases = (): void => {
    const sections = Array.from(
      document.querySelectorAll<HTMLElement>('[data-category-showcase]'),
    );

    for (const section of sections) {
      if (section.dataset.categoryInitialized === 'true') {
        continue;
      }

      section.dataset.categoryInitialized = 'true';

      const reducedMotion = window.matchMedia(
        '(prefers-reduced-motion: reduce)',
      ).matches;

      const revealElements = Array.from(
        section.querySelectorAll<HTMLElement>('[data-category-reveal]'),
      );

      if (!reducedMotion && 'IntersectionObserver' in window) {
        section.classList.add('category-motion-ready');

        const revealObserver = new IntersectionObserver(
          (entries, observer) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) {
                continue;
              }

              entry.target.classList.add('is-category-visible');
              observer.unobserve(entry.target);
            }
          },
          {
            rootMargin: '0px 0px -8% 0px',
            threshold: 0.1,
          },
        );

        window.requestAnimationFrame(() => {
          for (const element of revealElements) {
            revealObserver.observe(element);
          }
        });
      } else {
        for (const element of revealElements) {
          element.classList.add('is-category-visible');
        }
      }

      const supportsFinePointer = window.matchMedia(
        '(hover: hover) and (pointer: fine)',
      ).matches;

      if (reducedMotion || !supportsFinePointer) {
        continue;
      }

      const cards = Array.from(
        section.querySelectorAll<HTMLElement>('[data-category-interactive]'),
      );

      for (const card of cards) {
        let animationFrame = 0;
        let pointerX = 0;
        let pointerY = 0;

        const renderCardMotion = (): void => {
          animationFrame = 0;

          const rect = card.getBoundingClientRect();

          if (rect.width === 0 || rect.height === 0) {
            return;
          }

          const normalizedX = (pointerX - rect.left) / rect.width - 0.5;
          const normalizedY = (pointerY - rect.top) / rect.height - 0.5;

          const rotateY = normalizedX * 4.8;
          const rotateX = normalizedY * -4.2;

          const imageX = normalizedX * -8;
          const imageY = normalizedY * -8;

          card.style.setProperty('--card-rotate-x', `${rotateX.toFixed(2)}deg`);
          card.style.setProperty('--card-rotate-y', `${rotateY.toFixed(2)}deg`);

          card.style.setProperty('--card-image-x', `${imageX.toFixed(2)}px`);
          card.style.setProperty('--card-image-y', `${imageY.toFixed(2)}px`);

          card.style.setProperty(
            '--card-spotlight-x',
            `${(normalizedX + 0.5) * 100}%`,
          );

          card.style.setProperty(
            '--card-spotlight-y',
            `${(normalizedY + 0.5) * 100}%`,
          );
        };

        const handlePointerMove = (event: PointerEvent): void => {
          pointerX = event.clientX;
          pointerY = event.clientY;

          if (animationFrame === 0) {
            animationFrame = window.requestAnimationFrame(renderCardMotion);
          }
        };

        const resetCardMotion = (): void => {
          if (animationFrame !== 0) {
            window.cancelAnimationFrame(animationFrame);
            animationFrame = 0;
          }

          card.style.setProperty('--card-rotate-x', '0deg');
          card.style.setProperty('--card-rotate-y', '0deg');

          card.style.setProperty('--card-image-x', '0px');
          card.style.setProperty('--card-image-y', '0px');

          card.style.setProperty('--card-spotlight-x', '50%');
          card.style.setProperty('--card-spotlight-y', '50%');
        };

        card.addEventListener('pointermove', handlePointerMove, {
          passive: true,
        });

        card.addEventListener('pointerleave', resetCardMotion);
        card.addEventListener('blur', resetCardMotion, true);
      }
    }
  };

  initializeCategoryShowcases();

  document.addEventListener('astro:page-load', initializeCategoryShowcases);
</script>