---
import ConfettiBold from 'phosphor-astro/ConfettiBold.astro';
import HeartBold from 'phosphor-astro/HeartBold.astro';
import PawPrintBold from 'phosphor-astro/PawPrintBold.astro';
import ShieldCheckBold from 'phosphor-astro/ShieldCheckBold.astro';
import ShoppingBagOpenBold from 'phosphor-astro/ShoppingBagOpenBold.astro';
import SparkleBold from 'phosphor-astro/SparkleBold.astro';
import SuitcaseRollingBold from 'phosphor-astro/SuitcaseRollingBold.astro';

import CategoryCard from './CategoryCard.astro';

import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';

import { isStoreLive } from '../../config/storefront';

import {
  lifestyleCategories,
  type LifestyleCategoryIcon,
} from '../../data/homepage';

const iconByCategory: Record<LifestyleCategoryIcon, typeof PawPrintBold> = {
  play: ConfettiBold,
  travel: SuitcaseRollingBold,
  hydration: HeartBold,
  comfort: PawPrintBold,
  care: ShieldCheckBold,
  accessories: ShoppingBagOpenBold,
};

function getCategoryHref(slug: string): string {
  if (!isStoreLive) {
    return '/#join-the-pack';
  }

  return `/shop?category=${encodeURIComponent(slug)}`;
}

const categoryLinkLabel = isStoreLive
  ? 'Explore category'
  : 'Get launch updates';

const categoryCountLabel = `${lifestyleCategories.length} thoughtful categories`;
---

<section
  id="shop-by-lifestyle"
  class="category-showcase section-spacing relative isolate overflow-hidden"
  aria-labelledby="shop-by-lifestyle-title"
  data-category-showcase
>
  <div
    class="category-showcase__pattern pointer-events-none absolute inset-0"
    aria-hidden="true"
  >
  </div>

  <div
    class="category-showcase__orb category-showcase__orb--blue pointer-events-none absolute -top-24 -left-24 size-80 rounded-full bg-brand-300/25 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div
    class="category-showcase__orb category-showcase__orb--orange pointer-events-none absolute -right-28 bottom-12 size-96 rounded-full bg-accent-300/20 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div
    class="category-showcase__paw category-showcase__paw--one pointer-events-none absolute top-20 right-[8%] hidden text-brand-300/35 lg:block"
    aria-hidden="true"
  >
    <PawPrintBold class="size-16 rotate-12" />
  </div>

  <div
    class="category-showcase__paw category-showcase__paw--two pointer-events-none absolute bottom-32 left-[4%] hidden text-accent-300/30 lg:block"
    aria-hidden="true"
  >
    <PawPrintBold class="size-12 -rotate-12" />
  </div>

  <div class="site-container relative z-10">
    <div
      class="grid items-end gap-7 lg:grid-cols-1 lg:gap-14"
    >
      <div data-category-reveal>
        <Badge
          variant="brand"
          size="md"
        >
          <PawPrintBold
            slot="icon"
            aria-hidden="true"
          />

          {
            isStoreLive
              ? 'Shop by lifestyle'
              : 'What you will find'
          }
        </Badge>

        <h2
          id="shop-by-lifestyle-title"
          class="mt-5 text-4xl sm:text-5xl lg:text-6xl"
        >
          Products for play, care, comfort, and everyday adventures.
        </h2>
      </div>

      <div
        class="lg:pb-1"
        data-category-reveal
        style="--category-reveal-delay: 90ms;"
      >
        <p>
          {
            isStoreLive
              ? 'Explore MaxiPawz products based on the moments, routines, and experiences you share with your pet.'
              : 'MaxiPawz is preparing a varied collection that supports playtime, walks, travel, feeding, hydration, comfort, care, and personal style.'
          }
        </p>
      </div>
    </div>

    <!-- <div
      class="category-showcase__rail mt-9 rounded-card border border-sand-dark/45 bg-white-warm/75 p-3 shadow-soft backdrop-blur-md sm:p-4 lg:mt-10"
      data-category-reveal
      style="--category-reveal-delay: 150ms;"
      aria-label="Available lifestyle categories"
    >
      <ul
        class="flex flex-wrap justify-center gap-2 sm:gap-3"
        role="list"
      >
        {
          lifestyleCategories.map((category) => {
            const Icon = iconByCategory[category.icon];

            return (
              <li
                class="category-showcase__chip inline-flex items-center gap-2 rounded-full border border-sand-dark/35 bg-cream-soft/90 px-3 py-2 text-xs font-extrabold text-ink-700 sm:px-4 sm:text-sm"
              >
                <Icon
                  class="size-4 text-brand-600"
                  aria-hidden="true"
                />

                {category.title}
              </li>
            );
          })
        }
      </ul>
    </div> -->

    <div
      class="mt-8 grid gap-5 sm:grid-cols-2 lg:mt-10 lg:grid-cols-3 lg:gap-6"
    >
      {
        lifestyleCategories.map(
          (category, index) => {
            const Icon =
              iconByCategory[category.icon];

            return (
              <CategoryCard
                title={category.title}
                description={
                  category.description
                }
                href={getCategoryHref(
                  category.slug,
                )}
                linkLabel={
                  categoryLinkLabel
                }
                tone={category.tone}
                backgroundImage={
                  category.backgroundImage
                }
                backgroundPosition={
                  category.backgroundPosition
                }
                backgroundOverlay={
                  category.backgroundOverlay
                }
                index={index}
              >
                <Icon
                  slot="icon"
                  aria-hidden="true"
                />
              </CategoryCard>
            );
          },
        )
      }
    </div>

    <div
      class="category-showcase__cta mt-10 flex flex-col gap-6 overflow-hidden rounded-card-lg border border-brand-200/70 bg-white-warm/90 p-6 shadow-card backdrop-blur-md sm:p-8 lg:mt-12 lg:flex-row lg:items-center lg:justify-between"
      data-category-reveal
      style={`--category-reveal-delay: ${
        lifestyleCategories.length * 85 + 80
      }ms;`}
    >
      <div
        class="relative z-10 flex max-w-2xl items-start gap-4"
      >
        <span
          class="grid size-12 shrink-0 place-items-center rounded-2xl bg-accent-100 text-accent-700 shadow-orange"
          aria-hidden="true"
        >
          <HeartBold class="size-6" />
        </span>

        <div>
          <h3 class="text-2xl sm:text-3xl">
            {
              isStoreLive
                ? 'Find something made for your routine.'
                : 'Be first to meet the collection.'
            }
          </h3>

          <p
            class="mt-2 leading-7 text-ink-600"
          >
            {
              isStoreLive
                ? 'Browse the full MaxiPawz collection and discover useful products for more of the moments you share together.'
                : 'Join the MaxiPawz pack for launch news, collection updates, useful guidance, and occasional subscriber offers.'
            }
          </p>
        </div>
      </div>

      <div
        class="relative z-10 shrink-0"
      >
        {
          isStoreLive ? (
            <Button
              href="/shop"
              variant="primary"
              size="lg"
              iconPosition="right"
              class="w-full sm:w-auto"
            >
              <ShoppingBagOpenBold
                slot="icon"
                aria-hidden="true"
              />

              Shop All Products
            </Button>
          ) : (
            <Button
              href="/#join-the-pack"
              variant="primary"
              size="lg"
              iconPosition="right"
              class="w-full sm:w-auto"
            >
              <HeartBold
                slot="icon"
                aria-hidden="true"
              />

              Join the Pack
            </Button>
          )
        }
      </div>
    </div>
  </div>
</section>

<style is:global>
  .category-showcase {
    background: linear-gradient(
      180deg,
      rgb(255 253 244 / 20%) 0%,
      rgb(255 248 220 / 78%) 48%,
      rgb(255 253 244 / 18%) 100%
    );
  }

  .category-showcase__pattern {
    background-image: radial-gradient(
      circle,
      rgb(0 138 255 / 10%) 1.25px,
      transparent 1.25px
    );
    background-size: 2rem 2rem;
    mask-image: linear-gradient(
      to bottom,
      transparent,
      black 16%,
      black 78%,
      transparent
    );
    opacity: 0.65;
  }

  .category-showcase__orb {
    animation: category-orb-drift 10s
      ease-in-out infinite;
    will-change: transform;
  }

  .category-showcase__orb--orange {
    animation-delay: -4s;
    animation-direction: reverse;
  }

  .category-showcase__paw {
    animation: category-paw-float 7s
      ease-in-out infinite;
    will-change: transform;
  }

  .category-showcase__paw--two {
    animation-delay: -3.5s;
    animation-direction: reverse;
  }

  .category-showcase__rail {
    position: relative;
  }

  .category-showcase__rail::before {
    position: absolute;
    inset: 0.35rem;
    border: 1px solid
      rgb(255 255 255 / 68%);
    border-radius: calc(
      var(--radius-card) - 0.35rem
    );
    content: '';
    pointer-events: none;
  }

  .category-showcase__chip {
    transition:
      transform 200ms
        var(--ease-bounce-soft),
      border-color 200ms
        var(--ease-friendly),
      background-color 200ms
        var(--ease-friendly);
  }

  .category-showcase__chip:hover {
    transform: translateY(-2px);
    border-color: rgb(0 138 255 / 28%);
    background-color: rgb(
      238 248 255 / 92%
    );
  }

  .category-showcase__cta {
    position: relative;
  }

  .category-showcase__cta::before {
    position: absolute;
    top: -7rem;
    right: -5rem;
    width: 19rem;
    height: 19rem;
    border-radius: 9999px;
    background: rgb(82 184 255 / 20%);
    content: '';
    filter: blur(2.5rem);
    pointer-events: none;
  }

  .category-showcase__cta::after {
    position: absolute;
    bottom: -8rem;
    left: 22%;
    width: 17rem;
    height: 17rem;
    border-radius: 9999px;
    background: rgb(255 174 102 / 18%);
    content: '';
    filter: blur(2.5rem);
    pointer-events: none;
  }

  .category-motion-ready
    [data-category-reveal] {
    opacity: 0;
    transform: translate3d(
        0,
        1.5rem,
        0
      )
      scale(0.985);
    transition:
      opacity 650ms
        var(--ease-friendly)
        var(
          --category-reveal-delay,
          0ms
        ),
      transform 650ms
        var(--ease-friendly)
        var(
          --category-reveal-delay,
          0ms
        );
    will-change: opacity, transform;
  }

  .category-motion-ready
    [data-category-reveal].is-category-visible {
    opacity: 1;
    transform: translate3d(0, 0, 0)
      scale(1);
  }

  @keyframes category-orb-drift {
    0%,
    100% {
      transform: translate3d(
          0,
          0,
          0
        )
        scale(1);
    }

    50% {
      transform: translate3d(
          1rem,
          -1.25rem,
          0
        )
        scale(1.06);
    }
  }

  @keyframes category-paw-float {
    0%,
    100% {
      transform: translate3d(
          0,
          0,
          0
        )
        rotate(-4deg);
    }

    50% {
      transform: translate3d(
          0.45rem,
          -0.8rem,
          0
        )
        rotate(5deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .category-showcase__orb,
    .category-showcase__paw {
      animation: none !important;
    }

    .category-showcase__chip,
    .category-motion-ready
      [data-category-reveal] {
      transform: none !important;
      transition: none !important;
    }

    .category-motion-ready
      [data-category-reveal] {
      opacity: 1 !important;
    }
  }
</style>

<script>
  const initializeCategoryShowcases =
    (): void => {
      const sections = Array.from(
        document.querySelectorAll<HTMLElement>(
          '[data-category-showcase]',
        ),
      );

      for (const section of sections) {
        if (
          section.dataset
            .categoryInitialized === 'true'
        ) {
          continue;
        }

        section.dataset.categoryInitialized =
          'true';

        const reducedMotion =
          window.matchMedia(
            '(prefers-reduced-motion: reduce)',
          ).matches;

        const revealElements =
          Array.from(
            section.querySelectorAll<HTMLElement>(
              '[data-category-reveal]',
            ),
          );

        if (
          !reducedMotion &&
          'IntersectionObserver' in window
        ) {
          section.classList.add(
            'category-motion-ready',
          );

          const revealObserver =
            new IntersectionObserver(
              (entries, observer) => {
                for (const entry of entries) {
                  if (
                    !entry.isIntersecting
                  ) {
                    continue;
                  }

                  entry.target.classList.add(
                    'is-category-visible',
                  );

                  observer.unobserve(
                    entry.target,
                  );
                }
              },
              {
                rootMargin:
                  '0px 0px -8% 0px',
                threshold: 0.1,
              },
            );

          window.requestAnimationFrame(() => {
            for (
              const element of revealElements
            ) {
              revealObserver.observe(
                element,
              );
            }
          });
        } else {
          for (
            const element of revealElements
          ) {
            element.classList.add(
              'is-category-visible',
            );
          }
        }

        const supportsFinePointer =
          window.matchMedia(
            '(hover: hover) and (pointer: fine)',
          ).matches;

        if (
          reducedMotion ||
          !supportsFinePointer
        ) {
          continue;
        }

        const cards = Array.from(
          section.querySelectorAll<HTMLElement>(
            '[data-category-interactive]',
          ),
        );

        for (const card of cards) {
          let animationFrame = 0;
          let pointerX = 0;
          let pointerY = 0;

          const renderCardMotion =
            (): void => {
              animationFrame = 0;

              const rect =
                card.getBoundingClientRect();

              if (
                rect.width === 0 ||
                rect.height === 0
              ) {
                return;
              }

              const normalizedX =
                (pointerX - rect.left) /
                  rect.width -
                0.5;

              const normalizedY =
                (pointerY - rect.top) /
                  rect.height -
                0.5;

              const rotateY =
                normalizedX * 4.8;

              const rotateX =
                normalizedY * -4.2;

              const imageX =
                normalizedX * -8;

              const imageY =
                normalizedY * -8;

              card.style.setProperty(
                '--card-rotate-x',
                `${rotateX.toFixed(2)}deg`,
              );

              card.style.setProperty(
                '--card-rotate-y',
                `${rotateY.toFixed(2)}deg`,
              );

              card.style.setProperty(
                '--card-image-x',
                `${imageX.toFixed(2)}px`,
              );

              card.style.setProperty(
                '--card-image-y',
                `${imageY.toFixed(2)}px`,
              );

              card.style.setProperty(
                '--card-spotlight-x',
                `${
                  (normalizedX + 0.5) *
                  100
                }%`,
              );

              card.style.setProperty(
                '--card-spotlight-y',
                `${
                  (normalizedY + 0.5) *
                  100
                }%`,
              );
            };

          const handlePointerMove = (
            event: PointerEvent,
          ): void => {
            pointerX = event.clientX;
            pointerY = event.clientY;

            if (animationFrame === 0) {
              animationFrame =
                window.requestAnimationFrame(
                  renderCardMotion,
                );
            }
          };

          const resetCardMotion =
            (): void => {
              if (animationFrame !== 0) {
                window.cancelAnimationFrame(
                  animationFrame,
                );

                animationFrame = 0;
              }

              card.style.setProperty(
                '--card-rotate-x',
                '0deg',
              );

              card.style.setProperty(
                '--card-rotate-y',
                '0deg',
              );

              card.style.setProperty(
                '--card-image-x',
                '0px',
              );

              card.style.setProperty(
                '--card-image-y',
                '0px',
              );

              card.style.setProperty(
                '--card-spotlight-x',
                '50%',
              );

              card.style.setProperty(
                '--card-spotlight-y',
                '50%',
              );
            };

          card.addEventListener(
            'pointermove',
            handlePointerMove,
            {
              passive: true,
            },
          );

          card.addEventListener(
            'pointerleave',
            resetCardMotion,
          );

          card.addEventListener(
            'blur',
            resetCardMotion,
            true,
          );
        }
      }
    };

  initializeCategoryShowcases();

  document.addEventListener(
    'astro:page-load',
    initializeCategoryShowcases,
  );
</script>