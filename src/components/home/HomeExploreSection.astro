---
import ArrowRightBold from 'phosphor-astro/ArrowRightBold.astro';
import ConfettiBold from 'phosphor-astro/ConfettiBold.astro';
import HeartBold from 'phosphor-astro/HeartBold.astro';
import SparkleBold from 'phosphor-astro/SparkleBold.astro';

import Badge from '../ui/Badge.astro';
import { localizeHref, localizedLinkLabel } from '../../i18n/routes';
import { getLocaleFromPathname } from '../../i18n/languages';

const locale = getLocaleFromPathname(Astro.url.pathname);
const t = (english: string, spanish: string): string =>
    locale === 'es' ? spanish : english;

const currentActions = [
    {
        icon: ConfettiBold,

        eyebrow: t("Discover", "Descubre"),

        title: t("Preview the collection", "Conoce la futura colección"),

        description:
        t("Explore the product categories and everyday pet moments that are shaping the first Maxi Pawz collection.", "Descubre las categorías de productos y los momentos cotidianos que están dando forma a la primera colección de Maxi Pawz."),

        href: '/#shop-by-lifestyle',

        linkLabel: t("Explore categories", "Explorar categorías"),
    },

    {
        icon: SparkleBold,

        eyebrow: t("Learn", "Aprende"),

        title: t("Use our pet guides", "Consulta nuestras guías"),

        description:
        t("Read practical guidance about toys, enrichment, travel, hydration, comfort, accessories, and everyday routines.", "Encuentra consejos prácticos sobre juguetes, enriquecimiento, viajes, hidratación, descanso, accesorios y rutinas diarias."),

        href: '/pet-guides',

        linkLabel: t("Read pet guides", "Leer guías para mascotas"),
    },

    {
        icon: HeartBold,

        eyebrow: t("Updates", "Novedades"),

        title: t("Join the Founding Pack", "Únete a la comunidad fundadora"),

        description:
        t("Join Maxi Pawz before the first collection arrives and optionally tell Maxi a little about your pet.", "Únete a Maxi Pawz antes de que llegue la primera colección y, si quieres, cuéntale a Maxi un poco sobre tu mascota."),

        href: '/#maxi-pawz-updates',

        linkLabel: t("Join the Founding Pack", "Únete a la comunidad fundadora"),
    },
];
---

<section class="section-spacing" aria-labelledby="useful-now-title">
    <div class="site-container">
        <div class="mx-auto max-w-4xl text-center" data-reveal>
        <Badge variant="brand" size="md" class="mx-auto">
            <SparkleBold slot="icon" aria-hidden="true" />

            {t("Useful from day one", "Útil desde el primer día")}
        </Badge>

        <h2
            id="useful-now-title"
            class="section-title mx-auto mt-5 text-4xl sm:text-5xl"
        >
            {t("Explore Maxi Pawz before the first collection arrives.", "Descubre Maxi Pawz antes de que llegue la primera colección.")}
        </h2>

        <p class="section-description mx-auto mt-4">
            {t('The store is still growing, but there is already plenty to discover. Learn about the brand, preview our future categories, explore practical guidance, and join the Founding Pack.', 'La tienda sigue creciendo, pero ya hay mucho por descubrir. Conoce la marca y nuestras futuras categorías, consulta consejos prácticos y únete a la comunidad fundadora.')}
        </p>
        </div>

        <div class="mt-10 grid gap-5 lg:mt-12 lg:grid-cols-3">
        {
            currentActions.map(
            ({ icon: Icon, eyebrow, title, description, href, linkLabel }, index) => (
                <a
                href={localizeHref(href, locale)}
                class="surface-card-interactive group flex h-full flex-col p-6 sm:p-7"
                data-reveal
                style={`--reveal-delay: ${index * 100}ms;`}
                >
                <span
                    class="grid size-12 shrink-0 place-items-center rounded-2xl bg-brand-100 text-brand-700 transition duration-300 group-hover:-rotate-3 group-hover:scale-105 group-focus-visible:-rotate-3 group-focus-visible:scale-105"
                    aria-hidden="true"
                >
                    <Icon class="size-6" />
                </span>

                <span class="mt-6 text-sm font-extrabold uppercase tracking-[0.14em] text-accent-700">
                    {eyebrow}
                </span>

                <h3 class="mt-2 text-2xl">
                    {title}
                </h3>

                <p class="mt-3 flex-1 leading-7 text-ink-600">
                    {description}
                </p>

                <span class="mt-6 inline-flex items-center gap-2 font-extrabold text-brand-700">
                    {localizedLinkLabel(linkLabel, href, locale)}

                    <ArrowRightBold
                    class="size-5 transition group-hover:translate-x-1 group-focus-visible:translate-x-1"
                    aria-hidden="true"
                    />
                </span>
                </a>
            ),
            )
        }
        </div>
    </div>
</section>