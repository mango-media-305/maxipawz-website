---
import { Image } from 'astro:assets';

import ArrowRightBold from 'phosphor-astro/ArrowRightBold.astro';
import CheckCircleFill from 'phosphor-astro/CheckCircleFill.astro';
import ConfettiBold from 'phosphor-astro/ConfettiBold.astro';
import PawPrintBold from 'phosphor-astro/PawPrintBold.astro';
import ShoppingBagOpenBold from 'phosphor-astro/ShoppingBagOpenBold.astro';

import heroSlideOne from '../../assets/home/hero-slide-1.webp';
import heroSlideTwo from '../../assets/home/hero-slide-2.webp';
import heroSlideThree from '../../assets/home/hero-slide-3.webp';

import HeroShowcaseSlider from './HeroShowcaseSlider.astro';

import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';

import { isStoreLive } from '../../config/storefront';

const heroSlides = [
  {
    src: heroSlideOne,
  },

  {
    src: heroSlideTwo,
  },

  {
    src: heroSlideThree,
  },
];

const heroHighlights = [
  'Thoughtful product categories',
  'Practical pet guidance',
  'A secure shopping experience',
];
---

<section class="hero-home relative isolate overflow-hidden" aria-labelledby="home-hero-title">
  <!-- Full-section Ken Burns background slider -->
  <div class="hero-home__background absolute inset-0 z-0" aria-hidden="true">
    {
      heroSlides.map((slide, index) => (
        <div class="hero-home__slide absolute inset-0" style={`--hero-slide-delay: ${index * 6}s;`}>
          <Image
            src={slide.src}
            alt=""
            class="hero-home__slide-image absolute inset-0 size-full object-cover"
            widths={[768, 1024, 1280, 1600, 1920]}
            sizes="100vw"
            loading={index === 0 ? 'eager' : 'lazy'}
            fetchpriority={index === 0 ? 'high' : 'low'}
            quality={84}
          />
        </div>
      ))
    }

    <div class="hero-home__overlay absolute inset-0" aria-hidden="true"></div>

    <div class="hero-home__mesh absolute inset-0" aria-hidden="true"></div>

    <div class="hero-home__bottom-fade absolute inset-x-0 bottom-0 h-32" aria-hidden="true"></div>
  </div>

  <!-- Decorative parallax glows -->
  <div
    class="motion-parallax pointer-events-none absolute -top-40 -left-40 z-0"
    data-parallax
    data-parallax-speed="0.035"
    aria-hidden="true"
  >
    <div class="size-128 rounded-full bg-brand-300/20 blur-3xl"></div>
  </div>

  <div
    class="motion-parallax pointer-events-none absolute top-16 -right-48 z-0"
    data-parallax
    data-parallax-speed="0.055"
    aria-hidden="true"
  >
    <div class="size-136 rounded-full bg-accent-300/18 blur-3xl"></div>
  </div>

  <!-- Floating paw decorations -->
  <div
    class="pointer-events-none absolute inset-0 z-0 hidden overflow-hidden lg:block"
    aria-hidden="true"
  >
    <span
      class="motion-float absolute top-[14%] left-[47%] text-brand-600/24"
      data-motion-continuous
    >
      <PawPrintBold class="size-12 rotate-12" />
    </span>

    <span
      class="motion-float motion-float-slow motion-float-reverse absolute top-[68%] left-[3%] text-accent-600/22"
      data-motion-continuous
    >
      <PawPrintBold class="size-9 -rotate-12" />
    </span>

    <span
      class="motion-float motion-float-slow absolute right-[2%] bottom-[8%] text-brand-600/22"
      data-motion-continuous
    >
      <PawPrintBold class="size-14 rotate-20" />
    </span>
  </div>

  <div
    class="hero-home__content site-container-wide relative z-10 grid items-center gap-10 py-12 sm:py-14 lg:grid-cols-[1.2fr_0.8fr] lg:gap-14 lg:py-18"
  >
    <!-- Hero text -->
    <div class="hero-home__copy relative z-10 max-w-2xl" data-reveal>
      <Badge variant={isStoreLive ? 'brand' : 'accent'} size="md" class="motion-pulse-ring">
        <PawPrintBold slot="icon" aria-hidden="true" />

        {isStoreLive ? 'Find their next Maxi Pawz favorite' : 'Built for real pet life'}
      </Badge>

      <h1 id="home-hero-title" class="mt-6 max-w-3xl text-5xl text-ink-900 sm:text-6xl lg:text-7xl">
        Better everyday moments start with

        <span class="motion-gradient-text text-brand-gradient">
          {' '}the right pet essentials.
        </span>
      </h1>

      <p class="mt-6 max-w-2xl text-lg leading-8 text-ink-700 sm:text-xl">
        {
          isStoreLive
            ? 'Discover thoughtfully selected products for play, walks, travel, hydration, feeding, comfort, care, and everyday life together.'
            : 'Maxi Pawz is building a thoughtful online destination for pet toys, accessories, travel gear, hydration products, and useful everyday supplies. While our first collection takes shape, explore practical guides and discover what is ahead.'
        }
      </p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        {
          isStoreLive ? (
            <>
              <Button
                href="/shop"
                variant="primary"
                size="lg"
                iconPosition="left"
                class="w-full sm:w-auto"
              >
                <ShoppingBagOpenBold slot="icon" aria-hidden="true" />
                Shop the Collection
              </Button>

              <Button
                href="/pet-guides"
                variant="secondary"
                size="lg"
                iconPosition="right"
                class="w-full sm:w-auto"
              >
                <ArrowRightBold slot="icon" aria-hidden="true" />
                Explore Pet Guides
              </Button>
            </>
          ) : (
            <>
              <Button
                href="/#shop-by-lifestyle"
                variant="primary"
                size="lg"
                iconPosition="left"
                class="w-full sm:w-auto"
              >
                <ConfettiBold slot="icon" aria-hidden="true" />
                Explore What Is Coming
              </Button>

              <Button
                href="/pet-guides"
                variant="secondary"
                size="lg"
                iconPosition="right"
                class="w-full sm:w-auto"
              >
                <ArrowRightBold slot="icon" aria-hidden="true" />
                Read Pet Guides
              </Button>
            </>
          )
        }
      </div>

      <div
        class="mt-8 flex flex-wrap gap-x-6 gap-y-3 text-sm font-bold text-ink-600"
        aria-label="Maxi Pawz highlights"
      >
        {
          heroHighlights.map((highlight) => (
            <span class="inline-flex items-center gap-2">
              <CheckCircleFill class="size-5 shrink-0 text-brand-600" aria-hidden="true" />

              {highlight}
            </span>
          ))
        }
      </div>
    </div>

    <!-- Adaptive editorial/product slider -->
    <div
      class="motion-tilt-shell relative z-10 hidden sm:block"
      data-tilt-root
      data-tilt-strength="1.75"
      data-reveal="right"
      style="--reveal-delay: 120ms;"
    >
      <div class="motion-tilt-surface" data-tilt-surface>
        <HeroShowcaseSlider storeLive={isStoreLive} />
      </div>
    </div>
  </div>
</section>

<style>
  .hero-home {
    min-height: clamp(44rem, 88vh, 58rem);

    background-color: #fff8e6;
  }

  .hero-home__content {
    min-height: clamp(44rem, 88vh, 58rem);
  }

  .hero-home__background {
    background-color: #fff8e6;
  }

  .hero-home__slide {
    opacity: 0;

    animation: hero-slide-fade 18s linear infinite;

    animation-delay: var(--hero-slide-delay);
  }

  .hero-home__slide-image {
    opacity: 0.72;

    transform: scale(1.08);

    filter: saturate(0.98) contrast(0.96) brightness(1.04);

    animation: hero-ken-burns 18s ease-in-out infinite;

    animation-delay: var(--hero-slide-delay);
  }

  .hero-home__overlay {
    background:
      linear-gradient(
        90deg,
        rgb(255 253 246 / 78%) 0%,
        rgb(255 253 246 / 68%) 30%,
        rgb(255 250 235 / 42%) 56%,
        rgb(255 247 224 / 24%) 100%
      ),
      linear-gradient(
        180deg,
        rgb(255 255 255 / 20%) 0%,
        rgb(255 253 246 / 12%) 42%,
        rgb(255 248 228 / 38%) 100%
      );
  }

  .hero-home__mesh {
    background-image:
      radial-gradient(circle at 14% 18%, rgb(0 138 255 / 10%), transparent 23rem),
      radial-gradient(circle at 86% 72%, rgb(255 102 0 / 9%), transparent 26rem),
      radial-gradient(circle, rgb(53 39 31 / 5%) 1px, transparent 1px);

    background-size:
      auto,
      auto,
      2.75rem 2.75rem;

    mask-image: linear-gradient(to bottom, black, black 82%, transparent);

    opacity: 0.46;
  }

  .hero-home__bottom-fade {
    background: linear-gradient(to bottom, transparent, rgb(255 249 230 / 70%));
  }

  .hero-home__copy::before {
    position: absolute;
    z-index: -1;

    inset: -3rem -2.5rem;

    border-radius: 3rem;

    background: radial-gradient(
      circle at 28% 42%,
      rgb(255 255 255 / 82%),
      rgb(255 253 246 / 60%) 48%,
      rgb(255 253 246 / 22%) 68%,
      transparent 80%
    );

    content: '';
    pointer-events: none;
  }

  @keyframes hero-slide-fade {
    0%,
    28% {
      opacity: 1;
    }

    37%,
    100% {
      opacity: 0;
    }
  }

  @keyframes hero-ken-burns {
    0% {
      transform: scale(1.08) translate3d(0, 0, 0);
    }

    50% {
      transform: scale(1.14) translate3d(1.2%, -1%, 0);
    }

    100% {
      transform: scale(1.2) translate3d(-1%, 1%, 0);
    }
  }

  @media (max-width: 1023px) {
    .hero-home,
    .hero-home__content {
      min-height: auto;
    }

    .hero-home__slide-image {
      opacity: 0.65;
    }

    .hero-home__overlay {
      background: linear-gradient(
        180deg,
        rgb(255 253 246 / 70%) 0%,
        rgb(255 252 241 / 56%) 32%,
        rgb(255 248 228 / 38%) 62%,
        rgb(255 245 218 / 56%) 100%
      );
    }

    .hero-home__copy::before {
      inset: -2rem -1.25rem;

      border-radius: 2rem;
    }
  }

  @media (max-width: 639px) {
    .hero-home__slide-image {
      opacity: 0.58;
    }

    .hero-home__overlay {
      background: linear-gradient(
        180deg,
        rgb(255 253 246 / 74%) 0%,
        rgb(255 252 241 / 58%) 34%,
        rgb(255 248 228 / 40%) 68%,
        rgb(255 245 218 / 60%) 100%
      );
    }

    .hero-home__mesh {
      opacity: 0.34;
    }

    .hero-home__copy::before {
      inset: -1.5rem -0.75rem;

      background: radial-gradient(
        circle at 30% 35%,
        rgb(255 255 255 / 82%),
        rgb(255 253 246 / 55%) 55%,
        transparent 82%
      );
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-home__slide,
    .hero-home__slide-image {
      animation: none !important;
    }

    .hero-home__slide {
      opacity: 0 !important;
    }

    .hero-home__slide:first-child {
      opacity: 1 !important;
    }

    .hero-home__slide-image {
      transform: scale(1.1) !important;
    }
  }
</style>
