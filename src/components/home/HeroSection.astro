---
import { Image } from 'astro:assets';

import ArrowRightBold from 'phosphor-astro/ArrowRightBold.astro';
import BookOpenTextBold from 'phosphor-astro/BookOpenTextBold.astro';
import HeartBold from 'phosphor-astro/HeartBold.astro';
import PawPrintBold from 'phosphor-astro/PawPrintBold.astro';
import ShieldCheckBold from 'phosphor-astro/ShieldCheckBold.astro';
import ShoppingBagOpenBold from 'phosphor-astro/ShoppingBagOpenBold.astro';
import SparkleBold from 'phosphor-astro/SparkleBold.astro';

import heroSlideOne from '../../assets/home/hero-slide-1.webp';
import heroSlideTwo from '../../assets/home/hero-slide-2.webp';
import heroSlideThree from '../../assets/home/hero-slide-3.webp';

import BrandLogo from '../brand/BrandLogo.astro';
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';

import { isStoreLive } from '../../config/storefront';

const heroSlides = [
    {
        src: heroSlideOne,
    },
    {
        src: heroSlideTwo,
    },
    {
        src: heroSlideThree,
    },
];

const heroHighlights = [
    {
        title: 'Thoughtful product picks',
        description: 'Playful, practical items selected for everyday pet life.',
        icon: SparkleBold,
    },
    {
        title: 'Helpful Pet Guides',
        description: 'Friendly guidance for comfort, care, travel, and more.',
        icon: BookOpenTextBold,
    },
    {
        title: 'Built with heart',
        description: 'A warm pet brand inspired by real-life experience and Maxi.',
        icon: HeartBold,
    },
];
---

<section
    class="hero-home hero-shell relative isolate overflow-hidden"
    aria-labelledby="home-hero-title"
>
    <!-- Full-section background slider -->
    <div class="hero-home__background absolute inset-0 z-0" aria-hidden="true">
        {
        heroSlides.map((slide, index) => (
            <div class="hero-home__slide absolute inset-0" style={`--hero-slide-delay: ${index * 6}s;`}>
            <Image
                src={slide.src}
                alt=""
                class="hero-home__slide-image absolute inset-0 size-full object-cover"
                widths={[768, 1024, 1280, 1600, 1920]}
                sizes="100vw"
                loading={index === 0 ? 'eager' : 'lazy'}
                quality={82}
            />
            </div>
        ))
        }

        <div class="hero-home__overlay absolute inset-0" aria-hidden="true"></div>

        <div class="hero-home__mesh absolute inset-0" aria-hidden="true"></div>
    </div>

    <!-- Decorative glows -->
    <div
        class="motion-parallax pointer-events-none absolute -top-28 -left-24 z-0"
        data-parallax
        data-parallax-speed="0.028"
        aria-hidden="true"
    >
        <div class="size-88 rounded-full bg-brand-300/20 blur-3xl"></div>
    </div>

    <div
        class="motion-parallax pointer-events-none absolute -right-20 -bottom-24 z-0"
        data-parallax
        data-parallax-speed="0.05"
        aria-hidden="true"
    >
        <div class="size-104 rounded-full bg-accent-300/22 blur-3xl"></div>
    </div>

    <div
        class="pointer-events-none absolute top-[12%] right-[6%] z-0 hidden text-brand-200/30 lg:block"
        data-motion-continuous
        aria-hidden="true"
    >
        <PawPrintBold class="motion-float size-16 rotate-12" />
    </div>

    <div
        class="pointer-events-none absolute bottom-[12%] left-[4%] z-0 hidden text-accent-200/28 lg:block"
        data-motion-continuous
        aria-hidden="true"
    >
        <PawPrintBold class="motion-float motion-float-reverse size-12 -rotate-12" />
    </div>

    <div class="site-container-wide relative z-10">
        <div
        class="grid min-h-176 items-center gap-10 py-10 sm:min-h-192 sm:py-12 lg:grid-cols-[1.03fr_0.97fr] lg:gap-12 lg:py-14 xl:min-h-208"
        >
        <!-- Left copy -->
        <div class="max-w-3xl">
            <div data-reveal>
            <Badge variant="accent" size="md">
                <PawPrintBold slot="icon" aria-hidden="true" />

                Happy Pets • Happy Life
            </Badge>

            <h1
                id="home-hero-title"
                class="mt-6 max-w-4xl text-5xl text-white sm:text-6xl lg:text-7xl xl:text-[5.25rem]"
            >
                Playful essentials for pets and
                <span class="motion-gradient-text hero-home__gradient-text text-accent-300">
                {' '}better everyday routines.
                </span>
            </h1>

            <p class="mt-6 max-w-2xl text-lg leading-8 text-white/84 sm:text-xl sm:leading-9">
                Maxi Pawz brings together useful pet products, playful finds, and friendly guidance for
                the people who want everyday life with their pets to feel easier, happier, and more
                thoughtful.
            </p>
            </div>

            <div
            class="mt-8 flex flex-col gap-3 sm:flex-row"
            data-reveal
            style="--reveal-delay: 110ms;"
            >
            {
                isStoreLive ? (
                <Button
                    href="/shop"
                    variant="primary"
                    size="lg"
                    iconPosition="right"
                    class="w-full sm:w-auto"
                >
                    <ShoppingBagOpenBold slot="icon" aria-hidden="true" />
                    Explore the Shop
                </Button>
                ) : (
                <Button
                    href="/#join-the-pack"
                    variant="primary"
                    size="lg"
                    iconPosition="right"
                    class="w-full sm:w-auto"
                >
                    <ArrowRightBold slot="icon" aria-hidden="true" />
                    Join the Pack
                </Button>
                )
            }

            <Button
                href="/pet-guides"
                variant="secondary"
                size="lg"
                iconPosition="right"
                class="w-full sm:w-auto"
            >
                <BookOpenTextBold slot="icon" aria-hidden="true" />

                Browse Pet Guides
            </Button>
            </div>

            <div class="mt-8 grid gap-3 sm:grid-cols-3" data-reveal style="--reveal-delay: 190ms;">
            {
                heroHighlights.map((item) => {
                const Icon = item.icon;

                return (
                    <article class="rounded-3xl border border-white/14 bg-white/10 p-4 shadow-sm">
                    <span
                        class="grid size-11 place-items-center rounded-2xl bg-white/16 text-accent-200"
                        aria-hidden="true"
                    >
                        <Icon class="size-5" />
                    </span>

                    <h2 class="mt-4 text-lg text-white">{item.title}</h2>

                    <p class="mt-2 text-sm leading-6 text-white/72">{item.description}</p>
                    </article>
                );
                })
            }
            </div>
        </div>

        <!-- Right floating composition -->
        <div
            class="relative mx-auto w-full max-w-2xl lg:mx-0"
            data-reveal="right"
            style="--reveal-delay: 120ms;"
        >
            <div class="motion-tilt-shell relative" data-tilt-root data-tilt-strength="2.1">
            <div
                class="motion-tilt-surface hero-home__feature-card relative overflow-hidden rounded-4xl border border-white/14 p-5 shadow-2xl sm:p-6 lg:p-7"
                data-tilt-surface
            >
                <div
                class="pointer-events-none absolute inset-0 bg-linear-to-br from-white/14 via-white/8 to-transparent"
                aria-hidden="true"
                >
                </div>

                <div
                class="pointer-events-none absolute -top-16 -right-10 size-48 rounded-full bg-brand-300/18 blur-3xl"
                aria-hidden="true"
                >
                </div>

                <div
                class="pointer-events-none absolute -bottom-20 -left-12 size-56 rounded-full bg-accent-300/18 blur-3xl"
                aria-hidden="true"
                >
                </div>

                <div class="relative z-10">
                <div class="flex items-start justify-between gap-4">
                    <div class="max-w-sm">
                    <p class="text-xs font-extrabold tracking-[0.12em] text-accent-200 uppercase">
                        Meet the Maxi Pawz world
                    </p>

                    <h2 class="mt-3 text-3xl text-white sm:text-4xl">
                        Friendly products and helpful guidance in one place.
                    </h2>
                    </div>

                    <span
                    class="hidden size-20 shrink-0 place-items-center rounded-3xl border border-white/15 bg-white/12 p-3 shadow-sm sm:grid"
                    aria-hidden="true"
                    >
                    <BrandLogo variant="mark" class="size-full object-contain" />
                    </span>
                </div>

                <div class="mt-6 grid gap-3 sm:grid-cols-2">
                    <div class="rounded-3xl border border-white/12 bg-ink-950/38 p-4">
                    <div class="flex items-center gap-3">
                        <span
                        class="grid size-11 place-items-center rounded-2xl bg-accent-500 text-ink-950"
                        aria-hidden="true"
                        >
                        <ShoppingBagOpenBold class="size-5" />
                        </span>

                        <div>
                        <p class="text-xs font-extrabold tracking-[0.08em] text-white/58 uppercase">
                            Shop
                        </p>

                        <p class="mt-1 text-base text-white">
                            Toys, accessories, travel, care, and more.
                        </p>
                        </div>
                    </div>
                    </div>

                    <div class="rounded-3xl border border-white/12 bg-ink-950/38 p-4">
                    <div class="flex items-center gap-3">
                        <span
                        class="grid size-11 place-items-center rounded-2xl bg-brand-500 text-white"
                        aria-hidden="true"
                        >
                        <ShieldCheckBold class="size-5" />
                        </span>

                        <div>
                        <p class="text-xs font-extrabold tracking-[0.08em] text-white/58 uppercase">
                            Trust
                        </p>

                        <p class="mt-1 text-base text-white">
                            A warm brand built around real pet-owner experience.
                        </p>
                        </div>
                    </div>
                    </div>
                </div>

                <div class="mt-6 rounded-3xl border border-white/12 bg-white/10 p-4">
                    <p class="text-sm font-extrabold tracking-[0.09em] text-accent-200 uppercase">
                    Start here
                    </p>

                    <div class="mt-3 flex flex-wrap gap-2">
                    <a
                        href="/shop"
                        class="inline-flex min-h-10 items-center rounded-full border border-white/12 bg-white/10 px-4 text-sm font-extrabold text-white transition hover:bg-white/16"
                    >
                        Shop Essentials
                    </a>

                    <a
                        href="/pet-guides"
                        class="inline-flex min-h-10 items-center rounded-full border border-white/12 bg-white/10 px-4 text-sm font-extrabold text-white transition hover:bg-white/16"
                    >
                        Read Pet Guides
                    </a>

                    <a
                        href="/about"
                        class="inline-flex min-h-10 items-center rounded-full border border-white/12 bg-white/10 px-4 text-sm font-extrabold text-white transition hover:bg-white/16"
                    >
                        Meet Maxi
                    </a>
                    </div>
                </div>
                </div>
            </div>
            </div>

            <!-- Floating info card 1 -->
            <div
            class="hero-home__floating-card hero-home__floating-card--top motion-bob absolute -top-5 right-3 hidden max-w-56 rounded-3xl border border-white/14 bg-white/92 p-4 text-ink-800 shadow-card lg:block"
            data-motion-continuous
            aria-hidden="true"
            >
            <div class="flex items-start gap-3">
                <span
                class="grid size-10 shrink-0 place-items-center rounded-2xl bg-brand-500 text-white"
                >
                <PawPrintBold class="size-4.5" />
                </span>

                <div>
                <p class="text-xs font-extrabold tracking-[0.08em] text-brand-700 uppercase">
                    Curated with care
                </p>

                <p class="mt-1 text-sm leading-6 text-ink-600">
                    Designed to feel playful, useful, and easy to shop.
                </p>
                </div>
            </div>
            </div>

            <!-- Floating info card 2 -->
            <div
            class="hero-home__floating-card hero-home__floating-card--bottom motion-bob absolute -bottom-5 left-2 hidden max-w-60 rounded-3xl border border-white/14 bg-white/92 p-4 text-ink-800 shadow-card lg:block"
            data-motion-continuous
            style="animation-delay: -2.2s;"
            aria-hidden="true"
            >
            <div class="flex items-start gap-3">
                <span
                class="motion-pulse-ring grid size-10 shrink-0 place-items-center rounded-2xl bg-accent-500 text-ink-950"
                data-motion-continuous
                >
                <SparkleBold class="size-4.5" />
                </span>

                <div>
                <p class="text-xs font-extrabold tracking-[0.08em] text-accent-700 uppercase">
                    More than products
                </p>

                <p class="mt-1 text-sm leading-6 text-ink-600">
                    Helpful pet guidance is part of the experience too.
                </p>
                </div>
            </div>
            </div>
        </div>
        </div>
    </div>
</section>

<style>
    .hero-shell {
        min-height: clamp(44rem, 88vh, 56rem);
    }

    .hero-home {
        background: linear-gradient(180deg, rgb(33 23 17 / 18%) 0%, rgb(33 23 17 / 32%) 100%);
    }

    .hero-home__background {
        background-color: #211711;
    }

    .hero-home__slide {
        opacity: 0;

        animation: hero-slide-fade 18s linear infinite;
        animation-delay: var(--hero-slide-delay);
    }

    .hero-home__slide-image {
        transform: scale(1.08);
        opacity: 0.42;

        animation: hero-ken-burns 18s ease-in-out infinite;
        animation-delay: var(--hero-slide-delay);
    }

    .hero-home__overlay {
        background:
        linear-gradient(
            90deg,
            rgb(19 13 10 / 78%) 0%,
            rgb(19 13 10 / 60%) 30%,
            rgb(19 13 10 / 36%) 58%,
            rgb(19 13 10 / 56%) 100%
        ),
        linear-gradient(
            180deg,
            rgb(19 13 10 / 22%) 0%,
            rgb(19 13 10 / 18%) 18%,
            rgb(19 13 10 / 42%) 100%
        );
    }

    .hero-home__mesh {
        background-image:
        radial-gradient(circle at 16% 18%, rgb(0 138 255 / 12%), transparent 24rem),
        radial-gradient(circle at 82% 72%, rgb(255 102 0 / 10%), transparent 26rem),
        linear-gradient(rgb(255 255 255 / 3%) 1px, transparent 1px),
        linear-gradient(90deg, rgb(255 255 255 / 3%) 1px, transparent 1px);

        background-size:
        auto,
        auto,
        3rem 3rem,
        3rem 3rem;

        mask-image: linear-gradient(to bottom, black, black 80%, transparent);

        opacity: 0.5;
    }

    .hero-home__gradient-text {
        background: linear-gradient(110deg, #ffd098 0%, #ffb35c 25%, #ff8433 52%, #8ed3ff 100%);

        background-clip: text;
        color: transparent;
    }

    .hero-home__feature-card {
        background: linear-gradient(
        145deg,
        rgb(255 255 255 / 13%) 0%,
        rgb(255 255 255 / 9%) 55%,
        rgb(255 255 255 / 6%) 100%
        );
    }

    .hero-home__floating-card {
        backdrop-filter: none;
    }

    .hero-home__floating-card--top {
        transform-origin: top right;
    }

    .hero-home__floating-card--bottom {
        transform-origin: bottom left;
    }

    @keyframes hero-slide-fade {
        0% {
        opacity: 0;
        }

        4% {
        opacity: 1;
        }

        28% {
        opacity: 1;
        }

        37% {
        opacity: 0;
        }

        100% {
        opacity: 0;
        }
    }

    @keyframes hero-ken-burns {
        0% {
        transform: scale(1.08) translate3d(0%, 0%, 0);
        }

        50% {
        transform: scale(1.14) translate3d(1.2%, -1%, 0);
        }

        100% {
        transform: scale(1.2) translate3d(-1%, 1%, 0);
        }
    }

    @media (max-width: 1023px) {
        .hero-shell {
        min-height: auto;
        }

        .hero-home__overlay {
        background: linear-gradient(
            180deg,
            rgb(19 13 10 / 72%) 0%,
            rgb(19 13 10 / 58%) 26%,
            rgb(19 13 10 / 46%) 48%,
            rgb(19 13 10 / 68%) 100%
        );
        }

        .hero-home__feature-card {
        background: linear-gradient(145deg, rgb(255 255 255 / 14%) 0%, rgb(255 255 255 / 10%) 100%);
        }
    }

    @media (max-width: 767px) {
        .hero-home__slide-image {
        opacity: 0.34;
        }

        .hero-home__mesh {
        opacity: 0.38;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .hero-home__slide,
        .hero-home__slide-image {
        animation: none !important;
        }

        .hero-home__slide {
        opacity: 0 !important;
        }

        .hero-home__slide:first-child {
        opacity: 1 !important;
        }

        .hero-home__slide-image {
        transform: scale(1.1) !important;
        }
    }
</style>
