---
import { Image } from 'astro:assets';

import ArrowRightBold from 'phosphor-astro/ArrowRightBold.astro';
import CheckCircleFill from 'phosphor-astro/CheckCircleFill.astro';
import PawPrintBold from 'phosphor-astro/PawPrintBold.astro';

import heroBackground from '../../assets/home/hero-slide-1.webp';

import HeroShowcaseSlider from './HeroShowcaseSlider.astro';
import ProductImage from '../products/ProductImage.astro';
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';

import { isStoreLive } from '../../config/storefront';

import {
  formatProductPrice,
  getActiveProducts,
  getPrimaryProductImage,
} from '../../utils/products';

import { getLocaleFromPathname } from '../../i18n/languages';
import { localizeHref, localizedLinkLabel } from '../../i18n/routes';

const locale = getLocaleFromPathname(Astro.url.pathname);

const t = (english: string, spanish: string): string =>
  locale === 'es' ? spanish : english;

const catalog = getActiveProducts().filter(
  (product) => product.availability !== 'discontinued',
);

// Match the collection's local preview without changing product demo flags.
const requestedPreview = import.meta.env.HOME_COLLECTION_PREVIEW;

const previewMode =
  import.meta.env.DEV &&
  (requestedPreview === 'single' ||
    requestedPreview === 'grid' ||
    requestedPreview === 'empty')
    ? requestedPreview
    : undefined;

const heroProducts =
  previewMode === 'empty'
    ? []
    : catalog.filter((product) => (previewMode ? product.isDemo : !product.isDemo));

const heroProduct = isStoreLive ? heroProducts[0] : undefined;
const hasCollection = Boolean(heroProduct);

const primaryAction = hasCollection
  ? {
      href: '/#home-collection',
      label: t('Explore the Collection', 'Explorar la colección'),
    }
  : {
      href: '/#maxi-pawz-updates',
      label: isStoreLive
        ? t('Get Product Updates', 'Recibir novedades de productos')
        : t('Get Launch Updates', 'Recibir novedades del lanzamiento'),
    };

const secondaryAction = hasCollection
  ? {
      href: '/about',
      label: t('Meet Maxi', 'Conoce a Maxi'),
    }
  : isStoreLive
    ? {
        href: '/pet-guides',
        label: t('Read Pet Guides', 'Leer guías para mascotas'),
      }
    : {
        href: '/#shop-by-lifestyle',
        label: t('Explore What Is Coming', 'Descubrir lo que viene'),
      };

const heroDescription = hasCollection
  ? t(
      'Discover thoughtful products for the everyday moments you share with your pet.',
      'Descubre productos elegidos con cuidado para los momentos que compartes cada día con tu mascota.',
    )
  : isStoreLive
    ? t(
        'Stay in the loop on product news and explore practical guides for everyday pet life.',
        'Recibe novedades de productos y explora guías prácticas para el día a día con tu mascota.',
      )
    : t(
        'Our first collection is on its way. Get launch updates and discover what we are creating for pets and their people.',
        'Nuestra primera colección está en camino. Recibe novedades del lanzamiento y descubre lo que estamos creando para las mascotas y sus familias.',
      );

const heroHighlights = [
  t('Chosen with purpose', 'Elegidos con propósito'),
  t('Inspired by life with Maxi', 'Inspirados en la vida con Maxi'),
];
---

<section
  class="hero-home relative isolate overflow-hidden"
  aria-labelledby="home-hero-title"
>
  <div class="absolute inset-0 -z-10" aria-hidden="true">
    <Image
      src={heroBackground}
      alt=""
      class="size-full object-cover object-center"
      widths={[480, 768, 1024, 1280, 1600, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      quality={78}
    />

    <div class="hero-home__overlay absolute inset-0"></div>
  </div>

  <div
    class="site-container-wide grid items-center gap-8 py-8 sm:py-10 lg:grid-cols-[1.1fr_0.9fr] lg:gap-10 lg:py-12"
  >
    <div class="min-w-0 max-w-2xl">
      <Badge variant={hasCollection ? 'brand' : 'accent'} size="md">
        <PawPrintBold slot="icon" aria-hidden="true" />

        {
          hasCollection
            ? t('Discover Maxi Pawz', 'Descubre Maxi Pawz')
            : t('Built for real pet life', 'Pensado para la vida con mascotas')
        }
      </Badge>

      <h1
        id="home-hero-title"
        class="mt-5 text-4xl leading-[1.08] text-ink-900 sm:text-5xl xl:text-6xl"
      >
        {t('Pet essentials.', 'Esenciales para mascotas.')}

        <span class="mt-1 block text-brand-700">
          {t('Happier everyday moments.', 'Más felicidad cada día.')}
        </span>
      </h1>

      <p class="mt-5 max-w-xl text-base leading-7 text-ink-700 sm:text-lg sm:leading-8">
        {heroDescription}
      </p>

      <div class="mt-6 flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-3">
        <Button
          href={localizeHref(primaryAction.href, locale)}
          variant="primary"
          size="lg"
          iconPosition="right"
          class="w-full sm:w-auto"
        >
          <ArrowRightBold slot="icon" aria-hidden="true" />
          {localizedLinkLabel(primaryAction.label, primaryAction.href, locale)}
        </Button>

        <Button
          href={localizeHref(secondaryAction.href, locale)}
          variant="ghost"
          size="lg"
          class="w-full sm:w-auto"
        >
          {localizedLinkLabel(secondaryAction.label, secondaryAction.href, locale)}
        </Button>
      </div>

      {
        heroProduct && (
          <a
            href={localizeHref('/shop/' + heroProduct.slug, locale)}
            class="mt-6 flex min-w-0 items-center gap-4 rounded-2xl border border-sand bg-white-warm p-3 shadow-sm transition hover:border-brand-300 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-brand-200 lg:hidden"
          >
            <ProductImage
              image={getPrimaryProductImage(heroProduct)}
              variant="thumbnail"
              class="size-20 shrink-0 rounded-xl"
              sizes="80px"
              widths={[80, 160, 240]}
              eager={true}
            />

            <div class="min-w-0 flex-1">
              <p class="text-xs font-extrabold uppercase tracking-wider text-brand-700">
                {heroProduct.isDemo
                  ? t('Demo product preview', 'Vista previa de producto de muestra')
                  : t('Explore the collection', 'Explora la colección')}
              </p>

              <p
                class="mt-1 break-words text-base font-extrabold leading-6 text-ink-900"
                lang={locale === 'es' ? 'en' : undefined}
              >
                {heroProduct.name}
              </p>

              <p class="mt-1 text-sm font-bold text-ink-700">
                {heroProduct.price
                  ? formatProductPrice(heroProduct.price)
                  : t('Details coming soon', 'Próximamente más detalles')}
              </p>
            </div>

            <ArrowRightBold class="size-5 shrink-0 text-brand-700" aria-hidden="true" />
          </a>
        )
      }

      <ul class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-sm font-bold text-ink-700">
        {
          heroHighlights.map((highlight) => (
            <li class="inline-flex items-center gap-2">
              <CheckCircleFill class="size-4 shrink-0 text-brand-700" aria-hidden="true" />
              {highlight}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="hidden min-w-0 lg:block">
      <HeroShowcaseSlider storeLive={isStoreLive && hasCollection} />
    </div>
  </div>
</section>

<style>
  .hero-home {
    background-color: #fff8e6;
  }

  .hero-home__overlay {
    background:
      linear-gradient(
        90deg,
        rgb(255 253 246 / 96%) 0%,
        rgb(255 253 246 / 90%) 38%,
        rgb(255 250 235 / 62%) 68%,
        rgb(255 247 224 / 48%) 100%
      ),
      linear-gradient(
        180deg,
        rgb(255 253 246 / 10%) 0%,
        rgb(255 248 228 / 50%) 100%
      );
  }

  @media (max-width: 1023px) {
    .hero-home__overlay {
      background: linear-gradient(
        180deg,
        rgb(255 253 246 / 95%) 0%,
        rgb(255 252 241 / 92%) 58%,
        rgb(255 248 228 / 88%) 100%
      );
    }
  }
</style>