---
import { Image } from 'astro:assets';

import ArrowLeftBold from 'phosphor-astro/ArrowLeftBold.astro';
import ArrowRightBold from 'phosphor-astro/ArrowRightBold.astro';
import HeartBold from 'phosphor-astro/HeartBold.astro';
import PawPrintBold from 'phosphor-astro/PawPrintBold.astro';
import ShoppingBagOpenBold from 'phosphor-astro/ShoppingBagOpenBold.astro';
import SparkleBold from 'phosphor-astro/SparkleBold.astro';

import maxiHeroImage from '../../assets/home/maxi-4.webp';
import maxiPlayImage from '../../assets/home/shop-by-lifestyle.webp';
import maxiGuideImage from '../../assets/home/hero-slide-3.webp';

import ProductImage from '../products/ProductImage.astro';
import { isStoreLive } from '../../config/storefront';
import { getStorefrontCatalogProducts } from '../../utils/storefront-catalog';
import {
  formatProductPrice,
  getAvailabilityLabel,
  getCategoryLabel,
  getPrimaryProductImage,
} from '../../utils/products';

interface Props {
  storeLive: boolean;
}

const { storeLive } = Astro.props;
const requestedPreview = import.meta.env.HOME_COLLECTION_PREVIEW;
const previewMode =
  import.meta.env.DEV &&
  (requestedPreview === 'single' || requestedPreview === 'grid' || requestedPreview === 'empty')
    ? requestedPreview
    : undefined;

const catalog = getStorefrontCatalogProducts();
const showcaseProducts = storeLive && isStoreLive && previewMode !== 'empty'
  ? catalog
      .filter((product) => previewMode ? product.isDemo : !product.isDemo)
      .slice(0, previewMode === 'single' ? 1 : 4)
  : [];

const showProducts = showcaseProducts.length > 0;

const editorialSlides = [
  {
    image: maxiHeroImage,
    alt: 'Maxi, the dog who inspired Maxi Pawz Store',
    eyebrow: 'Meet Maxi',
    title: 'The happy face behind the Maxi Pawz name.',
    description:
      'Real experiences with Maxi inspired a store focused on joy, usefulness, comfort, and stronger everyday moments with pets.',
    href: '/about',
    linkLabel: 'Meet Maxi',
    accentClass: 'text-accent-200',
    icon: HeartBold,
  },
  {
    image: maxiPlayImage,
    alt: 'Dog enjoying a playful enrichment activity',
    eyebrow: isStoreLive ? 'Stay in the loop' : 'Play & enrichment',
    title: isStoreLive
      ? 'Good things for life with your pet.'
      : 'Products that make playtime count.',
    description: isStoreLive
      ? 'Get Maxi Pawz product news, practical pet guides, and occasional subscriber offers.'
      : 'Explore the everyday pet moments and product categories shaping the first Maxi Pawz collection.',
    href: isStoreLive ? '/#maxi-pawz-updates' : '/#shop-by-lifestyle',
    linkLabel: isStoreLive ? 'Get Product Updates' : 'Explore What Is Coming',
    accentClass: 'text-accent-200',
    icon: SparkleBold,
  },
  {
    image: maxiGuideImage,
    alt: 'Dog prepared for a walk and outdoor adventure',
    eyebrow: 'Practical guidance',
    title: 'Helpful ideas for everyday pet life.',
    description:
      'Discover friendly guidance for choosing products, supporting everyday routines, and making thoughtful decisions for your pet.',
    href: '/pet-guides',
    linkLabel: 'Explore Pet Guides',
    accentClass: 'text-brand-200',
    icon: PawPrintBold,
  },
];

const slideNames = showProducts
  ? showcaseProducts.map((product) => product.name)
  : editorialSlides.map((slide) => slide.title);
const slideCount = slideNames.length;
const sliderLabel = showProducts ? 'Explore the Maxi Pawz collection' : 'Explore Maxi Pawz';
---

<section
  class="hero-showcase relative"
  aria-label={sliderLabel}
  aria-roledescription={slideCount > 1 ? 'carousel' : undefined}
  data-hero-showcase
>
  <div
    class="hero-showcase__floating-label motion-bob pointer-events-none absolute -top-4 left-8 z-40 hidden items-center gap-2 rounded-full border border-white/90 bg-white-warm/96 px-4 py-2 text-sm font-extrabold text-ink-800 shadow-card sm:flex"
    data-motion-continuous
    aria-hidden="true"
  >
    <span class="grid size-7 place-items-center rounded-full bg-accent-100 text-accent-700">
      {showProducts ? <ShoppingBagOpenBold class="size-4" /> : <PawPrintBold class="size-4" />}
    </span>
    {showProducts ? 'Explore the collection' : 'Happy pets • happy life'}
  </div>

  <div class="hero-showcase__viewport relative overflow-hidden rounded-card-lg" data-hero-slider-viewport>
    {
      showProducts
        ? showcaseProducts.map((product, index) => {
            const image = getPrimaryProductImage(product);
            const onSale = Boolean(
              product.price && product.compareAtPrice &&
              product.compareAtPrice.amount > product.price.amount,
            );

            return (
              <article
                class:list={[
                  'hero-showcase__slide group absolute inset-0 overflow-hidden rounded-card-lg border border-white/90 bg-white-warm shadow-card',
                  index === 0 && 'is-active',
                ]}
                role="group"
                aria-roledescription="slide"
                aria-label={`${index + 1} of ${slideCount}: ${product.name}`}
                aria-hidden={index !== 0}
                inert={index !== 0}
                data-hero-slide
                data-slide-name={product.name}
              >
                <ProductImage
                  image={image}
                  eager={index === 0}
                  variant="detail"
                  class="absolute inset-0 size-full"
                  imageClass="transition duration-700 ease-out group-hover:scale-[1.035]"
                  sizes="(min-width: 1280px) 620px, (min-width: 1024px) 48vw, calc(100vw - 2rem)"
                  widths={[480, 640, 800, 960, 1200]}
                  quality={82}
                />

                <div
                  class="absolute inset-0 bg-linear-to-t from-ink-950/92 via-ink-950/30 to-ink-950/4"
                  aria-hidden="true"
                />

                <div class="absolute inset-x-0 top-0 flex flex-wrap items-start justify-end gap-3 p-5 sm:p-6">
                  <span class="rounded-full border border-white/20 bg-white/92 px-3 py-2 text-xs font-extrabold text-ink-700">
                    {getAvailabilityLabel(product.availability)}
                  </span>
                </div>

                <div class="absolute inset-x-0 bottom-0 p-6 text-white sm:p-8">
                  <p class="text-sm font-extrabold tracking-[0.08em] text-accent-200 uppercase">
                    {product.isDemo ? 'Demo product preview' : getCategoryLabel(product.category)}
                  </p>
                  <h2 class="mt-2 max-w-xl text-3xl text-white sm:text-4xl">{product.name}</h2>
                  <p class="mt-3 max-w-xl leading-7 text-white/82">{product.shortDescription}</p>

                  <div class="mt-5 flex flex-wrap items-center justify-between gap-4">
                    <div class="flex flex-wrap items-baseline gap-2">
                      {product.price ? (
                        <span class="text-2xl font-black text-white">
                          {formatProductPrice(product.price)}
                        </span>
                      ) : (
                        <span class="font-extrabold text-white">Price coming soon</span>
                      )}

                      {onSale && product.compareAtPrice && (
                        <span class="text-sm font-bold text-white/58 line-through">
                          <span class="sr-only">Previous price: </span>
                          {formatProductPrice(product.compareAtPrice)}
                        </span>
                      )}
                    </div>

                    <a
                      href={`/shop/${product.slug}`}
                      class="inline-flex min-h-11 items-center gap-2 rounded-full border border-white/25 bg-white px-5 text-sm font-extrabold text-ink-900 shadow-sm transition hover:-translate-y-0.5 hover:bg-cream-soft focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-brand-300"
                    >
                      {product.isDemo ? 'View demo product' : 'View product'}
                      <ArrowRightBold class="size-4" aria-hidden="true" />
                    </a>
                  </div>
                </div>
              </article>
            );
          })
        : editorialSlides.map((slide, index) => {
            const Icon = slide.icon;

            return (
              <article
                class:list={[
                  'hero-showcase__slide group absolute inset-0 overflow-hidden rounded-card-lg border border-white/90 bg-white-warm shadow-card',
                  index === 0 && 'is-active',
                ]}
                role="group"
                aria-roledescription="slide"
                aria-label={`${index + 1} of ${slideCount}: ${slide.title}`}
                aria-hidden={index !== 0}
                inert={index !== 0}
                data-hero-slide
                data-slide-name={slide.title}
              >
                <Image
                  src={slide.image}
                  alt={slide.alt}
                  class="absolute inset-0 size-full object-cover object-center transition duration-700 ease-out group-hover:scale-[1.035]"
                  loading={index === 0 ? 'eager' : 'lazy'}
                  fetchpriority={index === 0 ? 'high' : 'low'}
                  widths={[480, 640, 800, 960, 1200]}
                  sizes="(min-width: 1280px) 620px, (min-width: 1024px) 48vw, calc(100vw - 2rem)"
                  quality={82}
                />

                <div
                  class="absolute inset-0 bg-linear-to-t from-ink-950/90 via-ink-950/24 to-transparent"
                  aria-hidden="true"
                />

                <div class="absolute inset-x-0 bottom-0 p-6 text-white sm:p-8">
                  <span class:list={[
                    'inline-flex items-center gap-2 text-sm font-extrabold tracking-[0.06em] uppercase',
                    slide.accentClass,
                  ]}>
                    <Icon class="size-5" aria-hidden="true" />
                    {slide.eyebrow}
                  </span>

                  <h2 class="mt-3 max-w-xl text-3xl text-white sm:text-4xl">{slide.title}</h2>
                  <p class="mt-3 max-w-xl leading-7 text-white/82">{slide.description}</p>

                  <a
                    href={slide.href}
                    class="mt-5 inline-flex min-h-11 items-center gap-2 rounded-full border border-white/25 bg-white/12 px-5 text-sm font-extrabold text-white transition hover:-translate-y-0.5 hover:bg-white/20 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-brand-300"
                  >
                    {slide.linkLabel}
                    <ArrowRightBold class="size-4" aria-hidden="true" />
                  </a>
                </div>
              </article>
            );
          })
    }
  </div>

  {
    slideCount > 1 && (
      <div class="mt-4 flex flex-wrap items-center justify-between gap-3" data-hero-slider-controls>
        <div class="flex items-center" role="group" aria-label="Choose a slide">
          {slideNames.map((name, index) => (
            <button
              type="button"
              class:list={[
                'hero-showcase__dot grid size-11 shrink-0 place-items-center rounded-full focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-brand-300/45',
                index === 0 && 'is-active',
              ]}
              aria-label={`Show ${name}`}
              aria-current={index === 0 ? 'true' : undefined}
              data-hero-slider-dot
              data-slide-index={index}
            >
              <span class="hero-showcase__dot-mark block h-2.5 w-2.5 rounded-full bg-ink-300 transition-all" aria-hidden="true" />
            </button>
          ))}
        </div>

        <div class="flex items-center gap-2">
          <span class="mr-1 text-sm font-bold tabular-nums text-ink-600" aria-hidden="true" data-hero-slider-count>
            1 / {slideCount}
          </span>
          <button
            type="button"
            class="grid size-11 place-items-center rounded-full border border-sand-dark bg-white-warm text-ink-700 shadow-sm transition hover:border-brand-300 hover:text-brand-700 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-brand-300/45"
            aria-label="Show previous slide"
            data-hero-slider-previous
          >
            <ArrowLeftBold class="size-5" aria-hidden="true" />
          </button>
          <button
            type="button"
            class="grid size-11 place-items-center rounded-full border border-brand-600 bg-brand-500 text-white shadow-blue transition hover:bg-brand-600 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-brand-300/45"
            aria-label="Show next slide"
            data-hero-slider-next
          >
            <ArrowRightBold class="size-5" aria-hidden="true" />
          </button>
        </div>
      </div>
    )
  }

  <p class="sr-only" aria-live="polite" aria-atomic="true" data-hero-slider-status></p>
</section>

<style>
  .hero-showcase__viewport {
    min-height: 30rem;
  }

  .hero-showcase__slide {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translate3d(1rem, 0, 0) scale(0.99);
    transition:
      opacity 420ms var(--ease-friendly),
      visibility 420ms var(--ease-friendly),
      transform 520ms var(--ease-friendly);
  }

  .hero-showcase__slide.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translate3d(0, 0, 0) scale(1);
  }

  .hero-showcase__dot.is-active .hero-showcase__dot-mark {
    width: 2rem;
    background-color: rgb(0 138 255);
  }

  @media (min-width: 640px) {
    .hero-showcase__viewport {
      min-height: 35rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-showcase__slide,
    .hero-showcase__dot-mark {
      transition: none !important;
    }
  }
</style>

<script>
  const initializeHeroShowcaseSliders = (): void => {
    const sliders = document.querySelectorAll<HTMLElement>('[data-hero-showcase]');

    for (const slider of sliders) {
      if (slider.dataset.heroShowcaseInitialized === 'true') continue;
      slider.dataset.heroShowcaseInitialized = 'true';

      const slides = Array.from(slider.querySelectorAll<HTMLElement>('[data-hero-slide]'));
      const dots = Array.from(slider.querySelectorAll<HTMLButtonElement>('[data-hero-slider-dot]'));
      const previousButton = slider.querySelector<HTMLButtonElement>('[data-hero-slider-previous]');
      const nextButton = slider.querySelector<HTMLButtonElement>('[data-hero-slider-next]');
      const controls = slider.querySelector<HTMLElement>('[data-hero-slider-controls]');
      const viewport = slider.querySelector<HTMLElement>('[data-hero-slider-viewport]');
      const count = slider.querySelector<HTMLElement>('[data-hero-slider-count]');
      const status = slider.querySelector<HTMLElement>('[data-hero-slider-status]');
      const listeners = new AbortController();
      const options = { signal: listeners.signal };
      let activeIndex = Math.max(0, slides.findIndex((slide) => slide.classList.contains('is-active')));
      let pointerStart: { id: number; x: number; y: number } | null = null;

      const showSlide = (requestedIndex: number): void => {
        if (slides.length < 2 || !Number.isInteger(requestedIndex)) return;
        const nextIndex = ((requestedIndex % slides.length) + slides.length) % slides.length;
        if (nextIndex === activeIndex) return;

        // Keep keyboard focus out of a slide that is about to become inert.
        if (slides[activeIndex]?.contains(document.activeElement)) {
          nextButton?.focus({ preventScroll: true });
        }

        activeIndex = nextIndex;
        slides.forEach((slide, index) => {
          const active = index === activeIndex;
          slide.classList.toggle('is-active', active);
          slide.setAttribute('aria-hidden', String(!active));
          slide.toggleAttribute('inert', !active);
        });
        dots.forEach((dot, index) => {
          const active = index === activeIndex;
          dot.classList.toggle('is-active', active);
          if (active) dot.setAttribute('aria-current', 'true');
          else dot.removeAttribute('aria-current');
        });
        if (count) count.textContent = `${activeIndex + 1} / ${slides.length}`;
        if (status) status.textContent = `Slide ${activeIndex + 1} of ${slides.length}: ${slides[activeIndex].dataset.slideName ?? ''}`;
      };

      previousButton?.addEventListener('click', () => showSlide(activeIndex - 1), options);
      nextButton?.addEventListener('click', () => showSlide(activeIndex + 1), options);
      dots.forEach((dot) => {
        dot.addEventListener('click', () => showSlide(Number(dot.dataset.slideIndex)), options);
      });

      controls?.addEventListener('keydown', (event) => {
        if (event.altKey || event.ctrlKey || event.metaKey) return;
        const destination = event.key === 'ArrowLeft' ? activeIndex - 1
          : event.key === 'ArrowRight' ? activeIndex + 1
          : event.key === 'Home' ? 0
          : event.key === 'End' ? slides.length - 1
          : undefined;
        if (destination === undefined) return;
        event.preventDefault();
        showSlide(destination);
      }, options);

      viewport?.addEventListener('pointerdown', (event) => {
        if (event.pointerType !== 'touch' || !event.isPrimary) return;
        if (event.target instanceof Element && event.target.closest('a, button, input, select, textarea')) return;
        pointerStart = { id: event.pointerId, x: event.clientX, y: event.clientY };
      }, { ...options, passive: true });

      viewport?.addEventListener('pointerup', (event) => {
        if (!pointerStart || pointerStart.id !== event.pointerId) return;
        const distanceX = event.clientX - pointerStart.x;
        const distanceY = event.clientY - pointerStart.y;
        pointerStart = null;
        if (Math.abs(distanceX) < 48 || Math.abs(distanceX) <= Math.abs(distanceY)) return;
        showSlide(activeIndex + (distanceX > 0 ? -1 : 1));
      }, { ...options, passive: true });

      const clearPointer = (): void => { pointerStart = null; };
      viewport?.addEventListener('pointercancel', clearPointer, options);
      viewport?.addEventListener('pointerleave', clearPointer, options);

      document.addEventListener('astro:before-swap', () => {
        listeners.abort();
        pointerStart = null;
        delete slider.dataset.heroShowcaseInitialized;
      }, { once: true });
    }
  };

  initializeHeroShowcaseSliders();
  document.addEventListener('astro:page-load', initializeHeroShowcaseSliders);
</script>