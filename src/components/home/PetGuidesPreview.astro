---
import { getCollection } from 'astro:content';

import ArrowRightBold from 'phosphor-astro/ArrowRightBold.astro';
import CheckCircleBold from 'phosphor-astro/CheckCircleBold.astro';
import ConfettiBold from 'phosphor-astro/ConfettiBold.astro';
import HeartBold from 'phosphor-astro/HeartBold.astro';
import PawPrintBold from 'phosphor-astro/PawPrintBold.astro';
import ShieldCheckBold from 'phosphor-astro/ShieldCheckBold.astro';
import ShoppingBagOpenBold from 'phosphor-astro/ShoppingBagOpenBold.astro';
import SparkleBold from 'phosphor-astro/SparkleBold.astro';
import SuitcaseRollingBold from 'phosphor-astro/SuitcaseRollingBold.astro';

import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';

import {
  homepagePetGuides,
  type HomepagePetGuide,
  type PetGuideIcon,
  type PetGuideTone,
} from '../../data/pet-guides';

const iconByGuide: Record<PetGuideIcon, typeof PawPrintBold> = {
  choosing: CheckCircleBold,
  play: ConfettiBold,
  travel: SuitcaseRollingBold,
  hydration: HeartBold,
  comfort: PawPrintBold,
  care: ShieldCheckBold,
  accessories: ShoppingBagOpenBold,
};

const cardToneClasses: Record<PetGuideTone, string> = {
  brand: [
    'border-brand-200',
    'bg-brand-50',
    'hover:border-brand-300',
    'focus-visible:border-brand-400',
  ].join(' '),

  accent: [
    'border-accent-200',
    'bg-accent-50',
    'hover:border-accent-300',
    'focus-visible:border-accent-400',
  ].join(' '),

  sand: [
    'border-sand-dark/70',
    'bg-cream-soft',
    'hover:border-sand-dark',
    'focus-visible:border-sand-dark',
  ].join(' '),
};

const iconToneClasses: Record<PetGuideTone, string> = {
  brand: 'bg-brand-500 text-white shadow-blue',
  accent: 'bg-accent-500 text-ink-950 shadow-orange',
  sand: 'bg-ink-800 text-white shadow-soft',
};

const eyebrowToneClasses: Record<PetGuideTone, string> = {
  brand: 'text-brand-800',
  accent: 'text-accent-800',
  sand: 'text-ink-700',
};

const accentToneClasses: Record<PetGuideTone, string> = {
  brand: 'from-brand-300 via-brand-500 to-accent-400',
  accent: 'from-accent-300 via-accent-500 to-brand-400',
  sand: 'from-sand-dark via-ink-500 to-brand-400',
};

interface GuideHeroImage {
  src: string;
  alt: string;
}

interface HomepageGuideWithImage extends HomepagePetGuide {
  image?: GuideHeroImage;
}

const blogEntries = await getCollection('blog');

const heroImageBySlug = new Map<string, GuideHeroImage>();

for (const entry of blogEntries) {
  const normalizedId = entry.id.replace(/\.(md|mdx)$/i, '');

  const heroImage = entry.data.heroImage;

  if (!heroImage?.src || !heroImage.alt) {
    continue;
  }

  heroImageBySlug.set(normalizedId, {
    src: heroImage.src,
    alt: heroImage.alt,
  });
}

const guides: HomepageGuideWithImage[] = homepagePetGuides.map((guide) => ({
  ...guide,
  image: heroImageBySlug.get(guide.slug),
}));
---

<section
  id="pet-guides-preview"
  class="pet-guides-preview section-spacing relative isolate scroll-mt-28 overflow-hidden border-b border-sand bg-white-warm/75"
  aria-labelledby="pet-guides-preview-title"
  data-pet-guides-preview
>
  <div
    class="pet-guides-preview__pattern pointer-events-none absolute inset-0"
    aria-hidden="true"
  >
  </div>

  <div
    class="pet-guides-preview__parallax pointer-events-none absolute -top-28 -left-24"
    data-guide-parallax
    data-guide-parallax-speed="0.035"
    aria-hidden="true"
  >
    <div
      class="pet-guides-preview__orb size-88 rounded-full bg-brand-300/22 blur-3xl"
    >
    </div>
  </div>

  <div
    class="pet-guides-preview__parallax pointer-events-none absolute -right-28 bottom-8"
    data-guide-parallax
    data-guide-parallax-speed="0.052"
    aria-hidden="true"
  >
    <div
      class="pet-guides-preview__orb pet-guides-preview__orb--orange size-96 rounded-full bg-accent-300/20 blur-3xl"
    >
    </div>
  </div>

  <span
    class="pet-guides-preview__floating-paw pointer-events-none absolute top-[18%] right-[5%] hidden text-brand-300/35 lg:block"
    aria-hidden="true"
  >
    <PawPrintBold class="size-14 rotate-12" />
  </span>

  <span
    class="pet-guides-preview__floating-paw pet-guides-preview__floating-paw--two pointer-events-none absolute bottom-[14%] left-[4%] hidden text-accent-300/30 lg:block"
    aria-hidden="true"
  >
    <PawPrintBold class="size-11 -rotate-12" />
  </span>

  <div class="site-container relative z-10">
    <div class="grid items-end gap-7 lg:grid-cols-[1.05fr_0.95fr] lg:gap-14">
      <div data-guide-reveal>
        <h2
          id="pet-guides-preview-title"
          class="section-title mt-5 max-w-3xl text-4xl sm:text-5xl lg:text-6xl"
          data-guide-heading
        >
          Helpful guidance for everyday life with your friend.
        </h2>
      </div>

      <div
        class="lg:pb-1"
        data-guide-reveal
        style="--guide-reveal-delay: 90ms;"
      >
        <p
          class="section-description max-w-2xl lg:ml-auto"
          data-guide-description
        >
          Explore practical information inspired by our experiences with Maxi—from choosing toys to
          preparing for walks, travel, feeding, hydration, comfort, and care.
        </p>

        <div class="mt-5 flex flex-wrap items-center gap-3">
          <span
            class="inline-flex items-center gap-2 rounded-full border border-accent-200 bg-accent-50/90 px-4 py-2 text-sm font-extrabold text-accent-800 shadow-sm"
          >
            <CheckCircleBold class="size-4" aria-hidden="true" />

            Practical and easy to follow
          </span>

          <span class="text-sm font-bold text-ink-500">
            Built for real pet routines.
          </span>
        </div>
      </div>
    </div>

    <!--
      All cards now share one layout.

      The first DOM child becomes the large editorial card on
      desktop. When personalization changes the DOM order, the
      recommended guide automatically becomes the featured card.
    -->
    <div
      class="mt-10 grid gap-5 lg:mt-12 lg:grid-cols-[1.16fr_0.84fr] lg:grid-rows-3 lg:gap-6"
      data-guide-grid
    >
      {
        guides.map((guide, index) => {
          const Icon = iconByGuide[guide.icon];

          return (
            <article
              class={[
                'guide-preview-card h-full',
                'lg:first:row-span-3',
              ].join(' ')}
              data-guide-card
              data-guide-slug={guide.slug}
              data-guide-reveal={index === 0 ? 'left' : 'right'}
              style={`--guide-reveal-delay: ${150 + index * 80}ms;`}
            >
              <a
                href={guide.href}
                class:list={[
                  'guide-preview-card__surface group relative isolate flex h-full min-h-60 flex-col overflow-hidden rounded-card border p-5 shadow-sm sm:p-6',
                  'lg:[article:first-child_&]:min-h-128 lg:[article:first-child_&]:rounded-card-lg lg:[article:first-child_&]:p-8',
                  'focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-brand-300',
                  'focus-visible:ring-offset-2 focus-visible:ring-offset-cream-soft',
                  cardToneClasses[guide.tone],
                ]}
                data-guide-interactive
                data-guide-strength={index === 0 ? '4.2' : '3.1'}
                aria-label={`Read guide: ${guide.cardTitle}`}
              >
                {
                  guide.image && (
                    <div
                      class="pointer-events-none absolute inset-0 z-0 overflow-hidden rounded-[inherit]"
                      aria-hidden="true"
                    >
                      <img
                        src={guide.image.src}
                        alt=""
                        loading="lazy"
                        decoding="async"
                        class={[
                          'size-full object-cover',
                          'scale-[1.035] opacity-[0.88]',
                          'saturate-[0.95] contrast-[0.98]',
                          'transition-[transform,opacity,filter] duration-700 ease-out',
                          'group-hover:scale-[1.13] group-hover:opacity-[0.98]',
                          'group-hover:saturate-100 group-hover:contrast-100',
                          'group-focus-visible:scale-[1.13] group-focus-visible:opacity-[0.98]',
                          'group-focus-visible:saturate-100 group-focus-visible:contrast-100',
                          'motion-reduce:scale-[1.035] motion-reduce:transition-none',
                          'lg:[article:first-child_&]:scale-[1.03]',
                          'lg:[article:first-child_&]:opacity-90',
                          'lg:[article:first-child_.group:hover_&]:scale-[1.12]',
                          'lg:[article:first-child_.group:hover_&]:opacity-100',
                        ].join(' ')}
                      />

                      <div
                        class={[
                          'absolute inset-0',
                          'bg-[linear-gradient(180deg,rgba(255,254,249,0.04)_0%,rgba(255,254,249,0.08)_38%,rgba(255,254,249,0.60)_100%)]',
                          'transition-[background] duration-500 ease-out',
                          'group-hover:bg-[linear-gradient(180deg,rgba(255,254,249,0.02)_0%,rgba(255,254,249,0.04)_38%,rgba(255,254,249,0.52)_100%)]',
                          'group-focus-visible:bg-[linear-gradient(180deg,rgba(255,254,249,0.02)_0%,rgba(255,254,249,0.04)_38%,rgba(255,254,249,0.52)_100%)]',
                          'motion-reduce:transition-none',
                        ].join(' ')}
                      >
                      </div>
                    </div>
                  )
                }

                <span
                  class:list={[
                    'absolute inset-x-0 top-0 z-20 h-1 bg-linear-to-r',
                    'lg:[article:first-child_&]:h-1.5',
                    accentToneClasses[guide.tone],
                  ]}
                  aria-hidden="true"
                >
                </span>

                <div
                  class="guide-preview-card__orb guide-preview-card__orb--one pointer-events-none absolute -top-20 -right-16 z-1 size-56 rounded-full bg-white/45 blur-3xl lg:[article:first-child_&]:-top-24 lg:[article:first-child_&]:-right-20 lg:[article:first-child_&]:size-72"
                  aria-hidden="true"
                >
                </div>

                <div
                  class="guide-preview-card__watermark pointer-events-none absolute -right-5 -bottom-8 z-1 text-white/60 lg:[article:first-child_&]:-right-12 lg:[article:first-child_&]:-bottom-14"
                  aria-hidden="true"
                >
                  <Icon class="size-40 lg:[article:first-child_&]:size-72" />
                </div>

                <div
                  class="guide-preview-card__spotlight pointer-events-none absolute inset-0 z-2"
                  aria-hidden="true"
                >
                </div>

                <div class="relative z-10 flex h-full flex-col">
                  <div class="flex items-start justify-between gap-4">
                    <span
                      class:list={[
                        'guide-preview-card__icon grid size-12 shrink-0 place-items-center rounded-2xl',
                        '[&>svg]:size-6',
                        'lg:[article:first-child_&]:size-16',
                        'lg:[article:first-child_&]:[&>svg]:size-8',
                        iconToneClasses[guide.tone],
                      ]}
                      aria-hidden="true"
                    >
                      <Icon />
                    </span>

                    <span
                      class="hidden rounded-full border border-white/70 bg-white/88 px-3 py-1.5 text-xs font-black uppercase tracking-[0.13em] text-ink-800 shadow-sm backdrop-blur-md lg:[article:first-child_&]:inline-flex"
                      data-guide-featured-label
                    >
                      Featured guide
                    </span>
                  </div>

                  <div
                    class={[
                      'mt-auto rounded-2xl bg-white/74 p-4 shadow-sm backdrop-blur-[2px]',
                      'lg:[article:first-child_&]:max-w-2xl',
                      'lg:[article:first-child_&]:rounded-3xl',
                      'lg:[article:first-child_&]:p-6',
                    ].join(' ')}
                  >
                    <div class="flex flex-wrap items-center gap-2">
                      <span
                        class:list={[
                          'text-xs font-black uppercase tracking-[0.15em]',
                          eyebrowToneClasses[guide.tone],
                        ]}
                      >
                        {guide.eyebrow}
                      </span>

                      <span
                        class="size-1 rounded-full bg-ink-300"
                        aria-hidden="true"
                      >
                      </span>

                      <span class="text-xs font-extrabold text-ink-600">
                        {guide.readingTime}
                      </span>
                    </div>

                    <h3
                      class="mt-2 text-2xl text-ink-950 sm:text-[1.7rem] lg:[article:first-child_&]:mt-3 lg:[article:first-child_&]:text-[2.75rem]"
                    >
                      {guide.cardTitle}
                    </h3>

                    <p
                      class="mt-3 line-clamp-3 text-sm leading-6 text-ink-800 lg:[article:first-child_&]:mt-4 lg:[article:first-child_&]:line-clamp-none lg:[article:first-child_&]:text-lg lg:[article:first-child_&]:leading-8"
                    >
                      {guide.description}
                    </p>

                    <span
                      class="guide-preview-card__text-link mt-4 inline-flex w-fit items-center gap-2 font-extrabold text-brand-800 lg:[article:first-child_&]:mt-6 lg:[article:first-child_&]:rounded-full lg:[article:first-child_&]:bg-ink-900 lg:[article:first-child_&]:px-5 lg:[article:first-child_&]:py-3 lg:[article:first-child_&]:text-white lg:[article:first-child_&]:shadow-soft"
                    >
                      Read guide

                      <ArrowRightBold
                        class="guide-preview-card__arrow size-4 lg:[article:first-child_&]:size-5"
                        aria-hidden="true"
                      />
                    </span>
                  </div>
                </div>
              </a>
            </article>
          );
        })
      }
    </div>

    <div
      class="pet-guides-preview__cta mt-10 overflow-hidden rounded-card-lg border border-accent-200/70 bg-linear-to-br from-accent-50 via-white-warm to-brand-50 p-6 shadow-card sm:p-8 lg:mt-12"
      data-guide-reveal
      style={`--guide-reveal-delay: ${300 + guides.length * 80}ms;`}
    >
      <div
        class="relative z-10 flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between"
      >
        <div class="flex max-w-2xl items-start gap-4">
          <span
            class="grid size-12 shrink-0 place-items-center rounded-2xl bg-brand-500 text-white shadow-blue"
            aria-hidden="true"
          >
            <SparkleBold class="size-6" />
          </span>

          <div>
            <h3 class="text-2xl text-ink-900 sm:text-3xl">
              Practical answers for more of your everyday pet questions.
            </h3>

            <p class="mt-2 leading-7 text-ink-600">
              Browse the full Maxi Pawz guide library for help with products, play, travel,
              hydration, comfort, grooming, and accessories.
            </p>
          </div>
        </div>

        <div class="shrink-0">
          <Button
            href="/pet-guides"
            variant="primary"
            size="lg"
            iconPosition="right"
            class="w-full sm:w-auto"
          >
            <ArrowRightBold slot="icon" aria-hidden="true" />

            Explore All Pet Guides
          </Button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .pet-guides-preview {
    --guide-parallax-y: 0px;
  }

  .pet-guides-preview__pattern {
    background-image:
      radial-gradient(circle at 20% 30%, rgb(0 138 255 / 7%) 0, transparent 24rem),
      radial-gradient(circle at 82% 70%, rgb(255 102 0 / 7%) 0, transparent 25rem),
      radial-gradient(circle, rgb(113 87 72 / 8%) 1px, transparent 1px);

    background-size:
      auto,
      auto,
      2.2rem 2.2rem;

    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent,
      black 12%,
      black 88%,
      transparent
    );

    mask-image: linear-gradient(
      to bottom,
      transparent,
      black 12%,
      black 88%,
      transparent
    );

    opacity: 0.7;
  }

  .pet-guides-preview__parallax {
    transform: translate3d(0, var(--guide-parallax-y), 0);

    will-change: transform;
  }

  .pet-guides-preview__orb {
    animation: guide-orb-drift 11s ease-in-out infinite;

    will-change: transform;
  }

  .pet-guides-preview__orb--orange {
    animation-delay: -5s;
    animation-direction: reverse;
  }

  .pet-guides-preview__floating-paw {
    animation: guide-paw-float 7s ease-in-out infinite;

    will-change: transform;
  }

  .pet-guides-preview__floating-paw--two {
    animation-delay: -3.5s;
    animation-direction: reverse;
  }

  .guide-preview-card__surface {
    --guide-card-lift: 0px;
    --guide-card-rotate-x: 0deg;
    --guide-card-rotate-y: 0deg;
    --guide-card-spotlight-x: 50%;
    --guide-card-spotlight-y: 50%;
    --guide-card-icon-x: 0px;
    --guide-card-icon-y: 0px;

    transform:
      perspective(1100px)
      translate3d(
        0,
        var(--guide-card-lift),
        0
      )
      rotateX(
        var(--guide-card-rotate-x)
      )
      rotateY(
        var(--guide-card-rotate-y)
      );

    transform-style: preserve-3d;

    transition:
      transform 280ms var(--ease-friendly),
      border-color 240ms var(--ease-friendly),
      box-shadow 280ms var(--ease-friendly);

    will-change: transform;
  }

  .guide-preview-card__surface:hover,
  .guide-preview-card__surface:focus-visible {
    --guide-card-lift: -6px;

    box-shadow: var(--shadow-card-hover);
  }

  .guide-preview-card__spotlight {
    background: radial-gradient(
      circle 15rem at
        var(--guide-card-spotlight-x)
        var(--guide-card-spotlight-y),
      rgb(255 255 255 / 20%),
      transparent 68%
    );

    opacity: 0;

    transition: opacity 220ms ease;
  }

  .guide-preview-card__surface:hover
    .guide-preview-card__spotlight,
  .guide-preview-card__surface:focus-visible
    .guide-preview-card__spotlight {
    opacity: 1;
  }

  .guide-preview-card__icon {
    transform:
      translate3d(
        var(--guide-card-icon-x),
        var(--guide-card-icon-y),
        2rem
      )
      rotate(0deg)
      scale(1);

    transition:
      transform 260ms var(--ease-bounce-soft),
      box-shadow 260ms var(--ease-friendly);

    will-change: transform;
  }

  .guide-preview-card__surface:hover
    .guide-preview-card__icon,
  .guide-preview-card__surface:focus-visible
    .guide-preview-card__icon {
    transform:
      translate3d(
        var(--guide-card-icon-x),
        var(--guide-card-icon-y),
        2.4rem
      )
      rotate(4deg)
      scale(1.06);
  }

  .guide-preview-card__watermark {
    transform: translate3d(
      var(--guide-card-icon-x),
      var(--guide-card-icon-y),
      0
    );

    transition:
      transform 600ms var(--ease-friendly),
      opacity 600ms var(--ease-friendly);

    opacity: 0.25;
  }

  .guide-preview-card__surface:hover
    .guide-preview-card__watermark,
  .guide-preview-card__surface:focus-visible
    .guide-preview-card__watermark {
    opacity: 0.42;
  }

  .guide-preview-card__orb {
    transition: transform 650ms var(--ease-friendly);
  }

  .guide-preview-card__surface:hover
    .guide-preview-card__orb--one,
  .guide-preview-card__surface:focus-visible
    .guide-preview-card__orb--one {
    transform:
      translate3d(
        -0.8rem,
        0.6rem,
        0
      )
      scale(1.1);
  }

  .guide-preview-card__text-link {
    transition:
      gap 200ms var(--ease-friendly),
      transform 200ms var(--ease-bounce-soft),
      background-color 200ms var(--ease-friendly);
  }

  .guide-preview-card__surface:hover
    .guide-preview-card__text-link,
  .guide-preview-card__surface:focus-visible
    .guide-preview-card__text-link {
    gap: 0.75rem;
  }

  .guide-preview-card__arrow {
    transition: transform 200ms var(--ease-friendly);
  }

  .guide-preview-card__surface:hover
    .guide-preview-card__arrow,
  .guide-preview-card__surface:focus-visible
    .guide-preview-card__arrow {
    transform: translateX(0.22rem);
  }

  .pet-guides-preview__cta {
    position: relative;
  }

  .pet-guides-preview__cta::before {
    position: absolute;
    top: -8rem;
    right: -5rem;

    width: 20rem;
    height: 20rem;

    border-radius: 9999px;

    background: rgb(0 138 255 / 16%);

    content: '';
    filter: blur(2.5rem);
    pointer-events: none;
  }

  .pet-guides-preview__cta::after {
    position: absolute;
    bottom: -9rem;
    left: 18%;

    width: 18rem;
    height: 18rem;

    border-radius: 9999px;

    background: rgb(255 102 0 / 14%);

    content: '';
    filter: blur(2.5rem);
    pointer-events: none;
  }

  .pet-guides-motion-ready
    [data-guide-reveal] {
    opacity: 0;

    transform:
      translate3d(
        0,
        1.65rem,
        0
      )
      scale(0.985);

    transition:
      opacity
        660ms
        var(--ease-friendly)
        var(--guide-reveal-delay, 0ms),
      transform
        660ms
        var(--ease-friendly)
        var(--guide-reveal-delay, 0ms);

    will-change:
      opacity,
      transform;
  }

  .pet-guides-motion-ready
    [data-guide-reveal='left'] {
    transform:
      translate3d(
        -2rem,
        0,
        0
      )
      scale(0.985);
  }

  .pet-guides-motion-ready
    [data-guide-reveal='right'] {
    transform:
      translate3d(
        2rem,
        0,
        0
      )
      scale(0.985);
  }

  .pet-guides-motion-ready
    [data-guide-reveal].is-guide-visible {
    opacity: 1;

    transform:
      translate3d(
        0,
        0,
        0
      )
      scale(1);
  }

  @keyframes guide-orb-drift {
    0%,
    100% {
      transform:
        translate3d(
          0,
          0,
          0
        )
        scale(1);
    }

    50% {
      transform:
        translate3d(
          1rem,
          -1rem,
          0
        )
        scale(1.06);
    }
  }

  @keyframes guide-paw-float {
    0%,
    100% {
      transform:
        translate3d(
          0,
          0,
          0
        )
        rotate(-4deg);
    }

    50% {
      transform:
        translate3d(
          0.45rem,
          -0.75rem,
          0
        )
        rotate(5deg);
    }
  }

  @media (hover: none), (pointer: coarse) {
    .guide-preview-card__surface {
      transform: none !important;

      will-change: auto;
    }

    .guide-preview-card__spotlight {
      display: none;
    }

    .guide-preview-card__icon,
    .guide-preview-card__watermark {
      transform: none;

      will-change: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pet-guides-preview__parallax,
    .pet-guides-preview__orb,
    .pet-guides-preview__floating-paw,
    .guide-preview-card__surface,
    .guide-preview-card__spotlight,
    .guide-preview-card__icon,
    .guide-preview-card__watermark,
    .guide-preview-card__orb,
    .guide-preview-card__text-link,
    .guide-preview-card__arrow,
    .pet-guides-motion-ready
      [data-guide-reveal] {
      animation: none !important;
      transition: none !important;
    }

    .guide-preview-card__surface,
    .guide-preview-card__icon,
    .guide-preview-card__watermark,
    .guide-preview-card__orb,
    .guide-preview-card__text-link,
    .guide-preview-card__arrow,
    .pet-guides-motion-ready
      [data-guide-reveal] {
      transform: none !important;
    }

    .pet-guides-motion-ready
      [data-guide-reveal] {
      opacity: 1 !important;
    }

    .guide-preview-card__spotlight {
      display: none !important;
    }
  }
</style>

<script>
  import {
    buildFoundingPackPersonalizedMessaging,
    deserializeFoundingPackPersonalizationProfile,
    getPersonalizedGuidePriorities,
  } from '../../lib/founding-pack-personalization';

  import {
    FOUNDING_PACK_PERSONALIZATION_STORAGE_KEY,
    type FoundingPackPersonalizationProfile,
  } from '../../types/founding-pack-personalization';

  const PERSONALIZATION_SAVED_EVENT =
    'maxipawz:founding-pet-personalization-saved';

  const PERSONALIZATION_FORGOTTEN_EVENT =
    'maxipawz:founding-pet-personalization-forgotten';

  const DEFAULT_GUIDE_HEADING =
    'Helpful guidance for everyday life with your friend.';

  const DEFAULT_GUIDE_DESCRIPTION =
    'Explore practical information inspired by our experiences with Maxi—from choosing toys to preparing for walks, travel, feeding, hydration, comfort, and care.';

  const DEFAULT_BADGE_LABEL =
    'Practical Pet Guides';

  const initializePetGuidePreviews =
    (): void => {
      const sections =
        Array.from(
          document.querySelectorAll<HTMLElement>(
            '[data-pet-guides-preview]',
          ),
        );

      for (const section of sections) {
        if (
          section.dataset.petGuidesInitialized ===
          'true'
        ) {
          continue;
        }

        section.dataset.petGuidesInitialized =
          'true';

        const guideGrid =
          section.querySelector<HTMLElement>(
            '[data-guide-grid]',
          );

        const heading =
          section.querySelector<HTMLElement>(
            '[data-guide-heading]',
          );

        const description =
          section.querySelector<HTMLElement>(
            '[data-guide-description]',
          );

        const badgeLabel =
          section.querySelector<HTMLElement>(
            '[data-guide-badge-label]',
          );

        if (!guideGrid) {
          continue;
        }

        /*
         * Capture the server-rendered editorial order once.
         * We can always return to this exact order when local
         * personalization disappears.
         */
        const editorialCards =
          Array.from(
            guideGrid.querySelectorAll<HTMLElement>(
              '[data-guide-card]',
            ),
          );

        const editorialSlugs =
          editorialCards
            .map(
              (card) =>
                card.dataset.guideSlug,
            )
            .filter(
              (slug): slug is string =>
                Boolean(slug),
            );

        const cardsBySlug =
          new Map<string, HTMLElement>();

        for (const card of editorialCards) {
          const slug =
            card.dataset.guideSlug;

          if (slug) {
            cardsBySlug.set(
              slug,
              card,
            );
          }
        }

        const updateCardRoles =
          (): void => {
            const currentCards =
              Array.from(
                guideGrid.querySelectorAll<HTMLElement>(
                  '[data-guide-card]',
                ),
              );

            currentCards.forEach(
              (card, index) => {
                card.dataset.guideReveal =
                  index === 0
                    ? 'left'
                    : 'right';

                const interactive =
                  card.querySelector<HTMLElement>(
                    '[data-guide-interactive]',
                  );

                if (interactive) {
                  interactive.dataset.guideStrength =
                    index === 0
                      ? '4.2'
                      : '3.1';
                }

                const featuredLabel =
                  card.querySelector<HTMLElement>(
                    '[data-guide-featured-label]',
                  );

                if (featuredLabel) {
                  featuredLabel.textContent =
                    section.dataset
                      .guidePersonalized ===
                    'true'
                      ? 'Picked for your pet'
                      : 'Featured guide';
                }
              },
            );
          };

        const restoreEditorialCopy =
          (): void => {
            section.dataset.guidePersonalized =
              'false';

            if (heading) {
              heading.textContent =
                DEFAULT_GUIDE_HEADING;
            }

            if (description) {
              description.textContent =
                DEFAULT_GUIDE_DESCRIPTION;
            }

            if (badgeLabel) {
              badgeLabel.textContent =
                DEFAULT_BADGE_LABEL;
            }
          };

        const restoreEditorialOrder =
          (): void => {
            for (const slug of editorialSlugs) {
              const card =
                cardsBySlug.get(slug);

              if (card) {
                guideGrid.append(card);
              }
            }

            restoreEditorialCopy();

            updateCardRoles();
          };

        const applyProfile =
          (
            profile:
              FoundingPackPersonalizationProfile,
          ): void => {
            const priorities =
              getPersonalizedGuidePriorities(
                profile,
              );

            /*
             * Cat/other profiles intentionally return no
             * dog-guide priorities. Keep the editorial
             * presentation unchanged.
             */
            if (
              priorities.length ===
              0
            ) {
              restoreEditorialOrder();

              return;
            }

            const orderedSlugs = [
              ...priorities,

              ...editorialSlugs.filter(
                (slug) =>
                  !priorities.includes(
                    slug,
                  ),
              ),
            ];

            for (const slug of orderedSlugs) {
              const card =
                cardsBySlug.get(slug);

              if (card) {
                guideGrid.append(card);
              }
            }

            const messaging =
              buildFoundingPackPersonalizedMessaging(
                profile,
              );

            section.dataset.guidePersonalized =
              'true';

            if (badgeLabel) {
              badgeLabel.textContent =
                `Picked for ${profile.petName}`;
            }

            if (heading) {
              heading.textContent =
                messaging.guideHeading;
            }

            if (description) {
              description.textContent =
                messaging.guideDescription;
            }

            updateCardRoles();
          };

        const readStoredProfile =
          (): FoundingPackPersonalizationProfile | null => {
            try {
              const serialized =
                window.localStorage.getItem(
                  FOUNDING_PACK_PERSONALIZATION_STORAGE_KEY,
                );

              if (!serialized) {
                return null;
              }

              return deserializeFoundingPackPersonalizationProfile(
                serialized,
              );
            } catch (error) {
              console.warn(
                'Maxi Pawz pet personalization could not be read for guide recommendations.',
                error,
              );

              return null;
            }
          };

        const applyStoredProfile =
          (): void => {
            const profile =
              readStoredProfile();

            if (!profile) {
              restoreEditorialOrder();

              return;
            }

            applyProfile(profile);
          };

        const handleSavedProfile =
          (
            event:
              Event,
          ): void => {
            const customEvent =
              event as
              CustomEvent<FoundingPackPersonalizationProfile>;

            const profile =
              customEvent.detail;

            if (!profile) {
              applyStoredProfile();

              return;
            }

            applyProfile(profile);
          };

        const handleForgottenProfile =
          (): void => {
            restoreEditorialOrder();
          };

        /*
         * Apply personalization before reveal observers start.
         * This minimizes visible reordering during initial load.
         */
        applyStoredProfile();

        window.addEventListener(
          PERSONALIZATION_SAVED_EVENT,
          handleSavedProfile,
        );

        window.addEventListener(
          PERSONALIZATION_FORGOTTEN_EVENT,
          handleForgottenProfile,
        );

        const reducedMotion =
          window.matchMedia(
            '(prefers-reduced-motion: reduce)',
          ).matches;

        const revealElements =
          Array.from(
            section.querySelectorAll<HTMLElement>(
              '[data-guide-reveal]',
            ),
          );

        let revealObserver:
          IntersectionObserver |
          null =
          null;

        if (
          !reducedMotion &&
          'IntersectionObserver' in window
        ) {
          section.classList.add(
            'pet-guides-motion-ready',
          );

          revealObserver =
            new IntersectionObserver(
              (
                entries,
                observer,
              ) => {
                for (const entry of entries) {
                  if (!entry.isIntersecting) {
                    continue;
                  }

                  entry.target.classList.add(
                    'is-guide-visible',
                  );

                  observer.unobserve(
                    entry.target,
                  );
                }
              },
              {
                rootMargin:
                  '0px 0px -8% 0px',

                threshold:
                  0.1,
              },
            );

          const observer =
            revealObserver;

          window.requestAnimationFrame(
            () => {
              for (
                const element of
                revealElements
              ) {
                observer.observe(
                  element,
                );
              }
            },
          );
        } else {
          for (
            const element of
            revealElements
          ) {
            element.classList.add(
              'is-guide-visible',
            );
          }
        }

        const parallaxElements =
          Array.from(
            section.querySelectorAll<HTMLElement>(
              '[data-guide-parallax]',
            ),
          );

        let parallaxFrame =
          0;

        const updateParallax =
          (): void => {
            parallaxFrame =
              0;

            const sectionRect =
              section.getBoundingClientRect();

            const viewportCenter =
              window.innerHeight /
              2;

            const sectionCenter =
              sectionRect.top +
              sectionRect.height /
              2;

            const distanceFromCenter =
              sectionCenter -
              viewportCenter;

            for (
              const element of
              parallaxElements
            ) {
              const speed =
                Number(
                  element.dataset
                    .guideParallaxSpeed ??
                    '0.03',
                );

              const offset =
                Math.max(
                  -44,
                  Math.min(
                    44,
                    -distanceFromCenter *
                      speed,
                  ),
                );

              element.style.setProperty(
                '--guide-parallax-y',
                `${offset.toFixed(
                  2,
                )}px`,
              );
            }
          };

        const requestParallaxUpdate =
          (): void => {
            if (
              parallaxFrame !==
              0
            ) {
              return;
            }

            parallaxFrame =
              window.requestAnimationFrame(
                updateParallax,
              );
          };

        if (
          !reducedMotion &&
          parallaxElements.length >
            0
        ) {
          updateParallax();

          window.addEventListener(
            'scroll',
            requestParallaxUpdate,
            {
              passive:
                true,
            },
          );

          window.addEventListener(
            'resize',
            requestParallaxUpdate,
            {
              passive:
                true,
            },
          );
        }

        const supportsFinePointer =
          window.matchMedia(
            '(hover: hover) and (pointer: fine)',
          ).matches;

        const cardCleanupFunctions:
          Array<() => void> =
          [];

        if (
          !reducedMotion &&
          supportsFinePointer
        ) {
          const interactiveCards =
            Array.from(
              section.querySelectorAll<HTMLElement>(
                '[data-guide-interactive]',
              ),
            );

          for (
            const card of
            interactiveCards
          ) {
            let animationFrame =
              0;

            let pointerX =
              0;

            let pointerY =
              0;

            const renderCardMotion =
              (): void => {
                animationFrame =
                  0;

                const rect =
                  card.getBoundingClientRect();

                if (
                  rect.width ===
                    0 ||
                  rect.height ===
                    0
                ) {
                  return;
                }

                const strength =
                  Number(
                    card.dataset
                      .guideStrength ??
                      '3.2',
                  );

                const normalizedX =
                  (pointerX -
                    rect.left) /
                    rect.width -
                  0.5;

                const normalizedY =
                  (pointerY -
                    rect.top) /
                    rect.height -
                  0.5;

                const rotateY =
                  normalizedX *
                  strength;

                const rotateX =
                  normalizedY *
                  strength *
                  -0.88;

                const iconX =
                  normalizedX *
                  -8;

                const iconY =
                  normalizedY *
                  -8;

                card.style.setProperty(
                  '--guide-card-rotate-x',
                  `${rotateX.toFixed(
                    2,
                  )}deg`,
                );

                card.style.setProperty(
                  '--guide-card-rotate-y',
                  `${rotateY.toFixed(
                    2,
                  )}deg`,
                );

                card.style.setProperty(
                  '--guide-card-icon-x',
                  `${iconX.toFixed(
                    2,
                  )}px`,
                );

                card.style.setProperty(
                  '--guide-card-icon-y',
                  `${iconY.toFixed(
                    2,
                  )}px`,
                );

                card.style.setProperty(
                  '--guide-card-spotlight-x',
                  `${
                    (normalizedX +
                      0.5) *
                    100
                  }%`,
                );

                card.style.setProperty(
                  '--guide-card-spotlight-y',
                  `${
                    (normalizedY +
                      0.5) *
                    100
                  }%`,
                );
              };

            const handlePointerMove =
              (
                event:
                  PointerEvent,
              ): void => {
                pointerX =
                  event.clientX;

                pointerY =
                  event.clientY;

                if (
                  animationFrame ===
                  0
                ) {
                  animationFrame =
                    window.requestAnimationFrame(
                      renderCardMotion,
                    );
                }
              };

            const resetCardMotion =
              (): void => {
                if (
                  animationFrame !==
                  0
                ) {
                  window.cancelAnimationFrame(
                    animationFrame,
                  );

                  animationFrame =
                    0;
                }

                card.style.setProperty(
                  '--guide-card-rotate-x',
                  '0deg',
                );

                card.style.setProperty(
                  '--guide-card-rotate-y',
                  '0deg',
                );

                card.style.setProperty(
                  '--guide-card-icon-x',
                  '0px',
                );

                card.style.setProperty(
                  '--guide-card-icon-y',
                  '0px',
                );

                card.style.setProperty(
                  '--guide-card-spotlight-x',
                  '50%',
                );

                card.style.setProperty(
                  '--guide-card-spotlight-y',
                  '50%',
                );
              };

            card.addEventListener(
              'pointermove',
              handlePointerMove,
              {
                passive:
                  true,
              },
            );

            card.addEventListener(
              'pointerleave',
              resetCardMotion,
            );

            card.addEventListener(
              'blur',
              resetCardMotion,
              true,
            );

            cardCleanupFunctions.push(
              () => {
                card.removeEventListener(
                  'pointermove',
                  handlePointerMove,
                );

                card.removeEventListener(
                  'pointerleave',
                  resetCardMotion,
                );

                card.removeEventListener(
                  'blur',
                  resetCardMotion,
                  true,
                );

                if (
                  animationFrame !==
                  0
                ) {
                  window.cancelAnimationFrame(
                    animationFrame,
                  );
                }
              },
            );
          }
        }

        const cleanup =
          (): void => {
            revealObserver?.disconnect();

            window.removeEventListener(
              PERSONALIZATION_SAVED_EVENT,
              handleSavedProfile,
            );

            window.removeEventListener(
              PERSONALIZATION_FORGOTTEN_EVENT,
              handleForgottenProfile,
            );

            window.removeEventListener(
              'scroll',
              requestParallaxUpdate,
            );

            window.removeEventListener(
              'resize',
              requestParallaxUpdate,
            );

            if (
              parallaxFrame !==
              0
            ) {
              window.cancelAnimationFrame(
                parallaxFrame,
              );
            }

            for (
              const cleanupCard of
              cardCleanupFunctions
            ) {
              cleanupCard();
            }

            delete section.dataset
              .petGuidesInitialized;
          };

        document.addEventListener(
          'astro:before-swap',
          cleanup,
          {
            once:
              true,
          },
        );
      }
    };

  initializePetGuidePreviews();

  document.addEventListener(
    'astro:page-load',
    initializePetGuidePreviews,
  );
</script>