---
import { Image } from 'astro:assets';

import ArrowRightBold from 'phosphor-astro/ArrowRightBold.astro';
import CheckCircleBold from 'phosphor-astro/CheckCircleBold.astro';
import HeartBold from 'phosphor-astro/HeartBold.astro';
import PawPrintBold from 'phosphor-astro/PawPrintBold.astro';
import SparkleBold from 'phosphor-astro/SparkleBold.astro';

import launchSignupBackground from '../../assets/home/join-the-pack-background.webp';

import {
  FOUNDING_PACK_LAUNCH_INTERESTS,
  FOUNDING_PACK_PET_PERSONALITIES,
  FOUNDING_PACK_PET_TYPES,
} from '../../types/founding-pack';

import BrandLogo from '../brand/BrandLogo.astro';
import Button from '../ui/Button.astro';

import { isStoreLive } from '../../config/storefront';
import { getLocaleFromPathname } from '../../i18n/languages';
import {
  localizeHref,
  localizedLinkLabel,
} from '../../i18n/routes';

const locale = getLocaleFromPathname(Astro.url.pathname);

const t = (english: string, spanish: string): string =>
  locale === 'es' ? spanish : english;

const copy = isStoreLive
  ? {
      eyebrow: t('Maxi Pawz Updates', 'Novedades de Maxi Pawz'),
      title: t('Stay in the loop with Maxi Pawz.', 'Mantente al día con Maxi Pawz.'),
      description: t(
        'Get new-product news, practical pet guides, and occasional subscriber offers for life with your pet.',
        'Recibe noticias sobre nuevos productos, guías prácticas para mascotas y ofertas ocasionales para suscriptores, pensadas para la vida con tu mascota.',
      ),
      firstBenefit: t('New-product updates', 'Novedades de productos'),
      secondBenefit: t('Subscriber offers', 'Ofertas para suscriptores'),
      brandNote: t(
        'A little inspiration for the everyday moments you share with your pet.',
        'Un poco de inspiración para los momentos cotidianos que compartes con tu mascota.',
      ),
      formTitle: t('Good things for your inbox.', 'Buenas noticias para tu bandeja de entrada.'),
      formDescription: t(
        'Choose whether you want Maxi Pawz emails. You can also share an optional pet profile afterward.',
        'Elige si deseas recibir correos de Maxi Pawz. Después también puedes compartir un perfil opcional de tu mascota.',
      ),
      consentDescription: t(
        'I want new-product news, helpful pet guides, and occasional Maxi Pawz offers by email.',
        'Quiero recibir por correo novedades de productos, guías útiles para mascotas y ofertas ocasionales de Maxi Pawz.',
      ),
      submitLabel: t('Get Maxi Pawz Updates', 'Recibir novedades de Maxi Pawz'),
      interestQuestion: t('What would you like to see more of?', '¿Qué te gustaría ver más?'),
      interestHelp: t(
        'Optional. Help us choose future additions to the collection.',
        'Opcional. Ayúdanos a elegir futuras incorporaciones a la colección.',
      ),
      completeTitle: t('Welcome to the Pack.', 'Te damos la bienvenida al Pack.'),
    }
  : {
      eyebrow: 'Founding Pack',
      title: t('Join the Maxi Pawz Founding Pack.', 'Únete al Founding Pack de Maxi Pawz.'),
      description: t(
        'Be part of Maxi Pawz before the first collection arrives. Get launch news, helpful pet guides, and occasional subscriber offers.',
        'Forma parte de Maxi Pawz antes de que llegue la primera colección. Recibe noticias del lanzamiento, guías útiles para mascotas y ofertas ocasionales para suscriptores.',
      ),
      firstBenefit: t('Early launch updates', 'Novedades anticipadas del lanzamiento'),
      secondBenefit: t('Help shape what comes next', 'Ayuda a decidir qué viene después'),
      brandNote: t(
        'The Founding Pack is for the people helping us build Maxi Pawz from the beginning.',
        'El Founding Pack es para quienes nos ayudan a construir Maxi Pawz desde el principio.',
      ),
      formTitle: t('Be here from the beginning.', 'Acompáñanos desde el principio.'),
      formDescription: t(
        'Choose whether you want launch news, helpful pet guides, and occasional Maxi Pawz offers by email.',
        'Elige si deseas recibir noticias del lanzamiento, guías útiles para mascotas y ofertas ocasionales de Maxi Pawz por correo electrónico.',
      ),
      consentDescription: t(
        'I want launch updates, new-product news, helpful pet guides, and occasional Maxi Pawz offers by email.',
        'Quiero recibir por correo novedades del lanzamiento y de productos, guías útiles para mascotas y ofertas ocasionales de Maxi Pawz.',
      ),
      submitLabel: t('Join the Founding Pack', 'Unirme al Founding Pack'),
      interestQuestion: t('What should Maxi Pawz launch first?', '¿Qué debería lanzar primero Maxi Pawz?'),
      interestHelp: t(
        'Optional. This helps us understand what the Founding Pack wants most.',
        'Opcional. Esto nos ayuda a entender qué quiere más el Founding Pack.',
      ),
      completeTitle: t('Welcome to the Founding Pack.', 'Te damos la bienvenida al Founding Pack.'),
    };

const uiCopy = {
  usefulGuidance: t('Useful pet guidance', 'Consejos útiles para mascotas'),
  optionalPetProfile: t('Optional pet profile', 'Perfil de mascota opcional'),
  firstName: t('First name', 'Nombre'),
  optional: t('Optional', 'Opcional'),
  firstNamePlaceholder: t('Your first name', 'Tu nombre'),
  emailAddress: t('Email address', 'Correo electrónico'),
  emailHelp: t(
    'Choose below whether you want to receive Maxi Pawz emails.',
    'Elige abajo si deseas recibir correos de Maxi Pawz.',
  ),
  consentYes: t('Yes, send me Maxi Pawz emails.', 'Sí, envíame correos de Maxi Pawz.'),
  consentHelp: t(
    'Uncheck this box if you prefer not to receive marketing emails. You can unsubscribe at any time.',
    'Desmarca esta casilla si prefieres no recibir correos de marketing. Puedes cancelar la suscripción en cualquier momento.',
  ),
  petProfileLater: t(
    'Your pet profile comes later and is completely optional.',
    'El perfil de tu mascota viene después y es completamente opcional.',
  ),
  preferenceSaved: t(
    'Your email preference is saved.',
    'Tu preferencia de correo electrónico está guardada.',
  ),
  everythingBelowOptional: t('Everything below is optional.', 'Todo lo que aparece a continuación es opcional.'),
  profileTitle: t('Tell Maxi about your best friend.', 'Cuéntale a Maxi sobre tu mejor amigo.'),
  profileDescription: t(
    'Share a few details to help us understand your pet and the products that interest you.',
    'Comparte algunos detalles para ayudarnos a conocer a tu mascota y los productos que te interesan.',
  ),
  petName: t('Pet name', 'Nombre de la mascota'),
  petType: t('Pet type', 'Tipo de mascota'),
  chooseOne: t('Choose one', 'Elige una opción'),
  playPersonality: t('Play personality', 'Personalidad de juego'),
  noPreference: t('No preference', 'Sin preferencia'),
  personalityHelp: t(
    'Just for fun — choose whichever description feels closest.',
    'Solo por diversión: elige la descripción que más se parezca.',
  ),
  savePetProfile: t('Save Pet Profile', 'Guardar perfil de mascota'),
  skipForNow: t('Skip for now', 'Omitir por ahora'),
  completeEyebrow: t('Maxi Pawz Updates', 'Novedades de Maxi Pawz'),
  defaultCompleteMessage: t(
    'Your email preference has been saved.',
    'Tu preferencia de correo electrónico se ha guardado.',
  ),
  guidePrompt: t(
    'Explore practical pet guides for everyday life with your pet.',
    'Explora guías prácticas para el día a día con tu mascota.',
  ),
  explorePetGuides: t('Explore Pet Guides', 'Explorar guías para mascotas'),
  hiddenBotLabel: t('Do not fill out this field:', 'No completes este campo:'),
  hiddenProfileBotLabel: t('Leave this field empty', 'Deja este campo vacío'),
};

const clientCopy = {
  saving: t('Saving…', 'Guardando…'),
  savePreference: t('Save My Preference', 'Guardar mi preferencia'),
  savingPetProfile: t('Saving Pet Profile…', 'Guardando perfil de mascota…'),
  savePetProfile: uiCopy.savePetProfile,
  preferenceSubscribed: t(
    'Your preference to receive Maxi Pawz marketing emails has been saved.',
    'Se guardó tu preferencia de recibir correos de marketing de Maxi Pawz.',
  ),
  preferenceUnsubscribed: t(
    'Your preference not to receive Maxi Pawz marketing emails has been saved.',
    'Se guardó tu preferencia de no recibir correos de marketing de Maxi Pawz.',
  ),
  preferenceSavedTitle: t('Your preference is saved.', 'Tu preferencia está guardada.'),
  profileSavedPrefix: t('Thanks for introducing ', 'Gracias por presentarnos a '),
  profileSavedSuffix: t(
    ' to Maxi. Your pet profile has been saved.',
    '. El perfil de tu mascota se ha guardado.',
  ),
  shareLater: t(
    'You can share your pet’s details another time.',
    'Puedes compartir los detalles de tu mascota en otro momento.',
  ),
  signupSavedTitle: t('Your signup is saved.', 'Tu registro está guardado.'),
  emailPreferenceSavedTitle: uiCopy.preferenceSaved,
  everythingBelowOptional: uiCopy.everythingBelowOptional,
  emailError: t(
    'We could not save your email preference. Please try again.',
    'No pudimos guardar tu preferencia de correo electrónico. Inténtalo de nuevo.',
  ),
  profileFormError: t(
    'The pet profile form is unavailable. Please try again.',
    'El formulario del perfil de mascota no está disponible. Inténtalo de nuevo.',
  ),
  profileError: t(
    'We could not save your pet profile. Please try again.',
    'No pudimos guardar el perfil de tu mascota. Inténtalo de nuevo.',
  ),
};

const petTypeLabels = {
  dog: t('Dog', 'Perro'),
  cat: t('Cat', 'Gato'),
  other: t('Other pet', 'Otra mascota'),
} as const;

const petPersonalityLabels = {
  'fetch-fanatic': t('Fetch Fanatic', 'Fanático de traer la pelota'),
  'power-chewer': t('Power Chewer', 'Masticador incansable'),
  'puzzle-master': t('Puzzle Master', 'Maestro de los rompecabezas'),
  'professional-napper': t('Professional Napper', 'Dormilón profesional'),
  'adventure-buddy': t('Adventure Buddy', 'Compañero de aventuras'),
  'something-else': t('Something Else', 'Algo diferente'),
} as const;

const launchInterestLabels = {
  toys: t('Toys', 'Juguetes'),
  treats: t('Treats', 'Premios'),
  walking: t('Walking', 'Paseos'),
  travel: t('Travel', 'Viajes'),
  feeding: t('Feeding', 'Alimentación'),
  accessories: t('Accessories', 'Accesorios'),
} as const;
---

<section
  id="maxi-pawz-updates"
  class="launch-signup content-visibility-auto section-spacing relative isolate scroll-mt-28 overflow-hidden border-b border-sand/70"
  aria-labelledby="maxi-pawz-updates-title"
  data-launch-signup
  data-signup-locale={locale}
  data-signup-submit-label={copy.submitLabel}
  data-signup-complete-title={copy.completeTitle}
  data-signup-client-copy={JSON.stringify(clientCopy)}
>
  <div
    class="launch-signup__pattern pointer-events-none absolute inset-0"
    aria-hidden="true"
  ></div>

  <div
    class="motion-parallax pointer-events-none absolute -top-32 -left-28"
    data-parallax
    data-parallax-speed="0.035"
    aria-hidden="true"
  >
    <div
      class="launch-signup__orb launch-signup__orb--blue size-96 rounded-full bg-brand-300/24 blur-3xl"
      data-motion-continuous
    ></div>
  </div>

  <div
    class="motion-parallax pointer-events-none absolute -right-32 -bottom-24"
    data-parallax
    data-parallax-speed="0.052"
    aria-hidden="true"
  >
    <div
      class="launch-signup__orb launch-signup__orb--orange size-104 rounded-full bg-accent-300/22 blur-3xl"
      data-motion-continuous
    ></div>
  </div>

  <span
    class="launch-signup__floating-paw pointer-events-none absolute top-[13%] right-[5%] hidden text-brand-300/32 lg:block"
    data-motion-continuous
    aria-hidden="true"
  >
    <PawPrintBold class="size-14 rotate-12" />
  </span>

  <span
    class="launch-signup__floating-paw launch-signup__floating-paw--reverse pointer-events-none absolute bottom-[10%] left-[4%] hidden text-accent-300/28 lg:block"
    data-motion-continuous
    aria-hidden="true"
  >
    <PawPrintBold class="size-11 -rotate-12" />
  </span>

  <div class="site-container relative z-10">
    <div
      class="launch-signup__shell relative overflow-hidden rounded-[2.5rem] border border-white/10 bg-ink-950 shadow-2xl shadow-ink-950/20"
      data-reveal
    >
      <div
        class="launch-signup__shell-glow pointer-events-none absolute -top-40 -left-36 size-112 rounded-full bg-brand-500/28 blur-3xl"
        data-motion-continuous
        aria-hidden="true"
      ></div>

      <div
        class="launch-signup__shell-glow launch-signup__shell-glow--reverse pointer-events-none absolute -right-36 -bottom-44 size-120 rounded-full bg-accent-500/22 blur-3xl"
        data-motion-continuous
        aria-hidden="true"
      ></div>

      <div
        class="launch-signup__grid relative grid min-h-168 overflow-hidden lg:grid-cols-[0.92fr_1.08fr]"
      >
        <div
          class="launch-signup__background pointer-events-none absolute -left-60 inset-0 z-0 overflow-hidden"
          aria-hidden="true"
        >
          <Image
            src={launchSignupBackground}
            alt=""
            class="launch-signup__background-image absolute inset-0 size-full object-cover"
            widths={[640, 960, 1280, 1600, 1920]}
            sizes="(min-width: 1280px) 1280px, calc(100vw - 2rem)"
            loading="lazy"
            quality={80}
            data-motion-continuous
          />

          <div
            class="launch-signup__background-wash absolute inset-0"
            aria-hidden="true"
          ></div>
        </div>

        <!-- Brand / conversion copy -->
        <div
          class="launch-signup__copy-panel relative z-10 flex flex-col justify-end overflow-hidden p-6 sm:p-8 lg:p-10 xl:p-12"
          data-reveal="left"
          style="--reveal-delay: 80ms;"
        >
          <div
            class="launch-signup__left-pattern pointer-events-none absolute inset-0"
            aria-hidden="true"
          ></div>

          <div
            class="pointer-events-none absolute -bottom-28 -left-24 size-80 rounded-full bg-accent-500/18 blur-3xl"
            aria-hidden="true"
          ></div>

          <div class="relative z-10 max-w-xl">
            <p
              class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-ink-950/72 px-4 py-2 text-xs font-black uppercase tracking-[0.15em] text-accent-200 shadow-sm"
            >
              <HeartBold class="size-4" aria-hidden="true" />
              {copy.eyebrow}
            </p>

            <h2
              id="maxi-pawz-updates-title"
              class="mt-6 max-w-xl text-3xl text-white sm:text-4xl lg:text-[2.8rem]"
            >
              {copy.title}
            </h2>

            <p class="mt-5 max-w-xl text-base leading-7 text-white/78 sm:text-lg sm:leading-8">
              {copy.description}
            </p>

            <div class="mt-7 grid gap-3 text-sm font-bold text-white/82 sm:grid-cols-2">
              <span class="flex items-center gap-2">
                <CheckCircleBold
                  class="size-5 shrink-0 text-accent-300"
                  aria-hidden="true"
                />
                {copy.firstBenefit}
              </span>

              <span class="flex items-center gap-2">
                <CheckCircleBold
                  class="size-5 shrink-0 text-accent-300"
                  aria-hidden="true"
                />
                {copy.secondBenefit}
              </span>

              <span class="flex items-center gap-2">
                <CheckCircleBold
                  class="size-5 shrink-0 text-accent-300"
                  aria-hidden="true"
                />
                {uiCopy.usefulGuidance}
              </span>

              <span class="flex items-center gap-2">
                <CheckCircleBold
                  class="size-5 shrink-0 text-accent-300"
                  aria-hidden="true"
                />
                {uiCopy.optionalPetProfile}
              </span>
            </div>
          </div>

          <div
            class="launch-signup__brand-note relative z-10 mt-10 flex items-center gap-4 rounded-3xl border border-white/15 bg-ink-950/72 p-4 shadow-card sm:p-5"
            data-reveal="left"
            style="--reveal-delay: 270ms;"
          >
            <span
              class="launch-signup__mascot grid size-16 shrink-0 place-items-center overflow-hidden rounded-full border-4 border-white/12 bg-cream-soft shadow-orange sm:size-20"
              data-motion-continuous
              aria-hidden="true"
            >
              <BrandLogo variant="mascot" class="size-full object-contain p-1" />
            </span>

            <div>
              <p class="font-display text-xl text-white sm:text-2xl">
                Happy pets. Happy life.
              </p>

              <p class="mt-1 text-sm leading-6 text-white/68">
                {copy.brandNote}
              </p>
            </div>
          </div>
        </div>

        <!-- Interactive side -->
        <div
          class="launch-signup__form-panel relative z-10 flex items-center p-5 sm:p-7 lg:p-9 xl:p-12"
          data-reveal="right"
          style="--reveal-delay: 140ms;"
        >
          <div
            class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_85%_15%,rgba(0,138,255,0.12),transparent_18rem),radial-gradient(circle_at_10%_90%,rgba(255,102,0,0.12),transparent_20rem)]"
            aria-hidden="true"
          ></div>

          <span
            class="launch-signup__floating-mark pointer-events-none absolute top-5 right-5 z-20 hidden size-20 rotate-6 place-items-center rounded-3xl border border-brand-200 bg-white-warm/96 p-3 shadow-blue sm:grid"
            data-motion-continuous
            aria-hidden="true"
          >
            <BrandLogo variant="mark" class="size-full object-contain" />
          </span>

          <div
            class="motion-tilt-shell relative z-10 mx-auto w-full"
            data-tilt-root
            data-tilt-strength="1.9"
          >
            <div
              class="motion-tilt-surface launch-signup__tilt-surface rounded-card"
              data-tilt-surface
            >
              <div
                class="launch-signup__form surface-card relative overflow-hidden p-5 sm:p-7 lg:p-8"
              >
                <div
                  class="launch-signup__form-spotlight pointer-events-none absolute inset-0 z-0"
                  aria-hidden="true"
                ></div>

                <div
                  class="pointer-events-none absolute -top-20 -right-16 size-56 rounded-full bg-brand-200/25 blur-3xl"
                  aria-hidden="true"
                ></div>

                <div
                  class="pointer-events-none absolute -bottom-24 -left-20 size-64 rounded-full bg-accent-200/25 blur-3xl"
                  aria-hidden="true"
                ></div>

                <div class="relative z-10">
                  <!-- STEP 1 -->
                  <div data-founding-pack-step="signup">
                    <div
                      class="flex items-center gap-2 text-xs font-black tracking-[0.14em] text-brand-700 uppercase"
                    >
                      {copy.eyebrow}
                    </div>

                    <h3 class="mt-5 pr-0 text-2xl text-ink-900 sm:pr-20 sm:text-3xl">
                      {copy.formTitle}
                    </h3>

                    <p class="mt-4 leading-7 text-ink-600">
                      {copy.formDescription}
                    </p>

                    <form
                      name="maxipawz-launch-list"
                      action="/api/newsletter/subscribe"
                      method="POST"
                      class="mt-7"
                      data-launch-form
                    >
                      <p hidden>
                        <label>
                          {uiCopy.hiddenBotLabel}
                          <input name="bot-field" tabindex="-1" autocomplete="off" />
                        </label>
                      </p>

                      <div class="grid gap-5 sm:grid-cols-2">
                        <div>
                          <div class="flex items-center justify-between gap-3">
                            <label for="launch-first-name" class="form-label">
                              {uiCopy.firstName}
                            </label>

                            <span class="text-xs font-bold text-ink-400">{uiCopy.optional}</span>
                          </div>

                          <input
                            id="launch-first-name"
                            name="first-name"
                            type="text"
                            autocomplete="given-name"
                            class="launch-signup__input form-control"
                            placeholder={uiCopy.firstNamePlaceholder}
                            maxlength="80"
                            data-launch-field
                          />
                        </div>

                        <div>
                          <label for="launch-email" class="form-label">
                            {uiCopy.emailAddress}
                          </label>

                          <input
                            id="launch-email"
                            name="email"
                            type="email"
                            inputmode="email"
                            autocomplete="email"
                            spellcheck="false"
                            class="launch-signup__input form-control"
                            placeholder="you@example.com"
                            aria-describedby="launch-email-help"
                            required
                            data-launch-field
                            data-launch-email
                          />
                        </div>
                      </div>

                      <p
                        id="launch-email-help"
                        class="mt-3 text-xs leading-5 text-ink-500"
                      >
                        {uiCopy.emailHelp}
                      </p>

                      <div
                        class="mt-6 rounded-3xl border border-brand-200/70 bg-brand-50/85 p-4 sm:p-5"
                      >
                        <label
                          for="launch-marketing-consent"
                          class="flex cursor-pointer items-start gap-3"
                        >
                          <input
                            id="launch-marketing-consent"
                            name="marketing-consent"
                            type="checkbox"
                            value="yes"
                            checked
                            class="mt-1 size-5 shrink-0 cursor-pointer accent-brand-600"
                          />

                          <span class="min-w-0">
                            <span class="flex flex-wrap items-center gap-x-2 gap-y-1">
                              <span class="font-extrabold leading-6 text-ink-800">
                                {uiCopy.consentYes}
                              </span>

                              <span
                                class="rounded-full border border-brand-200 bg-white-warm px-2 py-0.5 text-[0.7rem] font-extrabold tracking-wider text-brand-700 uppercase"
                              >
                                {uiCopy.optional}
                              </span>
                            </span>

                            <span class="mt-1 block text-sm leading-6 text-ink-600">
                              {copy.consentDescription}
                            </span>

                            <span class="mt-2 block text-xs leading-5 text-ink-500">
                              {uiCopy.consentHelp}
                            </span>
                          </span>
                        </label>
                      </div>

                      <div class="mt-6">
                        <Button
                          type="submit"
                          variant="primary"
                          size="lg"
                          fullWidth={true}
                          iconPosition="right"
                        >
                          <ArrowRightBold slot="icon" aria-hidden="true" />
                          <span data-launch-submit-label>{copy.submitLabel}</span>
                        </Button>
                      </div>

                      <p
                        class="mt-4 hidden rounded-2xl border px-4 py-3 text-sm leading-6"
                        role="status"
                        aria-live="polite"
                        data-launch-form-status
                      ></p>

                      <div class="mt-4 flex items-start justify-center gap-2 text-center">
                        <CheckCircleBold
                          class="mt-0.5 size-4 shrink-0 text-brand-700"
                          aria-hidden="true"
                        />

                        <p class="max-w-md text-xs leading-5 text-ink-500">
                          {uiCopy.petProfileLater}
                        </p>
                      </div>
                    </form>
                  </div>

                  <!-- STEP 2 -->
                  <div data-founding-pack-step="profile" hidden>
                    <div
                      class="flex items-center gap-2 text-xs font-black tracking-[0.14em] text-accent-700 uppercase"
                    >
                      <span
                        class="grid size-7 place-items-center rounded-full bg-accent-100 text-accent-700"
                        aria-hidden="true"
                      >
                        2
                      </span>
                      {uiCopy.optional}
                    </div>

                    <div
                      class="mt-5 flex items-start gap-4 rounded-3xl border border-brand-200/70 bg-brand-50/85 p-4 sm:p-5"
                    >
                      <span
                        class="grid size-11 shrink-0 place-items-center rounded-2xl bg-white text-brand-700 shadow-sm"
                        aria-hidden="true"
                      >
                        <CheckCircleBold class="size-6" />
                      </span>

                      <div>
                        <p class="font-extrabold text-ink-900" data-preference-title>
                          {uiCopy.preferenceSaved}
                        </p>

                        <p
                          class="mt-1 text-sm leading-6 text-ink-600"
                          data-preference-message
                        >
                          {uiCopy.everythingBelowOptional}
                        </p>
                      </div>
                    </div>

                    <h3 class="mt-6 pr-0 text-2xl text-ink-900 sm:pr-16 sm:text-3xl">
                      {uiCopy.profileTitle}
                    </h3>

                    <p class="mt-4 leading-7 text-ink-600">
                      {uiCopy.profileDescription}
                    </p>

                    <form class="mt-7" data-pet-profile-form>
                      <div class="hidden" aria-hidden="true">
                        <label>
                          {uiCopy.hiddenProfileBotLabel}

                          <input
                            name="website"
                            type="text"
                            tabindex="-1"
                            autocomplete="off"
                            data-profile-bot-field
                          />
                        </label>
                      </div>

                      <div class="grid gap-5 sm:grid-cols-2">
                        <div>
                          <label for="founding-pet-name" class="form-label">
                            {uiCopy.petName}
                          </label>

                          <input
                            id="founding-pet-name"
                            name="pet-name"
                            type="text"
                            class="launch-signup__input form-control"
                            placeholder="Maxi"
                            maxlength="80"
                            required
                            data-profile-field
                          />
                        </div>

                        <div>
                          <label for="founding-pet-type" class="form-label">
                            {uiCopy.petType}
                          </label>

                          <select
                            id="founding-pet-type"
                            name="pet-type"
                            class="launch-signup__input form-control"
                            required
                            data-profile-field
                          >
                            <option value="">{uiCopy.chooseOne}</option>

                            {
                              FOUNDING_PACK_PET_TYPES.map((petType) => (
                                <option value={petType}>{petTypeLabels[petType]}</option>
                              ))
                            }
                          </select>
                        </div>
                      </div>

                      <div class="mt-5">
                        <div class="flex items-center justify-between gap-3">
                          <label for="founding-pet-personality" class="form-label">
                            {uiCopy.playPersonality}
                          </label>

                          <span class="text-xs font-bold text-ink-400">{uiCopy.optional}</span>
                        </div>

                        <select
                          id="founding-pet-personality"
                          name="pet-personality"
                          class="launch-signup__input form-control"
                          data-profile-field
                        >
                          <option value="">{uiCopy.noPreference}</option>

                          {
                            FOUNDING_PACK_PET_PERSONALITIES.map((personality) => (
                              <option value={personality}>
                                {petPersonalityLabels[personality]}
                              </option>
                            ))
                          }
                        </select>

                        <p class="mt-2 text-xs leading-5 text-ink-500">
                          {uiCopy.personalityHelp}
                        </p>
                      </div>

                      <fieldset class="mt-6">
                        <legend class="form-label">{copy.interestQuestion}</legend>

                        <p class="mt-1 text-xs leading-5 text-ink-500">
                          {copy.interestHelp}
                        </p>

                        <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3">
                          {
                            FOUNDING_PACK_LAUNCH_INTERESTS.map((interest) => (
                              <label class="launch-signup__interest-option cursor-pointer">
                                <input
                                  type="radio"
                                  name="launch-interest"
                                  value={interest}
                                  class="peer sr-only"
                                />

                                <span class="flex min-h-12 items-center justify-center rounded-2xl border border-sand bg-white px-3 py-2 text-center text-sm font-extrabold text-ink-700 transition hover:border-brand-300 hover:bg-brand-50 peer-checked:border-brand-500 peer-checked:bg-brand-100 peer-checked:text-brand-800 peer-focus-visible:ring-3 peer-focus-visible:ring-brand-300/45">
                                  {launchInterestLabels[interest]}
                                </span>
                              </label>
                            ))
                          }
                        </div>
                      </fieldset>

                      <div class="mt-7">
                        <Button
                          type="submit"
                          variant="primary"
                          size="lg"
                          fullWidth={true}
                          iconPosition="right"
                        >
                          <PawPrintBold slot="icon" aria-hidden="true" />
                          <span data-profile-submit-label>{uiCopy.savePetProfile}</span>
                        </Button>
                      </div>

                      <button
                        type="button"
                        class="mt-3 w-full rounded-2xl px-4 py-3 text-sm font-extrabold text-ink-500 transition hover:bg-cream hover:text-ink-800 focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-brand-300/45"
                        data-profile-skip
                      >
                        {uiCopy.skipForNow}
                      </button>

                      <p
                        class="mt-4 hidden rounded-2xl border px-4 py-3 text-sm leading-6"
                        role="status"
                        aria-live="polite"
                        data-profile-status
                      ></p>
                    </form>
                  </div>

                  <!-- COMPLETE -->
                  <div
                    class="py-4 text-center"
                    data-founding-pack-step="complete"
                    hidden
                  >
                    <span
                      class="mx-auto grid size-16 place-items-center rounded-full bg-brand-100 text-brand-700 shadow-sm"
                      aria-hidden="true"
                    >
                      <PawPrintBold class="size-8" />
                    </span>

                    <p
                      class="mt-5 text-xs font-black tracking-[0.14em] text-accent-700 uppercase"
                    >
                      {uiCopy.completeEyebrow}
                    </p>

                    <h3
                      class="mt-3 text-3xl text-ink-900"
                      data-complete-title
                    >
                      {copy.completeTitle}
                    </h3>

                    <p
                      class="mx-auto mt-4 max-w-md leading-7 text-ink-600"
                      data-complete-message
                    >
                      {uiCopy.defaultCompleteMessage}
                    </p>

                    <div
                      class="mx-auto mt-7 max-w-md rounded-3xl border border-brand-200/70 bg-brand-50/80 p-5 text-left"
                    >
                      <div class="flex items-start gap-3">
                        <SparkleBold
                          class="mt-0.5 size-5 shrink-0 text-brand-700"
                          aria-hidden="true"
                        />

                        <p class="text-sm leading-6 text-ink-600">
                          {uiCopy.guidePrompt}
                        </p>
                      </div>
                    </div>

                    <a
                      href={localizeHref('/pet-guides', locale)}
                      class="mt-7 inline-flex items-center gap-2 font-extrabold text-brand-700 transition hover:text-brand-800"
                    >
                      {localizedLinkLabel(uiCopy.explorePetGuides, '/pet-guides', locale)}
                      <ArrowRightBold class="size-5" aria-hidden="true" />
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

