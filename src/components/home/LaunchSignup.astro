<script>
  interface NewsletterSignupResponse {
    ok?: boolean;
    marketingConsent?: boolean;
    message?: string;
  }

  interface PetProfileResponse {
    ok?: boolean;
    message?: string;
  }

  interface LaunchSignupClientCopy {
    saving: string;
    savePreference: string;
    savingPetProfile: string;
    savePetProfile: string;
    preferenceSubscribed: string;
    preferenceUnsubscribed: string;
    preferenceSavedTitle: string;
    profileSavedPrefix: string;
    profileSavedSuffix: string;
    shareLater: string;
    signupSavedTitle: string;
    emailPreferenceSavedTitle: string;
    everythingBelowOptional: string;
    emailError: string;
    profileFormError: string;
    profileError: string;
  }

  const DEFAULT_CLIENT_COPY: LaunchSignupClientCopy = {
    saving: 'Saving…',
    savePreference: 'Save My Preference',
    savingPetProfile: 'Saving Pet Profile…',
    savePetProfile: 'Save Pet Profile',
    preferenceSubscribed:
      'Your preference to receive Maxi Pawz marketing emails has been saved.',
    preferenceUnsubscribed:
      'Your preference not to receive Maxi Pawz marketing emails has been saved.',
    preferenceSavedTitle: 'Your preference is saved.',
    profileSavedPrefix: 'Thanks for introducing ',
    profileSavedSuffix: ' to Maxi. Your pet profile has been saved.',
    shareLater: 'You can share your pet’s details another time.',
    signupSavedTitle: 'Your signup is saved.',
    emailPreferenceSavedTitle: 'Your email preference is saved.',
    everythingBelowOptional: 'Everything below is optional.',
    emailError: 'We could not save your email preference. Please try again.',
    profileFormError: 'The pet profile form is unavailable. Please try again.',
    profileError: 'We could not save your pet profile. Please try again.',
  };

  const initializeLaunchSignupForms = (): void => {
    const sections = Array.from(
      document.querySelectorAll<HTMLElement>('[data-launch-signup]'),
    );

    for (const section of sections) {
      if (section.dataset.launchFormInitialized === 'true') {
        continue;
      }

      section.dataset.launchFormInitialized = 'true';

      const isSpanish =
        section.dataset.signupLocale === 'es';

      const clientCopy: LaunchSignupClientCopy = (() => {
        const serialized = section.dataset.signupClientCopy;

        if (!serialized) {
          return DEFAULT_CLIENT_COPY;
        }

        try {
          return {
            ...DEFAULT_CLIENT_COPY,
            ...(JSON.parse(serialized) as Partial<LaunchSignupClientCopy>),
          };
        } catch {
          return DEFAULT_CLIENT_COPY;
        }
      })();

      const getResponseErrorMessage = (
        serverMessage: string | undefined,
        fallback: string,
      ): string =>
        isSpanish
          ? fallback
          : serverMessage ?? fallback;

      const signupStep = section.querySelector<HTMLElement>(
        '[data-founding-pack-step="signup"]',
      );

      const profileStep = section.querySelector<HTMLElement>(
        '[data-founding-pack-step="profile"]',
      );

      const completeStep = section.querySelector<HTMLElement>(
        '[data-founding-pack-step="complete"]',
      );

      const signupForm =
        section.querySelector<HTMLFormElement>('[data-launch-form]');

      const profileForm =
        section.querySelector<HTMLFormElement>('[data-pet-profile-form]');

      const signupSubmitButton =
        signupForm?.querySelector<HTMLButtonElement>('button[type="submit"]');

      const signupSubmitLabel =
        signupForm?.querySelector<HTMLElement>('[data-launch-submit-label]');

      const signupStatus =
        signupForm?.querySelector<HTMLElement>('[data-launch-form-status]');

      const marketingConsentCheckbox =
        signupForm?.querySelector<HTMLInputElement>('#launch-marketing-consent');

      const emailField =
        signupForm?.querySelector<HTMLInputElement>('[data-launch-email]');

      const profileSubmitButton =
        profileForm?.querySelector<HTMLButtonElement>('button[type="submit"]');

      const profileSubmitLabel =
        profileForm?.querySelector<HTMLElement>('[data-profile-submit-label]');

      const profileStatus =
        profileForm?.querySelector<HTMLElement>('[data-profile-status]');

      const profileSkipButton =
        profileForm?.querySelector<HTMLButtonElement>('[data-profile-skip]');

      const completeMessage =
        section.querySelector<HTMLElement>('[data-complete-message]');

      const completeTitle =
        section.querySelector<HTMLElement>('[data-complete-title]');

      const preferenceTitle =
        section.querySelector<HTMLElement>('[data-preference-title]');

      const preferenceMessage =
        section.querySelector<HTMLElement>('[data-preference-message]');

      const signupButtonLabel =
        section.dataset.signupSubmitLabel ?? 'Get Maxi Pawz Updates';

      const completionTitle =
        section.dataset.signupCompleteTitle ?? 'Welcome to the Pack.';

      if (
        !signupStep ||
        !profileStep ||
        !completeStep ||
        !signupForm ||
        !profileForm ||
        !emailField
      ) {
        continue;
      }

      let foundingPackEmail = '';
      let savedMarketingConsent = false;
      let signupSubmitting = false;
      let profileSubmitting = false;

      const cleanupFunctions: Array<() => void> = [];

      const showStatus = (
        element: HTMLElement | null | undefined,
        message: string,
        state: 'success' | 'error',
      ): void => {
        if (!element) {
          return;
        }

        element.textContent = message;

        element.classList.remove(
          'hidden',
          'border-red-200',
          'bg-red-50',
          'text-red-800',
          'border-emerald-200',
          'bg-emerald-50',
          'text-emerald-800',
        );

        if (state === 'success') {
          element.classList.add(
            'border-emerald-200',
            'bg-emerald-50',
            'text-emerald-800',
          );
          return;
        }

        element.classList.add('border-red-200', 'bg-red-50', 'text-red-800');
      };

      const clearStatus = (
        element: HTMLElement | null | undefined,
      ): void => {
        if (!element) {
          return;
        }

        element.textContent = '';
        element.classList.add('hidden');
      };

      const setSignupSubmitting = (submitting: boolean): void => {
        signupSubmitting = submitting;
        signupForm.classList.toggle('is-submitting', submitting);
        signupForm.toggleAttribute('aria-busy', submitting);

        if (signupSubmitButton) {
          signupSubmitButton.disabled = submitting;
          signupSubmitButton.toggleAttribute('aria-busy', submitting);
        }

        if (signupSubmitLabel) {
          signupSubmitLabel.textContent = submitting
            ? clientCopy.saving
            : marketingConsentCheckbox?.checked === false
              ? clientCopy.savePreference
              : signupButtonLabel;
        }
      };

      const setProfileSubmitting = (submitting: boolean): void => {
        profileSubmitting = submitting;
        profileForm.classList.toggle('is-submitting', submitting);
        profileForm.toggleAttribute('aria-busy', submitting);

        if (profileSubmitButton) {
          profileSubmitButton.disabled = submitting;
          profileSubmitButton.toggleAttribute('aria-busy', submitting);
        }

        if (profileSubmitLabel) {
          profileSubmitLabel.textContent = submitting
            ? clientCopy.savingPetProfile
            : clientCopy.savePetProfile;
        }

        if (profileSkipButton) {
          profileSkipButton.disabled = submitting;
        }
      };

      const showStep = (step: 'signup' | 'profile' | 'complete'): void => {
        signupStep.hidden = step !== 'signup';
        profileStep.hidden = step !== 'profile';
        completeStep.hidden = step !== 'complete';

        const target =
          step === 'signup'
            ? signupStep
            : step === 'profile'
              ? profileStep
              : completeStep;

        requestAnimationFrame(() => {
          const heading = target.querySelector<HTMLElement>('h3');

          heading?.setAttribute('tabindex', '-1');
          heading?.focus({ preventScroll: true });
        });
      };

      const getSavedPreferenceMessage = (): string =>
        savedMarketingConsent
          ? clientCopy.preferenceSubscribed
          : clientCopy.preferenceUnsubscribed;

      const showCompletion = (petName?: string): void => {
        if (completeTitle) {
          completeTitle.textContent = savedMarketingConsent
            ? completionTitle
            : clientCopy.preferenceSavedTitle;
        }

        if (completeMessage) {
          const profileMessage = petName
            ? `${clientCopy.profileSavedPrefix}${petName}${clientCopy.profileSavedSuffix}`
            : clientCopy.shareLater;

          completeMessage.textContent =
            `${getSavedPreferenceMessage()} ${profileMessage}`;
        }

        showStep('complete');
      };

      const updateFieldState = (
        field: HTMLInputElement | HTMLSelectElement,
      ): void => {
        const hasValue = field.value.trim().length > 0;
        const isValid = field.validity.valid;

        field.classList.toggle('is-valid', hasValue && isValid);

        if (isValid) {
          field.classList.remove('is-invalid');
          field.removeAttribute('aria-invalid');
        }
      };

      const initializeFieldValidation = (
        fields: Array<HTMLInputElement | HTMLSelectElement>,
      ): void => {
        for (const field of fields) {
          const handleInvalid = (): void => {
            field.classList.add('is-invalid');
            field.classList.remove('is-valid');
            field.setAttribute('aria-invalid', 'true');
          };

          const handleUpdate = (): void => {
            updateFieldState(field);
          };

          field.addEventListener('invalid', handleInvalid);
          field.addEventListener('input', handleUpdate);
          field.addEventListener('change', handleUpdate);
          field.addEventListener('blur', handleUpdate);

          cleanupFunctions.push(() => {
            field.removeEventListener('invalid', handleInvalid);
            field.removeEventListener('input', handleUpdate);
            field.removeEventListener('change', handleUpdate);
            field.removeEventListener('blur', handleUpdate);
          });
        }
      };

      const signupFields = Array.from(
        signupForm.querySelectorAll<HTMLInputElement>('[data-launch-field]'),
      );

      const profileFields = Array.from(
        profileForm.querySelectorAll<HTMLInputElement | HTMLSelectElement>(
          '[data-profile-field]',
        ),
      );

      initializeFieldValidation(signupFields);
      initializeFieldValidation(profileFields);

      const syncSignupButtonLabel = (): void => {
        if (
          signupForm.classList.contains('is-submitting') ||
          !signupSubmitLabel
        ) {
          return;
        }

        signupSubmitLabel.textContent =
          marketingConsentCheckbox?.checked === false
            ? clientCopy.savePreference
            : signupButtonLabel;
      };

      const handleMarketingConsentChange = (): void => {
        syncSignupButtonLabel();
      };

      const handleSignupSubmit = async (
        event: SubmitEvent,
      ): Promise<void> => {
        event.preventDefault();

        if (signupSubmitting) {
          return;
        }

        if (!signupForm.checkValidity()) {
          signupForm.reportValidity();
          return;
        }

        clearStatus(signupStatus);
        setSignupSubmitting(true);

        try {
          const formData = new FormData(signupForm);

          const submittedEmail = String(formData.get('email') ?? '')
            .trim()
            .toLowerCase();

          const submittedConsent =
            formData.get('marketing-consent') === 'yes';

          const response = await fetch(signupForm.action, {
            method: 'POST',
            headers: {
              Accept: 'application/json',
            },
            body: formData,
          });

          const body = (await response.json().catch(() => null)) as
            | NewsletterSignupResponse
            | null;

          if (!response.ok || body?.ok !== true) {
            throw new Error(
              getResponseErrorMessage(
                body?.message,
                clientCopy.emailError,
              ),
            );
          }

          foundingPackEmail = submittedEmail;

          savedMarketingConsent =
            typeof body.marketingConsent === 'boolean'
              ? body.marketingConsent
              : submittedConsent;

          if (preferenceTitle) {
            preferenceTitle.textContent = savedMarketingConsent
              ? clientCopy.signupSavedTitle
              : clientCopy.emailPreferenceSavedTitle;
          }

          if (preferenceMessage) {
            preferenceMessage.textContent =
              `${getSavedPreferenceMessage()} ${clientCopy.everythingBelowOptional}`;
          }

          showStep('profile');
        } catch (error) {
          const message =
            error instanceof Error
              ? error.message
              : clientCopy.emailError;

          showStatus(signupStatus, message, 'error');
        } finally {
          setSignupSubmitting(false);
        }
      };

      const handleProfileSubmit = async (
        event: SubmitEvent,
      ): Promise<void> => {
        event.preventDefault();

        if (profileSubmitting || !foundingPackEmail) {
          return;
        }

        if (!profileForm.checkValidity()) {
          profileForm.reportValidity();
          return;
        }

        clearStatus(profileStatus);
        setProfileSubmitting(true);

        try {
          const petNameField =
            profileForm.querySelector<HTMLInputElement>('[name="pet-name"]');

          const petTypeField =
            profileForm.querySelector<HTMLSelectElement>('[name="pet-type"]');

          const petPersonalityField =
            profileForm.querySelector<HTMLSelectElement>(
              '[name="pet-personality"]',
            );

          const selectedLaunchInterest =
            profileForm.querySelector<HTMLInputElement>(
              '[name="launch-interest"]:checked',
            );

          const botField =
            profileForm.querySelector<HTMLInputElement>(
              '[data-profile-bot-field]',
            );

          if (!petNameField || !petTypeField) {
            throw new Error(
              clientCopy.profileFormError,
            );
          }

          const submittedPetName = petNameField.value.trim();

          const response = await fetch('/api/founding-pack/profile', {
            method: 'POST',
            headers: {
              Accept: 'application/json',
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              email: foundingPackEmail,
              petName: submittedPetName,
              petType: petTypeField.value,
              petPersonality: petPersonalityField?.value || undefined,
              launchInterest: selectedLaunchInterest?.value || undefined,
              botField: botField?.value || undefined,
            }),
          });

          const body = (await response.json().catch(() => null)) as
            | PetProfileResponse
            | null;

          if (!response.ok || body?.ok !== true) {
            throw new Error(
              getResponseErrorMessage(
                body?.message,
                clientCopy.profileError,
              ),
            );
          }

          showCompletion(submittedPetName);
        } catch (error) {
          const message =
            error instanceof Error
              ? error.message
              : clientCopy.profileError;

          showStatus(profileStatus, message, 'error');
        } finally {
          setProfileSubmitting(false);
        }
      };

      const handleSkipProfile = (): void => {
        if (profileSubmitting || !foundingPackEmail) {
          return;
        }

        showCompletion();
      };

      const handlePageShow = (): void => {
        setSignupSubmitting(false);
        setProfileSubmitting(false);
      };

      marketingConsentCheckbox?.addEventListener(
        'change',
        handleMarketingConsentChange,
      );

      signupForm.addEventListener('submit', handleSignupSubmit);
      profileForm.addEventListener('submit', handleProfileSubmit);
      profileSkipButton?.addEventListener('click', handleSkipProfile);
      window.addEventListener('pageshow', handlePageShow);

      syncSignupButtonLabel();

      const cleanup = (): void => {
        marketingConsentCheckbox?.removeEventListener(
          'change',
          handleMarketingConsentChange,
        );

        signupForm.removeEventListener('submit', handleSignupSubmit);
        profileForm.removeEventListener('submit', handleProfileSubmit);
        profileSkipButton?.removeEventListener('click', handleSkipProfile);
        window.removeEventListener('pageshow', handlePageShow);

        for (const cleanupField of cleanupFunctions) {
          cleanupField();
        }

        delete section.dataset.launchFormInitialized;
      };

      document.addEventListener('astro:before-swap', cleanup, {
        once: true,
      });
    }
  };

  initializeLaunchSignupForms();

  document.addEventListener('astro:page-load', initializeLaunchSignupForms);
</script>