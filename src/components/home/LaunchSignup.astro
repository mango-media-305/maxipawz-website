---
import { Image } from 'astro:assets';

import ArrowRightBold from 'phosphor-astro/ArrowRightBold.astro';
import CheckCircleBold from 'phosphor-astro/CheckCircleBold.astro';
import HeartBold from 'phosphor-astro/HeartBold.astro';
import PawPrintBold from 'phosphor-astro/PawPrintBold.astro';
import SparkleBold from 'phosphor-astro/SparkleBold.astro';

import launchSignupBackground from '../../assets/home/join-the-pack-background.webp';

import {
  FOUNDING_PACK_LAUNCH_INTERESTS,
  FOUNDING_PACK_PET_PERSONALITIES,
  FOUNDING_PACK_PET_TYPES,
} from '../../types/founding-pack';

import BrandLogo from '../brand/BrandLogo.astro';
import Button from '../ui/Button.astro';

const petTypeLabels = {
  dog: 'Dog',
  cat: 'Cat',
  other: 'Other pet',
} as const;

const petPersonalityLabels = {
  'fetch-fanatic': 'Fetch Fanatic',
  'power-chewer': 'Power Chewer',
  'puzzle-master': 'Puzzle Master',
  'professional-napper': 'Professional Napper',
  'adventure-buddy': 'Adventure Buddy',
  'something-else': 'Something Else',
} as const;

const launchInterestLabels = {
  toys: 'Toys',
  treats: 'Treats',
  walking: 'Walking',
  travel: 'Travel',
  feeding: 'Feeding',
  accessories: 'Accessories',
} as const;
---

<section
  id="maxi-pawz-updates"
  class="launch-signup content-visibility-auto section-spacing relative isolate scroll-mt-28 overflow-hidden border-b border-sand/70"
  aria-labelledby="maxi-pawz-updates-title"
  data-launch-signup
>
  <div class="launch-signup__pattern pointer-events-none absolute inset-0" aria-hidden="true"></div>

  <div
    class="motion-parallax pointer-events-none absolute -top-32 -left-28"
    data-parallax
    data-parallax-speed="0.035"
    aria-hidden="true"
  >
    <div
      class="launch-signup__orb launch-signup__orb--blue size-96 rounded-full bg-brand-300/24 blur-3xl"
      data-motion-continuous
    >
    </div>
  </div>

  <div
    class="motion-parallax pointer-events-none absolute -right-32 -bottom-24"
    data-parallax
    data-parallax-speed="0.052"
    aria-hidden="true"
  >
    <div
      class="launch-signup__orb launch-signup__orb--orange size-104 rounded-full bg-accent-300/22 blur-3xl"
      data-motion-continuous
    >
    </div>
  </div>

  <span
    class="launch-signup__floating-paw pointer-events-none absolute top-[13%] right-[5%] hidden text-brand-300/32 lg:block"
    data-motion-continuous
    aria-hidden="true"
  >
    <PawPrintBold class="size-14 rotate-12" />
  </span>

  <span
    class="launch-signup__floating-paw launch-signup__floating-paw--reverse pointer-events-none absolute bottom-[10%] left-[4%] hidden text-accent-300/28 lg:block"
    data-motion-continuous
    aria-hidden="true"
  >
    <PawPrintBold class="size-11 -rotate-12" />
  </span>

  <div class="site-container relative z-10">
    <div
      class="launch-signup__shell relative overflow-hidden rounded-[2.5rem] border border-white/10 bg-ink-950 shadow-2xl shadow-ink-950/20"
      data-reveal
    >
      <div
        class="launch-signup__shell-glow pointer-events-none absolute -top-40 -left-36 size-112 rounded-full bg-brand-500/28 blur-3xl"
        data-motion-continuous
        aria-hidden="true"
      >
      </div>

      <div
        class="launch-signup__shell-glow launch-signup__shell-glow--reverse pointer-events-none absolute -right-36 -bottom-44 size-120 rounded-full bg-accent-500/22 blur-3xl"
        data-motion-continuous
        aria-hidden="true"
      >
      </div>

      <div
        class="launch-signup__grid relative grid min-h-168 overflow-hidden lg:grid-cols-[0.92fr_1.08fr]"
      >
        <div
          class="launch-signup__background pointer-events-none absolute inset-0 z-0 overflow-hidden"
          aria-hidden="true"
        >
          <Image
            src={launchSignupBackground}
            alt=""
            class="launch-signup__background-image absolute inset-0 size-full object-cover"
            widths={[640, 960, 1280, 1600, 1920]}
            sizes="(min-width: 1280px) 1280px, calc(100vw - 2rem)"
            loading="lazy"
            quality={80}
            data-motion-continuous
          />

          <div class="launch-signup__background-wash absolute inset-0" aria-hidden="true"></div>
        </div>

        <!-- Brand / conversion copy -->
        <div
          class="launch-signup__copy-panel relative z-10 flex flex-col justify-end overflow-hidden p-6 sm:p-8 lg:p-10 xl:p-12"
          data-reveal="left"
          style="--reveal-delay: 80ms;"
        >
          <div
            class="launch-signup__left-pattern pointer-events-none absolute inset-0"
            aria-hidden="true"
          >
          </div>

          <div
            class="pointer-events-none absolute -bottom-28 -left-24 size-80 rounded-full bg-accent-500/18 blur-3xl"
            aria-hidden="true"
          >
          </div>

          <div class="relative z-10 max-w-xl">
            <p
              class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-ink-950/72 px-4 py-2 text-xs font-black uppercase tracking-[0.15em] text-accent-200 shadow-sm"
            >
              <HeartBold class="size-4" aria-hidden="true" />

              Founding Pack
            </p>

            <h2
              id="maxi-pawz-updates-title"
              class="mt-6 max-w-xl text-3xl text-white sm:text-4xl lg:text-[2.8rem]"
            >
              Join the Maxi Pawz Founding Pack.
            </h2>

            <p class="mt-5 max-w-xl text-base leading-7 text-white/78 sm:text-lg sm:leading-8">
              Be part of Maxi Pawz before the first collection arrives. Get launch news, helpful pet
              guides, new-product updates, and occasional subscriber-only offers.
            </p>

            <div class="mt-7 grid gap-3 text-sm font-bold text-white/82 sm:grid-cols-2">
              <span class="flex items-center gap-2">
                <CheckCircleBold class="size-5 shrink-0 text-accent-300" aria-hidden="true" />

                Early launch updates
              </span>

              <span class="flex items-center gap-2">
                <CheckCircleBold class="size-5 shrink-0 text-accent-300" aria-hidden="true" />

                Help shape what comes next
              </span>

              <span class="flex items-center gap-2">
                <CheckCircleBold class="size-5 shrink-0 text-accent-300" aria-hidden="true" />

                Useful pet guidance
              </span>

              <span class="flex items-center gap-2">
                <CheckCircleBold class="size-5 shrink-0 text-accent-300" aria-hidden="true" />

                Optional pet profile
              </span>
            </div>
          </div>

          <div
            class="launch-signup__brand-note relative z-10 mt-10 flex items-center gap-4 rounded-3xl border border-white/15 bg-ink-950/72 p-4 shadow-card sm:p-5"
            data-reveal="left"
            style="--reveal-delay: 270ms;"
          >
            <span
              class="launch-signup__mascot grid size-16 shrink-0 place-items-center overflow-hidden rounded-full border-4 border-white/12 bg-cream-soft shadow-orange sm:size-20"
              data-motion-continuous
              aria-hidden="true"
            >
              <BrandLogo variant="mascot" class="size-full object-contain p-1" />
            </span>

            <div>
              <p class="font-display text-xl text-white sm:text-2xl">Happy pets. Happy life.</p>

              <p class="mt-1 text-sm leading-6 text-white/68">
                The Founding Pack is for the people helping us build Maxi Pawz from the beginning.
              </p>
            </div>
          </div>
        </div>

        <!-- Interactive side -->
        <div
          class="launch-signup__form-panel relative z-10 flex items-center p-5 sm:p-7 lg:p-9 xl:p-12"
          data-reveal="right"
          style="--reveal-delay: 140ms;"
        >
          <div
            class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_85%_15%,rgba(0,138,255,0.12),transparent_18rem),radial-gradient(circle_at_10%_90%,rgba(255,102,0,0.12),transparent_20rem)]"
            aria-hidden="true"
          >
          </div>

          <span
            class="launch-signup__floating-mark pointer-events-none absolute top-5 right-5 z-20 hidden size-20 rotate-6 place-items-center rounded-3xl border border-brand-200 bg-white-warm/96 p-3 shadow-blue sm:grid"
            data-motion-continuous
            aria-hidden="true"
          >
            <BrandLogo variant="mark" class="size-full object-contain" />
          </span>

          <div
            class="motion-tilt-shell relative z-10 mx-auto w-full"
            data-tilt-root
            data-tilt-strength="1.9"
          >
            <div
              class="motion-tilt-surface launch-signup__tilt-surface rounded-card"
              data-tilt-surface
            >
              <div
                class="launch-signup__form surface-card relative overflow-hidden p-5 sm:p-7 lg:p-8"
              >
                <div
                  class="launch-signup__form-spotlight pointer-events-none absolute inset-0 z-0"
                  aria-hidden="true"
                >
                </div>

                <div
                  class="pointer-events-none absolute -top-20 -right-16 size-56 rounded-full bg-brand-200/25 blur-3xl"
                  aria-hidden="true"
                >
                </div>

                <div
                  class="pointer-events-none absolute -bottom-24 -left-20 size-64 rounded-full bg-accent-200/25 blur-3xl"
                  aria-hidden="true"
                >
                </div>

                <div class="relative z-10">
                  <!-- STEP 1 -->
                  <div data-founding-pack-step="signup">
                    <div class="flex items-center gap-2 text-xs font-black tracking-[0.14em] text-brand-700 uppercase">
                      <span
                        class="grid size-7 place-items-center rounded-full bg-brand-100 text-brand-700"
                        aria-hidden="true"
                      >
                        1
                      </span>

                      Join the Pack
                    </div>

                    <h3 class="mt-5 pr-0 text-2xl text-ink-900 sm:pr-20 sm:text-3xl">
                      Be here from the beginning.
                    </h3>

                    <p class="mt-4 leading-7 text-ink-600">
                      Sign up for the Maxi Pawz Founding Pack to get early launch updates, helpful
                      pet guides, and occasional subscriber-only offers.
                    </p>

                    <form
                      name="maxipawz-launch-list"
                      action="/api/newsletter/subscribe"
                      method="POST"
                      class="mt-7"
                      data-launch-form
                    >
                      <p hidden>
                        <label>
                          Do not fill out this field:

                          <input name="bot-field" tabindex="-1" autocomplete="off" />
                        </label>
                      </p>

                      <div class="grid gap-5 sm:grid-cols-2">
                        <div>
                          <div class="flex items-center justify-between gap-3">
                            <label for="launch-first-name" class="form-label">First name</label>

                            <span class="text-xs font-bold text-ink-400">Optional</span>
                          </div>

                          <input
                            id="launch-first-name"
                            name="first-name"
                            type="text"
                            autocomplete="given-name"
                            class="launch-signup__input form-control"
                            placeholder="Your first name"
                            maxlength="80"
                            data-launch-field
                          />
                        </div>

                        <div>
                          <label for="launch-email" class="form-label">Email address</label>

                          <input
                            id="launch-email"
                            name="email"
                            type="email"
                            inputmode="email"
                            autocomplete="email"
                            spellcheck="false"
                            class="launch-signup__input form-control"
                            placeholder="you@example.com"
                            aria-describedby="launch-email-help"
                            required
                            data-launch-field
                            data-launch-email
                          />
                        </div>
                      </div>

                      <div
                        class="mt-6 rounded-3xl border border-brand-200/70 bg-brand-50/85 p-4 sm:p-5"
                      >
                        <label
                          for="launch-marketing-consent"
                          class="flex cursor-pointer items-start gap-3"
                        >
                          <input
                            id="launch-marketing-consent"
                            name="marketing-consent"
                            type="checkbox"
                            value="yes"
                            checked
                            class="mt-1 size-5 shrink-0 cursor-pointer accent-brand-600"
                          />

                          <span class="min-w-0">
                            <span class="flex flex-wrap items-center gap-x-2 gap-y-1">
                              <span class="font-extrabold leading-6 text-ink-800">
                                Yes, send me Maxi Pawz emails.
                              </span>

                              <span
                                class="rounded-full border border-brand-200 bg-white-warm px-2 py-0.5 text-[0.7rem] font-extrabold tracking-wider text-brand-700 uppercase"
                              >
                                Optional
                              </span>
                            </span>

                            <span class="mt-1 block text-sm leading-6 text-ink-600">
                              I want launch updates, new-product news, helpful pet guides, and
                              occasional Maxi Pawz offers by email.
                            </span>

                            <span class="mt-2 block text-xs leading-5 text-ink-500">
                              Uncheck this box if you prefer not to receive marketing emails. You can
                              unsubscribe at any time.
                            </span>
                          </span>
                        </label>
                      </div>

                      <div class="mt-6">
                        <Button
                          type="submit"
                          variant="primary"
                          size="lg"
                          fullWidth={true}
                          iconPosition="right"
                        >
                          <ArrowRightBold slot="icon" aria-hidden="true" />

                          <span data-launch-submit-label>Join the Founding Pack</span>
                        </Button>
                      </div>

                      <p
                        class="mt-4 hidden rounded-2xl border px-4 py-3 text-sm leading-6"
                        role="status"
                        aria-live="polite"
                        data-launch-form-status
                      >
                      </p>

                      <div class="mt-4 flex items-start justify-center gap-2 text-center">
                        <CheckCircleBold
                          class="mt-0.5 size-4 shrink-0 text-brand-700"
                          aria-hidden="true"
                        />

                        <p class="max-w-md text-xs leading-5 text-ink-500">
                          Your pet profile comes later and is completely optional.
                        </p>
                      </div>
                    </form>
                  </div>

                  <!-- STEP 2 -->
                  <div data-founding-pack-step="profile" hidden>
                    <div class="flex items-center gap-2 text-xs font-black tracking-[0.14em] text-accent-700 uppercase">
                      <span
                        class="grid size-7 place-items-center rounded-full bg-accent-100 text-accent-700"
                        aria-hidden="true"
                      >
                        2
                      </span>

                      Optional
                    </div>

                    <div
                      class="mt-5 flex items-start gap-4 rounded-3xl border border-brand-200/70 bg-brand-50/85 p-4 sm:p-5"
                    >
                      <span
                        class="grid size-11 shrink-0 place-items-center rounded-2xl bg-white text-brand-700 shadow-sm"
                        aria-hidden="true"
                      >
                        <CheckCircleBold class="size-6" />
                      </span>

                      <div>
                        <p class="font-extrabold text-ink-900">You're in the Founding Pack.</p>

                        <p class="mt-1 text-sm leading-6 text-ink-600">
                          Your signup has already been saved. Everything below is optional.
                        </p>
                      </div>
                    </div>

                    <h3 class="mt-6 pr-0 text-2xl text-ink-900 sm:pr-16 sm:text-3xl">
                      Tell Maxi about your best friend.
                    </h3>

                    <p class="mt-4 leading-7 text-ink-600">
                      A few details can help us understand what our community actually wants. No
                      birthday, breed, address, phone number, or other unnecessary information.
                    </p>

                    <form class="mt-7" data-pet-profile-form>
                      <div class="hidden" aria-hidden="true">
                        <label>
                          Leave this field empty

                          <input
                            name="website"
                            type="text"
                            tabindex="-1"
                            autocomplete="off"
                            data-profile-bot-field
                          />
                        </label>
                      </div>

                      <div class="grid gap-5 sm:grid-cols-2">
                        <div>
                          <label for="founding-pet-name" class="form-label">Pet name</label>

                          <input
                            id="founding-pet-name"
                            name="pet-name"
                            type="text"
                            class="launch-signup__input form-control"
                            placeholder="Maxi"
                            maxlength="80"
                            required
                            data-profile-field
                          />
                        </div>

                        <div>
                          <label for="founding-pet-type" class="form-label">Pet type</label>

                          <select
                            id="founding-pet-type"
                            name="pet-type"
                            class="launch-signup__input form-control"
                            required
                            data-profile-field
                          >
                            <option value="">Choose one</option>

                            {
                              FOUNDING_PACK_PET_TYPES.map((petType) => (
                                <option value={petType}>{petTypeLabels[petType]}</option>
                              ))
                            }
                          </select>
                        </div>
                      </div>

                      <div class="mt-5">
                        <div class="flex items-center justify-between gap-3">
                          <label for="founding-pet-personality" class="form-label">
                            Play personality
                          </label>

                          <span class="text-xs font-bold text-ink-400">Optional</span>
                        </div>

                        <select
                          id="founding-pet-personality"
                          name="pet-personality"
                          class="launch-signup__input form-control"
                          data-profile-field
                        >
                          <option value="">No preference</option>

                          {
                            FOUNDING_PACK_PET_PERSONALITIES.map((personality) => (
                              <option value={personality}>
                                {petPersonalityLabels[personality]}
                              </option>
                            ))
                          }
                        </select>

                        <p class="mt-2 text-xs leading-5 text-ink-500">
                          Just for fun — choose whichever description feels closest.
                        </p>
                      </div>

                      <fieldset class="mt-6">
                        <legend class="form-label">What should Maxi Pawz launch first?</legend>

                        <p class="mt-1 text-xs leading-5 text-ink-500">
                          Optional. This helps us understand what the Founding Pack wants most.
                        </p>

                        <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3">
                          {
                            FOUNDING_PACK_LAUNCH_INTERESTS.map((interest) => (
                              <label class="launch-signup__interest-option cursor-pointer">
                                <input
                                  type="radio"
                                  name="launch-interest"
                                  value={interest}
                                  class="peer sr-only"
                                />

                                <span class="flex min-h-12 items-center justify-center rounded-2xl border border-sand bg-white px-3 py-2 text-center text-sm font-extrabold text-ink-700 transition hover:border-brand-300 hover:bg-brand-50 peer-checked:border-brand-500 peer-checked:bg-brand-100 peer-checked:text-brand-800 peer-focus-visible:ring-3 peer-focus-visible:ring-brand-300/45">
                                  {launchInterestLabels[interest]}
                                </span>
                              </label>
                            ))
                          }
                        </div>
                      </fieldset>

                      <div class="mt-7">
                        <Button
                          type="submit"
                          variant="primary"
                          size="lg"
                          fullWidth={true}
                          iconPosition="right"
                        >
                          <PawPrintBold slot="icon" aria-hidden="true" />

                          <span data-profile-submit-label>Save Pet Profile</span>
                        </Button>
                      </div>

                      <button
                        type="button"
                        class="mt-3 w-full rounded-2xl px-4 py-3 text-sm font-extrabold text-ink-500 transition hover:bg-cream hover:text-ink-800 focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-brand-300/45"
                        data-profile-skip
                      >
                        Skip for now
                      </button>

                      <p
                        class="mt-4 hidden rounded-2xl border px-4 py-3 text-sm leading-6"
                        role="status"
                        aria-live="polite"
                        data-profile-status
                      >
                      </p>
                    </form>
                  </div>

                  <!-- COMPLETE -->
                  <div class="py-4 text-center" data-founding-pack-step="complete" hidden>
                    <span
                      class="mx-auto grid size-16 place-items-center rounded-full bg-brand-100 text-brand-700 shadow-sm"
                      aria-hidden="true"
                    >
                      <PawPrintBold class="size-8" />
                    </span>

                    <p class="mt-5 text-xs font-black tracking-[0.14em] text-accent-700 uppercase">
                      Founding Pack Member
                    </p>

                    <h3 class="mt-3 text-3xl text-ink-900">Welcome to the Pack.</h3>

                    <p
                      class="mx-auto mt-4 max-w-md leading-7 text-ink-600"
                      data-complete-message
                    >
                      You're officially part of the Maxi Pawz Founding Pack.
                    </p>

                    <div
                      class="mx-auto mt-7 max-w-md rounded-3xl border border-brand-200/70 bg-brand-50/80 p-5 text-left"
                    >
                      <div class="flex items-start gap-3">
                        <SparkleBold
                          class="mt-0.5 size-5 shrink-0 text-brand-700"
                          aria-hidden="true"
                        />

                        <p class="text-sm leading-6 text-ink-600">
                          We'll keep building while you explore the Pet Guides and follow along as
                          the first Maxi Pawz collection takes shape.
                        </p>
                      </div>
                    </div>

                    <a
                      href="/pet-guides"
                      class="mt-7 inline-flex items-center gap-2 font-extrabold text-brand-700 transition hover:text-brand-800"
                    >
                      Explore Pet Guides

                      <ArrowRightBold class="size-5" aria-hidden="true" />
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .launch-signup {
    background: linear-gradient(
      180deg,
      rgb(255 253 244 / 82%) 0%,
      rgb(255 248 220 / 94%) 52%,
      rgb(248 237 200 / 68%) 100%
    );
  }

  .launch-signup__pattern {
    background-image:
      radial-gradient(circle at 18% 25%, rgb(0 138 255 / 8%), transparent 24rem),
      radial-gradient(circle at 85% 72%, rgb(255 102 0 / 8%), transparent 26rem),
      radial-gradient(circle, rgb(53 39 31 / 7%) 1px, transparent 1px);

    background-size:
      auto,
      auto,
      2.25rem 2.25rem;

    mask-image: linear-gradient(to bottom, transparent, black 10%, black 90%, transparent);

    opacity: 0.72;
  }

  .launch-signup__shell {
    background:
      radial-gradient(circle at 10% 10%, rgb(0 138 255 / 22%), transparent 23rem),
      radial-gradient(circle at 34% 100%, rgb(255 102 0 / 17%), transparent 25rem), #211711;
  }

  .launch-signup__background {
    background-color: #211711;
  }

  .launch-signup__background-image {
    object-position: center 46%;
    opacity: 0.88;
    transform: translate3d(-1.5%, 0, 0) scale(1.06);
    filter: saturate(0.92) contrast(1.03);
  }

  .launch-signup__background-wash {
    background:
      linear-gradient(
        90deg,
        rgb(33 23 17 / 52%) 0%,
        rgb(33 23 17 / 28%) 46%,
        rgb(255 253 250 / 8%) 58%,
        rgb(255 253 250 / 18%) 100%
      ),
      linear-gradient(180deg, rgb(33 23 17 / 10%) 0%, rgb(33 23 17 / 22%) 100%);
  }

  .launch-signup__copy-panel {
    background:
      linear-gradient(
        180deg,
        rgb(33 23 17 / 18%) 0%,
        rgb(33 23 17 / 48%) 46%,
        rgb(33 23 17 / 86%) 100%
      ),
      linear-gradient(90deg, rgb(33 23 17 / 35%), rgb(33 23 17 / 8%));
  }

  .launch-signup__form-panel {
    background: linear-gradient(
      145deg,
      rgb(238 248 255 / 97%) 0%,
      rgb(255 253 250 / 97%) 52%,
      rgb(255 245 235 / 96%) 100%
    );
  }

  .launch-signup__left-pattern {
    background-image:
      linear-gradient(rgb(255 255 255 / 3%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 3%) 1px, transparent 1px);

    background-size: 3rem 3rem;
    mask-image: linear-gradient(to bottom right, black, transparent 76%);
    opacity: 0.65;
  }

  .launch-signup__brand-note {
    transition:
      transform 240ms var(--ease-friendly),
      border-color 240ms var(--ease-friendly),
      background-color 240ms var(--ease-friendly);
  }

  .launch-signup__brand-note:hover {
    transform: translateY(-0.25rem);
    border-color: rgb(255 174 102 / 30%);
    background-color: rgb(33 23 17 / 82%);
  }

  .launch-signup__tilt-surface {
    border-radius: var(--radius-card);
  }

  .launch-signup__tilt-surface::after {
    display: none;
  }

  .launch-signup__form {
    background: rgb(255 254 249 / 97%);
    transition:
      border-color 240ms var(--ease-friendly),
      box-shadow 260ms var(--ease-friendly);
  }

  .motion-tilt-shell:hover .launch-signup__form {
    border-color: rgb(0 138 255 / 28%);
    box-shadow: var(--shadow-card-hover);
  }

  .launch-signup__form-spotlight {
    background: radial-gradient(
      circle 17rem at var(--spotlight-x) var(--spotlight-y),
      rgb(255 255 255 / 48%),
      transparent 68%
    );

    opacity: 0;
    transition: opacity 220ms ease;
  }

  .motion-tilt-shell:hover .launch-signup__form-spotlight {
    opacity: 1;
  }

  .launch-signup__input {
    transition:
      border-color 180ms var(--ease-friendly),
      box-shadow 180ms var(--ease-friendly),
      background-color 180ms var(--ease-friendly),
      transform 180ms var(--ease-friendly);
  }

  .launch-signup__input:hover {
    border-color: rgb(0 138 255 / 38%);
  }

  .launch-signup__input:focus {
    transform: translateY(-1px);
  }

  .launch-signup__input.is-valid {
    border-color: rgb(34 169 104 / 55%);
    background-color: rgb(239 252 245 / 72%);
    box-shadow: 0 0 0 4px rgb(34 169 104 / 10%);
  }

  .launch-signup__input.is-invalid {
    border-color: rgb(220 69 69 / 70%);
    background-color: rgb(255 241 241 / 82%);
    box-shadow: 0 0 0 4px rgb(220 69 69 / 11%);
  }

  .launch-signup__form.is-submitting {
    pointer-events: none;
  }

  .launch-signup__form.is-submitting button[type='submit'] {
    cursor: wait;
    opacity: 0.72;
  }

  @keyframes launch-ken-burns {
    0% {
      transform: translate3d(-1.5%, 0, 0) scale(1.06);
    }

    50% {
      transform: translate3d(0.5%, -1%, 0) scale(1.11);
    }

    100% {
      transform: translate3d(2%, -1.5%, 0) scale(1.16);
    }
  }

  @keyframes launch-orb-drift {
    0%,
    100% {
      transform: translate3d(0, 0, 0) scale(1);
    }

    50% {
      transform: translate3d(1rem, -1rem, 0) scale(1.06);
    }
  }

  @keyframes launch-shell-glow {
    0%,
    100% {
      transform: translate3d(0, 0, 0) scale(1);
    }

    50% {
      transform: translate3d(1.1rem, -0.8rem, 0) scale(1.07);
    }
  }

  @keyframes launch-paw-float {
    0%,
    100% {
      transform: translate3d(0, 0, 0) rotate(-4deg);
    }

    50% {
      transform: translate3d(0.45rem, -0.75rem, 0) rotate(5deg);
    }
  }

  @keyframes launch-mascot-bob {
    0%,
    100% {
      transform: translate3d(0, 0, 0) rotate(-2deg);
    }

    50% {
      transform: translate3d(0, -0.35rem, 0) rotate(2deg);
    }
  }

  @keyframes launch-mark-float {
    0%,
    100% {
      transform: translate3d(0, 0, 0) rotate(6deg);
    }

    50% {
      transform: translate3d(0.25rem, -0.5rem, 0) rotate(10deg);
    }
  }

  @media (min-width: 64rem) {
    .launch-signup__background-image.is-motion-active {
      animation: launch-ken-burns 20s ease-in-out infinite alternate;
      will-change: transform;
    }
  }

  .launch-signup__orb.is-motion-active {
    animation: launch-orb-drift 11s ease-in-out infinite;
    will-change: transform;
  }

  .launch-signup__orb--orange.is-motion-active,
  .launch-signup__orb--reverse.is-motion-active {
    animation-delay: -5s;
    animation-direction: reverse;
  }

  .launch-signup__shell-glow.is-motion-active {
    animation: launch-shell-glow 10s ease-in-out infinite;
    will-change: transform;
  }

  .launch-signup__shell-glow--reverse.is-motion-active {
    animation-delay: -4.5s;
    animation-direction: reverse;
  }

  .launch-signup__floating-paw.is-motion-active {
    animation: launch-paw-float 7s ease-in-out infinite;
    will-change: transform;
  }

  .launch-signup__floating-paw--reverse.is-motion-active {
    animation-delay: -3.5s;
    animation-direction: reverse;
  }

  .launch-signup__mascot.is-motion-active {
    animation: launch-mascot-bob 5s ease-in-out infinite;
    will-change: transform;
  }

  .launch-signup__floating-mark.is-motion-active {
    animation: launch-mark-float 5.5s ease-in-out infinite;
    will-change: transform;
  }

  @media (max-width: 1023px) {
    .launch-signup__grid {
      min-height: 0;
    }

    .launch-signup__copy-panel {
      min-height: 34rem;

      background: linear-gradient(
        180deg,
        rgb(33 23 17 / 18%) 0%,
        rgb(33 23 17 / 58%) 52%,
        rgb(33 23 17 / 90%) 100%
      );
    }

    .launch-signup__background-image {
      object-position: 44% center;
    }
  }

  @media (hover: none), (pointer: coarse) {
    .launch-signup__brand-note:hover {
      transform: none;
      background-color: rgb(33 23 17 / 72%);
    }

    .launch-signup__form-spotlight {
      display: none;
    }

    .launch-signup__input:focus {
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .launch-signup__background-image {
      animation: none !important;
      transform: scale(1.08) !important;
    }

    .launch-signup__orb,
    .launch-signup__floating-paw,
    .launch-signup__shell-glow,
    .launch-signup__brand-note,
    .launch-signup__mascot,
    .launch-signup__floating-mark,
    .launch-signup__input {
      animation: none !important;
      transition: none !important;
      will-change: auto !important;
    }

    .launch-signup__form-spotlight {
      display: none !important;
    }
  }
</style>

<script>
  interface NewsletterSignupResponse {
    ok?: boolean;

    message?: string;
  }

  interface PetProfileResponse {
    ok?: boolean;

    message?: string;
  }

  const initializeLaunchSignupForms = (): void => {
    const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-launch-signup]'));

    for (const section of sections) {
      if (section.dataset.launchFormInitialized === 'true') {
        continue;
      }

      section.dataset.launchFormInitialized = 'true';

      const signupStep = section.querySelector<HTMLElement>(
        '[data-founding-pack-step="signup"]',
      );

      const profileStep = section.querySelector<HTMLElement>(
        '[data-founding-pack-step="profile"]',
      );

      const completeStep = section.querySelector<HTMLElement>(
        '[data-founding-pack-step="complete"]',
      );

      const signupForm = section.querySelector<HTMLFormElement>('[data-launch-form]');

      const profileForm = section.querySelector<HTMLFormElement>('[data-pet-profile-form]');

      const signupSubmitButton =
        signupForm?.querySelector<HTMLButtonElement>('button[type="submit"]');

      const signupSubmitLabel =
        signupForm?.querySelector<HTMLElement>('[data-launch-submit-label]');

      const signupStatus =
        signupForm?.querySelector<HTMLElement>('[data-launch-form-status]');

      const marketingConsentCheckbox =
        signupForm?.querySelector<HTMLInputElement>('#launch-marketing-consent');

      const emailField =
        signupForm?.querySelector<HTMLInputElement>('[data-launch-email]');

      const profileSubmitButton =
        profileForm?.querySelector<HTMLButtonElement>('button[type="submit"]');

      const profileSubmitLabel =
        profileForm?.querySelector<HTMLElement>('[data-profile-submit-label]');

      const profileStatus =
        profileForm?.querySelector<HTMLElement>('[data-profile-status]');

      const profileSkipButton =
        profileForm?.querySelector<HTMLButtonElement>('[data-profile-skip]');

      const completeMessage =
        section.querySelector<HTMLElement>('[data-complete-message]');

      if (
        !signupStep ||
        !profileStep ||
        !completeStep ||
        !signupForm ||
        !profileForm ||
        !emailField
      ) {
        continue;
      }

      let foundingPackEmail = '';

      const cleanupFunctions: Array<() => void> = [];

      const showStatus = (
        element: HTMLElement | null | undefined,
        message: string,
        state: 'success' | 'error',
      ): void => {
        if (!element) {
          return;
        }

        element.textContent = message;

        element.classList.remove(
          'hidden',
          'border-red-200',
          'bg-red-50',
          'text-red-800',
          'border-emerald-200',
          'bg-emerald-50',
          'text-emerald-800',
        );

        if (state === 'success') {
          element.classList.add(
            'border-emerald-200',
            'bg-emerald-50',
            'text-emerald-800',
          );

          return;
        }

        element.classList.add('border-red-200', 'bg-red-50', 'text-red-800');
      };

      const clearStatus = (element: HTMLElement | null | undefined): void => {
        if (!element) {
          return;
        }

        element.textContent = '';
        element.classList.add('hidden');
      };

      const setSignupSubmitting = (submitting: boolean): void => {
        signupForm.classList.toggle('is-submitting', submitting);
        signupForm.toggleAttribute('aria-busy', submitting);

        if (signupSubmitButton) {
          signupSubmitButton.disabled = submitting;
          signupSubmitButton.toggleAttribute('aria-busy', submitting);
        }

        if (signupSubmitLabel) {
          signupSubmitLabel.textContent = submitting
            ? 'Joining the Pack…'
            : marketingConsentCheckbox?.checked === false
              ? 'Save My Preference'
              : 'Join the Founding Pack';
        }
      };

      const setProfileSubmitting = (submitting: boolean): void => {
        profileForm.classList.toggle('is-submitting', submitting);
        profileForm.toggleAttribute('aria-busy', submitting);

        if (profileSubmitButton) {
          profileSubmitButton.disabled = submitting;
          profileSubmitButton.toggleAttribute('aria-busy', submitting);
        }

        if (profileSubmitLabel) {
          profileSubmitLabel.textContent = submitting
            ? 'Saving Pet Profile…'
            : 'Save Pet Profile';
        }

        if (profileSkipButton) {
          profileSkipButton.disabled = submitting;
        }
      };

      const showStep = (step: 'signup' | 'profile' | 'complete'): void => {
        signupStep.hidden = step !== 'signup';
        profileStep.hidden = step !== 'profile';
        completeStep.hidden = step !== 'complete';

        const target =
          step === 'signup'
            ? signupStep
            : step === 'profile'
              ? profileStep
              : completeStep;

        requestAnimationFrame(() => {
          const heading = target.querySelector<HTMLElement>('h3');

          heading?.setAttribute('tabindex', '-1');
          heading?.focus({ preventScroll: true });
        });
      };

      const updateFieldState = (
        field: HTMLInputElement | HTMLSelectElement,
      ): void => {
        const hasValue = field.value.trim().length > 0;
        const isValid = field.validity.valid;

        field.classList.toggle('is-valid', hasValue && isValid);

        if (isValid) {
          field.classList.remove('is-invalid');
          field.removeAttribute('aria-invalid');
        }
      };

      const initializeFieldValidation = (
        fields: Array<HTMLInputElement | HTMLSelectElement>,
      ): void => {
        for (const field of fields) {
          const handleInvalid = (): void => {
            field.classList.add('is-invalid');
            field.classList.remove('is-valid');
            field.setAttribute('aria-invalid', 'true');
          };

          const handleUpdate = (): void => {
            updateFieldState(field);
          };

          field.addEventListener('invalid', handleInvalid);
          field.addEventListener('input', handleUpdate);
          field.addEventListener('change', handleUpdate);
          field.addEventListener('blur', handleUpdate);

          cleanupFunctions.push(() => {
            field.removeEventListener('invalid', handleInvalid);
            field.removeEventListener('input', handleUpdate);
            field.removeEventListener('change', handleUpdate);
            field.removeEventListener('blur', handleUpdate);
          });
        }
      };

      const signupFields = Array.from(
        signupForm.querySelectorAll<HTMLInputElement>('[data-launch-field]'),
      );

      const profileFields = Array.from(
        profileForm.querySelectorAll<HTMLInputElement | HTMLSelectElement>(
          '[data-profile-field]',
        ),
      );

      initializeFieldValidation(signupFields);
      initializeFieldValidation(profileFields);

      const syncSignupButtonLabel = (): void => {
        if (signupForm.classList.contains('is-submitting') || !signupSubmitLabel) {
          return;
        }

        signupSubmitLabel.textContent =
          marketingConsentCheckbox?.checked === false
            ? 'Save My Preference'
            : 'Join the Founding Pack';
      };

      const handleMarketingConsentChange = (): void => {
        syncSignupButtonLabel();
      };

      const handleSignupSubmit = async (event: SubmitEvent): Promise<void> => {
        if (!signupForm.checkValidity()) {
          return;
        }

        event.preventDefault();

        clearStatus(signupStatus);

        setSignupSubmitting(true);

        try {
          const formData = new FormData(signupForm);

          const response = await fetch(signupForm.action, {
            method: 'POST',

            headers: {
              Accept: 'application/json',
            },

            body: formData,
          });

          const body = (await response.json().catch(() => null)) as
            | NewsletterSignupResponse
            | null;

          if (!response.ok || body?.ok !== true) {
            throw new Error(
              body?.message ??
                'We could not save your Founding Pack signup. Please try again.',
            );
          }

          foundingPackEmail = emailField.value.trim().toLowerCase();

          showStep('profile');
        } catch (error) {
          const message =
            error instanceof Error
              ? error.message
              : 'We could not save your Founding Pack signup. Please try again.';

          showStatus(signupStatus, message, 'error');
        } finally {
          setSignupSubmitting(false);
        }
      };

      const handleProfileSubmit = async (event: SubmitEvent): Promise<void> => {
        event.preventDefault();

        if (!profileForm.checkValidity()) {
          profileForm.reportValidity();

          return;
        }

        clearStatus(profileStatus);

        setProfileSubmitting(true);

        try {
          const petNameField =
            profileForm.querySelector<HTMLInputElement>('[name="pet-name"]');

          const petTypeField =
            profileForm.querySelector<HTMLSelectElement>('[name="pet-type"]');

          const petPersonalityField =
            profileForm.querySelector<HTMLSelectElement>(
              '[name="pet-personality"]',
            );

          const selectedLaunchInterest =
            profileForm.querySelector<HTMLInputElement>(
              '[name="launch-interest"]:checked',
            );

          const botField =
            profileForm.querySelector<HTMLInputElement>(
              '[data-profile-bot-field]',
            );

          if (!petNameField || !petTypeField) {
            throw new Error('The pet profile form is unavailable. Please try again.');
          }

          const response = await fetch('/api/founding-pack/profile', {
            method: 'POST',

            headers: {
              Accept: 'application/json',
              'Content-Type': 'application/json',
            },

            body: JSON.stringify({
              email: foundingPackEmail,
              petName: petNameField.value,
              petType: petTypeField.value,
              petPersonality: petPersonalityField?.value || undefined,
              launchInterest: selectedLaunchInterest?.value || undefined,
              botField: botField?.value || undefined,
            }),
          });

          const body = (await response.json().catch(() => null)) as
            | PetProfileResponse
            | null;

          if (!response.ok || body?.ok !== true) {
            throw new Error(
              body?.message ?? 'We could not save your pet profile. Please try again.',
            );
          }

          if (completeMessage) {
            completeMessage.textContent =
              body.message ??
              `Thanks for introducing ${petNameField.value.trim()} to Maxi. You're officially part of the Founding Pack.`;
          }

          showStep('complete');
        } catch (error) {
          const message =
            error instanceof Error
              ? error.message
              : 'We could not save your pet profile. Please try again.';

          showStatus(profileStatus, message, 'error');
        } finally {
          setProfileSubmitting(false);
        }
      };

      const handleSkipProfile = (): void => {
        if (completeMessage) {
          completeMessage.textContent =
            "You're officially part of the Maxi Pawz Founding Pack. You can tell us more about your pet another time.";
        }

        showStep('complete');
      };

      const handlePageShow = (): void => {
        setSignupSubmitting(false);
        setProfileSubmitting(false);
      };

      marketingConsentCheckbox?.addEventListener(
        'change',
        handleMarketingConsentChange,
      );

      signupForm.addEventListener('submit', handleSignupSubmit);

      profileForm.addEventListener('submit', handleProfileSubmit);

      profileSkipButton?.addEventListener('click', handleSkipProfile);

      window.addEventListener('pageshow', handlePageShow);

      syncSignupButtonLabel();

      const cleanup = (): void => {
        marketingConsentCheckbox?.removeEventListener(
          'change',
          handleMarketingConsentChange,
        );

        signupForm.removeEventListener('submit', handleSignupSubmit);

        profileForm.removeEventListener('submit', handleProfileSubmit);

        profileSkipButton?.removeEventListener('click', handleSkipProfile);

        window.removeEventListener('pageshow', handlePageShow);

        for (const cleanupField of cleanupFunctions) {
          cleanupField();
        }

        delete section.dataset.launchFormInitialized;
      };

      document.addEventListener('astro:before-swap', cleanup, {
        once: true,
      });
    }
  };

  initializeLaunchSignupForms();

  document.addEventListener('astro:page-load', initializeLaunchSignupForms);
</script>