---
import { Image } from 'astro:assets';

import ArrowRightBold from 'phosphor-astro/ArrowRightBold.astro';
import HeartBold from 'phosphor-astro/HeartBold.astro';
import PawPrintBold from 'phosphor-astro/PawPrintBold.astro';
import ShoppingBagOpenBold from 'phosphor-astro/ShoppingBagOpenBold.astro';

import storyBackgroundOne from '../../assets/home/hero-slide-1.webp';
import storyBackgroundTwo from '../../assets/home/hero-slide-2.webp';
import storyBackgroundThree from '../../assets/home/hero-slide-3.webp';

import BrandStoryVisualSlider from './BrandStoryVisualSlider.astro';

import Button from '../ui/Button.astro';

import { isStoreLive } from '../../config/storefront';

import { brandStory } from '../../data/homepage';

const backgroundSlides = [
  {
    src: storyBackgroundOne,
  },

  {
    src: storyBackgroundTwo,
  },

  {
    src: storyBackgroundThree,
  },
];
---

<section
  id="our-story"
  class="brand-story-editorial section-spacing relative isolate overflow-hidden bg-ink-950 text-white"
  aria-labelledby="brand-story-title"
  data-brand-story-section
>
  <!-- Full-section background slider -->
  <div
    class="brand-story-background pointer-events-none absolute inset-0 z-0 overflow-hidden"
    aria-hidden="true"
  >
    {
      backgroundSlides.map((slide, index) => (
        <div
          class="brand-story-background__slide absolute inset-0"
          style={`--story-background-delay: ${index * 8}s;`}
        >
          <Image
            src={slide.src}
            alt=""
            class="brand-story-background__image absolute inset-0 size-full object-cover"
            loading="lazy"
            fetchpriority="low"
            widths={[768, 1024, 1280, 1600, 1920]}
            sizes="100vw"
            quality={78}
          />
        </div>
      ))
    }

    <div
      class="brand-story-background__overlay absolute inset-0"
      aria-hidden="true"
    >
    </div>

    <div
      class="brand-story-background__edge-fade absolute inset-0"
      aria-hidden="true"
    >
    </div>
  </div>

  <div
    class="brand-story-editorial__pattern pointer-events-none absolute inset-0 z-0"
    aria-hidden="true"
  >
  </div>

  <div
    class="motion-parallax brand-story-editorial__glow brand-story-editorial__glow--blue pointer-events-none absolute -top-40 -left-32 z-0"
    data-parallax
    data-parallax-speed="0.035"
    data-motion-continuous
    aria-hidden="true"
  >
    <div
      class="size-96 rounded-full bg-brand-500/24 blur-3xl"
    >
    </div>
  </div>

  <div
    class="motion-parallax brand-story-editorial__glow brand-story-editorial__glow--orange pointer-events-none absolute -right-32 -bottom-44 z-0"
    data-parallax
    data-parallax-speed="0.055"
    data-motion-continuous
    aria-hidden="true"
  >
    <div
      class="size-112 rounded-full bg-accent-500/20 blur-3xl"
    >
    </div>
  </div>

  <div
    class="brand-story-editorial__paw brand-story-editorial__paw--one pointer-events-none absolute top-[10%] right-[7%] z-0 hidden text-brand-300/25 lg:block"
    data-motion-continuous
    aria-hidden="true"
  >
    <PawPrintBold
      class="size-16 rotate-12"
    />
  </div>

  <div
    class="brand-story-editorial__paw brand-story-editorial__paw--two pointer-events-none absolute bottom-[10%] left-[4%] z-0 hidden text-accent-300/22 lg:block"
    data-motion-continuous
    aria-hidden="true"
  >
    <PawPrintBold
      class="size-12 -rotate-12"
    />
  </div>

  <div
    class="site-container relative z-10"
  >
    <div
      class="mb-10 flex flex-col gap-5 border-b border-white/10 pb-8 sm:mb-12 sm:flex-row sm:items-end sm:justify-between"
      data-reveal
    >
      <div>
        <p
          class="mt-4 max-w-xl text-sm font-extrabold tracking-[0.18em] text-white/55 uppercase"
        >
          Meet Maxi · Discover our story
        </p>
      </div>

      <p
        class="text-sm leading-6 text-white/60 sm:text-right"
      >
        A pet store shaped by real experience, everyday routines, and the dog who inspired it all.
      </p>
    </div>

    <div
      class="grid items-center gap-12 lg:grid-cols-[0.92fr_1.08fr] lg:gap-16 xl:gap-20"
    >
      <!-- Maxi story slider: desktop only -->
      <div
        class="mx-auto hidden w-full max-w-lg lg:mx-0 lg:block"
        data-reveal="left"
        style="--reveal-delay: 80ms;"
      >
        <div
          class="motion-parallax brand-story-visual-parallax relative"
          data-parallax
          data-parallax-speed="0.025"
        >
          <div
            class="motion-tilt-shell brand-story-visual-shell relative"
            data-tilt-root
            data-tilt-strength="1.8"
          >
            <div
              class="motion-tilt-surface brand-story-visual-surface relative"
              data-tilt-surface
            >
              <BrandStoryVisualSlider />
            </div>
          </div>
        </div>
      </div>

      <!-- Story copy -->
      <div
        class="mx-auto w-full max-w-3xl lg:mx-0 lg:max-w-none"
      >
        <div
          data-reveal="right"
          style="--reveal-delay: 120ms;"
        >
          <h2
            id="brand-story-title"
            class="section-title text-4xl text-white sm:text-5xl lg:text-[3.65rem]"
          >
            The dog behind the name—and the{' '}

            <span
              class="brand-story-accent-text text-accent-300"
            >
              heart behind our store.
            </span>
          </h2>

          <p
            class="mt-6 border-l-4 border-accent-400 pl-5 text-lg leading-8 font-bold text-white/92 sm:text-xl"
          >
            {brandStory.introduction}
          </p>
        </div>

        <div
          class="mt-6 space-y-4 text-base leading-7 text-white/72 sm:text-lg sm:leading-8"
          data-reveal="right"
          style="--reveal-delay: 180ms;"
        >
          <p>
            {brandStory.experience}
          </p>

          <p>
            {brandStory.community}
          </p>
        </div>

        <div
          class="brand-story-cta mt-8 overflow-hidden rounded-card border border-white/12 bg-linear-to-br from-white/9 via-white/5.5 to-brand-500/12 p-5 shadow-card sm:p-6"
          data-reveal="right"
          style="--reveal-delay: 290ms;"
        >
          <div
            class="relative z-10"
          >
            <div
              class="flex items-start gap-3"
            >
              <div>
                <p
                  class="font-display text-lg text-white sm:text-xl"
                >
                  More than a mascot. This is where the story starts.
                </p>

                <p
                  class="mt-2 text-sm leading-6 text-white/65"
                >
                  Learn how Maxi, two friends, and a shared love for pets became the foundation of
                  Maxi Pawz.
                </p>
              </div>
            </div>

            <div
              class="mt-5 flex flex-col gap-3 sm:flex-row"
            >
              <Button
                href="/about"
                variant="primary"
                size="lg"
                iconPosition="right"
                class="w-full sm:w-auto"
              >
                <ArrowRightBold
                  slot="icon"
                  aria-hidden="true"
                />

                Meet Maxi & Our Story
              </Button>

              {
                isStoreLive ? (
                  <Button
                    href="/shop"
                    variant="secondary"
                    size="lg"
                    iconPosition="right"
                    class="w-full sm:w-auto"
                  >
                    <ShoppingBagOpenBold
                      slot="icon"
                      aria-hidden="true"
                    />

                    Explore the Shop
                  </Button>
                ) : (
                  <Button
                    href="/#join-the-pack"
                    variant="secondary"
                    size="lg"
                    iconPosition="right"
                    class="w-full sm:w-auto"
                  >
                    <HeartBold
                      slot="icon"
                      aria-hidden="true"
                    />

                    Join the Pack
                  </Button>
                )
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /*
   * Background slider
   *
   * The dark section color remains the foundation. The photography
   * adds atmosphere without replacing the established dark appearance.
   */
  .brand-story-background {
    background-color:
      rgb(20 15 12);
  }

  .brand-story-background__slide {
    opacity:
      0;
  }

  .brand-story-background__slide:first-child {
    opacity:
      1;
  }

  .brand-story-background__image {
    opacity:
      0.48;

    transform:
      scale(1.08);

    filter:
      saturate(0.88)
      contrast(0.96)
      brightness(0.72);
  }

  .brand-story-editorial.is-story-visible
    .brand-story-background__slide {
    animation:
      brand-story-background-fade
      24s
      linear
      infinite;

    animation-delay:
      var(--story-background-delay);
  }

  .brand-story-editorial.is-story-visible
    .brand-story-background__image {
    animation:
      brand-story-background-ken-burns
      24s
      ease-in-out
      infinite;

    animation-delay:
      var(--story-background-delay);
  }

  .brand-story-background__overlay {
    background:
      linear-gradient(
        90deg,
        rgb(20 15 12 / 62%) 0%,
        rgb(20 15 12 / 70%) 44%,
        rgb(20 15 12 / 76%) 100%
      ),
      linear-gradient(
        180deg,
        rgb(20 15 12 / 54%) 0%,
        rgb(20 15 12 / 28%) 44%,
        rgb(20 15 12 / 72%) 100%
      );
  }

  .brand-story-background__edge-fade {
    box-shadow:
      inset 0 8rem 8rem -6rem
        rgb(20 15 12 / 92%),
      inset 0 -8rem 8rem -6rem
        rgb(20 15 12 / 94%);
  }

  .brand-story-editorial__pattern {
    background-image:
      linear-gradient(
        rgb(255 255 255 / 3%) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgb(255 255 255 / 3%) 1px,
        transparent 1px
      );

    background-size:
      3.5rem 3.5rem;

    mask-image:
      linear-gradient(
        to bottom,
        transparent,
        black 12%,
        black 88%,
        transparent
      );

    opacity:
      0.36;
  }

  /*
   * Existing decorative motion
   */
  .brand-story-editorial__glow.is-motion-active {
    animation:
      brand-story-glow-drift
      11s
      ease-in-out
      infinite;
  }

  .brand-story-editorial__glow--orange.is-motion-active {
    animation-delay:
      -5s;

    animation-direction:
      reverse;
  }

  .brand-story-editorial__paw.is-motion-active {
    animation:
      brand-story-paw-float
      7.5s
      ease-in-out
      infinite;

    will-change:
      transform;
  }

  .brand-story-editorial__paw--two.is-motion-active {
    animation-delay:
      -3.5s;

    animation-direction:
      reverse;
  }

  .brand-story-accent-text {
    background:
      linear-gradient(
        110deg,
        #ffae66 0%,
        #ff8433 45%,
        #8ed3ff 100%
      );

    background-clip:
      text;

    color:
      transparent;
  }

  .brand-story-cta {
    position:
      relative;
  }

  .brand-story-cta::before {
    position:
      absolute;

    top:
      -7rem;

    right:
      -5rem;

    width:
      17rem;

    height:
      17rem;

    border-radius:
      9999px;

    background:
      rgb(0 138 255 / 18%);

    content:
      '';

    filter:
      blur(2.5rem);

    pointer-events:
      none;
  }

  .brand-story-cta::after {
    position:
      absolute;

    bottom:
      -8rem;

    left:
      15%;

    width:
      16rem;

    height:
      16rem;

    border-radius:
      9999px;

    background:
      rgb(255 102 0 / 16%);

    content:
      '';

    filter:
      blur(2.5rem);

    pointer-events:
      none;
  }

  @keyframes brand-story-background-fade {
    0%,
    29% {
      opacity:
        1;
    }

    38%,
    100% {
      opacity:
        0;
    }
  }

  @keyframes brand-story-background-ken-burns {
    0% {
      transform:
        scale(1.08)
        translate3d(
          0,
          0,
          0
        );
    }

    50% {
      transform:
        scale(1.14)
        translate3d(
          -1%,
          -0.8%,
          0
        );
    }

    100% {
      transform:
        scale(1.19)
        translate3d(
          1%,
          0.8%,
          0
        );
    }
  }

  @keyframes brand-story-glow-drift {
    0%,
    100% {
      transform:
        translate3d(
          0,
          var(--motion-parallax-y),
          0
        )
        scale(1);
    }

    50% {
      transform:
        translate3d(
          1rem,
          calc(
            var(--motion-parallax-y) -
            1rem
          ),
          0
        )
        scale(1.06);
    }
  }

  @keyframes brand-story-paw-float {
    0%,
    100% {
      transform:
        translate3d(
          0,
          0,
          0
        )
        rotate(-4deg);
    }

    50% {
      transform:
        translate3d(
          0.45rem,
          -0.8rem,
          0
        )
        rotate(5deg);
    }
  }

  @media (max-width: 1023px) {
    .brand-story-background__image {
      opacity:
        0.42;
    }

    .brand-story-background__overlay {
      background:
        linear-gradient(
          180deg,
          rgb(20 15 12 / 72%) 0%,
          rgb(20 15 12 / 54%) 40%,
          rgb(20 15 12 / 78%) 100%
        );
    }
  }

  @media (max-width: 639px) {
    .brand-story-background__image {
      opacity:
        0.36;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-story-background__slide,
    .brand-story-background__image,
    .brand-story-editorial__glow,
    .brand-story-editorial__paw {
      animation:
        none !important;

      transition:
        none !important;

      will-change:
        auto !important;
    }

    .brand-story-background__slide {
      opacity:
        0 !important;
    }

    .brand-story-background__slide:first-child {
      opacity:
        1 !important;
    }

    .brand-story-background__image {
      transform:
        scale(1.08) !important;
    }
  }
</style>