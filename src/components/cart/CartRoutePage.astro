---
import ShoppingCartBold from 'phosphor-astro/ShoppingCartBold.astro';

import CartPage from '@components/cart/CartPage';
import Badge from '@components/ui/Badge.astro';
import BaseLayout from '@layouts/BaseLayout.astro';

import { getLocaleFromPathname } from '../../i18n/languages';

const locale =
  getLocaleFromPathname(
    Astro.url.pathname,
  );

const spanish =
  locale === 'es';

const copy =
  spanish
    ? {
        title:
          'Carrito de compras',

        description:
          'Revisa los productos, opciones y cantidades seleccionadas en tu carrito de Maxi Pawz.',

        badge:
          'Carrito de Maxi Pawz',

        heading:
          'Tu carrito de compras.',

        intro:
          'Revisa tus productos, ajusta las cantidades y elimina lo que ya no necesites.',
      }
    : {
        title:
          'Shopping Cart',

        description:
          'Review your selected products, options, and quantities in your Maxi Pawz shopping cart.',

        badge:
          'Maxi Pawz Cart',

        heading:
          'Your shopping cart.',

        intro:
          'Review your items, adjust quantities, and remove anything you no longer need.',
      };
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  noIndex={true}
>
  <section class="py-6 sm:py-8">
    <div class="site-container">
      <div
        class="relative overflow-hidden rounded-[2.75rem] border border-brand-200 bg-linear-to-br from-brand-50 via-white-warm to-accent-50 p-6 shadow-card sm:p-8"
      >
        <div
          class="pointer-events-none absolute -top-32 -left-28 size-80 rounded-full bg-brand-300/25 blur-3xl"
          aria-hidden="true"
        >
        </div>

        <div class="relative max-w-3xl">
          <Badge
            variant="accent"
            size="md"
          >
            <ShoppingCartBold
              slot="icon"
              aria-hidden="true"
            />

            {copy.badge}
          </Badge>

          <h1 class="mt-4 text-4xl text-ink-900 sm:text-5xl">
            {copy.heading}
          </h1>

          <p class="mt-4 max-w-2xl text-base leading-7 text-ink-600 sm:text-lg">
            {copy.intro}
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="pb-16 sm:pb-20 lg:pb-24">
    <div class="site-container">
      <CartPage
        locale={locale}
        client:load
      />
    </div>
  </section>
</BaseLayout>