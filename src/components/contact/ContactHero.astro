---
import CheckCircleFill from 'phosphor-astro/CheckCircleFill.astro';
import HeartBold from 'phosphor-astro/HeartBold.astro';
import PawPrintBold from 'phosphor-astro/PawPrintBold.astro';
import ShoppingBagOpenBold from 'phosphor-astro/ShoppingBagOpenBold.astro';
import SparkleBold from 'phosphor-astro/SparkleBold.astro';

import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';

import { isStoreLive } from '../../config/storefront';

const heroHighlights = isStoreLive
    ? [
        'General and product questions',
        'Order and return support',
        'Partnerships and website feedback',
        ]
    : [
        'General and product questions',
        'Partnership and collaboration ideas',
        'Website feedback and suggestions',
        ];
---

<section class="relative overflow-hidden" aria-labelledby="contact-hero-title">
    <div
        class="pointer-events-none absolute -top-40 -left-40 size-128 rounded-full bg-brand-300/25 blur-3xl"
        aria-hidden="true"
    >
    </div>

    <div
        class="pointer-events-none absolute top-8 -right-48 size-136 rounded-full bg-accent-300/25 blur-3xl"
        aria-hidden="true"
    >
    </div>

    <div
        class="site-container-wide grid items-center gap-10 py-12 sm:py-14 lg:grid-cols-[1.02fr_0.98fr] lg:gap-14 lg:py-16"
    >
        <!-- Hero content -->
        <div class="relative z-10 max-w-2xl">
        <Badge variant="accent" size="md">
            <HeartBold slot="icon" aria-hidden="true" />

            Contact MaxiPawz
        </Badge>

        <h1
            id="contact-hero-title"
            class="mt-6 max-w-2xl text-5xl text-ink-900 sm:text-6xl lg:text-7xl"
        >
            We would love to{' '}
            <span class="text-brand-gradient"> hear from you. </span>
        </h1>

        <p class="mt-6 max-w-xl text-lg leading-8 text-ink-600 sm:text-xl">
            {
            isStoreLive
                ? 'Send us your general questions, product questions, order-support requests, partnership ideas, or feedback about the MaxiPawz experience.'
                : 'Send us your questions about MaxiPawz, future products, partnership ideas, Pet Guides, or feedback about the website.'
            }
        </p>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <Button
            href="#contact-form"
            variant="primary"
            size="lg"
            iconPosition="right"
            class="w-full sm:w-auto"
            >
            <HeartBold slot="icon" aria-hidden="true" />

            Send a Message
            </Button>

            <Button
            href="/pet-guides"
            variant="secondary"
            size="lg"
            iconPosition="right"
            class="w-full sm:w-auto"
            >
            <PawPrintBold slot="icon" aria-hidden="true" />

            Explore Pet Guides
            </Button>
        </div>

        <div class="mt-8 flex flex-wrap gap-x-6 gap-y-3 text-sm font-bold text-ink-600">
            {
            heroHighlights.map((highlight) => (
                <span class="inline-flex items-center gap-2">
                <CheckCircleFill class="size-5 shrink-0 text-brand-500" aria-hidden="true" />

                {highlight}
                </span>
            ))
            }
        </div>
        </div>

        <!-- Message overview -->
        <div
        class="relative overflow-hidden rounded-[2.5rem] border border-brand-200 bg-linear-to-br from-brand-50 via-white-warm to-accent-50 p-5 shadow-card sm:p-6"
        >
        <div
            class="pointer-events-none absolute -top-20 -right-20 size-56 rounded-full bg-brand-300/25 blur-3xl"
            aria-hidden="true"
        >
        </div>

        <div
            class="pointer-events-none absolute -bottom-24 -left-20 size-64 rounded-full bg-accent-300/25 blur-3xl"
            aria-hidden="true"
        >
        </div>

        <div class="relative">
            <div class="flex items-start gap-4">
            <span
                class="grid size-12 shrink-0 place-items-center rounded-2xl bg-brand-500 text-white shadow-blue"
                aria-hidden="true"
            >
                <SparkleBold class="size-6" />
            </span>

            <div>
                <p class="text-xs font-extrabold tracking-[0.09em] text-brand-700 uppercase">
                A helpful message
                </p>

                <h2 class="mt-2 text-2xl text-ink-900 sm:text-3xl">Tell us what you need.</h2>
            </div>
            </div>

            <div class="mt-6 grid gap-3">
            <article class="rounded-2xl border border-sand/80 bg-white-warm/90 p-4">
                <PawPrintBold class="size-6 text-brand-500" aria-hidden="true" />

                <h3 class="mt-3 text-lg text-ink-900">Choose a clear topic</h3>

                <p class="mt-2 text-sm leading-6 text-ink-600">
                Select the option that most closely matches your question, idea, or request.
                </p>
            </article>

            <article class="rounded-2xl border border-sand/80 bg-white-warm/90 p-4">
                <ShoppingBagOpenBold class="size-6 text-accent-500" aria-hidden="true" />

                <h3 class="mt-3 text-lg text-ink-900">Add useful context</h3>

                <p class="mt-2 text-sm leading-6 text-ink-600">
                Mention the product category, page, feature, order number, or pet routine connected to
                your message.
                </p>
            </article>
            </div>
        </div>
        </div>
    </div>
</section>