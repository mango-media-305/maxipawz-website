---
import ArrowRightBold from 'phosphor-astro/ArrowRightBold.astro';
import CheckCircleFill from 'phosphor-astro/CheckCircleFill.astro';
import HeartBold from 'phosphor-astro/HeartBold.astro';
import PawPrintBold from 'phosphor-astro/PawPrintBold.astro';
import ShieldCheckBold from 'phosphor-astro/ShieldCheckBold.astro';

import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';

import { businessConfig } from '../../config/business';
import { isStoreLive } from '../../config/storefront';

import { contactPrinciples, getAvailableContactTopics } from '../../data/contact';

const availableTopics = getAvailableContactTopics(isStoreLive);
---

<section
  id="contact-form"
  class="section-spacing scroll-mt-28"
  aria-labelledby="contact-form-title"
>
  <div class="site-container grid items-start gap-8 lg:grid-cols-2 lg:gap-12">
    <div class="lg:sticky lg:top-28">
      <Badge variant="accent" size="md">
        <HeartBold slot="icon" aria-hidden="true" />

        Send a Message
      </Badge>

      <h2 id="contact-form-title" class="section-title mt-5 text-4xl sm:text-5xl">
        Tell us how {businessConfig.shortName} can help.
      </h2>

      <p class="section-description mt-4">
        Complete the form with the closest topic and enough context for us to understand your
        question, idea, feedback, or request.
      </p>

      <p class="mt-4 text-sm font-bold leading-6 text-ink-500">
        {businessConfig.supportResponseTime}
      </p>

      <div class="mt-8 grid grid-cols-1 sm:grid-cols-3 gap-3">
        {
          contactPrinciples.map((principle) => (
            <article class="flex items-start gap-3 rounded-2xl border border-sand bg-white-warm/80 p-6">
              <div>
                <h3 class="text-base text-ink-900">{principle.title}</h3>

                <p class="mt-1 text-sm leading-6 text-ink-600">{principle.description}</p>
              </div>
            </article>
          ))
        }
      </div>

      <div class="mt-6 rounded-2xl border border-accent-200 bg-accent-50 p-4">
        <ShieldCheckBold class="size-6 text-accent-600" aria-hidden="true" />

        <p class="mt-3 text-sm leading-6 text-ink-600">
          This form is not intended for emergencies. Contact an appropriate veterinarian or
          emergency provider for urgent pet-health or safety concerns.
        </p>
      </div>

      <div class="mt-6 rounded-2xl border border-brand-200 bg-brand-50 p-4">
        <p class="text-sm font-extrabold text-ink-800">Prefer email?</p>

        <a
          href={`mailto:${businessConfig.generalEmail}`}
          class="mt-2 inline-flex break-all font-extrabold text-brand-700 transition hover:text-brand-900"
        >
          {businessConfig.generalEmail}
        </a>
      </div>
    </div>

    <form
      name="maxipawz-contact"
      action="/contact/success"
      method="POST"
      data-netlify="true"
      data-netlify-honeypot="bot-field"
      class="surface-card p-5 sm:p-6 lg:p-8"
    >
      <input type="hidden" name="form-name" value="maxipawz-contact" />

      <p hidden>
        <label>
          Do not fill out this field:

          <input name="bot-field" />
        </label>
      </p>

      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <label for="contact-name" class="form-label"> Full name </label>

          <input
            id="contact-name"
            name="name"
            type="text"
            autocomplete="name"
            class="form-control"
            placeholder="Your full name"
            required
          />
        </div>

        <div>
          <label for="contact-email" class="form-label"> Email address </label>

          <input
            id="contact-email"
            name="email"
            type="email"
            autocomplete="email"
            inputmode="email"
            class="form-control"
            placeholder="you@example.com"
            required
          />
        </div>
      </div>

      <div class="mt-5">
        <label for="contact-topic" class="form-label"> How can we help? </label>

        <select id="contact-topic" name="topic" class="form-control" required>
          <option value="" disabled selected> Choose a topic </option>

          {availableTopics.map((topic) => <option value={topic.value}>{topic.label}</option>)}
        </select>
      </div>

      {
        isStoreLive && (
          <div class="mt-5">
            <label for="contact-order-number" class="form-label">
              Order number
              <span class="font-normal text-ink-500"> — optional</span>
            </label>

            <input
              id="contact-order-number"
              name="order-number"
              type="text"
              autocomplete="off"
              class="form-control"
              placeholder="Example: MPZ-ABC1234567"
            />

            <p id="contact-order-help" class="form-help">
              Include this for order or return questions when it is available.
            </p>
          </div>
        )
      }

      <div class="mt-5">
        <label for="contact-message" class="form-label"> Message </label>

        <textarea
          id="contact-message"
          name="message"
          class="form-control"
          rows="8"
          minlength="20"
          maxlength="3000"
          placeholder="Tell us about your question, idea, feedback, or request."
          required></textarea>

        <p id="contact-message-help" class="form-help">
          Please provide at least 20 characters. Do not include card numbers, passwords, or complete
          payment information.
        </p>
      </div>

      <div class="mt-6">
        <Button type="submit" variant="primary" size="lg" fullWidth={true} iconPosition="right">
          <ArrowRightBold slot="icon" aria-hidden="true" />

          Send Message
        </Button>
      </div>

      <div
        class="mt-5 flex items-start justify-center gap-2 text-center text-xs leading-5 text-ink-500"
      >
        <PawPrintBold class="mt-0.5 size-4 shrink-0 text-brand-500" aria-hidden="true" />

        <p>Your message will be submitted securely through the website’s contact form.</p>
      </div>
    </form>
  </div>
</section>