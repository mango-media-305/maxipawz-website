    font-weight: 800;
    transition:
      background-color 160ms ease,
      border-color 160ms ease;
  }

  .catalog-active-chip:hover {
    border-color: #008aff;
    background: #dff1ff;
  }

  .catalog-page-button {
    display: inline-flex;
    min-height: 2.75rem;
    min-width: 2.75rem;
    align-items: center;
    justify-content: center;
    border: 1px solid #ecdab7;
    border-radius: 9999px;
    background: #fffdf5;
    padding: 0 0.9rem;
    color: #49372d;
    font-size: 0.875rem;
    font-weight: 800;
    transition:
      transform 160ms ease,
      background-color 160ms ease,
