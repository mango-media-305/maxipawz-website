---
import ArrowRightBold from 'phosphor-astro/ArrowRightBold.astro';
import PawPrintBold from 'phosphor-astro/PawPrintBold.astro';
import SparkleBold from 'phosphor-astro/SparkleBold.astro';

import Button from '../ui/Button.astro';

import {
  getLocaleFromPathname,
} from '../../i18n/languages';

import {
  localizeHref,
  localizedLinkLabel,
} from '../../i18n/routes';

interface Props {
  variant?:
    'catalog' |
    'filtered';
}

const {
  variant = 'catalog',
} =
  Astro.props;

const locale =
  getLocaleFromPathname(
    Astro.url.pathname,
  );

const spanish =
  locale === 'es';

const isFiltered =
  variant === 'filtered';

const title =
  isFiltered
    ? spanish
      ? 'Ningún producto coincide con esos filtros.'
      : 'No products match those filters.'
    : spanish
      ? 'No hay productos publicados actualmente.'
      : 'No products are currently published.';

const description =
  isFiltered
    ? spanish
      ? 'Intenta eliminar un filtro, cambiar el rango de precios o utilizar una búsqueda más amplia.'
      : 'Try removing a filter, changing the price range, or using a broader search.'
    : spanish
      ? 'La estructura del catálogo está lista. Los productos aparecerán aquí cuando se agreguen la información de inventario y las imágenes.'
      : 'The catalog structure is ready. Products will appear here after inventory information and images are added.';

const actionSourceHref =
  isFiltered
    ? '#products'
    : '/pet-guides';

const actionHref =
  isFiltered
    ? '#products'
    : localizeHref(
        actionSourceHref,
        locale,
      );

const baseActionLabel =
  isFiltered
    ? spanish
      ? 'Eliminar todos los filtros'
      : 'Clear All Filters'
    : spanish
      ? 'Explorar guías para mascotas'
      : 'Explore Pet Guides';

const actionLabel =
  isFiltered
    ? baseActionLabel
    : localizedLinkLabel(
        baseActionLabel,
        actionSourceHref,
        locale,
      );
---

<article
  class="relative overflow-hidden rounded-[2.5rem] border border-brand-200 bg-linear-to-br from-brand-50 via-white-warm to-accent-50 p-6 text-center shadow-card sm:p-8 lg:p-12"
>
  <div
    class="pointer-events-none absolute -top-24 -right-20 size-64 rounded-full bg-brand-300/25 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div
    class="pointer-events-none absolute -bottom-24 -left-20 size-64 rounded-full bg-accent-300/25 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-3xl">
    <span
      class="mx-auto grid size-16 place-items-center rounded-full border border-brand-200 bg-white-warm text-brand-600 shadow-soft"
      aria-hidden="true"
    >
      {
        isFiltered
          ? (
              <PawPrintBold class="size-8" />
            )
          : (
              <SparkleBold class="size-8" />
            )
      }
    </span>

    <h2 class="mx-auto mt-6 max-w-2xl text-3xl text-ink-900 sm:text-4xl">
      {title}
    </h2>

    <p class="mx-auto mt-4 max-w-2xl text-base leading-7 text-ink-600">
      {description}
    </p>

    <div class="mt-7">
      <Button
        href={actionHref}
        variant="secondary"
        size="lg"
        iconPosition="right"
      >
        <ArrowRightBold
          slot="icon"
          aria-hidden="true"
        />

        {actionLabel}
      </Button>
    </div>
  </div>
</article>