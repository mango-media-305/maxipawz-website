---
import type {
  ImageMetadata,
} from 'astro';

import {
  Image,
} from 'astro:assets';

import PawPrintBold from 'phosphor-astro/PawPrintBold.astro';

import type {
  ProductImage as ProductImageData,
  ProductImagePosition,
} from '../../types/product';

type ProductImageVariant =
  | 'card'
  | 'detail'
  | 'thumbnail';

type ProductImageFit =
  | 'cover'
  | 'contain';

interface Props {
  image?: ProductImageData;

  eager?: boolean;

  class?: string;

  imageClass?: string;

  variant?: ProductImageVariant;

  fit?: ProductImageFit;

  sizes?: string;

  widths?: number[];

  quality?: number;
}

interface ImageProfile {
  sizes: string;

  widths: number[];

  quality: number;
}

const imageProfiles:
  Record<
    ProductImageVariant,
    ImageProfile
  > = {
    card: {
      sizes:
        '(min-width: 1280px) 22vw, (min-width: 768px) 44vw, calc(100vw - 2.5rem)',

      widths: [
        320,
        480,
        640,
        800,
      ],

      quality: 78,
    },

    detail: {
      sizes:
        '(min-width: 1280px) 34rem, (min-width: 1024px) 43vw, calc(100vw - 2rem)',

      widths: [
        480,
        640,
        800,
        960,
        1200,
      ],

      quality: 82,
    },

    thumbnail: {
      sizes:
        '(min-width: 1024px) 13vw, (min-width: 640px) 30vw, 46vw',

      widths: [
        160,
        240,
        320,
        480,
        640,
      ],

      quality: 76,
    },
  };

const {
  image,

  eager = false,

  class:
    className = '',

  imageClass = '',

  variant = 'detail',

  fit = 'cover',

  sizes,

  widths,

  quality,
} = Astro.props;

const profile =
  imageProfiles[
    variant
  ];

const resolvedSizes =
  sizes ??
  profile.sizes;

const requestedWidths =
  widths ??
  profile.widths;

const resolvedQuality =
  quality ??
  profile.quality;

function getObjectPosition(
  position:
    ProductImagePosition =
      'center',
): string {
  switch (
    position
  ) {
    case 'top':
      return 'center top';

    case 'bottom':
      return 'center bottom';

    case 'left':
      return 'left center';

    case 'right':
      return 'right center';

    case 'center':
    default:
      return 'center center';
  }
}

const resolvedObjectPosition =
  getObjectPosition(
    image?.position ??
      'center',
  );

/**
 * Important:
 *
 * The site-wide base stylesheet contains:
 *
 * img {
 *   height: auto;
 * }
 *
 * That is a good default for normal content images, but ProductImage is
 * specifically designed to fill a visual container.
 *
 * We therefore set width, height, object-fit, and object-position inline.
 * This guarantees that `cover` really covers the complete wrapper on every
 * breakpoint while avoiding a global CSS change that could affect unrelated
 * images around the site.
 */
const imageStyle = [
  'display: block',
  'width: 100%',
  'height: 100%',
  `object-fit: ${fit}`,
  `object-position: ${resolvedObjectPosition}`,
].join('; ');

const imageClasses = [
  'block',

  'max-w-none',

  imageClass,
]
  .filter(
    Boolean,
  )
  .join(
    ' ',
  );

const loading =
  eager
    ? 'eager'
    : 'lazy';

const fetchPriority =
  eager
    ? 'high'
    : 'auto';

function getSourceWidth(
  sourceImage:
    ProductImageData,
): number {
  return typeof sourceImage.src ===
    'string'
    ? sourceImage.width
    : sourceImage.src.width;
}

function getResponsiveWidths(
  sourceImage:
    ProductImageData,
): number[] {
  const sourceWidth =
    getSourceWidth(
      sourceImage,
    );

  const validWidths =
    requestedWidths
      .filter(
        (
          width,
        ) =>
          Number.isFinite(
            width,
          ) &&
          width >
            0 &&
          width <=
            sourceWidth,
      )
      .map(
        (
          width,
        ) =>
          Math.round(
            width,
          ),
      );

  if (
    validWidths.length ===
    0
  ) {
    validWidths.push(
      sourceWidth,
    );
  }

  return Array.from(
    new Set(
      validWidths,
    ),
  ).sort(
    (
      firstWidth,
      secondWidth,
    ) =>
      firstWidth -
      secondWidth,
  );
}

function isUnsplashImage(
  source: string,
): boolean {
  try {
    return (
      new URL(
        source,
      ).hostname ===
      'images.unsplash.com'
    );
  } catch {
    return false;
  }
}

function createUnsplashVariant(
  source: string,

  width: number,

  height: number,
): string {
  const url =
    new URL(
      source,
    );

  url.searchParams.set(
    'auto',
    'format',
  );

  url.searchParams.set(
    'w',
    String(
      width,
    ),
  );

  url.searchParams.set(
    'q',
    String(
      resolvedQuality,
    ),
  );

  if (
    fit ===
    'contain'
  ) {
    url.searchParams.set(
      'fit',
      'max',
    );

    url.searchParams.delete(
      'h',
    );
  } else {
    url.searchParams.set(
      'fit',
      'crop',
    );

    url.searchParams.set(
      'h',
      String(
        height,
      ),
    );
  }

  return url.toString();
}

const responsiveWidths =
  image
    ? getResponsiveWidths(
        image,
      )
    : [];

const remoteImage =
  image &&
  typeof image.src ===
    'string'
    ? image
    : undefined;

const remoteSourceSet =
  remoteImage &&
  isUnsplashImage(
    remoteImage.src,
  )
    ? responsiveWidths
        .map(
          (
            width,
          ) => {
            const height =
              Math.max(
                1,

                Math.round(
                  width *
                    (
                      remoteImage.height /
                      remoteImage.width
                    ),
                ),
              );

            return `${createUnsplashVariant(
              remoteImage.src,

              width,

              height,
            )} ${width}w`;
          },
        )
        .join(
          ', ',
        )
    : undefined;

const remoteFallbackSource =
  remoteImage &&
  isUnsplashImage(
    remoteImage.src,
  )
    ? (() => {
        const fallbackWidth =
          responsiveWidths.at(
            -1,
          ) ??
          remoteImage.width;

        const fallbackHeight =
          Math.max(
            1,

            Math.round(
              fallbackWidth *
                (
                  remoteImage.height /
                  remoteImage.width
                ),
            ),
          );

        return createUnsplashVariant(
          remoteImage.src,

          fallbackWidth,

          fallbackHeight,
        );
      })()
    : remoteImage?.src;
---

<div
  class:list={[
    'relative overflow-hidden bg-linear-to-br from-brand-50 via-cream-soft to-accent-50',

    className,
  ]}
>
  {
    image ? (
      typeof image.src === 'string' ? (
        <img
          src={remoteFallbackSource}
          srcset={remoteSourceSet}
          sizes={remoteSourceSet ? resolvedSizes : undefined}
          alt={image.alt}
          width={image.width}
          height={image.height}
          loading={loading}
          decoding="async"
          fetchpriority={fetchPriority}
          class={imageClasses}
          style={imageStyle}
        />
      ) : (
        <Image
          src={image.src as ImageMetadata}
          alt={image.alt}
          loading={loading}
          decoding="async"
          fetchpriority={fetchPriority}
          widths={responsiveWidths}
          sizes={resolvedSizes}
          quality={resolvedQuality}
          class={imageClasses}
          style={imageStyle}
        />
      )
    ) : (
      <div
        class="grid h-full min-h-64 place-items-center p-8 text-center"
        aria-label="Product image coming soon"
      >
        <div>
          <span
            class="mx-auto grid size-16 place-items-center rounded-full border border-brand-200 bg-white-warm text-brand-600 shadow-soft"
            aria-hidden="true"
          >
            <PawPrintBold
              class="size-8"
            />
          </span>

          <p
            class="mt-4 text-sm font-extrabold text-ink-600"
          >
            Product image coming soon
          </p>
        </div>
      </div>
    )
  }
</div>