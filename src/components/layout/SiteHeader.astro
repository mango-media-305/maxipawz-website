---
import ArrowRightBold from 'phosphor-astro/ArrowRightBold.astro';
import MagnifyingGlassBold from 'phosphor-astro/MagnifyingGlassBold.astro';

import BrandLogo from '../brand/BrandLogo.astro';
import CartButton from '../cart/CartButton';
import MobileNavigation from './MobileNavigation.astro';
import Button from '../ui/Button.astro';

import { isStoreLive, storefrontState } from '../../config/storefront';

import { mobileNavigation, primaryNavigation } from '../../data/navigation';

import { getActiveProducts } from '../../utils/products';

function normalizePath(path: string): string {
  if (path === '/') {
    return '/';
  }

  return path.replace(/\/+$/, '') || '/';
}

const currentPath = normalizePath(Astro.url.pathname);

const activeNavigationHref = primaryNavigation
  .filter((item) => {
    const itemPath = normalizePath(item.href);

    return currentPath === itemPath || currentPath.startsWith(`${itemPath}/`);
  })
  .sort((firstItem, secondItem) => secondItem.href.length - firstItem.href.length)[0]?.href;

function isCurrentRoute(href: string): boolean {
  if (!activeNavigationHref) {
    return false;
  }

  return normalizePath(href) === normalizePath(activeNavigationHref);
}

const headerAction = storefrontState.headerAction;

const activeProducts = getActiveProducts();

const hasDemoProducts = activeProducts.some((product) => product.isDemo);

const cartEnabled = isStoreLive || hasDemoProducts;
---

<header
  class="sticky top-0 z-40 isolate w-full border-b border-sand/60 shadow-[0_8px_28px_-24px_rgba(53,39,31,0.35)]"
  data-site-header
>
  <div
    class="pointer-events-none absolute inset-0 z-0 bg-cream-soft/95 backdrop-blur-xl"
    aria-hidden="true"
  >
  </div>

  <div
    class="site-container-wide relative z-10 flex min-h-16 items-center justify-between gap-3 py-1.5 sm:min-h-17"
  >
    <a
      href="/"
      class="group relative z-10 inline-flex shrink-0 items-center rounded-full focus-visible:outline-offset-4 md:rounded-2xl"
      aria-label="MaxiPawz Store home"
    >
      <BrandLogo
        variant="mascot"
        class="size-11 rounded-full border border-brand-100 bg-white-warm object-cover shadow-sm transition duration-200 group-hover:-translate-y-0.5 group-hover:shadow-blue md:hidden"
        eager={true}
      />

      <BrandLogo
        variant="logo"
        class="hidden h-10 w-auto object-contain transition duration-200 group-hover:-translate-y-0.5 md:block lg:h-11"
        eager={true}
      />
    </a>

    <nav class="hidden items-center gap-0.5 lg:flex" aria-label="Primary navigation">
      {
        primaryNavigation.map((item) => {
          const isCurrent = isCurrentRoute(item.href);

          return (
            <a
              href={item.href}
              class:list={[
                'relative inline-flex min-h-10 items-center rounded-full px-3 py-2 text-sm font-extrabold transition duration-200',

                isCurrent
                  ? 'bg-brand-100 text-brand-800'
                  : 'text-ink-700 hover:bg-white-warm hover:text-brand-700',
              ]}
              aria-current={isCurrent ? 'page' : undefined}
            >
              {item.label}

              {isCurrent && (
                <span
                  class="absolute inset-x-4 -bottom-0.5 h-0.5 rounded-full bg-accent-500"
                  aria-hidden="true"
                ></span>
              )}
            </a>
          );
        })
      }
    </nav>

    <div class="flex shrink-0 items-center gap-1.5 sm:gap-2">
      {
        cartEnabled && (
          <a
            href="/shop#products"
            class="hidden size-10 place-items-center rounded-full border border-brand-200 bg-white-warm text-brand-800 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:border-brand-400 hover:bg-brand-50 xl:grid"
            aria-label="Search MaxiPawz products"
          >
            <MagnifyingGlassBold class="size-4.5" aria-hidden="true" />
          </a>
        )
      }

      {cartEnabled && <CartButton client:load />}

      {
        !isStoreLive && headerAction && (
          <div class="hidden xl:block">
            <Button
              href={headerAction.href}
              variant="primary"
              size="sm"
              iconPosition="right"
              ariaLabel={headerAction.label}
            >
              <ArrowRightBold slot="icon" aria-hidden="true" />

              {headerAction.label}
            </Button>
          </div>
        )
      }

      <MobileNavigation
        items={mobileNavigation}
        currentPath={currentPath}
        cartEnabled={cartEnabled}
        actionLabel={headerAction?.label}
        actionHref={headerAction?.href}
        note={storefrontState.mobileNote}
      />
    </div>
  </div>
</header>