---
import HeartBold from 'phosphor-astro/HeartBold.astro';
import PawPrintBold from 'phosphor-astro/PawPrintBold.astro';

import { storefrontState } from '../../config/storefront';

const { announcement } = storefrontState;
---

<aside
  class="relative overflow-hidden bg-brand-500 text-white"
  aria-label="Store announcement"
>
  <div
    class="pointer-events-none absolute inset-y-0 left-0 w-40 bg-linear-to-r from-brand-700/45 to-transparent"
    aria-hidden="true"
  >
  </div>

  <div
    class="pointer-events-none absolute inset-y-0 right-0 w-40 bg-linear-to-l from-accent-500/55 to-transparent"
    aria-hidden="true"
  >
  </div>

  <a
    href={announcement.href}
    class="site-container relative flex min-h-10 items-center justify-center gap-2 py-2 text-center text-sm font-bold tracking-wide transition hover:bg-white/5"
    aria-label={announcement.ariaLabel}
  >
    <PawPrintBold
      class="hidden size-4 shrink-0 text-accent-200 sm:block"
      aria-hidden="true"
    />

    <span>{announcement.message}</span>

    <HeartBold
      class="hidden size-4 shrink-0 text-accent-200 sm:block"
      aria-hidden="true"
    />
  </a>
</aside>