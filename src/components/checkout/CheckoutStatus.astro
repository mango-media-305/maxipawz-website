---
import ArrowRightBold from 'phosphor-astro/ArrowRightBold.astro';
import CheckCircleFill from 'phosphor-astro/CheckCircleFill.astro';
import ShieldCheckBold from 'phosphor-astro/ShieldCheckBold.astro';
import ShoppingCartBold from 'phosphor-astro/ShoppingCartBold.astro';

import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';

import { getLocaleFromPathname } from '../../i18n/languages';

import {
  localizeHref,
  localizedLinkLabel,
} from '../../i18n/routes';

interface Props {
  status:
    | 'success'
    | 'cancel';
}

const {
  status,
} =
  Astro.props;

const locale =
  getLocaleFromPathname(
    Astro.url.pathname,
  );

const spanish =
  locale === 'es';

const isSuccess =
  status === 'success';

const copy =
  isSuccess
    ? spanish
      ? {
          badge:
            'Regreso del pago',

          heading:
            'Regresaste del proceso de pago de Stripe.',

          description:
            'Esta página únicamente confirma que el navegador regresó desde Stripe. El pago y la preparación del pedido deben verificarse por separado mediante el flujo de webhooks de Stripe.',

          noticeTitle:
            'Ahora debemos verificar el pago',

          notice:
            'No se deben enviar productos, reducir el inventario ni vaciar el carrito basándose únicamente en esta página. Primero, un evento verificado de Stripe debe confirmar el pago.',

          cart:
            'Volver al carrito',

          shop:
            'Seguir comprando',
        }
      : {
          badge:
            'Checkout Return',

          heading:
            'You returned from Stripe Checkout.',

          description:
            'This page confirms only that the browser returned from Stripe. Payment and order fulfillment must be verified separately through the Stripe webhook workflow.',

          noticeTitle:
            'Payment verification comes next',

          notice:
            'Do not ship products, reduce inventory, or clear the cart based only on this page. A verified Stripe event must confirm the payment first.',

          cart:
            'Return to Cart',

          shop:
            'Continue Shopping',
        }
    : spanish
      ? {
          badge:
            'Pago cancelado',

          heading:
            'Tu proceso de pago no se completó.',

          description:
            'Esta página no confirma ningún pedido completado. Los productos de tu carrito local permanecen disponibles para que puedas revisarlos o continuar con las pruebas.',

          noticeTitle:
            '',

          notice:
            '',

          cart:
            'Volver al carrito',

          shop:
            'Seguir comprando',
        }
      : {
          badge:
            'Checkout Cancelled',

          heading:
            'Your checkout was not completed.',

          description:
            'No completed order is being confirmed on this page. The products in your local cart remain available so you can review them or continue testing.',

          noticeTitle:
            '',

          notice:
            '',

          cart:
            'Return to Cart',

          shop:
            'Continue Shopping',
        };

const cartHref =
  localizeHref(
    '/cart',
    locale,
  );

const shopSourceHref =
  '/shop#products';

const shopHref =
  localizeHref(
    shopSourceHref,
    locale,
  );

const shopLabel =
  localizedLinkLabel(
    copy.shop,
    shopSourceHref,
    locale,
  );
---

<section class="py-10 sm:py-14 lg:py-18">
  <div class="site-container">
    <div
      class="relative overflow-hidden rounded-[2.75rem] border border-brand-200 bg-linear-to-br from-brand-50 via-white-warm to-accent-50 p-6 text-center shadow-card sm:p-10 lg:p-14"
    >
      <div
        class="pointer-events-none absolute -top-28 -left-24 size-80 rounded-full bg-brand-300/25 blur-3xl"
        aria-hidden="true"
      >
      </div>

      <div
        class="pointer-events-none absolute -right-24 -bottom-28 size-80 rounded-full bg-accent-300/25 blur-3xl"
        aria-hidden="true"
      >
      </div>

      <div class="relative mx-auto max-w-3xl">
        <span
          class:list={[
            'mx-auto grid size-18 place-items-center rounded-full border shadow-soft',

            isSuccess
              ? 'border-success-100 bg-success-50 text-success-700'
              : 'border-accent-200 bg-accent-50 text-accent-700',
          ]}
          aria-hidden="true"
        >
          {
            isSuccess
              ? (
                  <CheckCircleFill
                    class="size-9"
                  />
                )
              : (
                  <ShoppingCartBold
                    class="size-9"
                  />
                )
          }
        </span>

        <Badge
          variant={
            isSuccess
              ? 'brand'
              : 'accent'
          }
          size="md"
          class="mx-auto mt-6"
        >
          {
            isSuccess
              ? (
                  <CheckCircleFill
                    slot="icon"
                    aria-hidden="true"
                  />
                )
              : (
                  <ShoppingCartBold
                    slot="icon"
                    aria-hidden="true"
                  />
                )
          }

          {copy.badge}
        </Badge>

        <h1 class="mt-6 text-4xl text-ink-900 sm:text-5xl lg:text-6xl">
          {copy.heading}
        </h1>

        <p class="mx-auto mt-5 max-w-2xl text-lg leading-8 text-ink-600">
          {copy.description}
        </p>

        {
          isSuccess && (
            <div class="mx-auto mt-7 max-w-2xl rounded-card border border-accent-200 bg-accent-50 p-5 text-left">
              <ShieldCheckBold
                class="size-7 text-accent-700"
                aria-hidden="true"
              />

              <h2 class="mt-3 text-xl text-ink-900">
                {copy.noticeTitle}
              </h2>

              <p class="mt-2 text-sm leading-6 text-ink-600">
                {copy.notice}
              </p>
            </div>
          )
        }

        <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
          <Button
            href={cartHref}
            variant="primary"
            size="lg"
            iconPosition="right"
          >
            <ShoppingCartBold
              slot="icon"
              aria-hidden="true"
            />

            {copy.cart}
          </Button>

          <Button
            href={shopHref}
            variant="secondary"
            size="lg"
            iconPosition="right"
          >
            <ArrowRightBold
              slot="icon"
              aria-hidden="true"
            />

            {shopLabel}
          </Button>
        </div>
      </div>
    </div>
  </div>
</section>