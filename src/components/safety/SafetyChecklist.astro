---
import CheckCircleFill from 'phosphor-astro/CheckCircleFill.astro';

import type { SafetyTone } from '../../data/product-safety';

interface Props {
  id?: string;
  title: string;
  description?: string;
  items: readonly string[];
  tone?: SafetyTone;
  compact?: boolean;
  class?: string;
}

const {
  id,
  title,
  description,
  items,
  tone = 'brand',
  compact = false,
  class: className = '',
} = Astro.props;

const surfaceClasses: Record<SafetyTone, string> = {
  brand: 'border-brand-200 bg-brand-50/80',

  accent: 'border-accent-200 bg-accent-50/80',

  sand: 'border-sand-dark/70 bg-cream-soft/[0.85]',
};

const iconClasses: Record<SafetyTone, string> = {
  brand: 'bg-brand-500 text-white shadow-blue',

  accent: 'bg-accent-500 text-ink-950 shadow-orange',

  sand: 'bg-ink-800 text-white shadow-soft',
};
---

<article
  id={id}
  class:list={[
    'scroll-mt-28 rounded-4xl border shadow-sm',
    compact ? 'p-4 sm:p-5' : 'p-5 sm:p-6',
    surfaceClasses[tone],
    className,
  ]}
>
  <header class="flex items-start gap-4">
    <span
      class:list={[
        'grid size-11 shrink-0 place-items-center rounded-2xl',
        '[&>svg]:size-5',
        iconClasses[tone],
      ]}
      aria-hidden="true"
    >
      <slot name="icon" />
    </span>

    <div class="min-w-0">
      <h3 class:list={['text-ink-900', compact ? 'text-xl' : 'text-2xl']}>
        {title}
      </h3>

      {description && <p class="mt-2 text-sm leading-6 text-ink-600">{description}</p>}
    </div>
  </header>

  <ul class:list={['grid gap-3', compact ? 'mt-4' : 'mt-5']}>
    {
      items.map((item) => (
        <li class="flex items-start gap-3 rounded-2xl border border-sand/80 bg-white-warm/90 p-3.5">
          <CheckCircleFill class="mt-0.5 size-5 shrink-0 text-brand-500" aria-hidden="true" />

          <span class="text-sm font-bold leading-6 text-ink-700">{item}</span>
        </li>
      ))
    }
  </ul>
</article>
