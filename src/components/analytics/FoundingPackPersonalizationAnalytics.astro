---
const analyticsEnabled =
  import.meta.env.PROD &&
  import.meta.env.PUBLIC_ANALYTICS_ENABLED === 'true';

const gaMeasurementId =
  import.meta.env.PUBLIC_GA_MEASUREMENT_ID?.trim() ?? '';

const clarityProjectId =
  import.meta.env.PUBLIC_CLARITY_PROJECT_ID?.trim() ?? '';

const gaEnabled =
  analyticsEnabled &&
  gaMeasurementId.startsWith('G-');

const clarityEnabled =
  analyticsEnabled &&
  clarityProjectId.length > 0;
---

<div
  hidden
  aria-hidden="true"
  data-founding-pack-personalization-analytics
  data-ga-enabled={String(gaEnabled)}
  data-clarity-enabled={String(clarityEnabled)}
>
</div>

<script>
  import {
    buildFoundingPackAnalyticsContext,
    buildFoundingPackAnalyticsEvent,
  } from '../../lib/founding-pack-personalization-analytics';

  import {
    deserializeFoundingPackPersonalizationProfile,
    getPersonalizedGuidePriorities,
  } from '../../lib/founding-pack-personalization';

  import {
    FOUNDING_PACK_PERSONALIZATION_STORAGE_KEY,
    type FoundingPackPersonalizationProfile,
    type FoundingPackPersonalizedGuideSlug,
  } from '../../types/founding-pack-personalization';

  interface MaxiPawzAnalyticsWindow extends Window {
    gtag?: (
      command: string,
      eventName: string,
      parameters?: Record<
        string,
        boolean | number | string
      >,
    ) => void;

    clarity?: (
      command: string,
      eventName: string,
    ) => void;
  }

  const PERSONALIZATION_SAVED_EVENT =
    'maxipawz:founding-pet-personalization-saved';

  const PERSONALIZATION_FORGOTTEN_EVENT =
    'maxipawz:founding-pet-personalization-forgotten';

  const ANALYTICS_COMPONENT_SELECTOR =
    '[data-founding-pack-personalization-analytics]';

  const GUIDE_SECTION_SELECTOR =
    '[data-pet-guides-preview]';

  const GUIDE_CARD_SELECTOR =
    '[data-guide-card]';

  const GUIDE_LINK_SELECTOR =
    '[data-guide-interactive]';

  const WELCOME_SECTION_SELECTOR =
    '[data-founding-pet-welcome]';

  const RECOMMENDATION_VISIBILITY_THRESHOLD =
    0.5;

  const WELCOME_VISIBILITY_THRESHOLD =
    0.35;

  const isPersonalizedGuideSlug =
    (
      value:
        string | undefined,
    ): value is FoundingPackPersonalizedGuideSlug =>
      value ===
        'dog-hydration-miami-heat' ||
      value ===
        'play-and-enrichment' ||
      value ===
        'walk-and-travel' ||
      value ===
        'feeding-and-hydration';

  const initializeFoundingPackPersonalizationAnalytics =
    (): void => {
      const element =
        document.querySelector<HTMLElement>(
          ANALYTICS_COMPONENT_SELECTOR,
        );

      if (
        !element ||
        element.dataset
          .foundingPackPersonalizationAnalyticsInitialized ===
          'true'
      ) {
        return;
      }

      element.dataset
        .foundingPackPersonalizationAnalyticsInitialized =
        'true';

      const gaEnabled =
        element.dataset.gaEnabled ===
        'true';

      const clarityEnabled =
        element.dataset.clarityEnabled ===
        'true';

      /*
       * Analytics remains completely inactive outside the
       * configured production analytics environment.
       */
      if (
        !gaEnabled &&
        !clarityEnabled
      ) {
        return;
      }

      const analyticsWindow =
        window as MaxiPawzAnalyticsWindow;

      let currentProfile:
        FoundingPackPersonalizationProfile |
        null =
        null;

      let currentPriorities:
        FoundingPackPersonalizedGuideSlug[] =
        [];

      let recommendationObserver:
        IntersectionObserver |
        null =
        null;

      let welcomeObserver:
        IntersectionObserver |
        null =
        null;

      const cleanupFunctions:
        Array<() => void> =
        [];

      const readStoredProfile =
        (): FoundingPackPersonalizationProfile | null => {
          try {
            const serialized =
              window.localStorage.getItem(
                FOUNDING_PACK_PERSONALIZATION_STORAGE_KEY,
              );

            if (!serialized) {
              return null;
            }

            return deserializeFoundingPackPersonalizationProfile(
              serialized,
            );
          } catch {
            /*
             * Analytics must never interfere with the
             * storefront or personalization experience.
             */
            return null;
          }
        };

      const createTrackingStorageKey =
        (
          eventName:
            string,

          profile:
            FoundingPackPersonalizationProfile,

          discriminator?:
            string,
        ): string =>
          [
            'maxipawz',
            'personalization-analytics',
            window.location.pathname,
            eventName,
            profile.savedAt,

            ...(discriminator
              ? [discriminator]
              : []),
          ].join(
            ':',
          );

      const hasTracked =
        (
          eventName:
            string,

          profile:
            FoundingPackPersonalizationProfile,

          discriminator?:
            string,
        ): boolean => {
          const storageKey =
            createTrackingStorageKey(
              eventName,
              profile,
              discriminator,
            );

          try {
            if (
              window.sessionStorage.getItem(
                storageKey,
              ) ===
              '1'
            ) {
              return true;
            }

            window.sessionStorage.setItem(
              storageKey,
              '1',
            );

            return false;
          } catch {
            /*
             * If sessionStorage is unavailable, analytics
             * remains best-effort.
             */
            return false;
          }
        };

      const sendAnalyticsEvent =
        (
          eventName:
            string,

          parameters:
            Record<
              string,
              boolean | number | string
            >,
        ): void => {
          if (
            gaEnabled &&
            typeof analyticsWindow.gtag ===
              'function'
          ) {
            analyticsWindow.gtag(
              'event',
              eventName,
              parameters,
            );
          }

          if (
            clarityEnabled &&
            typeof analyticsWindow.clarity ===
              'function'
          ) {
            analyticsWindow.clarity(
              'event',
              eventName,
            );
          }
        };

      const getGuideCards =
        (): HTMLElement[] => {
          const section =
            document.querySelector<HTMLElement>(
              GUIDE_SECTION_SELECTOR,
            );

          if (!section) {
            return [];
          }

          return Array.from(
            section.querySelectorAll<HTMLElement>(
              GUIDE_CARD_SELECTOR,
            ),
          );
        };

      const getGuidePosition =
        (
          guideSlug:
            FoundingPackPersonalizedGuideSlug,
        ): number => {
          const cards =
            getGuideCards();

          const index =
            cards.findIndex(
              (card) =>
                card.dataset.guideSlug ===
                guideSlug,
            );

          return index >= 0
            ? index + 1
            : 0;
        };

      const setCurrentProfile =
        (
          profile:
            FoundingPackPersonalizationProfile | null,
        ): void => {
          currentProfile =
            profile;

          currentPriorities =
            profile
              ? getPersonalizedGuidePriorities(
                  profile,
                )
              : [];
        };

      const trackPersonalizationLoaded =
        (
          profile:
            FoundingPackPersonalizationProfile,
        ): void => {
          const priorities =
            getPersonalizedGuidePriorities(
              profile,
            );

          const context =
            buildFoundingPackAnalyticsContext(
              profile,
            );

          const analyticsEvent =
            buildFoundingPackAnalyticsEvent(
              {
                event:
                  'founding_pet_personalization_loaded',

                ...context,

                personalizedGuideCount:
                  priorities.length,
              },
            );

          if (
            hasTracked(
              analyticsEvent.eventName,
              profile,
            )
          ) {
            return;
          }

          sendAnalyticsEvent(
            analyticsEvent.eventName,
            analyticsEvent.parameters,
          );
        };

      const trackWelcomeViewed =
        (
          profile:
            FoundingPackPersonalizationProfile,
        ): void => {
          const context =
            buildFoundingPackAnalyticsContext(
              profile,
            );

          const analyticsEvent =
            buildFoundingPackAnalyticsEvent(
              {
                event:
                  'founding_pet_welcome_viewed',

                ...context,
              },
            );

          /*
           * This is an impression, not an action.
           *
           * Count it only once per saved profile during
           * the browser session.
           */
          if (
            hasTracked(
              analyticsEvent.eventName,
              profile,
            )
          ) {
            return;
          }

          sendAnalyticsEvent(
            analyticsEvent.eventName,
            analyticsEvent.parameters,
          );
        };

      const trackRecommendedGuide =
        (
          profile:
            FoundingPackPersonalizationProfile,

          guideSlug:
            FoundingPackPersonalizedGuideSlug,
        ): void => {
          const priorityIndex =
            currentPriorities.indexOf(
              guideSlug,
            );

          if (
            priorityIndex <
            0
          ) {
            return;
          }

          const recommendationPosition =
            getGuidePosition(
              guideSlug,
            );

          if (
            recommendationPosition <=
            0
          ) {
            return;
          }

          const context =
            buildFoundingPackAnalyticsContext(
              profile,
            );

          const analyticsEvent =
            buildFoundingPackAnalyticsEvent(
              {
                event:
                  'founding_pet_guide_recommended',

                ...context,

                guideSlug,

                recommendationPosition,
              },
            );

          if (
            hasTracked(
              analyticsEvent.eventName,
              profile,
              guideSlug,
            )
          ) {
            return;
          }

          sendAnalyticsEvent(
            analyticsEvent.eventName,
            analyticsEvent.parameters,
          );
        };

      const trackGuideClick =
        (
          guideSlug:
            FoundingPackPersonalizedGuideSlug,
        ): void => {
          const profile =
            currentProfile;

          if (!profile) {
            return;
          }

          const recommendationPosition =
            getGuidePosition(
              guideSlug,
            );

          if (
            recommendationPosition <=
            0
          ) {
            return;
          }

          const personalized =
            currentPriorities.includes(
              guideSlug,
            );

          const context =
            buildFoundingPackAnalyticsContext(
              profile,
            );

          const analyticsEvent =
            buildFoundingPackAnalyticsEvent(
              {
                event:
                  'founding_pet_guide_clicked',

                ...context,

                guideSlug,

                recommendationPosition,

                personalized,
              },
            );

          /*
           * Clicks are deliberate user actions and are
           * intentionally not deduplicated.
           */
          sendAnalyticsEvent(
            analyticsEvent.eventName,
            analyticsEvent.parameters,
          );
        };

      const trackPersonalizationForgotten =
        (
          profile:
            FoundingPackPersonalizationProfile,
        ): void => {
          const context =
            buildFoundingPackAnalyticsContext(
              profile,
            );

          const analyticsEvent =
            buildFoundingPackAnalyticsEvent(
              {
                event:
                  'founding_pet_personalization_forgotten',

                ...context,
              },
            );

          /*
           * Forget is also a deliberate user action.
           *
           * Do not session-dedupe it. If a visitor later
           * creates another profile and forgets that one,
           * both actions should be measurable.
           */
          sendAnalyticsEvent(
            analyticsEvent.eventName,
            analyticsEvent.parameters,
          );
        };

      const disconnectRecommendationObserver =
        (): void => {
          recommendationObserver?.disconnect();

          recommendationObserver =
            null;
        };

      const disconnectWelcomeObserver =
        (): void => {
          welcomeObserver?.disconnect();

          welcomeObserver =
            null;
        };

      const observeRecommendations =
        (): void => {
          disconnectRecommendationObserver();

          const profile =
            currentProfile;

          if (
            !profile ||
            currentPriorities.length ===
              0
          ) {
            return;
          }

          if (
            !(
              'IntersectionObserver' in
              window
            )
          ) {
            /*
             * We deliberately avoid manufacturing
             * impressions when visibility cannot be
             * measured reliably.
             */
            return;
          }

          const cards =
            getGuideCards();

          recommendationObserver =
            new IntersectionObserver(
              (
                entries,
                observer,
              ) => {
                for (
                  const entry of
                  entries
                ) {
                  if (
                    !entry.isIntersecting ||
                    entry.intersectionRatio <
                      RECOMMENDATION_VISIBILITY_THRESHOLD
                  ) {
                    continue;
                  }

                  const card =
                    entry.target;

                  if (
                    !(
                      card instanceof
                      HTMLElement
                    )
                  ) {
                    observer.unobserve(
                      entry.target,
                    );

                    continue;
                  }

                  const guideSlug =
                    card.dataset
                      .guideSlug;

                  if (
                    isPersonalizedGuideSlug(
                      guideSlug,
                    ) &&
                    currentPriorities.includes(
                      guideSlug,
                    )
                  ) {
                    trackRecommendedGuide(
                      profile,
                      guideSlug,
                    );
                  }

                  observer.unobserve(
                    entry.target,
                  );
                }
              },
              {
                threshold:
                  RECOMMENDATION_VISIBILITY_THRESHOLD,

                rootMargin:
                  '0px 0px -8% 0px',
              },
            );

          for (
            const card of
            cards
          ) {
            const guideSlug =
              card.dataset
                .guideSlug;

            if (
              !isPersonalizedGuideSlug(
                guideSlug,
              ) ||
              !currentPriorities.includes(
                guideSlug,
              )
            ) {
              continue;
            }

            recommendationObserver.observe(
              card,
            );
          }
        };

      const observeWelcomeBack =
        (): void => {
          disconnectWelcomeObserver();

          const profile =
            currentProfile;

          if (!profile) {
            return;
          }

          const welcomeSection =
            document.querySelector<HTMLElement>(
              WELCOME_SECTION_SELECTOR,
            );

          if (!welcomeSection) {
            return;
          }

          if (
            !(
              'IntersectionObserver' in
              window
            )
          ) {
            /*
             * Just like guide recommendations, we avoid
             * claiming an impression if we cannot observe
             * viewport visibility.
             */
            return;
          }

          welcomeObserver =
            new IntersectionObserver(
              (
                entries,
                observer,
              ) => {
                for (
                  const entry of
                  entries
                ) {
                  if (
                    !entry.isIntersecting ||
                    entry.intersectionRatio <
                      WELCOME_VISIBILITY_THRESHOLD
                  ) {
                    continue;
                  }

                  trackWelcomeViewed(
                    profile,
                  );

                  observer.unobserve(
                    entry.target,
                  );
                }
              },
              {
                threshold:
                  WELCOME_VISIBILITY_THRESHOLD,

                rootMargin:
                  '0px 0px -6% 0px',
              },
            );

          welcomeObserver.observe(
            welcomeSection,
          );
        };

      const attachGuideClickTracking =
        (): void => {
          const cards =
            getGuideCards();

          for (
            const card of
            cards
          ) {
            const guideSlug =
              card.dataset
                .guideSlug;

            if (
              !isPersonalizedGuideSlug(
                guideSlug,
              )
            ) {
              continue;
            }

            const link =
              card.querySelector<HTMLElement>(
                GUIDE_LINK_SELECTOR,
              );

            if (!link) {
              continue;
            }

            const handleClick =
              (): void => {
                trackGuideClick(
                  guideSlug,
                );
              };

            link.addEventListener(
              'click',
              handleClick,
            );

            cleanupFunctions.push(
              () => {
                link.removeEventListener(
                  'click',
                  handleClick,
                );
              },
            );
          }
        };

      const activateProfileAnalytics =
        (
          profile:
            FoundingPackPersonalizationProfile,
        ): void => {
          setCurrentProfile(
            profile,
          );

          trackPersonalizationLoaded(
            profile,
          );

          /*
           * The personalization UI and Pet Guides both
           * react to the same browser profile.
           *
           * Wait one frame so their DOM state can settle
           * before viewport observation begins.
           */
          window.requestAnimationFrame(
            () => {
              observeWelcomeBack();

              observeRecommendations();
            },
          );
        };

      const activateStoredProfile =
        (): void => {
          const profile =
            readStoredProfile();

          if (!profile) {
            setCurrentProfile(
              null,
            );

            disconnectWelcomeObserver();

            disconnectRecommendationObserver();

            return;
          }

          activateProfileAnalytics(
            profile,
          );
        };

      const handleSavedProfile =
        (
          event:
            Event,
        ): void => {
          const customEvent =
            event as
              CustomEvent<FoundingPackPersonalizationProfile>;

          const eventProfile =
            customEvent.detail;

          if (!eventProfile) {
            activateStoredProfile();

            return;
          }

          /*
           * CustomEvent payloads are browser-controlled.
           *
           * Validate them against the versioned safe
           * personalization contract before analytics.
           */
          let serialized:
            string;

          try {
            serialized =
              JSON.stringify(
                eventProfile,
              );
          } catch {
            activateStoredProfile();

            return;
          }

          const profile =
            deserializeFoundingPackPersonalizationProfile(
              serialized,
            );

          if (!profile) {
            activateStoredProfile();

            return;
          }

          activateProfileAnalytics(
            profile,
          );
        };

      const handleForgottenProfile =
        (): void => {
          /*
           * FoundingPackWelcomeBack removes localStorage
           * before dispatching the forgotten event.
           *
           * Therefore we intentionally use the validated
           * profile already held in memory here.
           */
          const profile =
            currentProfile;

          if (profile) {
            trackPersonalizationForgotten(
              profile,
            );
          }

          disconnectWelcomeObserver();

          disconnectRecommendationObserver();

          setCurrentProfile(
            null,
          );
        };

      /*
       * Cards are moved during personalization but not
       * replaced, so one click-listener attachment is
       * sufficient for the component lifecycle.
       */
      attachGuideClickTracking();

      /*
       * Existing saved profile:
       *
       * homepage
       *   ↓
       * personalization_loaded
       *   ↓
       * Welcome Back impression
       *   ↓
       * recommendation impressions
       */
      activateStoredProfile();

      window.addEventListener(
        PERSONALIZATION_SAVED_EVENT,
        handleSavedProfile,
      );

      window.addEventListener(
        PERSONALIZATION_FORGOTTEN_EVENT,
        handleForgottenProfile,
      );

      const cleanup =
        (): void => {
          disconnectWelcomeObserver();

          disconnectRecommendationObserver();

          window.removeEventListener(
            PERSONALIZATION_SAVED_EVENT,
            handleSavedProfile,
          );

          window.removeEventListener(
            PERSONALIZATION_FORGOTTEN_EVENT,
            handleForgottenProfile,
          );

          for (
            const cleanupFunction of
            cleanupFunctions
          ) {
            cleanupFunction();
          }

          setCurrentProfile(
            null,
          );

          delete element.dataset
            .foundingPackPersonalizationAnalyticsInitialized;
        };

      document.addEventListener(
        'astro:before-swap',
        cleanup,
        {
          once:
            true,
        },
      );
    };

  initializeFoundingPackPersonalizationAnalytics();

  document.addEventListener(
    'astro:page-load',
    initializeFoundingPackPersonalizationAnalytics,
  );
</script>