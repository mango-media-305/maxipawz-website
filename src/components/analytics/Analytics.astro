---
const analyticsEnabled =
    import.meta.env.PROD &&
    import.meta.env.PUBLIC_ANALYTICS_ENABLED === 'true';

const gaMeasurementId =
    import.meta.env.PUBLIC_GA_MEASUREMENT_ID?.trim() ?? '';

const clarityProjectId =
    import.meta.env.PUBLIC_CLARITY_PROJECT_ID?.trim() ?? '';

const gaEnabled =
    analyticsEnabled &&
    gaMeasurementId.startsWith('G-');

const clarityEnabled =
    analyticsEnabled &&
    clarityProjectId.length > 0;

const gaScriptUrl =
    `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(
        gaMeasurementId,
    )}`;
---

{
    gaEnabled && (
        <>
        <script
            is:inline
            async
            src={gaScriptUrl}
        >
        </script>

        <script
            is:inline
            define:vars={{ gaMeasurementId }}
        >
            window.dataLayer = window.dataLayer || [];

            window.gtag =
            window.gtag ||
            function () {
                window.dataLayer.push(arguments);
            };

            window.gtag('js', new Date());

            window.gtag('config', gaMeasurementId, {
            send_page_view: true,
            });
        </script>
        </>
    )
}

{
    clarityEnabled && (
        <script
        is:inline
        define:vars={{ clarityProjectId }}
        >
        (function (c, l, a, r, i, t, y) {
            c[a] =
            c[a] ||
            function () {
                (c[a].q = c[a].q || []).push(arguments);
            };

            t = l.createElement(r);
            t.async = 1;
            t.src = 'https://www.clarity.ms/tag/' + i;

            y = l.getElementsByTagName(r)[0];
            y.parentNode.insertBefore(t, y);
        })(
            window,
            document,
            'clarity',
            'script',
            clarityProjectId,
        );
        </script>
    )
}