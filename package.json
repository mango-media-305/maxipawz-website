{
  "name": "maxipawz-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The official MaxiPawz Store e-commerce storefront for pet toys and accessories.",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint \"src/**/*.{astro,js,jsx,ts,tsx,mjs,cjs}\" \"netlify/functions/**/*.{js,ts,mjs,cjs}\" \"*.{js,mjs,cjs}\" --no-error-on-unmatched-pattern",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "npm run check && npm run lint && npm run format:check && npm run build"
  },
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "dependencies": {
    "@astrojs/preact": "6.0.1",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "astro": "7.1.3",
    "phosphor-astro": "^2.1.0",
    "preact": "10.29.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.8",
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "eslint": "10.7.0",
    "eslint-plugin-astro": "3.0.1",
    "prettier": "3.6.2",
    "prettier-plugin-astro": "0.14.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.64.0"
  }
}
