# ---------------------------------------------------------
# STOREFRONT
# ---------------------------------------------------------

PUBLIC_STOREFRONT_MODE=prelaunch
PUBLIC_CHECKOUT_MODE=disabled
PUBLIC_SANDBOX_CATALOG_CHECKOUT=false

# ---------------------------------------------------------
# SITE
# ---------------------------------------------------------

PUBLIC_SITE_URL=https://maxi-pawz.netlify.app

# ---------------------------------------------------------
# STRIPE
# ---------------------------------------------------------

# Public Stripe Sandbox key used by Embedded Checkout.
PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Server-only Stripe Sandbox credential.
STRIPE_SECRET_KEY=sk_test_replace_me

# Signing secret from the deployed Stripe Sandbox webhook.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# ---------------------------------------------------------
# EASYPOST
# ---------------------------------------------------------

# Keep this as "test" while Stripe Checkout is in Sandbox.
EASYPOST_MODE=test

# Server-only EasyPost Test API key.
EASYPOST_API_KEY=replace_with_easypost_test_key

# Physical location from which MaxiPawz packages will ship.
# These values are server-only.
EASYPOST_FROM_NAME=MaxiPawz Store
EASYPOST_FROM_STREET1=
EASYPOST_FROM_STREET2=
EASYPOST_FROM_CITY=
EASYPOST_FROM_STATE=
EASYPOST_FROM_ZIP=

# Sandbox parcel used only to test carrier-rating integration.
#
# These values DO NOT define production packaging.
# Production shipping will use real packaged product/box data.
EASYPOST_TEST_PARCEL_LENGTH_IN=12
EASYPOST_TEST_PARCEL_WIDTH_IN=10
EASYPOST_TEST_PARCEL_HEIGHT_IN=6
EASYPOST_TEST_PARCEL_WEIGHT_OZ=32

# ---------------------------------------------------------
# RESEND
# ---------------------------------------------------------

RESEND_EMAILS_ENABLED=false

RESEND_CUSTOMER_ORDER_EMAILS_ENABLED=true
RESEND_INTERNAL_ORDER_EMAILS_ENABLED=true

RESEND_API_KEY=re_replace_me

RESEND_FROM_NAME=MaxiPawz Store

RESEND_FROM_EMAIL=onboarding@resend.dev

RESEND_REPLY_TO_EMAIL=

RESEND_ORDER_NOTIFICATION_EMAIL=

RESEND_SANDBOX_RECIPIENT_EMAIL=