# Public storefront configuration
PUBLIC_STOREFRONT_MODE=prelaunch
PUBLIC_CHECKOUT_MODE=disabled

# Netlify Dev runs the local site on port 8888.
PUBLIC_SITE_URL=http://localhost:8888

# Server-only Stripe test credentials
# Never commit real secret values.
STRIPE_SECRET_KEY=test

# Generated by `stripe listen`.
STRIPE_WEBHOOK_SECRET=whsec_replace_me