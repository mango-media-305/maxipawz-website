# ---------------------------------------------------------
# SITE
# ---------------------------------------------------------

# Canonical production origin.
# Do not include a trailing slash.
PUBLIC_SITE_URL=https://maxipawz.com

# Local development and production should normally be false.
# Netlify Deploy Previews and test projects should override this.
PUBLIC_ROBOTS_NOINDEX=false

# ---------------------------------------------------------
# ANALYTICS
# ---------------------------------------------------------

# Keep false for local development unless analytics are being
# tested intentionally.
PUBLIC_ANALYTICS_ENABLED=false

# Public Google Analytics 4 Measurement ID.
PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Public Microsoft Clarity project ID.
PUBLIC_CLARITY_PROJECT_ID=XXXXXXXXXX

# ---------------------------------------------------------
# STOREFRONT
# ---------------------------------------------------------

# Keep the public storefront in prelaunch mode until business
# registration, policies, real products, live payments, and final
# production testing are complete.
PUBLIC_STOREFRONT_MODE=prelaunch

# Real checkout must remain disabled during prelaunch.
PUBLIC_CHECKOUT_MODE=disabled

# Keep the fictional Sandbox catalog hidden from the public site.
PUBLIC_SANDBOX_CATALOG_CHECKOUT=false

# ---------------------------------------------------------
# STRIPE
# ---------------------------------------------------------

# Use Sandbox keys in local development and testing environments.
# Configure live keys only in production.
PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Server-only Stripe credential.
STRIPE_SECRET_KEY=sk_test_replace_me

# Signing secret for the Stripe webhook endpoint deployed in this
# environment.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# ---------------------------------------------------------
# MAXI PAWZ INTERNAL SERVICES
# ---------------------------------------------------------

# Shared server-only secret used when one Maxi Pawz Netlify Function
# invokes another internal function.
#
# Generate a unique random value containing at least 32 characters.
# Never expose this as a PUBLIC_ environment variable.
MAXIPAWZ_INTERNAL_FUNCTION_SECRET=replace_with_a_unique_random_secret_of_at_least_32_characters

# ---------------------------------------------------------
# MAXI PAWZ ADMIN
# ---------------------------------------------------------

# Server-only secret used to access internal order dashboard APIs.
MAXIPAWZ_ADMIN_TOKEN=replace_with_long_random_secret

# ---------------------------------------------------------
# RESEND - TRANSACTIONAL EMAIL
# ---------------------------------------------------------

# Controls transactional Stripe/order email processing.
RESEND_EMAILS_ENABLED=false

RESEND_CUSTOMER_ORDER_EMAILS_ENABLED=true
RESEND_INTERNAL_ORDER_EMAILS_ENABLED=true

# Sending-access Resend API key.
#
# This key should only need permission to send email.
# Newsletter Contact management uses RESEND_CONTACTS_API_KEY instead.
RESEND_API_KEY=re_replace_with_sending_access_key

# Signing secret assigned to the Resend webhook endpoint.
RESEND_WEBHOOK_SECRET=whsec_replace_me

# Verified transactional sender identity.
RESEND_FROM_NAME=Maxi Pawz Store
RESEND_FROM_EMAIL=orders@updates.maxipawz.com

# Customer replies are handled through Microsoft 365.
RESEND_REPLY_TO_EMAIL=support@maxipawz.com

# Internal paid-order notifications.
RESEND_ORDER_NOTIFICATION_EMAIL=orders@maxipawz.com

# Optional safety override for Stripe Sandbox ORDER email testing.
#
# This does not control newsletter Contact synchronization.
RESEND_SANDBOX_RECIPIENT_EMAIL=

# ---------------------------------------------------------
# RESEND - CONTACTS / MARKETING AUDIENCE
# ---------------------------------------------------------

# Full-access Resend API key.
#
# This credential manages Contacts and Topic preferences.
# Do not expose it as a PUBLIC_ environment variable.
RESEND_CONTACTS_API_KEY=re_replace_with_full_access_key

# ---------------------------------------------------------
# NEWSLETTER / JOIN THE PACK
# ---------------------------------------------------------

# Enables Join the Pack lead capture and Resend Contact synchronization.
NEWSLETTER_SIGNUPS_ENABLED=false

# Explicit newsletter Blob-storage environment.
#
# Local development:
#   test
#
# maxi-pawz Netlify testing project:
#   test
#
# Final production Maxi Pawz project:
#   live
NEWSLETTER_DATA_MODE=test

# Resend Topic used for Maxi Pawz marketing communications.
#
# Recommended Topic:
# Maxi Pawz News & Offers
#
# Recommended default subscription:
# Opt-out
#
# Checkbox selected:
#   Contact unsubscribed = false
#   Topic subscription = opt_in
#
# Checkbox unselected:
#   Contact unsubscribed = true
#   Topic subscription = opt_out
RESEND_NEWSLETTER_TOPIC_ID=replace_with_resend_topic_uuid

# ---------------------------------------------------------
# MARKETING EMAIL
# ---------------------------------------------------------

# Master switch for outbound Maxi Pawz marketing email.
#
# Keep false until:
# - a valid physical mailing address is configured,
# - unsubscribe handling is implemented,
# - unsubscribe behavior has been tested.
MARKETING_EMAILS_ENABLED=false

# Marketing sender identity.
#
# For the initial Maxi Pawz stage, marketing and transactional email
# share the already verified updates.maxipawz.com Resend domain while
# using separate sender addresses.
#
# Transactional:
#   orders@updates.maxipawz.com
#
# Marketing:
#   hello@updates.maxipawz.com
RESEND_MARKETING_FROM_NAME=Maxi Pawz Store
RESEND_MARKETING_FROM_EMAIL=hello@updates.maxipawz.com

# Valid physical postal address displayed in commercial marketing email.
#
# This may be a valid street address, registered USPS PO Box,
# or qualifying commercial mailbox.
#
# Keep the real value in local/Netlify environment configuration,
# not in source control.
MARKETING_MAILING_ADDRESS=