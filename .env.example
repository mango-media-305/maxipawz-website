# ---------------------------------------------------------
# STOREFRONT
# ---------------------------------------------------------

PUBLIC_STOREFRONT_MODE=prelaunch
PUBLIC_CHECKOUT_MODE=disabled
PUBLIC_SANDBOX_CATALOG_CHECKOUT=false

# ---------------------------------------------------------
# SHIPPING
# ---------------------------------------------------------

# Flat standard-shipping amount in cents.
# Example: 799 means $7.99.
PUBLIC_STANDARD_SHIPPING_RATE_CENTS=799

# ---------------------------------------------------------
# SITE
# ---------------------------------------------------------

PUBLIC_SITE_URL=https://maxi-pawz.netlify.app

# ---------------------------------------------------------
# STRIPE
# ---------------------------------------------------------

# Server-only Stripe Sandbox credentials.
# Never commit real secret values.
STRIPE_SECRET_KEY=sk_test_replace_me

# Signing secret from the deployed Stripe Sandbox webhook.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# ---------------------------------------------------------
# RESEND
# ---------------------------------------------------------

# Master switch for transactional email.
RESEND_EMAILS_ENABLED=false

# Individual transactional-email switches.
RESEND_CUSTOMER_ORDER_EMAILS_ENABLED=true
RESEND_INTERNAL_ORDER_EMAILS_ENABLED=true

# Server-only Resend API credential.
# Never commit the real value.
RESEND_API_KEY=re_replace_me

# Sender identity.
RESEND_FROM_NAME=MaxiPawz Store

# For initial testing you may use onboarding@resend.dev.
# Production should use an address on a verified MaxiPawz domain.
RESEND_FROM_EMAIL=onboarding@resend.dev

# Optional address that receives customer replies.
RESEND_REPLY_TO_EMAIL=

# Internal MaxiPawz address that receives new-order alerts.
RESEND_ORDER_NOTIFICATION_EMAIL=

# During Stripe Sandbox testing, all transactional emails can be
# redirected here instead of being sent to the Checkout customer.
#
# When using onboarding@resend.dev, this should be the email address
# associated with your Resend account.
RESEND_SANDBOX_RECIPIENT_EMAIL=